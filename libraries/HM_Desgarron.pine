// ═══════════════════════════════════════════════════════════════ Functions
parseDates(string s) =>
    array<int> out = array.new<int>()
    for p in str.split(s, ",")
        out.push(int(str.tonumber(p)))
    out
parseStats(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p))
    out
unpackMilli(string s) =>
    array<float> out = array.new<float>()
    for i = 0 to int(str.length(s) / 2) - 1
        out.push((str.pos(P92, str.substring(s, 2 * i, 2 * i + 1)) * 92 + str.pos(P92, str.substring(s, 2 * i + 1, 2 * i + 2)) - 2000) / 1000.0)
    out
parseMilli(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p) / 1000.0)
    out
txAdd(State hmS, string s) =>
    hmS.s1.TXA.push(s)
    hmS.s1.TXA.size() - 1
ck(State hmS, int i, int m, int k, int j) => hmS.s1.CK.get(i * CKB + m * 230 + k * 46 + j)
ckSh(State hmS, int i, int j) => hmS.s1.CK.get(i * CKB + 460 + j)
ckAt(State hmS, int i, int m, int k, int j, float f) =>
    float b  = ck(hmS, i, m, k, j)
    float a0 = j > 0 ? ck(hmS, i, m, k, j - 1) : 0.0
    a0 + (b - a0) * f
ckShAt(State hmS, int i, int j, float f) =>
    float b  = ckSh(hmS, i, j)
    float a0 = j > 0 ? ckSh(hmS, i, j - 1) : 0.0
    a0 + (b - a0) * f
lsOf(string s) => s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed
posOf(string s) =>
    switch s
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
keyTime(int k) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, 12, 0)
keyAt(int k, int m) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, int(m / 60), m % 60)
addDays(int k, int n) => dateKey(keyTime(k) + n * 86400000)
anchorKey(int an, int t) => an == 0 ? dateKey(t + 6 * 3600000) : dateKey(t)
inWin(int an, int m) => an == 0 ? true : an == 1 ? m < 1020 : m >= 570 and m < 975
winBars(int an) => an == 0 ? 92 : an == 1 ? 68 : 27
pf(float v) => str.tostring(v, format.mintick)
x2(float v) => str.tostring(v, "0.00") + "×"
p0(float v) => str.tostring(v * 100, "0") + "%"
fmtDay(int k) => str.format_time(keyTime(k), "EEE dd MMM", TZ)
dowOf(int k) => dayofweek(keyTime(k), TZ)
hhmm(int m) => (m / 60 < 10 ? "0" : "") + str.tostring(int(m / 60)) + ":" + (m % 60 < 10 ? "0" : "") + str.tostring(m % 60)
stepEnd(int j) => (1080 + 30 * (j + 1)) % 1440
dayType(State hmS, int k, int pk) =>
    int  dw  = dowOf(k)
    bool hol = false
    if dw >= 2 and dw <= 5
        for j = 1 to 6 - dw
            if hmS.s1.NP.includes(addDays(k, j))
                hol := true
    hmS.s1.FO.includes(k) ? 0 : hmS.s1.NP.includes(k) ? 1 : hmS.s1.CP.includes(k) ? 2 : hmS.s1.FO.includes(pk) ? 3 : hmS.s1.FO.includes(addDays(k, 1)) ? 4 : hol ? 5 : 6
typeShort(int ty) =>
    switch ty
        0 => "FOMC"
        1 => "NFP"
        2 => "CPI"
        3 => "FOMC +1"
        4 => "FOMC D1"
        5 => "NFP week"
        => "Normal"
nextOf(array<int> a, int k) =>
    int r = na
    for d in a
        if d >= k
            r := d
            break
    r
inDays(int k, int today) => int(math.round((keyTime(k) - keyTime(today)) / 86400000.0))
whenTxt(int k, int today) =>
    int dd = inDays(k, today)
    fmtDay(k) + (dd == 0 ? " · today" : dd == 1 ? " · tomorrow" : " · in " + str.tostring(dd) + "d")
pctQ(float x, float q10, float q25, float q50, float q75, float q90) =>
    float p = na
    if not na(x) and not na(q10) and not na(q90)
        if x < q10
            p := 5.0
        else if x <= q25
            p := 10.0 + 15.0 * (x - q10) / math.max(q25 - q10, 1e-9)
        else if x <= q50
            p := 25.0 + 25.0 * (x - q25) / math.max(q50 - q25, 1e-9)
        else if x <= q75
            p := 50.0 + 25.0 * (x - q50) / math.max(q75 - q50, 1e-9)
        else if x <= q90
            p := 75.0 + 15.0 * (x - q75) / math.max(q90 - q75, 1e-9)
        else
            p := 95.0
    p
pTxt(float p) => na(p) ? "—" : p <= 5.0 ? "<P10" : p >= 95.0 ? ">P90" : "≈P" + str.tostring(p, "0")
pill(string s) => s == "Above" ? "▲ ABOVE" : s == "Below" ? "▼ BELOW" : s == "Inside" ? "● INSIDE" : "—"
pfName(int k) =>
    switch k
        0 => "M6 DESGARRÓN · NFP 08:30"
        => ""
ownTy(int k) =>
    switch k
        0 => 1
        => 6
talIs(State hmS, int k, int pk) => hmS.s1.NP.includes(k)
ownCk(int k) =>
    switch k
        0 => 0
        => 0
ckName(int k) =>
    switch k
        0 => "NFP"
        1 => "Normal"
        => ""
ckN(State hmS, int k) =>
    switch k
        0 => hmS.s1.isRTY ? "100" : "98"
        1 => hmS.s1.isES ? "1416" : hmS.s1.isRTY ? "1430" : "1342"
        => ""
ownProfile(State hmS, int tk, int pk, int today) =>
    bool now = hmS.s1.NP.includes(tk)
    int  rf  = na(tk) ? today : math.max(tk, today)
    [0, now, now ? tk : nextOf(hmS.s1.NP, rf)]
ownNext(State hmS, int today) =>
    int n1 = nextOf(hmS.s1.NP, today)
    ["NFP 08:30", n1, "then", na(n1) ? na : nextOf(hmS.s1.NP, addDays(n1, 1))]
fdSg(float v, string f) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), f)
vzSg(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), format.mintick)
vzAr(float v) => na(v) or v == 0 ? "·" : v > 0 ? "▲" : "▼"
vh(int i) => str.substring(VH, i, i + 1) == "1"
ctxOf(State hmS, Feed hmF, float c, float h, float l) =>
    float a  = hmF.ADRtd * hmS.s1.tdO
    float mh = math.max(nz(hmF.mtH, h), h)
    float ml = math.min(nz(hmF.mtL, l), l)
    float p  = mh > ml ? (c - ml) / (mh - ml) : na
    float m  = a > 0 ? (c - hmF.mtO) / a : na
    float d  = na(hmS.s1.ptdH) or not (a > 0) ? na : c > hmS.s1.ptdH ? (c - hmS.s1.ptdH) / a : c < hmS.s1.ptdL ? (c - hmS.s1.ptdL) / a : 0.0
    float s  = a > 0 ? (c - hmS.s1.tdO) / a : na
    float w  = a > 0 and not na(hmS.s1.wkOp) ? (c - hmS.s1.wkOp) / a : na
    [p, m, d, s, a, w]
nxtTd(int k) => addDays(k, dowOf(k) == dayofweek.friday ? 3 : 1)
ceOdds(Cfg hmC, float x) => na(x) ? "—" : hmC.ceEnd == "17:00" ? (x <= 0.5 ? "79%" : x <= 1 ? "23%" : x <= 2 ? "1%" : "0%") : (x <= 0.5 ? "83%" : x <= 1 ? "31%" : x <= 2 ? "6%" : "0%")
trimL(State hmS, line l, int e) =>
    if e > time
        l.set_x2(time)
        hmS.s2.GL.push(l)
        hmS.s2.GLE.push(e)
    l
trimT(State hmS, label t, int e) =>
    if e > time
        t.set_x(time)
        hmS.s2.GT.push(t)
        hmS.s2.GTE.push(e)
    t
kPath(State hmS, int i, int m, int k, int t0, float sc, color lc, int lw, string ls) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, k, j) * sc))
    polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = lc, line_width = lw, line_style = ls)
kBand(State hmS, int i, int m, int kUp, int kDn, int t0, float sc, color fc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kUp, j) * sc))
    for j = 45 to 0
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kDn, j) * sc))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = #00000000, fill_color = fc)
drawCore1(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on)
        for p in hmS.s2.KP
            p.delete()
        for l in hmS.s2.KL
            l.delete()
        for t in hmS.s2.KT
            t.delete()
        hmS.s2.KP.clear()
        hmS.s2.KL.clear()
        hmS.s2.KT.clear()
        if hmS.s2.clkGo and hmS.s2.scP > 0
            int   t0  = keyAt(addDays(hmS.s1.tdK, -1), 1080)
            int   tE  = t0 + 46 * 1800000
            color ce  = hmS.s2.ckEv ? hmC.cGh : hmS.s1.cSub
            int   iR  = hmS.s2.ckEv ? NCK - 1 : hmS.s2.ckEvI
            color cR  = hmS.s2.ckEv ? hmS.s1.cMu : color.new(hmC.cGh, 25)
            if hmC.kBands
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 0, t0, hmS.s2.scP, color.new(ce, 90)))
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, 1, t0, hmS.s2.scP, color.new(ce, 80)))
            hmS.s2.KP.push(kPath(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, t0, hmS.s2.scP, ce, 2, line.style_solid))
            hmS.s2.KT.push(label.new(tE, ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(hmS.s2.ckI) + " median " + pf(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = ce, style = label.style_label_left, size = size.tiny))
            if hmC.kRef
                hmS.s2.KP.push(kPath(hmS, iR, hmS.s2.mSel, 2, t0, hmS.s2.scP, cR, 1, line.style_dashed))
                hmS.s2.KT.push(label.new(tE, ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(iR) + (hmS.s2.ckEv ? "" : " (next)") + " " + pf(ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = cR, style = label.style_label_left, size = size.tiny))
            for s in str.split(REL, ",")
                float rm = str.tonumber(s)
                if not na(rm)
                    int tr = keyAt(hmS.s1.tdK, int(rm))
                    hmS.s2.KL.push(line.new(tr, 0.0, tr, hmS.s2.scP, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cGh, hmS.s2.ckEv ? 30 : 70), style = line.style_dotted))
    true
clearRight(State hmS) =>
    for b in hmS.s2.RB
        b.delete()
    for l in hmS.s2.RL
        l.delete()
    for t in hmS.s2.RT
        t.delete()
    hmS.s2.RB.clear()
    hmS.s2.RL.clear()
    hmS.s2.RT.clear()
gapOf(string on, string p) => p == "Top left" or p == "Top center" or (p == "Top right" and on == "Indicator pane")
tc(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    t.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = hmS.s1.crdSz, text_halign = ha, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
stripe(table t, int r, color col) =>
    t.cell(0, r, "", bgcolor = col, width = 0.25)
cardHead(State hmS, table t, int r, color col, string title, string tip, string pill, color pfg, color pbg) =>
    hmS.s2.CQ.push(CRow.new(t, 1, r, 0, col, title, "", "", pill, tip, false, pfg, pbg))
cardSub(State hmS, table t, int r, color col, string txt, string a1, string a2) =>
    hmS.s2.CQ.push(CRow.new(t, 2, r, 0, col, "", txt, a1, a2))
cardRow(State hmS, table t, int r, color col, string key, bool held, string lab, string v, string b, string tip, color vfg = na, color bfg = na) =>
    hmS.s2.CQ.push(CRow.new(t, 0, r, 0, col, key, lab, v, b, tip, held, vfg, bfg))
cardWide(State hmS, table t, int r, color col, string key, string txt, string tip, color fg) =>
    hmS.s2.CQ.push(CRow.new(t, 3, r, 0, col, key, txt, "", "", tip, false, fg))
tcQ(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    hmS.s2.CQ.push(CRow.new(t, 4, r, c, na, s, "", "", "", tip, b, fg, bg, ha))
stripeQ(State hmS, table t, int r, color col) =>
    hmS.s2.CQ.push(CRow.new(t, 5, r, 0, col))
gauge(float frac) =>
    string out = "░░░░░░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 10))
        out := str.repeat("█", k) + str.repeat("░", 10 - k)
    out
gauge5(float frac) =>
    string out = "░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 5))
        out := str.repeat("█", k) + str.repeat("░", 5 - k)
    out
meter(float p) =>
    string out = "──────────"
    if not na(p)
        int k = int(math.round(math.max(0.0, math.min(100.0, p)) / 10.0))
        out := str.repeat("─", k) + "●" + str.repeat("─", 10 - k)
    out
octBar(int o) =>
    string out = ""
    for i = 1 to 8
        out += i == o ? "█" : "░"
    out
octOf(float px, float h, float l) => na(h) or na(l) or h <= l ? na : math.min(8, int(math.floor((px - l) / (h - l) * 8)) + 1)
zoneOf(State hmS, float h, float l) =>
    int    o  = octOf(close, h, l)
    string z  = na(o) ? "—" : o >= 7 ? "PREM" : o <= 2 ? "DISC" : "EQ"
    color  zb = na(o) ? hmS.s2.cBody : o >= 7 ? hmS.s2.cPrem : o <= 2 ? hmS.s2.cDisc : hmS.s2.cNeu
    color  zf = na(o) or (o > 2 and o < 7) ? hmS.s1.cTx : #ffffff
    [o, z, zb, zf]
zoneTip(int o, float h, float l, string what) =>
    "This " + what + "'s range so far " + pf(l) + " – " + pf(h) + ": price is " + (na(o) ? "—" : p0((close - l) / (h - l))) + " of the way up (octant " + (na(o) ? "—" : str.tostring(o)) + " of 8), " + (na(l) ? "—" : pf(close - l)) + " above the low and " + (na(h) ? "—" : pf(h - close)) + " below the high (right). Top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount. A locator, not a tested signal."
zoneRow(State hmS, table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(hmS, h, l)
    string tip = zoneTip(o, h, l, what)
    stripeQ(hmS, t, r, col)
    tcQ(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
    tcQ(hmS, t, 2, r, octBar(o) + " O" + (na(o) ? "—" : str.tostring(o)), hmS.s1.cTx, hmS.s2.cBody, tip)
    tcQ(hmS, t, 3, r, z, zf, zb, tip, text.align_center, true)
    tcQ(hmS, t, 4, r, na(h) ? "—" : "−" + str.tostring(h - close, "0"), hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
talAcc(array<float> acc, int t_, int r_, float g_, float p_) =>
    acc.set(0, acc.get(0) + 1)
    acc.set(1, acc.get(1) + (t_ > 0 ? 1 : 0))
    acc.set(2, acc.get(2) + (t_ < 0 ? 1 : 0))
    acc.set(3, acc.get(3) + (r_ > 0 ? 1 : 0))
    acc.set(4, acc.get(4) + (r_ < 0 ? 1 : 0))
    if not na(g_)
        acc.set(5, acc.get(5) + 1)
        acc.set(6, acc.get(6) + g_)
        acc.set(7, acc.get(7) + math.abs(g_))
        acc.set(8, acc.get(8) + (na(p_) ? 0.0 : math.abs(p_)))
        acc.set(9, acc.get(9) + (g_ > 0 ? 1 : 0))
drawCore2(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        clearRight(hmS)
        bool   pend = hmS.s1.AN == 2 and hmS.s1.mod < 570                      // RTH not open yet: the model sits on the last price
        int    tKey = pend ? hmS.s1.calK : hmS.s1.dK
        int    today = hmS.s1.calK
        [pk, pNow, pDay] = ownProfile(hmS, tKey, pend ? hmS.s1.dK : hmS.s1.pK, today)
        int    mTy  = ownTy(pk)                                  // this indicator's own event, never another event's
        bool   live = pNow and not pend
        bool   hasD = not pend and not na(hmS.s1.dO)
        float  O    = hasD ? hmS.s1.dO : close
        // ── cards
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        int    dd   = na(pDay) ? na : inDays(pDay, today)
        string ev   = typeShort(mTy)
        [n1t, n1k, n2t, n2k] = ownNext(hmS, today)
        bool   warn = inDays(LAST_DATE, today) < 60
        // tally of the last N event days (both layouts): this chart's own records first, then built-in ones older than those
        array<float> acc = array.new_float(10, 0.0)
        string seq = ""
        int    d0  = na
        if hmC.showEv
            if hmS.s1.LTd.size() > 0
                for i = hmS.s1.LTd.size() - 1 to 0
                    if acc.get(0) < hmC.talN
                        talAcc(acc, hmS.s1.LTt.get(i), hmS.s1.LTr.get(i), hmS.s1.LTg.get(i), hmS.s1.LTp.get(i))
                        seq := (hmS.s1.LTt.get(i) > 0 ? "▲" : hmS.s1.LTt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s1.LTd.get(i)
            int oldest = hmS.s1.LTd.size() > 0 ? hmS.s1.LTd.get(0) : 99999999
            if hmS.s2.TEd.size() > 0
                for i = hmS.s2.TEd.size() - 1 to 0
                    if acc.get(0) < hmC.talN and hmS.s2.TEd.get(i) < oldest
                        talAcc(acc, hmS.s2.TEt.get(i), hmS.s2.TEr.get(i), hmS.s2.TEg.get(i), hmS.s2.TEp.get(i))
                        seq := (hmS.s2.TEt.get(i) > 0 ? "▲" : hmS.s2.TEt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s2.TEd.get(i)
        int    nT   = int(acc.get(0))
        int    uT   = int(acc.get(1))
        int    dT_  = int(acc.get(2))
        int    uR   = int(acc.get(3))
        int    dR_  = int(acc.get(4))
        int    nG   = int(acc.get(5))
        float  gAvg = nG > 0 ? acc.get(6) / nG : na
        float  gAbs = nG > 0 ? acc.get(7) / nG : na
        string since = na(d0) ? "" : " since " + str.format_time(keyTime(d0), "MMM yyyy", TZ)
        string srcT = hmS.s2.TEd.size() > 0 ? " Built-in " + hmS.s1.symR + " records run to " + str.format_time(keyTime(hmS.s1.talEnd), "dd MMM yyyy", TZ) + "; later days, and any this chart loads itself, come from the chart's own bars." : " Records come from this chart's own bars (built-in history covers NQ / MNQ, ES / MES and RTY / M2K)."
        string tTip = "Trading day (18:00 → 17:00) close vs open on the last " + str.tostring(nT) + " " + TAL_NAME + " days" + since + ", oldest → newest: " + seq + ". RTH (09:30 → 16:14): ▲ " + str.tostring(uR) + " ▼ " + str.tostring(dR_) + ". A tally, not a forecast: across 2018–26 the up-close rate on these days was not different from normal days." + srcT
        string gTip = "RTH gap = 09:30 open − prior trading day's 16:14 close. Average over the last " + str.tostring(nG) + " " + TAL_NAME + " days: " + (na(gAvg) ? "—" : pf(gAvg)) + " pts; average size " + (na(gAbs) ? "—" : pf(gAbs) + " pts (" + str.tostring(acc.get(8) / nG, "0.00") + "%)") + "; gapped up on " + str.tostring(int(acc.get(9))) + " of " + str.tostring(nG) + "."
        string nxT  = na(n1k) ? "beyond loaded dates" : "NFP " + str.format_time(keyTime(n1k), "dd MMM", TZ) + (n1k == today ? " · today" : " · " + str.tostring(inDays(n1k, today)) + "d") + (warn ? " · UPDATE" : "")
        string nxTip = "Next release: " + (na(n1k) ? "beyond the loaded dates" : fmtDay(n1k) + " 08:30 ET" + (na(n2k) ? "" : ", then " + fmtDay(n2k))) + ". Release dates are built in up to " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's dates (bls.gov/schedule, federalreserve.gov) to S_FOMC, S_CPI and S_NFP, then raise LAST_DATE."
        string hdT  = pfName(pk) + ". Clock and tally: " + hmS.s1.symR + " 1-minute data 2018–26; stages card and findings: NQ + ES + RTY pooled." + (hmS.s1.isNQ or hmS.s1.isES or hmS.s1.isRTY ? "" : " This chart is " + syminfo.root + ": the clock and tally are " + hmS.s1.symR + "'s.")
        string pill_ = pNow ? "TODAY" : na(dd) ? "—" : dd == 1 ? "TMRW" : "IN " + str.tostring(dd) + "D"
        if hmC.showEv and not na(hmS.s2.TS)
            int r0 = hmS.s2.tsO
            cardHead(hmS, hmS.s2.TS, r0, hmC.cGh, dot + " DESGARRÓN · " + ev + " · " + hmS.s1.symTag, hdT + " " + nxTip, hmS.s2.mob and warn ? "UPDATE" : pill_, hmS.s2.mob and warn or not pNow ? #ffffff : hmC.cGh, hmS.s2.mob and warn ? hmS.s1.cWarn : pNow ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.mob
                cardSub(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "last " + str.tostring(nT) + " " + TAL_NAME + " days", "▲", "▼")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, gauge(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na) + " " + (uT + dT_ > 0 ? p0(float(uT) / (uT + dT_)) : "—"), str.tostring(uT), str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "RTH", false, gauge(uR + dR_ > 0 ? float(uR) / (uR + dR_) : na) + " " + (uR + dR_ > 0 ? p0(float(uR) / (uR + dR_)) : "—"), str.tostring(uR), str.tostring(dR_), "RTH 09:30 → 16:14 close vs open on the same days (days without RTH data are left out).", hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 4, hmC.cGh, "GAP", false, "avg gap · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 5 + zi, hmC.cGh, zi == 0 ? "WEEK" : "MONTH", zi == 0 ? math.max(nz(hmF.wH, hmS.s1.tdH), hmS.s1.tdH) : hmS.s1.mHi, zi == 0 ? math.min(nz(hmF.wL, hmS.s1.tdL), hmS.s1.tdL) : hmS.s1.mLo, zi == 0 ? "week" : "month")
                cardWide(hmS, hmS.s2.TS, r0 + hmS.s2.EV_N - 1, hmC.cGh, "NEXT", nxT, nxTip, na(n1k) or warn ? hmS.s1.cWarn : hmS.s1.cTx)
            else
                // mobile: NOW reads the clock in one row, then the tally in short form
                if hmS.s2.clkTF and not na(hmS.s2.vAdr)
                    float  q50m = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                    string nTip = "Today so far (" + (hmS.s2.clkR ? "range" : "net move") + " from the 18:00 open) against " + ckName(hmS.s2.ckI) + " days at this time: median " + pf(q50m * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts at today's ADR20 (" + x2(q50m) + " typical, " + x2(hmS.s2.vAdr) + " today). Above / below = outside that middle half."
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, (hmS.s2.clkR ? "range " : "net ") + (hmS.s2.clkR or hmS.s2.vPts < 0 ? "" : "+") + str.tostring(hmS.s2.vPts, "0"), x2(hmS.s2.vAdr), "", nTip)
                    tcQ(hmS, hmS.s2.TS, 4, r0 + 1, str.upper(hmS.s2.stB), hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff, hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu, nTip, text.align_center, true)
                else
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, not hmS.s2.clkTF ? "clock: ≤ 60 min" : "needs 15+ days", "", "", "")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, "last " + str.tostring(nT) + " " + gauge5(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na), "▲" + str.tostring(uT), "▼" + str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "GAP", false, "avg · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 4 + zi, hmC.cGh, zi == 0 ? "WK" : "MO", zi == 0 ? math.max(nz(hmF.wH, hmS.s1.tdH), hmS.s1.tdH) : hmS.s1.mHi, zi == 0 ? math.min(nz(hmF.wL, hmS.s1.tdL), hmS.s1.tdL) : hmS.s1.mLo, zi == 0 ? "week" : "month")
    true
drawCore2B(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        // ── clock card
        if hmC.showCk and not na(hmS.s2.TK)
            string bN   = ckName(hmS.s2.ckI)
            string eN   = ckName(hmS.s2.ckEvI)
            string nowT = hhmm(int(math.min(1439.0, (hmS.s2.elM + hmS.s1.tfM + 1080) % 1440)))
            int    r0   = hmS.s2.tkO
            cardHead(hmS, hmS.s2.TK, r0, hmC.cGh, dot + " " + "DESGARRÓN · CLOCK · " + nowT + " ET", "Today's running range (or net move) from the 18:00 open against the same time of day on " + bN + " days, 2018–26: paths from " + ckN(hmS, hmS.s2.ckI) + " " + bN + " days" + (hmS.s2.ckI != NCK - 1 ? " and " + ckN(hmS, NCK - 1) + " normal days" : "") + ", half-hour steps, scaled by today's ADR20" + (hmS.s2.scP > 0 ? " (" + pf(hmS.s2.scP) + " pts)." : "."), hmS.s2.ckEv ? eN + " DAY" : "NORMAL", hmS.s2.ckEv ? hmC.cGh : #ffffff, hmS.s2.ckEv ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.clkTF or na(hmS.s2.vAdr)
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "CLOCK", false, not hmS.s2.clkTF ? "needs an intraday chart ≤ 60 min" : "needs 15+ days of history", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "", false, "", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "", false, "", "", "", "")
            else
                float q10 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 0, hmS.s2.jB, hmS.s2.fB)
                float q50 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                float q90 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, hmS.s2.jB, hmS.s2.fB)
                float pc  = pctQ(hmS.s2.vAdr, q10, hmS.s2.q25B, q50, hmS.s2.q75B, q90)
                string mW = hmS.s2.clkR ? "range" : "net"
                color sBg = hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu
                color sFg = hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "NOW", false, mW + " " + (hmS.s2.clkR ? "" : hmS.s2.vPts >= 0 ? "+" : "") + pf(hmS.s2.vPts) + " pts", x2(hmS.s2.vAdr), "", "Today so far, in ADR20 of the trading day.")
                tcQ(hmS, hmS.s2.TK, 4, r0 + 1, pill(hmS.s2.stB), sFg, sBg, "Above / below = outside the middle half (25–75%) of " + bN + " days at this time.", text.align_center, true)
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "vs " + bN, false, meter(pc) + " " + pTxt(pc), "typ " + x2(q50), "", bN + " days by " + nowT + ": median " + pf(q50 * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts (" + mW + ", at today's ADR20).", hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx)
                float sh = ckShAt(hmS, hmS.s2.ckI, hmS.s2.jB, hmS.s2.fB)
                float rgT = hmS.s1.tdH - hmS.s1.tdL
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "DONE", false, gauge(sh) + " " + p0(sh), sh >= 0.25 ? "→ " + pf(rgT / sh) : "—", "pts", "Median share of the final day range already made by this time on " + bN + " days; right: today's range so far ÷ that share, a rough full-day figure (shown from 25% on).")
            float bestD = -1.0
            int   bestJ = 0
            for j = 0 to 45
                float dj = ck(hmS, hmS.s2.ckEvI, 0, 2, j) - (j > 0 ? ck(hmS, hmS.s2.ckEvI, 0, 2, j - 1) : 0.0)
                if dj > bestD
                    bestD := dj
                    bestJ := j
            float nD = ck(hmS, NCK - 1, 0, 2, bestJ) - (bestJ > 0 ? ck(hmS, NCK - 1, 0, 2, bestJ - 1) : 0.0)
            cardRow(hmS, hmS.s2.TK, r0 + 4, hmC.cGh, "BUSIEST", false, hhmm(stepEnd(bestJ - 1)) + "–" + hhmm(stepEnd(bestJ)), "+" + x2(bestD), "norm +" + x2(nD), "The half hour in which the median running range of " + eN + " days grows most, against normal days in the same half hour.", hmS.s2.ckEv ? hmC.cGh : hmS.s1.cTx)
    true
drawLast1(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        int xd = bar_index + offI
        // week open, and NFP day's 08:30 and 08:50 opens, extended to the right of price
        if hmC.showWO and not na(hmS.s1.wkX) and not na(hmS.s1.wkOp)
            hmS.s2.RL.push(line.new(math.max(hmS.s1.wkX, bar_index - 4900), hmS.s1.wkOp, xd, hmS.s1.wkOp, color = color.new(hmC.cLvl, 15), style = line.style_dashed, force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.wkOp, "week open " + pf(hmS.s1.wkOp), color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = hmS.s1.lbSz, force_overlay = true))
        if hmC.showATH and not na(hmS.s1.athN) and not na(hmS.s1.athNT)
            float aA = hmF.ADRtd * hmS.s1.tdO
            hmS.s2.RL.push(line.new(hmS.s1.athNT, hmS.s1.athN, time + offI * timeframe.in_seconds() * 1000, hmS.s1.athN, xloc = xloc.bar_time, color = hmC.cAth, width = 1, style = lsOf(hmC.stAth), force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.athN, "ATH " + pf(hmS.s1.athN) + " · −" + str.tostring(hmS.s1.athN - close, "0"), color = #00000000, textcolor = hmC.cAth, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = "All-time high " + pf(hmS.s1.athN) + ", set " + (hmS.s1.athTd ? "today" : str.format_time(hmS.s1.athNT, "dd MMM yyyy", TZ)) + " (highest daily high of the chart's history). Price is " + pf(hmS.s1.athN - close) + " pts below it" + (aA > 0 ? " (" + str.tostring((hmS.s1.athN - close) / aA, "0.00") + " ADR)" : "") + ". On NFP days the CE between it and the 08:29 close is drawn at 08:30.", force_overlay = true))
        if hmC.showWO and hmS.s1.vzF and hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s1X) and bar_index - hmS.s1.s1X < 4900
            hmS.s2.RL.push(line.new(hmS.s1.s1X, hmS.s1.s1O, xd, hmS.s1.s1O, color = color.new(hmC.cGh, 15), force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.s1O, "08:30 open " + pf(hmS.s1.s1O), color = #00000000, textcolor = hmC.cGh, style = label.style_label_left, size = hmS.s1.lbSz, force_overlay = true))
            if not na(hmS.s1.s2X)
                hmS.s2.RL.push(line.new(hmS.s1.s2X, hmS.s1.s2O, xd, hmS.s1.s2O, color = color.new(hmC.cGh, 35), style = line.style_dashed, force_overlay = true))
                hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.s2O, "08:50 open " + pf(hmS.s1.s2O), color = #00000000, textcolor = color.new(hmC.cGh, 25), style = label.style_label_left, size = hmS.s1.lbSz, force_overlay = true))
    true
zIdx(float p) => na(p) ? 1 : p >= 0.75 ? 2 : p <= 0.25 ? 0 : 1
zWd(int z) => z == 2 ? "PREM" : z == 0 ? "DISC" : "MID"
sgP(float v) => na(v) ? "—" : str.tostring(v, "0")
sgS(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), "0")
pcV(State hmS, int i) => hmS.s1.VS.get(i) < 0 ? "—" : str.tostring(hmS.s1.VS.get(i), "0")
hl(State hmS, int i) => "H" + pcV(hmS, i) + " L" + pcV(hmS, i + 1)
hlH(int i) => vh(i) or vh(i + 1)
rg(State hmS, int i) => "R" + str.tostring(hmS.s1.VS.get(i), "0.00")
liveTx(float sv, float dv) => na(sv) ? "—" : sgS(sv) + " · DXY " + (na(dv) ? "—" : vzAr(dv) + str.tostring(math.abs(dv), "0.00"))
dxPill(State hmS, float dv, float sv, float thr) =>
    bool ok  = not (na(dv) or na(sv) or dv == 0 or sv == 0)
    bool big = ok and math.abs(dv) >= thr
    bool oth = ok and math.sign(dv) != math.sign(sv)
    [not ok ? "—" : (oth ? "⇄" : "⇉") + (big ? " BIG" : ""), big ? #ffffff : hmS.s1.cTx, not ok ? hmS.s2.cBody : big ? (oth ? hmS.s1.cOk : hmS.s1.cWarn) : hmS.s2.cNeu]
drawSg(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV)
        string dot  = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        int    z    = hmS.s2.uZ
        float  a    = hmS.s2.uA
        float  e1   = hmS.s1.VS.get(2 * z) * a
        float  e2   = hmS.s1.VS.get(6 + 2 * z) * a
        float  eA   = hmS.s1.VS.get(12 + 2 * z) * a
        float  eR   = hmS.s1.VS.get(18 + 2 * z) * a
        float  r1   = na(hmS.s3.sv1) or not (e1 > 0) ? na : math.abs(hmS.s3.sv1) / e1
        float  r2   = na(hmS.s3.sv2) or not (e2 > 0) ? na : math.abs(hmS.s3.sv2) / e2
        float  rq   = hmS.s3.stS and not na(hmS.s2.qH) ? hmS.s2.qH - hmS.s2.qL : na
        float  rR   = na(rq) or not (eR > 0) ? na : rq / eR
        [t1, f1, b1] = dxPill(hmS, hmS.s3.dv1, hmS.s3.sv1, 0.42)
        [t2, f2, b2] = dxPill(hmS, hmS.s3.dv2, hmS.s3.sv2, 0.22)
        string zW   = z == 2 ? "PREMIUM" : z == 0 ? "DISCOUNT" : "MIDDLE"
        string dayT = hmS.s1.vzF ? "NFP TODAY" : na(hmS.s3.uDd) ? "NFP —" : "NFP IN " + str.tostring(hmS.s3.uDd) + "D"
        int    oi   = na(hmS.s2.uOc) ? 0 : 4 * (hmS.s2.uOc - 1)
        string ocT  = na(hmS.s2.uOc) ? "" : "Octant " + str.tostring(hmS.s2.uOc) + " of 8 (n " + str.tostring(hmS.s1.OC.get(oi), "0") + "): range after 08:30 " + str.tostring(hmS.s1.OC.get(oi + 1), "0.00") + " ADR, new high " + str.tostring(hmS.s1.OC.get(oi + 2), "0") + "%, new low " + str.tostring(hmS.s1.OC.get(oi + 3), "0") + "%. "
        string mTp  = "Price at " + (na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP)) + " of the month's range so far (" + (hmS.s2.fzS ? "08:29" : "live") + "): " + zW + ". " + ocT + hmS.s1.TXA.get(hmS.s1.VZT_MON)
        string oTp  = "Month's open " + pf(hmF.mtO) + ": " + fdSg(hmS.s2.uM, "0.0") + " ADR (" + sgS(hmS.s2.uM * a) + " pts). " + VZT_MO
        string pdT  = na(hmS.s2.uD) ? "prior day —" : hmS.s2.uD > 0 ? "above PDH " + sgS(hmS.s2.uD * a) : hmS.s2.uD < 0 ? "below PDL " + sgS(hmS.s2.uD * a) : "inside prior day"
        string vxT  = na(hmS.s2.uV) ? "VIX —" : "VIX " + str.tostring(hmF.vxC, "0.0") + " · " + fdSg(100 * hmS.s2.uV, "0") + "% vs 20d"
        bool   zH   = hlH(42 + 2 * z) or vh(18 + 2 * z)
        int    r    = hmS.s2.tvO
        if not hmS.s2.mob
            cardHead(hmS, hmS.s2.TV, r, hmC.cGh, dot + " NFP STAGES · " + hmS.s1.symTag, hmS.s1.TXA.get(hmS.s1.VZT_HD), zW, hmS.s3.zFg, hmS.s3.zBg)
            cardSub(hmS, hmS.s2.TV, r + 1, hmC.cGh, (hmS.s2.fzS ? "SETUP AT 08:29 · " : "SETUP LIVE · ") + dayT, "ADR", "after")
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "MONTH", zH, octBar(hmS.s2.uOc) + " O" + (na(hmS.s2.uOc) ? "—" : str.tostring(hmS.s2.uOc)), na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP), hl(hmS, 42 + 2 * z), mTp, z == 1 ? na : hmS.s3.zBg, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "MO", vh(48 + hmS.s2.uMo), "vs month open " + sgS(hmS.s2.uM * a), fdSg(hmS.s2.uM, "0.0"), rg(hmS, 48 + hmS.s2.uMo), oTp, hmS.s2.uMo == 0 ? hmS.s1.cHot : hmS.s2.uMo == 2 ? hmS.s1.cCold : na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, "PD", hlH(30 + 2 * hmS.s2.uPg), pdT, hmS.s2.uPg == 1 ? "" : fdSg(hmS.s2.uD, "0.0"), hl(hmS, 30 + 2 * hmS.s2.uPg), hmS.s1.TXA.get(hmS.s1.VZT_PD), na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 5, hmC.cGh, "18:00", hlH(36 + 2 * hmS.s3.uSg), "since 18:00 " + sgS(hmS.s2.uS * a), fdSg(hmS.s2.uS, "0.0"), hl(hmS, 36 + 2 * hmS.s3.uSg), hmS.s1.TXA.get(hmS.s1.VZT_18), hmS.s3.uSg == 0 ? hmS.s2.cDisc : hmS.s3.uSg == 2 ? hmS.s2.cPrem : na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 6, hmC.cGh, "WEEK", vh(54 + hmS.s3.uWg), "week in " + sgS(hmS.s2.uW * a), fdSg(hmS.s2.uW, "0.0"), rg(hmS, 54 + hmS.s3.uWg), hmS.s1.TXA.get(hmS.s1.VZT_WK), hmS.s3.uWg == 0 ? hmS.s2.cDisc : hmS.s3.uWg == 2 ? hmS.s2.cPrem : na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 7, hmC.cGh, "VIX", vh(51 + hmS.s3.uVg), vxT, "", rg(hmS, 51 + hmS.s3.uVg), hmS.s1.TXA.get(hmS.s1.VZT_VX), na, hmS.s1.cSub)
            if hmS.s3.stS
                cardSub(hmS, hmS.s2.TV, r + 8, hmS.s2.cDxc, "LIVE · vs DXY", "×typ", "DXY")
                cardRow(hmS, hmS.s2.TV, r + 9, hmC.cGh, "S1", false, liveTx(hmS.s3.sv1, hmS.s3.dv1), na(r1) ? "" : x2(r1), "", hmS.s1.TXA.get(hmS.s1.VZT_LV), nz(r1) >= 1 ? hmS.s1.cHot : na)
                tcQ(hmS, hmS.s2.TV, 4, r + 9, t1, f1, b1, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "S2", false, na(hmS.s1.s2O) ? "from 08:50" : liveTx(hmS.s3.sv2, hmS.s3.dv2), na(r2) ? "" : x2(r2), "", hmS.s1.TXA.get(hmS.s1.VZT_LV), nz(r2) >= 1 ? hmS.s1.cHot : na)
                tcQ(hmS, hmS.s2.TV, 4, r + 10, t2, f2, b2, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "RANGE", vh(18 + 2 * z), "since 08:30 " + sgP(rq) + " pts", na(rR) ? "" : x2(rR), "med " + sgP(eR), hmS.s1.TXA.get(hmS.s1.VZT_LV) + " " + hmS.s1.TXA.get(hmS.s1.VZT_E), nz(rR) >= 1 ? hmS.s1.cHot : na)
            else
                cardSub(hmS, hmS.s2.TV, r + 8, hmC.cGh, "EXPECT · " + zWd(z) + " · ADR " + sgP(a), "med", "80%")
                cardRow(hmS, hmS.s2.TV, r + 9, hmC.cGh, "RANGE", vh(18 + 2 * z), "after 08:30", sgP(eR), sgP(hmS.s1.VS.get(19 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_E))
                cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "NY AM", vh(12 + 2 * z), "09:30–11:00", "±" + sgP(eA), "±" + sgP(hmS.s1.VS.get(13 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_E))
                cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "S1/S2", false, "08:30–08:50 / –09:30", "±" + sgP(e1) + "/" + sgP(e2), "±" + sgP(hmS.s1.VS.get(1 + 2 * z) * a) + "/" + sgP(hmS.s1.VS.get(7 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_E) + (hmS.s1.isES ? " " + VZT_MN : ""))
        else
            cardHead(hmS, hmS.s2.TV, r, hmC.cGh, dot + " NFP · " + hmS.s1.symTag + (hmS.s1.vzF or na(hmS.s3.uDd) ? "" : " · " + str.tostring(hmS.s3.uDd) + "D"), hmS.s1.TXA.get(hmS.s1.VZT_HD), zWd(z), hmS.s3.zFg, hmS.s3.zBg)
            cardRow(hmS, hmS.s2.TV, r + 1, hmC.cGh, "MO", zH, octBar(hmS.s2.uOc) + " " + (na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP)), fdSg(hmS.s2.uM, "0.0"), hl(hmS, 42 + 2 * z), mTp + " " + oTp, hmS.s2.uMo == 0 ? hmS.s1.cHot : hmS.s2.uMo == 2 ? hmS.s1.cCold : na)
            if hmS.s3.stS
                bool in2 = not na(hmS.s1.s2O)
                cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, in2 ? "S2" : "S1", false, in2 ? liveTx(hmS.s3.sv2, hmS.s3.dv2) : liveTx(hmS.s3.sv1, hmS.s3.dv1), na(in2 ? r2 : r1) ? "" : x2(in2 ? r2 : r1), "", hmS.s1.TXA.get(hmS.s1.VZT_LV))
                tcQ(hmS, hmS.s2.TV, 4, r + 2, in2 ? t2 : t1, in2 ? f2 : f1, in2 ? b2 : b1, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "RANGE", vh(18 + 2 * z), "since 08:30 " + sgP(rq), na(rR) ? "" : x2(rR), "med " + sgP(eR), hmS.s1.TXA.get(hmS.s1.VZT_LV))
            else
                cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "EXP", vh(18 + 2 * z), "range " + sgP(eR) + " · AM ±" + sgP(eA), sgP(hmS.s1.VS.get(19 + 2 * z) * a), "80%", hmS.s1.TXA.get(hmS.s1.VZT_E))
                cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "PD", hlH(30 + 2 * hmS.s2.uPg), (hmS.s2.uPg == 0 ? "> PDH " : hmS.s2.uPg == 2 ? "< PDL " : "in PD ") + hl(hmS, 30 + 2 * hmS.s2.uPg), hmS.s2.uPg == 1 ? "" : fdSg(hmS.s2.uD, "0.0"), "", hmS.s1.TXA.get(hmS.s1.VZT_PD))
            cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, "WK·VX", vh(54 + hmS.s3.uWg) or vh(51 + hmS.s3.uVg), "wk " + fdSg(hmS.s2.uW, "0.0") + " · VIX " + fdSg(100 * hmS.s2.uV, "0") + "%", rg(hmS, 54 + hmS.s3.uWg), rg(hmS, 51 + hmS.s3.uVg), hmS.s1.TXA.get(hmS.s1.VZT_WK) + " " + hmS.s1.TXA.get(hmS.s1.VZT_VX))
    true
drawHy(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmS.s1.showHy and not na(hmS.s2.TH)
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        int    z   = hmS.s2.uZ
        float  a   = hmS.s2.uA
        int    r   = hmS.s2.thO
        float  eR  = hmS.s1.VS.get(18 + 2 * z) * a
        // size: the month's group, then the other held size groups and whether they agree (bigger / smaller than all NFP days)
        string tg  = ""
        string tgN = ""
        int    bg_ = z == 0 ? 1 : 0
        int    sm_ = z == 2 ? 1 : 0
        if hmS.s2.uMo != 1
            tg  += (hmS.s2.uMo == 0 ? "MO↑ " : "MO↓ ")
            tgN += (hmS.s2.uMo == 0 ? "MO↑ " : "MO↓ ") + str.tostring(hmS.s1.VS.get(48 + hmS.s2.uMo), "0.00") + " · "
            bg_ += hmS.s2.uMo == 2 ? 1 : 0
            sm_ += hmS.s2.uMo == 0 ? 1 : 0
        if hmS.s3.uVg != 1
            tg  += (hmS.s3.uVg == 0 ? "VIX↑ " : "VIX↓ ")
            tgN += (hmS.s3.uVg == 0 ? "VIX↑ " : "VIX↓ ") + str.tostring(hmS.s1.VS.get(51 + hmS.s3.uVg), "0.00") + " · "
            bg_ += hmS.s3.uVg == 0 ? 1 : 0
            sm_ += hmS.s3.uVg == 2 ? 1 : 0
        if hmS.s3.uWg != 1
            tg  += (hmS.s3.uWg == 0 ? "WK↑ " : "WK↓ ")
            tgN += (hmS.s3.uWg == 0 ? "WK↑ " : "WK↓ ") + str.tostring(hmS.s1.VS.get(54 + hmS.s3.uWg), "0.00") + " · "
            bg_ += hmS.s3.uWg == 2 ? 1 : 0
            sm_ += hmS.s3.uWg == 0 ? 1 : 0
        if hmS.s2.uPg == 2
            tg  += "<PDL "
            tgN += "<PDL 1.29 · "
            bg_ += 1
        if hmS.s3.uSg == 2
            tg  += "18↓ "
            tgN += "18↓ 1.20 · "
            bg_ += 1
        string agr = bg_ > 0 and sm_ == 0 ? "BIGGER" : sm_ > 0 and bg_ == 0 ? "SMALLER" : bg_ > 0 ? "MIXED" : "TYPICAL"
        string agT = "Active today: " + (tgN == "" ? "none" : tgN) + " Range after 08:30 in ADR for each held size group active today (all NFP days 0.95): MO = more than 1 ADR from the month's open, VIX = more than 10% from its 20-day average, WK = the week into the release beyond ±0.5 ADR, <PDL = below the prior day's low, 18↓ = down more than 0.4 ADR since 18:00. BIGGER / SMALLER = every active group, the month's position included, points the same way; MIXED = they disagree. " + hmS.s1.TXA.get(hmS.s1.VZT_VX) + " " + hmS.s1.TXA.get(hmS.s1.VZT_WK)
        // extremes after 08:30: the most specific held group (the move since 18:00, then the prior day, then the month)
        int    xi  = hmS.s3.uSg != 1 ? 36 + 2 * hmS.s3.uSg : hmS.s2.uPg != 1 ? 30 + 2 * hmS.s2.uPg : 42 + 2 * z
        string xn  = hmS.s3.uSg == 0 ? "18:00↑" : hmS.s3.uSg == 2 ? "18:00↓" : hmS.s2.uPg == 0 ? ">PDH" : hmS.s2.uPg == 2 ? "<PDL" : zWd(z)
        // ATH CE: fixed at 08:30 on NFP day, else where it would sit now
        bool   ceF = not na(hmS.s2.ceV) and not na(hmS.s2.ceXE) and time < hmS.s2.ceXE
        float  ceX = ceF ? hmS.s2.ceV : hmS.s1.athN > close ? (hmS.s1.athN + close) / 2 : na
        float  ceD = ceF ? hmS.s2.ceDA : a > 0 and not na(ceX) ? (ceX - close) / a : na
        bool   ceH = not na(ceD) and (ceD <= 0.5 or ceD > 1)
        string ceS = ceF ? (na(hmS.s2.ceHT) ? "open" : "hit " + str.format_time(hmS.s2.ceHT, dateKey(hmS.s2.ceHT) == hmS.s1.calK ? "HH:mm" : "EEE HH:mm", TZ)) : "at 08:30"
        // first side of the pre-release range (07:00–08:29) taken after 08:30
        string fsR = hmS.s3.uVg == 2 ? "79%" : hmS.s3.uWg == 0 ? "74%" : hmS.s3.uWg == 1 ? "46%" : "59%"
        bool   fsH = hmS.s3.uVg == 2 or hmS.s3.uWg == 0 or hmS.s3.uWg == 1
        string fsW = hmS.s3.uVg == 2 ? "VIX low" : hmS.s3.uWg == 0 ? "week up" : hmS.s3.uWg == 1 ? "flat wk" : "all"
        string fsX = hmS.s2.fsd == 0 ? (hmS.s3.stS ? "no break yet" : "break from 08:30") : hmS.s2.fsd == 2 ? "both sides, one bar" : "break " + (hmS.s2.fsd == 1 ? "▲ " : "▼ ") + str.format_time(hmS.s2.fsT, "HH:mm", TZ)
        [t1, f1, b1] = dxPill(hmS, hmS.s3.dv1, hmS.s3.sv1, 0.42)
        [t2, f2, b2] = dxPill(hmS, hmS.s3.dv2, hmS.s3.sv2, 0.22)
        int    nH  = (vh(18 + 2 * z) ? 1 : 0) + (tg != "" ? 1 : 0) + (hlH(xi) ? 1 : 0) + (ceH ? 1 : 0) + (fsH ? 1 : 0) + 3
        bool   in2 = hmS.s3.stS and not na(hmS.s1.s2O)
        if not hmS.s2.mob
            cardHead(hmS, hmS.s2.TH, r, hmC.cHy, dot + " GRIMMJOW · NFP", hmS.s1.TXA.get(hmS.s1.VZT_HY), str.tostring(nH) + " ✓", hmC.cHy, #ffffff)
            cardSub(hmS, hmS.s2.TH, r + 1, hmC.cHy, "NQ+ES+RTY · ADR " + sgP(a), "today", "base")
            cardWide(hmS, hmS.s2.TH, r + 2, hmC.cHy, "SIDE", "none held: size the day", hmS.s1.TXA.get(hmS.s1.VZT_HY), hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TH, r + 3, hmC.cHy, "RANGE", vh(18 + 2 * z), "after 08:30 · " + zWd(z), sgP(eR), "all " + sgP(0.95 * a), "Range after 08:30 for today's month position (" + zWd(z) + "): median " + sgP(eR) + ", 80% " + sgP(hmS.s1.VS.get(19 + 2 * z) * a) + " pts. " + hmS.s1.TXA.get(hmS.s1.VZT_MON) + " " + hmS.s1.TXA.get(hmS.s1.VZT_E))
            cardRow(hmS, hmS.s2.TH, r + 4, hmC.cHy, "SIZE+", tg != "", tg == "" ? "none active" : tg, "", "", agT)
            tcQ(hmS, hmS.s2.TH, 3, r + 4, agr, agr == "BIGGER" or agr == "SMALLER" ? #ffffff : hmS.s1.cTx, agr == "BIGGER" ? hmS.s1.cHot : agr == "SMALLER" ? hmS.s1.cCold : hmS.s2.cNeu, agT, text.align_center, true)
            cardRow(hmS, hmS.s2.TH, r + 5, hmC.cHy, "H/L", hlH(xi), "after 08:30 · " + xn, hl(hmS, xi), "H75 L64", "New day high (H) / low (L) after 08:30 for today's most specific group (" + xn + "); all NFP days H75 L64. " + hmS.s1.TXA.get(hmS.s1.VZT_18) + " " + hmS.s1.TXA.get(hmS.s1.VZT_PD) + " " + hmS.s1.TXA.get(hmS.s1.VZT_MON))
            cardRow(hmS, hmS.s2.TH, r + 6, hmC.cHy, "CE", ceH, na(ceX) ? "at the ATH" : pf(ceX) + " · " + str.tostring(ceD, "0.0") + " ADR", ceOdds(hmC, ceD), ceS, hmS.s1.TXA.get(hmS.s1.VZT_CE), nz(ceD, 9) <= 0.5 ? hmS.s1.cHot : na, ceF and not na(hmS.s2.ceHT) ? hmS.s1.cOk : na)
            cardRow(hmS, hmS.s2.TH, r + 7, hmC.cHy, "1ST", fsH, fsX, fsR, fsW, hmS.s1.TXA.get(hmS.s1.VZT_FS))
            cardRow(hmS, hmS.s2.TH, r + 8, hmC.cHy, "DXY1", true, "S1 BIG ≥ 0.42 → other", "82%", "vs 53%", hmS.s1.TXA.get(hmS.s1.VZT_DR))
            cardRow(hmS, hmS.s2.TH, r + 9, hmC.cHy, "DXY2", true, "S2 BIG ≥ 0.22 → other", "71%", "vs 59%", hmS.s1.TXA.get(hmS.s1.VZT_DR))
            if hmS.s3.stS
                tcQ(hmS, hmS.s2.TH, 4, r + 8, t1, f1, b1, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
            if in2
                tcQ(hmS, hmS.s2.TH, 4, r + 9, t2, f2, b2, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
            cardRow(hmS, hmS.s2.TH, r + 10, hmC.cHy, "08:30", true, "→09:00 adds · typ " + sgP(0.14 * a), na(hmS.s3.uAdd) ? "—" : "+" + sgP(hmS.s3.uAdd * a), na(hmS.s3.uAdd) ? "+0.14×" : "+" + x2(hmS.s3.uAdd), VZT_AD, nz(hmS.s3.uAdd) >= 0.14 ? hmS.s1.cHot : na)
        else
            cardHead(hmS, hmS.s2.TH, r, hmC.cHy, dot + " GRIMMJOW", hmS.s1.TXA.get(hmS.s1.VZT_HY), str.tostring(nH) + " ✓", hmC.cHy, #ffffff)
            cardRow(hmS, hmS.s2.TH, r + 1, hmC.cHy, "RANGE", vh(18 + 2 * z), zWd(z) + " " + sgP(eR) + " pts", "", "", hmS.s1.TXA.get(hmS.s1.VZT_E))
            tcQ(hmS, hmS.s2.TH, 3, r + 1, agr, agr == "BIGGER" or agr == "SMALLER" ? #ffffff : hmS.s1.cTx, agr == "BIGGER" ? hmS.s1.cHot : agr == "SMALLER" ? hmS.s1.cCold : hmS.s2.cNeu, agT, text.align_center, true)
            cardRow(hmS, hmS.s2.TH, r + 2, hmC.cHy, "H/L", hlH(xi), "after 08:30 · " + xn, hl(hmS, xi), "", hmS.s1.TXA.get(hmS.s1.VZT_PD))
            cardRow(hmS, hmS.s2.TH, r + 3, hmC.cHy, "CE", ceH, na(ceX) ? "at the ATH" : str.tostring(ceD, "0.0") + " ADR · " + ceS, ceOdds(hmC, ceD), "", hmS.s1.TXA.get(hmS.s1.VZT_CE))
            cardRow(hmS, hmS.s2.TH, r + 4, hmC.cHy, "1ST", fsH, fsX, fsR, "", hmS.s1.TXA.get(hmS.s1.VZT_FS))
            cardRow(hmS, hmS.s2.TH, r + 5, hmC.cHy, in2 ? "DXY2" : "DXY1", true, "BIG → other way", in2 ? "71%" : "82%", "", hmS.s1.TXA.get(hmS.s1.VZT_DR))
            if hmS.s3.stS
                tcQ(hmS, hmS.s2.TH, 4, r + 5, in2 ? t2 : t1, in2 ? f2 : f1, in2 ? b2 : b1, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
    true
cardFlush(State hmS) =>
    if hmS.s2.CQ.size() > 0
        for q in hmS.s2.CQ
            table t = q.t
            int   r = q.r
            switch q.k
                0 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, q.b ? #ffffff : hmS.s1.cMu, q.b ? hmS.s1.cOk : hmS.s2.cBody, q.tip, text.align_center, q.b)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cTx, hmS.s2.cBody, q.tip)
                    tc(hmS, t, 3, r, q.s3, na(q.f1) ? hmS.s1.cTx : q.f1, hmS.s2.cBody, q.tip, text.align_center, true)
                    tc(hmS, t, 4, r, q.s4, na(q.f2) ? hmS.s1.cMu : q.f2, hmS.s2.cBody, q.tip, text.align_center)
                1 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, #ffffff, q.col, q.tip, text.align_left, true)
                    tc(hmS, t, 4, r, q.s4, q.f1, q.f2, "", text.align_center, true)
                2 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, "", hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 3, r, q.s3, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                    tc(hmS, t, 4, r, q.s4, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                3 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, hmS.s1.cMu, hmS.s2.cBody, "", text.align_center)
                    tc(hmS, t, 2, r, q.s2, q.f1, hmS.s2.cBody, q.tip)
                4 =>
                    tc(hmS, t, q.c, r, q.s1, q.f1, q.f2, q.tip, q.ha, q.b)
                =>
                    stripe(t, r, q.col)
        hmS.s2.CQ.clear()
    true

// ═══════════════════════════════════════════════════════════════ Steps (Hueco Mundo calls them in order on every bar)
// @function Step 1: Data
export step1(State hmS, Cfg hmC) =>
    hmS.s3.calK_1 := hmS.s1.calK
    hmS.s3.iwin_1 := hmS.s1.iwin
    hmS.s3.key_1 := hmS.s1.key
    hmS.s3.mod_1 := hmS.s1.mod
    hmS.s3.tdH_1 := hmS.s1.tdH
    hmS.s3.tdK_1 := hmS.s1.tdK
    hmS.s3.tdL_1 := hmS.s1.tdL
    hmS.s1.clkOn := hmC.paneI == "Clock + Grimmjow" or hmC.paneI == "Event clock"
    hmS.s1.showHy := hmC.paneI == "Clock + Grimmjow" or hmC.paneI == "Grimmjow"
    hmS.s1.AN := hmC.anchorI == "Trading day (18:00)" ? 0 : hmC.anchorI == "NY midnight" ? 1 : 2
    hmS.s1.isES := syminfo.root == "ES" or syminfo.root == "MES"
    hmS.s1.isNQ := syminfo.root == "NQ" or syminfo.root == "MNQ"
    hmS.s1.isRTY := syminfo.root == "RTY" or syminfo.root == "M2K"
    hmS.s1.symR := hmS.s1.isES ? "ES" : hmS.s1.isRTY ? "RTY" : "NQ"           // whose clock and tally the chart shows
    hmS.s1.symTag := hmS.s1.isNQ or hmS.s1.isES or hmS.s1.isRTY ? syminfo.root : syminfo.root + " (" + hmS.s1.symR + " DATA)"
    if barstate.isfirst
        hmS.s1.VS := parseStats("0.16,0.33,0.15,0.31,0.18,0.36,0.08,0.19,0.08,0.18,0.06,0.15,0.36,0.72,0.28,0.61,0.21,0.44,1.21,1.49,1.06,1.55,0.88,1.13,1.27,2.16,0.96,1.43,0.78,1.03,80,40,81,64,36,92,88,25,80,65,19,85,61,91,80,59,79,54,0.90,0.91,1.37,1.35,0.94,0.69,0.82,0.90,1.34")
    if barstate.isfirst
        hmS.s1.OC := parseStats("29,1.34,66,93;37,0.94,57,89;32,1.30,69,72;24,1.18,92,62;20,0.98,90,50;25,0.91,76,48;45,0.90,71,64;81,0.87,83,48")
    if barstate.isfirst
        hmS.s1.TXA := array.new<string>()
    if barstate.isfirst
        hmS.s1.VZT_MON := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. By the month's position (bottom quarter = discount, top quarter = premium). R = range after 08:30, H / L = new day high / low after 08:30. discount (n 66) R1.21 H61% L91% · middle (n 101) R1.06 H80% L59% · premium (n 126) R0.88 H79% L54%. Held: ✓ discount: range after 08:30 1.21 vs 0.92 (2018–24 1.16 vs 0.92, 2025–26 1.32 vs 0.96); new high after 08:30 61% vs 79% (2018–24 65% vs 80%, 2025–26 42% vs 78%); new low after 08:30 91% vs 56% (2018–24 91% vs 55%, 2025–26 92% vs 61%); ✓ premium: range after 08:30 0.88 vs 1.14 (2018–24 0.87 vs 1.09, 2025–26 0.95 vs 1.21); new low after 08:30 54% vs 72% (2018–24 54% vs 71%, 2025–26 56% vs 74%). ✓ = p < 0.05 with errors clustered by release date, the same side in 2018–24 and 2025–26, and on NQ, ES and RTY separately.")
    if barstate.isfirst
        hmS.s1.VZT_PD := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. Against the prior day's high (PDH) and low (PDL). above PDH (n 40) R0.93 H80% L40% · inside (n 217) R0.91 H81% L64% · below PDL (n 36) R1.29 H36% L92%. Held: ✓ above PDH: new low after 08:30 40% vs 68% (2018–24 35% vs 68%, 2025–26 67% vs 68%); ✓ inside: new high after 08:30 81% vs 59% (2018–24 81% vs 63%, 2025–26 79% vs 43%); ✓ below PDL: range after 08:30 1.29 vs 0.92 (2018–24 1.20 vs 0.92, 2025–26 1.65 vs 0.96); new high after 08:30 36% vs 81% (2018–24 43% vs 81%, 2025–26 12% vs 80%); new low after 08:30 92% vs 60% (2018–24 89% vs 60%, 2025–26 100% vs 62%). ✓ = p < 0.05 with errors clustered by release date, the same side in 2018–24 and 2025–26, and on NQ, ES and RTY separately.")
    if barstate.isfirst
        hmS.s1.VZT_18 := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. Move from the 18:00 open to 08:29; strong = beyond ±0.4 ADR. up (n 16) R1.03 H88% L25% · within (n 251) R0.94 H80% L65% · down (n 26) R1.20 H19% L85%. Held: ✓ up: new low after 08:30 25% vs 66% (2018–24 38% vs 64%, 2025–26 12% vs 78%); ✓ within: new high after 08:30 80% vs 45% (2018–24 80% vs 42%, 2025–26 78% vs 50%); ✓ down: range after 08:30 1.20 vs 0.94 (2018–24 0.99 vs 0.94, 2025–26 1.69 vs 0.90); new high after 08:30 19% vs 81% (2018–24 28% vs 80%, 2025–26 0% vs 82%); new low after 08:30 85% vs 62% (2018–24 78% vs 62%, 2025–26 100% vs 62%). ✓ = p < 0.05 with errors clustered by release date, the same side in 2018–24 and 2025–26, and on NQ, ES and RTY separately.")
    if barstate.isfirst
        hmS.s1.VZT_WK := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. The week into the release (Sunday 18:00 open to 08:29 Friday); up / down = beyond ±0.5 ADR. week up (n 115) R0.82 H80% L53% · flat (n 85) R0.90 H73% L66% · week down (n 93) R1.34 H71% L76%. Held: ✓ week up: range after 08:30 0.82 vs 1.16 (2018–24 0.82 vs 1.14, 2025–26 0.90 vs 1.27); new low after 08:30 53% vs 71% (2018–24 56% vs 68%, 2025–26 37% vs 85%); ✓ week down: range after 08:30 1.34 vs 0.87 (2018–24 1.33 vs 0.87, 2025–26 1.45 vs 0.84); new low after 08:30 76% vs 58% (2018–24 72% vs 59%, 2025–26 100% vs 55%). A strong week into NFP came with a smaller reaction, a weak week with a bigger one. ✓ = p < 0.05 with errors clustered by release date, the same side in 2018–24 and 2025–26, and on NQ, ES and RTY separately.")
    if barstate.isfirst
        hmS.s1.VZT_VX := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. VIX's prior close against its 20-day average (±10%). over (n 84) R1.35 H76% L73% · near (n 146) R0.94 H73% L62% · under (n 63) R0.69 H79% L57%. Held: ✓ over: range after 08:30 1.35 vs 0.90 (2018–24 1.34 vs 0.90, 2025–26 1.45 vs 0.96); ✓ under: range after 08:30 0.69 vs 1.04 (2018–24 0.77 vs 1.03, 2025–26 0.43 vs 1.18). ✓ = p < 0.05 with errors clustered by release date, the same side in 2018–24 and 2025–26, and on NQ, ES and RTY separately.")
    if barstate.isfirst
        hmS.s1.VZT_E := txAdd(hmS, "NFP days 2018–26, NQ + ES + RTY pooled (293 symbol-days on 99 releases), read at 08:29, in ADR20. Median and 80th percentile by the month's position (discount · middle · premium; n 66 · 101 · 126), at today's ADR20. |stage 1| 08:30–08:50: 0.16 · 0.15 · 0.18 ADR (80%: 0.33 · 0.31 · 0.36); |stage 2| 08:50–09:30: 0.08 · 0.08 · 0.06 ADR (80%: 0.19 · 0.18 · 0.15); |NY AM| 09:30–11:00: 0.36 · 0.28 · 0.21 ADR (80%: 0.72 · 0.61 · 0.44); range after 08:30: 1.21 · 1.06 · 0.88 ADR (80%: 1.49 · 1.55 · 1.13) — held for discount, premium; the next session's range (Monday): 1.27 · 0.96 · 0.78 ADR (80%: 2.16 · 1.43 · 1.03) — held for discount, premium. Sizes for stops and targets: no direction held.")
    if barstate.isfirst
        hmS.s1.VZT_DR := txAdd(hmS, "Index against DXY futures in the same window, Feb 2023 – Jul 2026, NQ + ES + RTY pooled. Stage 1 (08:30–08:50): with DXY ≥ 0.42 of its ADR20 (BIG) the index went the other way 82% (n 60 on 20 releases; 2023–24 86%, 2025–26 72%; NQ 80%, ES 80%, RTY 85%; p 0.001) vs 53% when smaller. Stage 2 (08:50–09:30): BIG ≥ 0.22: 71% (n 56; 2023–24 78%, 2025–26 66%; NQ 72%, ES 74%, RTY 68%; p 0.024) vs 59%. It confirms the stage, it does not call it.")
    if barstate.isfirst
        hmS.s1.VZT_FS := txAdd(hmS, "First side of the pre-release range (07:00–08:29) taken after 08:30, and whether the day then reached further that way than the other (high vs low after 08:30, from 08:29). All NFP days: 59%. Held: ✓ VIX > 10% under its average 79% vs 54% (p 0.006); ✓ week up > 0.5 ADR 74% vs 50% (p < 0.001); ✓ flat week 46% vs 65% (lower). Not held: a quiet night (range since 18:00 ≤ 0.36 ADR) 71% vs 53%, but 67% vs 68% in 2025–26. The first break is a lean, not a call: it was wrong on about 4 in 10 days.")
    if barstate.isfirst
        hmS.s1.VZT_CE := txAdd(hmS, "ATH CE = halfway between the all-time high and the 08:29 close, drawn from 08:30 to 17:00 or into the next session to 11:00 (the Monday after a Friday release). Touched on pooled NFP days, by its distance at 08:29, by 17:00 / by the next session's 11:00: ≤ 0.5 ADR 79% / 83% (n 63; next-session odds 2018–24 91%, 2025–26 61%; NQ 88, ES 79, RTY 82) · 0.5–1 ADR 23% / 31% (n 26) · 1–2 ADR 1% / 6% (n 71) · > 2 ADR 0% / 0% (n 133). Within 0.5 ADR the ATH itself was taken by 17:00 on 56%. HYDRA: distance is the whole story (the whole-net AUC 0.93 on 2025–26 is the distance effect).")
    if barstate.isfirst
        hmS.s1.VZT_HY := txAdd(hmS, "Grimmjow: the HYDRA findings for NFP day. HYDRA on NQ + ES + RTY pooled: 406 heads × 18 targets on 240 symbol-days (80 releases, 2018–24), errors clustered by date, Benjamini–Hochberg 10% against 20 shifted nulls; survivors tested on 2025–26 (53 symbol-days) and on each symbol. Direction: stage 1, stage 2, RTH, 08:30 → 16:14 and day-against-the-week found no more survivors than their nulls; NY AM up found 8 against a null mean of 2.6 (max 18) and none held; 1 direction head of 283 survivors held in the test (chance level); the whole net's direction AUCs sat at the null's 95th percentile (0.62–0.65). Sizes and extremes: 177 of 283 held — the range after 08:30, |NY AM|, Monday's range, new high / low after 08:30, the ATH CE and the first DR side. So the pane sizes the day and gives the odds that held; it does not call a side.")
    if barstate.isfirst
        hmS.s1.FO := parseDates(S_FOMC)
    if barstate.isfirst
        hmS.s1.CP := parseDates(S_CPI)
    if barstate.isfirst
        hmS.s1.NP := parseDates(S_NFP)
    if barstate.isfirst
        hmS.s1.CK := unpackMilli(hmS.s1.isES ? CK_ES : hmS.s1.isRTY ? CK_RTY : CK_NQ)
    hmS
// @function Step 2: Today, live
export step2(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s1.bgLum := 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
    hmS.s1.dark := hmC.themeI == "Dark" or (hmC.themeI == "Auto" and hmS.s1.bgLum < 128)
    hmS.s1.cBg := hmS.s1.dark ? #0e1117 : #ffffff
    hmS.s1.cTx := hmS.s1.dark ? #e6e9ef : #131722
    hmS.s1.cSub := hmS.s1.dark ? #9aa3b5 : #4a5163
    hmS.s1.cMu := hmS.s1.dark ? #5d6476 : #9aa1b2
    hmS.s1.cWarn := #ff5252
    hmS.s1.cHot := hmS.s1.dark ? #ff8a65 : #d84315
    hmS.s1.cCold := hmS.s1.dark ? #64b5f6 : #1565c0
    hmS.s1.cOk := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s1.crdSz := hmC.crdSzI == "Tiny" ? size.tiny : hmC.crdSzI == "Small" ? size.small : size.normal
    hmS.s1.lbSz := hmC.lblI == "Small" ? size.small : hmC.lblI == "Normal" ? size.normal : size.tiny
    hmS.s1.relM := hmC.relEnd == "08:45" ? 525 : hmC.relEnd == "08:50" ? 530 : hmC.relEnd == "09:30" ? 570 : 540
    hmS.s1.drEM := hmC.drEnd == "11:00" ? 660 : hmC.drEnd == "17:00" ? 1020 : 974
    hmS.s1.tfM := math.max(1, int(timeframe.in_seconds() / 60))
    hmS.s1.mod := hour(time, TZ) * 60 + minute(time, TZ)
    hmS.s1.calK := dateKey(time)
    hmS.s1.key := anchorKey(hmS.s1.AN, time)
    hmS.s1.iwin := inWin(hmS.s1.AN, hmS.s1.mod)
    hmS.s1.dSt := hmS.s1.iwin and (not hmS.s3.iwin_1 or hmS.s1.key != hmS.s3.key_1)
    if hmS.s1.dSt
        hmS.s1.pK := hmS.s1.dK
        hmS.s1.dK := hmS.s1.key
        hmS.s1.dO := open
        hmS.s1.dH := high
        hmS.s1.dL := low
        hmS.s1.dX := bar_index
        hmS.s1.dT := dayType(hmS, hmS.s1.key, hmS.s1.pK)
    else if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dH := math.max(hmS.s1.dH, high)
        hmS.s1.dL := math.min(hmS.s1.dL, low)
    if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dC := close
    hmS.s1.tdK := anchorKey(0, time)
    hmS.s1.tdSt := hmS.s1.tdK != hmS.s3.tdK_1
    if hmS.s1.tdSt
        hmS.s1.tdPK := hmS.s3.tdK_1
        hmS.s1.ptdH := hmS.s1.tdH
        hmS.s1.ptdL := hmS.s1.tdL
        hmS.s1.tdO  := open
        hmS.s1.tdH  := high
        hmS.s1.tdL  := low
        hmS.s1.tdX  := bar_index
        hmS.s1.tdHT := time
    else
        if na(hmS.s1.tdH) or high > hmS.s1.tdH
            hmS.s1.tdHT := time
        hmS.s1.tdH := math.max(nz(hmS.s1.tdH, high), high)
        hmS.s1.tdL := math.min(nz(hmS.s1.tdL, low), low)
    hmS.s1.athTd := na(hmF.athP) or hmS.s1.tdH >= hmF.athP
    hmS.s1.athN := hmS.s1.athTd ? hmS.s1.tdH : hmF.athP
    hmS.s1.athNT := hmS.s1.athTd ? hmS.s1.tdHT : hmF.athPT
    hmS.s1.rthSt := hmS.s1.mod >= 570 and hmS.s1.mod < 975 and (hmS.s3.mod_1 < 570 or hmS.s3.mod_1 >= 975 or hmS.s1.calK != hmS.s3.calK_1)
    if hmS.s1.rthSt
        hmS.s1.rthO  := open
        hmS.s1.tgKey := hmS.s1.calK
        hmS.s1.tgGap := na(hmS.s1.rthC) ? na : open - hmS.s1.rthC
        hmS.s1.tgPct := na(hmS.s1.rthC) or hmS.s1.rthC == 0 ? na : (open / hmS.s1.rthC - 1) * 100
        hmS.s1.gapPC := hmS.s1.rthC
        hmS.s1.gapCE := na(hmS.s1.rthC) ? na : (hmS.s1.rthC + open) / 2
        hmS.s1.rH    := high
        hmS.s1.rL    := low
    else if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rH := math.max(hmS.s1.rH, high)
        hmS.s1.rL := math.min(hmS.s1.rL, low)
    if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rthC := close
    hmS.s1.mHi := math.max(nz(hmF.mtH, hmS.s1.tdH), hmS.s1.tdH)
    hmS.s1.mLo := math.min(nz(hmF.mtL, hmS.s1.tdL), hmS.s1.tdL)
    hmS.s1.recent := time > timenow - hmC.markD * 86400000
    if barstate.isfirst
        hmS.s1.LTd := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTt := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTr := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTg := array.new<float>()
    if barstate.isfirst
        hmS.s1.LTp := array.new<float>()
    hmS.s1.talEnd := hmS.s1.isES ? TAL_END_ES : hmS.s1.isRTY ? TAL_END_RTY : hmS.s1.isNQ ? TAL_END_NQ : 0
    if hmS.s1.tdSt and not na(hmS.s1.prvTdO) and hmS.s1.prvTdO_k == hmS.s3.tdK_1 and talIs(hmS, hmS.s3.tdK_1, hmS.s1.prvTdPK)
        bool rOk = hmS.s1.tgKey == hmS.s3.tdK_1 and not na(hmS.s1.rthO)
        hmS.s1.LTd.push(hmS.s3.tdK_1)
        hmS.s1.LTt.push(int(math.sign(close[1] - hmS.s1.prvTdO)))
        hmS.s1.LTr.push(rOk ? int(math.sign(hmS.s1.rthC - hmS.s1.rthO)) : 0)
        hmS.s1.LTg.push(rOk ? hmS.s1.tgGap : na)
        hmS.s1.LTp.push(rOk ? hmS.s1.tgPct : na)
    hmS
// @function Step 3: NFP stages (Desgarrón)
export step3(State hmS, Cfg hmC, Feed hmF) =>
    if hmS.s1.tdSt
        hmS.s1.prvTdO   := open
        hmS.s1.prvTdO_k := hmS.s1.tdK
        hmS.s1.prvTdPK  := hmS.s1.tdPK
    if hmS.s1.tdSt
        hmS.s1.dxTdO := hmF.dxL_1
    if barstate.isfirst
        hmS.s1.VZT_HD := txAdd(hmS, "The NFP release (08:30 ET), led by where price sits in the month's range: discount (bottom quarter), middle or premium (top quarter), the setup that sized NFP days most. SETUP: the month, its open, the prior day, the 18:00 open, the week into the release and VIX (live, then fixed at 08:29). EXPECT: how far NFP days with today's month position moved, at today's ADR20. LIVE (from 08:30): stages 1 and 2 against DXY and the range since 08:30. Figures: NQ + ES + RTY pooled, 2018–26 (293 symbol-days, 99 releases). Green key = held; every other figure describes. No 08:29 feature called the direction.")
    if barstate.isfirst
        hmS.s1.VZT_LV := txAdd(hmS, "Today's stage so far (points from its open) and DXY's move in the same window, in DXY's ADR20. ×typ = against the EXPECT median. ⇄ = the other way to DXY, ⇉ = the same way. BIG = DXY has moved at least 0.42 (stage 1) or 0.22 (stage 2) of its ADR20, about its median release move: then the index went the other way 82% and 71% of the time (pooled, held). RANGE: the range since 08:30 against the median for today's month position.")
    hmS.s1.vzF := hmS.s1.NP.includes(hmS.s1.calK)
    if ta.change(time("W")) != 0
        hmS.s1.wkX  := bar_index
        hmS.s1.wkOp := open
    if hmS.s1.vzF and hmS.s1.mod >= 420 and hmS.s1.mod < 510
        if nz(hmS.s2.p7K) != hmS.s1.calK
            hmS.s2.p7K := hmS.s1.calK
            hmS.s2.p7H := high
            hmS.s2.p7L := low
        else
            hmS.s2.p7H := math.max(hmS.s2.p7H, high)
            hmS.s2.p7L := math.min(hmS.s2.p7L, low)
    hmS.s2.at830 := hmS.s1.vzF and hmS.s1.tfM <= 30 and hmS.s1.mod >= 510 and hmS.s1.mod < 540 and (hmS.s3.mod_1 < 510 or hmS.s3.calK_1 != hmS.s1.calK) and nz(hmS.s1.vzK) != hmS.s1.calK
    if hmS.s2.at830
        hmS.s1.vzK  := hmS.s1.calK
        hmS.s1.s1O  := open
        hmS.s1.s1X  := bar_index
        hmS.s1.x1O  := hmF.dxL_1
        hmS.s1.s2O  := na
        hmS.s1.s2X  := na
        hmS.s1.s1C  := na
        hmS.s1.s2C  := na
        hmS.s1.amC  := na
        hmS.s1.x2O  := na
        hmS.s1.x1C  := na
        hmS.s1.x2C  := na
        hmS.s1.r09  := na
        hmS.s1.r830 := hmS.s3.tdH_1 - hmS.s3.tdL_1
        [p_, m_, d_, q_, a_, w_] = ctxOf(hmS, hmF, close[1], hmS.s3.tdH_1, hmS.s3.tdL_1)
        hmS.s2.k59 := hmS.s1.calK
        hmS.s2.fsd  := 0
        hmS.s2.fsT  := na
        hmS.s2.qH   := na
        hmS.s2.qL   := na
        hmS.s2.ceAt := math.max(nz(hmF.athP, hmS.s3.tdH_1), hmS.s3.tdH_1)
        hmS.s2.ceV  := hmS.s2.ceAt > close[1] ? (hmS.s2.ceAt + close[1]) / 2 : na
        hmS.s2.ceDA := a_ > 0 and not na(hmS.s2.ceV) ? (hmS.s2.ceV - close[1]) / a_ : na
        hmS.s2.ceHT := na
        hmS.s2.ceXE := hmC.ceEnd == "17:00" ? keyAt(hmS.s1.calK, 1020) : keyAt(nxtTd(hmS.s1.calK), 660)
        hmS.s2.cxP := p_
        hmS.s2.cxM := m_
        hmS.s2.cxD := d_
        hmS.s2.cxS := q_
        hmS.s2.cxA := a_
        hmS.s2.cxW := w_
    hmS.s2.at850 := hmS.s1.vzK == hmS.s1.calK and na(hmS.s1.s2O) and hmS.s1.mod >= 530 and hmS.s1.mod < 570
    if hmS.s2.at850
        hmS.s1.s2O := open
        hmS.s1.s2X := bar_index
        hmS.s1.s1C := close[1]
        hmS.s1.x2O := hmF.dxL_1
        hmS.s1.x1C := hmF.dxL_1
    if hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s2O) and na(hmS.s1.s2C) and hmS.s1.mod >= 570
        hmS.s1.s2C := close[1]
        hmS.s1.x2C := hmF.dxL_1
    if hmS.s1.vzK == hmS.s1.calK and na(hmS.s1.r09) and hmS.s1.mod >= 540
        hmS.s1.r09 := hmS.s3.tdH_1 - hmS.s3.tdL_1
    if hmS.s1.vzK == hmS.s1.calK and na(hmS.s1.amC) and hmS.s1.mod >= 660 and hmS.s1.tgKey == hmS.s1.calK
        hmS.s1.amC := close[1]
    if hmS.s1.vzK == hmS.s1.calK and hmS.s1.mod >= 510 and hmS.s1.mod < 975
        hmS.s2.qH := math.max(nz(hmS.s2.qH, high), high)
        hmS.s2.qL := math.min(nz(hmS.s2.qL, low), low)
        if hmS.s2.fsd == 0 and hmS.s2.p7K == hmS.s1.calK
            bool bu = high > hmS.s2.p7H
            bool bd = low < hmS.s2.p7L
            if bu or bd
                hmS.s2.fsd := bu and bd ? 2 : bu ? 1 : -1
                hmS.s2.fsT := time
    if not na(hmS.s2.ceV) and na(hmS.s2.ceHT) and not na(hmS.s2.ceXE) and time < hmS.s2.ceXE and high >= hmS.s2.ceV
        hmS.s2.ceHT := time
    hmS.s2.SGR := hmC.layI == "Mobile" ? 5 : 12
    hmS
// @function Step 4: Model structure on the price chart
export step4(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and na(hmS.s2.TV) and hmC.showSg
        hmS.s2.tvO := hmC.sgPos == "Top left" or hmC.sgPos == "Top center" or (hmC.sgPos == "Top right" and hmC.sgOn == "Indicator pane") ? 1 : 0
        if hmC.sgOn == "Price chart"
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
        else
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0)
        if hmS.s2.tvO == 1
            hmS.s2.TV.cell(0, 0, "", height = hmC.sgOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
            hmS.s2.TV.merge_cells(0, 0, 4, 0)
        hmS.s2.TV.merge_cells(1, hmS.s2.tvO, 3, hmS.s2.tvO)
    hmS.s2.HYR := hmC.layI == "Mobile" ? 6 : 11
    if (barstate.islast and hmC.on) and na(hmS.s2.TH) and hmS.s1.showHy
        hmS.s2.thO := hmC.hyPos == "Top left" or hmC.hyPos == "Top center" or hmC.hyPos == "Top right" ? 1 : 0
        hmS.s2.TH  := table.new(posOf(hmC.hyPos), 5, hmS.s2.HYR + hmS.s2.thO, bgcolor = #00000000, frame_width = 0, border_width = 0)
        if hmS.s2.thO == 1
            hmS.s2.TH.cell(0, 0, "", height = 7.0, bgcolor = #00000000)
            hmS.s2.TH.merge_cells(0, 0, 4, 0)
        hmS.s2.TH.merge_cells(1, hmS.s2.thO, 3, hmS.s2.thO)
        if hmC.layI != "Mobile"
            hmS.s2.TH.merge_cells(2, hmS.s2.thO + 2, 4, hmS.s2.thO + 2)
    if barstate.isfirst
        hmS.s2.GL := array.new<line>()
    if barstate.isfirst
        hmS.s2.GLE := array.new<int>()
    if barstate.isfirst
        hmS.s2.GT := array.new<label>()
    if barstate.isfirst
        hmS.s2.GTE := array.new<int>()
    hmS.s2.cNFP := hmS.s1.NP.includes(hmS.s1.calK)
    hmS.s2.cOn := hmC.showStr and hmS.s1.recent and hmS.s2.cNFP
    hmS.s2.drE := keyAt(hmS.s1.calK, hmS.s1.drEM)
    if hmS.s2.cNFP and hmS.s1.mod >= 420 and hmS.s1.mod < 540
        if nz(hmS.s2.drK) != hmS.s1.calK
            hmS.s2.drK := hmS.s1.calK
            hmS.s2.drH := high
            hmS.s2.drL := low
        else
            hmS.s2.drH := math.max(hmS.s2.drH, high)
            hmS.s2.drL := math.min(hmS.s2.drL, low)
    if hmS.s2.cOn and hmC.showDR0 and hmS.s2.p7K == hmS.s1.calK and hmS.s1.mod >= 420 and hmS.s1.mod < 510
        if nz(hmS.s2.d0K) != hmS.s1.calK
            hmS.s2.d0K  := hmS.s1.calK
            hmS.s2.d0On := true
            hmS.s2.d0H  := line.new(keyAt(hmS.s1.calK, 420), hmS.s2.p7H, time, hmS.s2.p7H, xloc = xloc.bar_time, color = hmC.cDR0, style = lsOf(hmC.stDR0), force_overlay = true)
            hmS.s2.d0L  := line.new(keyAt(hmS.s1.calK, 420), hmS.s2.p7L, time, hmS.s2.p7L, xloc = xloc.bar_time, color = hmC.cDR0, style = lsOf(hmC.stDR0), force_overlay = true)
            string t0 = "Pre-release range 07:00–08:29, drawn live. The first side the release takes after 08:30 became the bigger side of the day on 59% of pooled NFP days (79% with VIX > 10% under its average, 74% after an up week, 46% after a flat week). " + hmS.s1.TXA.get(hmS.s1.VZT_FS)
            hmS.s2.d0T  := label.new(keyAt(hmS.s1.calK, 420), hmS.s2.p7H, "pre-NFP high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR0, style = label.style_label_lower_left, size = hmS.s1.lbSz, tooltip = t0, force_overlay = true)
            hmS.s2.d0B  := label.new(keyAt(hmS.s1.calK, 420), hmS.s2.p7L, "pre-NFP low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR0, style = label.style_label_upper_left, size = hmS.s1.lbSz, tooltip = t0, force_overlay = true)
        else
            hmS.s2.d0H.set_y1(hmS.s2.p7H)
            hmS.s2.d0H.set_y2(hmS.s2.p7H)
            hmS.s2.d0L.set_y1(hmS.s2.p7L)
            hmS.s2.d0L.set_y2(hmS.s2.p7L)
            hmS.s2.d0T.set_y(hmS.s2.p7H)
            hmS.s2.d0B.set_y(hmS.s2.p7L)
    if hmS.s2.cOn and hmC.showDR and hmS.s2.drK == hmS.s1.calK and nz(hmS.s2.dK2) != hmS.s1.calK and ((hmS.s1.vzK == hmS.s1.calK and hmS.s2.fsd != 0) or hmS.s1.mod >= 540)
        hmS.s2.dK2 := hmS.s1.calK
        int    x0 = keyAt(hmS.s1.calK, 420)
        string tD = "NFP dealing range 07:00–09:00 ET: created when the release broke the 07:00–08:29 range" + (hmS.s2.fsd == 0 ? " (it did not by 09:00)" : " at " + str.format_time(hmS.s2.fsT, "HH:mm", TZ)) + ", following the high and low to 09:00, then fixed."
        hmS.s2.dLH := line.new(x0, hmS.s2.drH, time, hmS.s2.drH, xloc = xloc.bar_time, color = hmC.cDR, style = lsOf(hmC.stDR), width = hmC.wDR, force_overlay = true)
        hmS.s2.dLL := line.new(x0, hmS.s2.drL, time, hmS.s2.drL, xloc = xloc.bar_time, color = hmC.cDR, style = lsOf(hmC.stDR), width = hmC.wDR, force_overlay = true)
        hmS.s2.dLE := hmC.drEq ? line.new(x0, (hmS.s2.drH + hmS.s2.drL) / 2, time, (hmS.s2.drH + hmS.s2.drL) / 2, xloc = xloc.bar_time, color = color.new(hmC.cDR, 35), style = line.style_dotted, force_overlay = true) : na
        hmS.s2.dBx := hmC.drFill ? box.new(x0, hmS.s2.drH, time, hmS.s2.drL, xloc = xloc.bar_time, border_color = #00000000, bgcolor = color.new(hmC.cDR, 92), force_overlay = true) : na
        hmS.s2.dTH := label.new(keyAt(hmS.s1.calK, 540), hmS.s2.drH, "DR high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR, style = label.style_label_lower_left, size = hmS.s1.lbSz, tooltip = tD, force_overlay = true)
        hmS.s2.dTL := label.new(keyAt(hmS.s1.calK, 540), hmS.s2.drL, "DR low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR, style = label.style_label_upper_left, size = hmS.s1.lbSz, tooltip = tD, force_overlay = true)
    if hmS.s2.dK2 == hmS.s1.calK
        if hmS.s1.mod < 540
            hmS.s2.dLH.set_y1(hmS.s2.drH)
            hmS.s2.dLH.set_y2(hmS.s2.drH)
            hmS.s2.dLL.set_y1(hmS.s2.drL)
            hmS.s2.dLL.set_y2(hmS.s2.drL)
            hmS.s2.dTH.set_y(hmS.s2.drH)
            hmS.s2.dTL.set_y(hmS.s2.drL)
            if not na(hmS.s2.dLE)
                hmS.s2.dLE.set_y1((hmS.s2.drH + hmS.s2.drL) / 2)
                hmS.s2.dLE.set_y2((hmS.s2.drH + hmS.s2.drL) / 2)
            if not na(hmS.s2.dBx)
                hmS.s2.dBx.set_top(hmS.s2.drH)
                hmS.s2.dBx.set_bottom(hmS.s2.drL)
        if time <= hmS.s2.drE
            hmS.s2.dLH.set_x2(time)
            hmS.s2.dLL.set_x2(time)
            if not na(hmS.s2.dLE)
                hmS.s2.dLE.set_x2(time)
            if not na(hmS.s2.dBx)
                hmS.s2.dBx.set_right(time)
    if hmS.s2.d0On and hmS.s2.d0K == hmS.s1.calK
        hmS.s2.d0On := nz(hmS.s2.dK2) != hmS.s1.calK and time <= hmS.s2.drE
        hmS.s2.d0H.set_x2(time)
        hmS.s2.d0L.set_x2(time)
    hmS
// @function Step 5: Event clock (indicator pane)
export step5(State hmS, Cfg hmC, Feed hmF) =>
    if hmS.s2.cOn
        if hmS.s2.at830 and hmC.showATH and hmC.showCE and not na(hmS.s2.ceV)
            string ceTp = "ATH CE " + pf(hmS.s2.ceV) + " = (ATH " + pf(hmS.s2.ceAt) + " + 08:29 close) ÷ 2, " + str.tostring(hmS.s2.ceDA, "0.00") + " ADR above price at 08:29: touched by " + (hmC.ceEnd == "17:00" ? "17:00" : "the next session's 11:00") + " on " + ceOdds(hmC, hmS.s2.ceDA) + " of pooled NFP days at that distance. " + hmS.s1.TXA.get(hmS.s1.VZT_CE)
            trimL(hmS, line.new(time, hmS.s2.ceV, hmS.s2.ceXE, hmS.s2.ceV, xloc = xloc.bar_time, color = hmC.cAth, width = 1, style = line.style_dashed, force_overlay = true), hmS.s2.ceXE)
            trimT(hmS, label.new(hmS.s2.ceXE, hmS.s2.ceV, "ATH CE " + ceOdds(hmC, hmS.s2.ceDA), xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cAth, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = ceTp, force_overlay = true), hmS.s2.ceXE)
        if hmS.s1.mod <= 530 and hmS.s1.mod + hmS.s1.tfM > 530
            line.new(keyAt(hmS.s1.calK, 530), close, keyAt(hmS.s1.calK, 530), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cLvl, 60), style = line.style_dotted, force_overlay = true)
        if hmC.showGap and hmS.s1.rthSt and not na(hmS.s1.gapPC)
            trimL(hmS, line.new(time, hmS.s1.gapPC, keyAt(hmS.s1.calK, 974), hmS.s1.gapPC, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 40), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
            trimL(hmS, line.new(time, hmS.s1.gapCE, keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 20), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
            trimT(hmS, label.new(keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = "RTH gap 50% = (prior 16:14 close + 09:30 open) ÷ 2. NFP days filled the full gap less often than normal days (NQ 54% vs 63%, ES 53% vs 62%).", force_overlay = true), keyAt(hmS.s1.calK, 974))
    if hmS.s2.cOn and hmC.markEv and hmS.s1.mod <= 510 and hmS.s1.mod + hmS.s1.tfM > 510
        float yT = high + 0.3 * hmF.ADRtd * hmS.s1.tdO
        hmS.s2.nfK := hmS.s1.calK
        hmS.s2.nfV := line.new(time, open, time, yT, xloc = xloc.bar_time, color = color.new(hmC.cGh, 25), style = line.style_dotted, width = 1, force_overlay = true)
        hmS.s2.nfL := label.new(time, yT, "NFP 08:30 · " + pf(open), xloc = xloc.bar_time, color = hmC.cGh, textcolor = #ffffff, style = label.style_label_down, size = hmS.s1.lbSz == size.tiny ? size.small : hmS.s1.lbSz, tooltip = "Employment Situation release, 08:30 ET " + str.format_time(time, "dd MMM yyyy", TZ) + ". The stem runs down to the 08:30 open, " + pf(open) + ".", force_overlay = true)
    else if hmS.s2.nfK == hmS.s1.calK and hmS.s1.mod > 510 and hmS.s1.mod < 540 and high + 0.3 * hmF.ADRtd * hmS.s1.tdO > hmS.s2.nfL.get_y()
        hmS.s2.nfL.set_y(high + 0.3 * hmF.ADRtd * hmS.s1.tdO)
        hmS.s2.nfV.set_y2(high + 0.3 * hmF.ADRtd * hmS.s1.tdO)
    hmS.s3.bg0 := hmS.s2.cOn and hmS.s1.mod >= 510 and hmS.s1.mod < hmS.s1.relM ? hmC.cHands : na
    if hmS.s2.cOn and hmC.showWO and hmS.s2.at830
        trimL(hmS, line.new(time, open, keyAt(hmS.s1.calK, 974), open, xloc = xloc.bar_time, color = color.new(hmC.cGh, 15), width = 1, force_overlay = true), keyAt(hmS.s1.calK, 974))
    if hmS.s2.cOn and hmC.showWO and hmS.s2.at850
        trimL(hmS, line.new(time, open, keyAt(hmS.s1.calK, 974), open, xloc = xloc.bar_time, color = color.new(hmC.cGh, 35), width = 1, style = line.style_dashed, force_overlay = true), keyAt(hmS.s1.calK, 974))
    if hmS.s2.GL.size() > 0
        for i = hmS.s2.GL.size() - 1 to 0
            int e = hmS.s2.GLE.get(i)
            hmS.s2.GL.get(i).set_x2(math.min(e, time))
            if time >= e
                hmS.s2.GL.remove(i)
                hmS.s2.GLE.remove(i)
    if hmS.s2.GT.size() > 0
        for i = hmS.s2.GT.size() - 1 to 0
            int e = hmS.s2.GTE.get(i)
            hmS.s2.GT.get(i).set_x(math.min(e, time))
            if time >= e
                hmS.s2.GT.remove(i)
                hmS.s2.GTE.remove(i)
    hmS.s2.clkTF := timeframe.isintraday and timeframe.in_seconds() <= 3600
    hmS.s2.clkGo := hmS.s1.clkOn and hmS.s2.clkTF
    hmS.s2.clkR := hmC.clkMet == "Range"
    hmS.s2.mSel := hmS.s2.clkR ? 0 : 1
    if barstate.isfirst
        hmS.s2.ckI := NCK - 1                                     // today's baseline: this event if today is one, else normal
    if hmS.s1.tdSt or barstate.isfirst
        [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
        hmS.s2.ckEv  := now_
        hmS.s2.ckEvI := ownCk(k_)
        hmS.s2.ckI   := now_ ? ownCk(k_) : NCK - 1
    hmS.s2.elM := (hmS.s1.mod - 1080 + 1440) % 1440
    hmS.s2.eEnd := math.min(1380.0, hmS.s2.elM + hmS.s1.tfM)
    hmS.s2.jB := math.min(45, math.max(0, int(math.ceil(hmS.s2.eEnd / 30.0)) - 1))
    hmS.s2.fB := math.max(0.0, math.min(1.0, (hmS.s2.eEnd - 30.0 * hmS.s2.jB) / 30.0))
    hmS.s2.scP := hmS.s1.tdO * hmF.ADRtd
    hmS.s2.vPts := hmS.s2.clkR ? hmS.s1.tdH - hmS.s1.tdL : close - hmS.s1.tdO
    hmS.s2.vAdr := hmS.s2.scP > 0 ? hmS.s2.vPts / hmS.s2.scP : na
    hmS.s2.q25B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 1, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.q75B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.stB := na(hmS.s2.vAdr) ? "" : hmS.s2.vAdr > hmS.s2.q75B ? "Above" : hmS.s2.vAdr < hmS.s2.q25B ? "Below" : "Inside"
    hmS.s2.isTd := anchorKey(0, last_bar_time) == hmS.s1.tdK
    hmS.s2.liveC := hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx
    hmS.s3.p1 := hmS.s2.clkGo and hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc1 := hmS.s2.liveC
    hmS.s3.p2 := hmS.s2.clkGo and hmC.kPast and not hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc2 := color.new(hmS.s1.cSub, 75)
    hmS.s2.ckTop := (hmC.showCk and hmC.ckOn == "Indicator pane" and str.startswith(hmC.ckPos, "Top")) or (hmS.s1.showHy and str.startswith(hmC.hyPos, "Top"))
    hmS.s2.hdrm := hmS.s2.clkGo and hmS.s2.scP > 0 ? math.max(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 45), ck(hmS, NCK - 1, hmS.s2.mSel, 4, 45)) * hmS.s2.scP * (hmS.s2.ckTop ? 1.75 : 1.1) : na
    hmS.s3.p3 := hmS.s2.hdrm
    if barstate.isfirst
        hmS.s2.KP := array.new<polyline>()
    if barstate.isfirst
        hmS.s2.KL := array.new<line>()
    if barstate.isfirst
        hmS.s2.KT := array.new<label>()
    drawCore1(hmS, hmC)
    hmS
// @function Step 6: Cards
export step6(State hmS, Cfg hmC) =>
    if barstate.isfirst
        hmS.s2.RB := array.new<box>()
    if barstate.isfirst
        hmS.s2.RL := array.new<line>()
    if barstate.isfirst
        hmS.s2.RT := array.new<label>()
    hmS.s2.cBody := hmS.s1.dark ? #161a23 : #f4f6f9
    hmS.s2.cBody2 := hmS.s1.dark ? #1c2130 : #e9edf3
    hmS.s2.cNeu := hmS.s1.dark ? #3a3f4b : #d1d4dc
    hmS.s2.cDxc := hmC.cAcD
    hmS.s2.cPrem := hmS.s1.dark ? #ef5350 : #d32f2f
    hmS.s2.cDisc := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s2.mob := hmC.layI == "Mobile"
    hmS.s2.EV_N := hmS.s2.mob ? 6 : 8                    // Full: header · sub · DAY · RTH · GAP · WEEK · MONTH · NEXT; Mobile: header · NOW · DAY · GAP · WK · MO
    if (barstate.islast and hmC.on)
        if hmC.showEv and na(hmS.s2.TS)
            hmS.s2.tsO := gapOf("Price chart", hmC.crdPos) ? 1 : 0
            hmS.s2.TS  := table.new(posOf(hmC.crdPos), SC, hmS.s2.EV_N + hmS.s2.tsO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if hmS.s2.tsO == 1
                hmS.s2.TS.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                hmS.s2.TS.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TS.merge_cells(1, hmS.s2.tsO, 3, hmS.s2.tsO)
            if not hmS.s2.mob
                hmS.s2.TS.merge_cells(2, hmS.s2.tsO + hmS.s2.EV_N - 1, SC - 1, hmS.s2.tsO + hmS.s2.EV_N - 1)
        if hmC.showCk and na(hmS.s2.TK)
            hmS.s2.tkO := gapOf(hmC.ckOn, hmC.ckPos) ? 1 : 0
            if hmC.ckOn == "Price chart"
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            else
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0)
            if hmS.s2.tkO == 1
                hmS.s2.TK.cell(0, 0, "", height = hmC.ckOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
                hmS.s2.TK.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TK.merge_cells(1, hmS.s2.tkO, 3, hmS.s2.tkO)
    if barstate.isfirst
        hmS.s2.CQ := array.new<CRow>()
    if barstate.isfirst
        hmS.s2.TEd := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEt := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEr := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEg := array.new<float>()
    if barstate.isfirst
        hmS.s2.TEp := array.new<float>()
    if barstate.isfirst
        string src = hmS.s1.isES ? TAL_ES : hmS.s1.isRTY ? TAL_RTY : hmS.s1.isNQ ? TAL_NQ : ""
        if src != ""
            for rec in str.split(src, ";")
                array<string> f = str.split(rec, ",")
                if f.size() >= 3
                    hmS.s2.TEd.push(int(str.tonumber(f.get(0))))
                    hmS.s2.TEt.push(int(str.tonumber(f.get(1))))
                    hmS.s2.TEr.push(int(str.tonumber(f.get(2))))
                    hmS.s2.TEg.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
                    hmS.s2.TEp.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)
    hmS
// @function Step 7: Write the queued card cells, in the order they were queued
export step7(State hmS, Cfg hmC, Feed hmF) =>
    drawCore2(hmS, hmC, hmF)
    drawCore2B(hmS, hmC, hmF)
    drawLast1(hmS, hmC, hmF)
    [t_lp_, t_lm_, t_ld_, t_ls_, t_la_, t_lw_] = ctxOf(hmS, hmF, close, hmS.s1.tdH, hmS.s1.tdL)
    hmS.s2.lp_ := t_lp_
    hmS.s2.lm_ := t_lm_
    hmS.s2.ld_ := t_ld_
    hmS.s2.ls_ := t_ls_
    hmS.s2.la_ := t_la_
    hmS.s2.lw_ := t_lw_
    hmS.s2.fzS := not na(hmS.s2.k59) and hmS.s2.k59 == hmS.s1.calK
    hmS.s2.uP := hmS.s2.fzS ? hmS.s2.cxP : hmS.s2.lp_
    hmS.s2.uM := hmS.s2.fzS ? hmS.s2.cxM : hmS.s2.lm_
    hmS.s2.uD := hmS.s2.fzS ? hmS.s2.cxD : hmS.s2.ld_
    hmS.s2.uS := hmS.s2.fzS ? hmS.s2.cxS : hmS.s2.ls_
    hmS.s2.uA := hmS.s2.fzS ? hmS.s2.cxA : hmS.s2.la_
    hmS.s2.uW := hmS.s2.fzS ? hmS.s2.cxW : hmS.s2.lw_
    hmS.s2.uV := hmF.vxA > 0 ? hmF.vxC / hmF.vxA - 1 : na
    hmS.s2.uZ := zIdx(hmS.s2.uP)
    hmS.s2.uOc := na(hmS.s2.uP) ? na : math.min(8, int(math.floor(hmS.s2.uP * 8)) + 1)
    hmS.s2.uMo := na(hmS.s2.uM) ? 1 : hmS.s2.uM > 1 ? 0 : hmS.s2.uM < -1 ? 2 : 1                 // over · near · under the month's open
    hmS.s2.uPg := na(hmS.s2.uD) ? 1 : hmS.s2.uD > 0 ? 0 : hmS.s2.uD < 0 ? 2 : 1                  // above PDH · inside · below PDL
    hmS.s3.uSg := na(hmS.s2.uS) ? 1 : hmS.s2.uS > 0.4 ? 0 : hmS.s2.uS < -0.4 ? 2 : 1              // strong up · within · strong down
    hmS.s3.uWg := na(hmS.s2.uW) ? 1 : hmS.s2.uW > 0.5 ? 0 : hmS.s2.uW < -0.5 ? 2 : 1              // week up · flat · down
    hmS.s3.uVg := na(hmS.s2.uV) ? 1 : hmS.s2.uV > 0.1 ? 0 : hmS.s2.uV < -0.1 ? 2 : 1              // VIX over · near · under its average
    hmS.s3.uDd := na(nextOf(hmS.s1.NP, hmS.s1.calK)) ? na : inDays(nextOf(hmS.s1.NP, hmS.s1.calK), hmS.s1.calK)
    hmS.s3.stS := hmS.s1.vzK == hmS.s1.calK
    hmS.s3.sv1 := hmS.s3.stS and not na(hmS.s1.s1O) ? (na(hmS.s1.s1C) ? close : hmS.s1.s1C) - hmS.s1.s1O : na
    hmS.s3.sv2 := hmS.s3.stS and not na(hmS.s1.s2O) ? (na(hmS.s1.s2C) ? close : hmS.s1.s2C) - hmS.s1.s2O : na
    hmS.s3.dv1 := hmS.s3.stS and not na(hmS.s1.x1O) and hmF.dxA > 0 ? ((na(hmS.s1.x1C) ? hmF.dxL : hmS.s1.x1C) - hmS.s1.x1O) / hmF.dxA : na
    hmS.s3.dv2 := hmS.s3.stS and not na(hmS.s1.x2O) and hmF.dxA > 0 ? ((na(hmS.s1.x2C) ? hmF.dxL : hmS.s1.x2C) - hmS.s1.x2O) / hmF.dxA : na
    hmS.s3.uAdd := hmS.s3.stS and not na(hmS.s1.r830) and hmS.s2.uA > 0 ? ((na(hmS.s1.r09) ? hmS.s1.tdH - hmS.s1.tdL : hmS.s1.r09) - hmS.s1.r830) / hmS.s2.uA : na
    hmS.s3.zBg := hmS.s2.uZ == 2 ? hmS.s2.cPrem : hmS.s2.uZ == 0 ? hmS.s2.cDisc : hmS.s2.cNeu
    hmS.s3.zFg := hmS.s2.uZ == 1 ? hmS.s1.cTx : #ffffff
    drawSg(hmS, hmC, hmF)
    drawHy(hmS, hmC, hmF)
    cardFlush(hmS)
    hmS
// @function The day this module's cards read (yyyymmdd): today's trading day when it is one of its days, else the next.
export nextDay(State hmS) =>
    [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
    d_

// @function A new, empty State with all its parts. Hold it with var.
export newState() =>
    State.new(StatePart1.new(), StatePart2.new(), StatePart3.new())

plot(na, "Hueco Mundo module", display = display.none)
