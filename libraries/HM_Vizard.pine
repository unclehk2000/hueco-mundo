// ═══════════════════════════════════════════════════════════════ Functions
parseDates(string s) =>
    array<int> out = array.new<int>()
    for p in str.split(s, ",")
        out.push(int(str.tonumber(p)))
    out
parseStats(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p))
    out
unpackMilli(string s) =>
    array<float> out = array.new<float>()
    for i = 0 to int(str.length(s) / 2) - 1
        out.push((str.pos(P92, str.substring(s, 2 * i, 2 * i + 1)) * 92 + str.pos(P92, str.substring(s, 2 * i + 1, 2 * i + 2)) - 2000) / 1000.0)
    out
parseMilli(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p) / 1000.0)
    out
ck(State hmS, int i, int m, int k, int j) => hmS.s1.CK.get(i * CKB + m * 230 + k * 46 + j)
ckSh(State hmS, int i, int j) => hmS.s1.CK.get(i * CKB + 460 + j)
ckAt(State hmS, int i, int m, int k, int j, float f) =>
    float b  = ck(hmS, i, m, k, j)
    float a0 = j > 0 ? ck(hmS, i, m, k, j - 1) : 0.0
    a0 + (b - a0) * f
ckShAt(State hmS, int i, int j, float f) =>
    float b  = ckSh(hmS, i, j)
    float a0 = j > 0 ? ckSh(hmS, i, j - 1) : 0.0
    a0 + (b - a0) * f
posOf(string s) =>
    switch s
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
keyTime(int k) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, 12, 0)
keyAt(int k, int m) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, int(m / 60), m % 60)
addDays(int k, int n) => dateKey(keyTime(k) + n * 86400000)
anchorKey(int an, int t) => an == 0 ? dateKey(t + 6 * 3600000) : dateKey(t)
inWin(int an, int m) => an == 0 ? true : an == 1 ? m < 1020 : m >= 570 and m < 975
winBars(int an) => an == 0 ? 92 : an == 1 ? 68 : 27
pf(float v) => str.tostring(v, format.mintick)
x2(float v) => str.tostring(v, "0.00") + "×"
p0(float v) => str.tostring(v * 100, "0") + "%"
fmtDay(int k) => str.format_time(keyTime(k), "EEE dd MMM", TZ)
dowOf(int k) => dayofweek(keyTime(k), TZ)
hhmm(int m) => (m / 60 < 10 ? "0" : "") + str.tostring(int(m / 60)) + ":" + (m % 60 < 10 ? "0" : "") + str.tostring(m % 60)
stepEnd(int j) => (1080 + 30 * (j + 1)) % 1440
dayType(State hmS, int k, int pk) =>
    int  dw  = dowOf(k)
    bool hol = false
    if dw >= 2 and dw <= 5
        for j = 1 to 6 - dw
            if hmS.s1.NP.includes(addDays(k, j))
                hol := true
    hmS.s1.FO.includes(k) ? 0 : hmS.s1.NP.includes(k) ? 1 : hmS.s1.CP.includes(k) ? 2 : hmS.s1.FO.includes(pk) ? 3 : hmS.s1.FO.includes(addDays(k, 1)) ? 4 : hol ? 5 : 6
typeShort(int ty) =>
    switch ty
        0 => "FOMC"
        1 => "NFP"
        2 => "CPI"
        3 => "FOMC +1"
        4 => "FOMC D1"
        5 => "NFP week"
        => "Normal"
nextOf(array<int> a, int k) =>
    int r = na
    for d in a
        if d >= k
            r := d
            break
    r
inDays(int k, int today) => int(math.round((keyTime(k) - keyTime(today)) / 86400000.0))
whenTxt(int k, int today) =>
    int dd = inDays(k, today)
    fmtDay(k) + (dd == 0 ? " · today" : dd == 1 ? " · tomorrow" : " · in " + str.tostring(dd) + "d")
pctQ(float x, float q10, float q25, float q50, float q75, float q90) =>
    float p = na
    if not na(x) and not na(q10) and not na(q90)
        if x < q10
            p := 5.0
        else if x <= q25
            p := 10.0 + 15.0 * (x - q10) / math.max(q25 - q10, 1e-9)
        else if x <= q50
            p := 25.0 + 25.0 * (x - q25) / math.max(q50 - q25, 1e-9)
        else if x <= q75
            p := 50.0 + 25.0 * (x - q50) / math.max(q75 - q50, 1e-9)
        else if x <= q90
            p := 75.0 + 15.0 * (x - q75) / math.max(q90 - q75, 1e-9)
        else
            p := 95.0
    p
pTxt(float p) => na(p) ? "—" : p <= 5.0 ? "<P10" : p >= 95.0 ? ">P90" : "≈P" + str.tostring(p, "0")
pill(string s) => s == "Above" ? "▲ ABOVE" : s == "Below" ? "▼ BELOW" : s == "Inside" ? "● INSIDE" : "—"
pfName(int k) =>
    switch k
        0 => "M9 VIZARD · FOMC 14:00"
        1 => "M10 PESQUISA · FOMC day 1"
        => ""
ownTy(int k) =>
    switch k
        0 => 0
        1 => 4
        => 6
talIs(State hmS, int k, int pk) => hmS.s1.FO.includes(k)
ownCk(int k) =>
    switch k
        0 => 0
        1 => 1
        => 0
ckName(int k) =>
    switch k
        0 => "FOMC"
        1 => "FOMC D1"
        2 => "Normal"
        => ""
ckN(int k, bool es) =>
    switch k
        0 => es ? "68" : "68"
        1 => es ? "64" : "64"
        2 => es ? "1416" : "1342"
        => ""
ownProfile(State hmS, int tk, int pk, int today) =>
    int  k   = 0
    bool now = false
    int  d   = na
    if hmS.s1.FO.includes(tk)
        now := true
        d := tk
    else if hmS.s1.FO.includes(addDays(tk, 1))
        k := 1
        now := true
        d := tk
    else
        int rf = na(tk) ? today : math.max(tk, today)
        int f  = nextOf(hmS.s1.FO, rf)
        int f2 = na(f) ? na : addDays(f, -1) >= rf ? f : nextOf(hmS.s1.FO, addDays(f, 1))
        k := 1
        d := na(f2) ? na : addDays(f2, -1)
    [k, now, d]
ownNext(State hmS, int today) =>
    int f  = nextOf(hmS.s1.FO, today)
    int f2 = na(f) ? na : addDays(f, -1) >= today ? f : nextOf(hmS.s1.FO, addDays(f, 1))
    ["FOMC day 1", na(f2) ? na : addDays(f2, -1), "FOMC 14:00", f]
fdYM(State hmS, int i) =>
    int t = hmS.s1.fdY * 12 + hmS.s1.fdM - 2 + i
    [int(math.floor(t / 12)), t % 12 + 1]
fdTk(State hmS, Cfg hmC, int i) =>
    [y, m] = fdYM(hmS, i)
    hmC.fdRoot + str.substring("FGHJKMNQUVXZ", m - 1, m) + str.tostring(y)
fdDim(int y, int m) => m == 2 ? (y % 4 == 0 ? 29 : 28) : m == 4 or m == 6 or m == 9 or m == 11 ? 30 : 31
fdDay(State hmS, int y, int m) =>
    int d = 0
    for k in hmS.s1.FO
        if int(k / 10000) == y and int(k / 100) % 100 == m
            d := k % 100
    d
fdRates(State hmS, array<float> Z) =>
    array<float> A = array.new<float>(FDN, na)
    for i = 0 to FDN - 1
        if Z.size() > i
            float p = Z.get(i)
            A.set(i, na(p) ? na : 100.0 - p)
    array<float> S  = array.new<float>(FDN, na)
    array<float> E  = array.new<float>(FDN, na)
    array<float> SS = array.new<float>(FDN, na)
    for i = FDN - 1 to 0
        int   d = hmS.s1.FMD.get(i)
        float a = A.get(i)
        if d > 0 and not na(a)
            float en = na
            if i < FDN - 1
                en := hmS.s1.FMD.get(i + 1) == 0 ? A.get(i + 1) : SS.get(i + 1)
            if not na(en)
                E.set(i, en)
                SS.set(i, (a * hmS.s1.FND.get(i) - en * (hmS.s1.FND.get(i) - d)) / d)
    for i = 0 to FDN - 1
        int   d = hmS.s1.FMD.get(i)
        float a = A.get(i)
        if d > 0 and not na(a)
            float st = SS.get(i)
            if i > 0
                if hmS.s1.FMD.get(i - 1) == 0 and not na(A.get(i - 1))
                    st := A.get(i - 1)
            S.set(i, st)
            if na(E.get(i)) and not na(st) and hmS.s1.FND.get(i) > d
                E.set(i, (a * hmS.s1.FND.get(i) - st * d) / (hmS.s1.FND.get(i) - d))
    [S, E, hmS.s1.FKY]
fdNode(float dl) =>
    float st = dl / 0.25
    float k  = math.floor(math.abs(st))
    float r  = math.abs(st) - k
    int   sg = st >= 0 ? 1 : -1
    [int(sg * k), int(sg * (k + 1)), 1.0 - r, r]
fdStep(array<float> p, float dl) =>
    [k1, k2, w1, w2] = fdNode(dl)
    array<float> q = array.new<float>(41, 0.0)
    for x = 0 to 40
        float v = p.get(x)
        if v > 0
            int a = x + k1
            int b = x + k2
            if a >= 0 and a <= 40
                q.set(a, q.get(a) + v * w1)
            if b >= 0 and b <= 40
                q.set(b, q.get(b) + v * w2)
    q
fdCalc(State hmS, array<float> Z, int today, bool after) =>
    [S, E, KY] = fdRates(hmS, Z)
    array<int>   K  = array.new<int>()
    array<float> EA = array.new<float>()
    array<int>   MK = array.new<int>()
    array<float> MP = array.new<float>()
    float base = na
    float lo0  = na
    int   k1   = na
    int   k2   = na
    float w1   = na
    float w2   = na
    array<float> P = array.new<float>(41, 0.0)
    P.set(20, 1.0)
    for i = 0 to FDN - 1
        int ky = KY.get(i)
        if ky % 100 > 0 and (ky > today or (ky == today and not after)) and K.size() < 4
            float s = S.get(i)
            float e = E.get(i)
            if na(s) or na(e)
                break
            if K.size() == 0
                base := s
                lo0  := math.floor((s + 0.0001) / 0.25) * 0.25
                [a1, a2, b1, b2] = fdNode(e - s)
                k1 := a1
                k2 := a2
                w1 := b1
                w2 := b2
            P := fdStep(P, e - s)
            int   bk = 20
            float bp = 0.0
            for x = 0 to 40
                if P.get(x) > bp
                    bp := P.get(x)
                    bk := x
            K.push(ky)
            EA.push(e)
            MK.push(bk - 20)
            MP.push(bp)
    [K, EA, MK, MP, k1, k2, w1, w2, lo0, base]
fdWord(int k) => na(k) ? "—" : k == 0 ? "hold" : k < 0 ? "cut " + str.tostring(-25 * k) : "hike " + str.tostring(25 * k)
fdRng(float lo0, int k) => na(lo0) or na(k) ? "—" : str.tostring((lo0 + 0.25 * k) * 100, "0") + "–" + str.tostring((lo0 + 0.25 * (k + 1)) * 100, "0")
fdOdd(int k, int a1, int a2, float b1, float b2) => na(k) or na(a1) ? na : (k == a1 ? b1 : 0.0) + (k == a2 ? b2 : 0.0)
fdSg(float v, string f) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), f)
fdDate(int k) => str.upper(str.format_time(keyTime(k), "dd MMM", TZ))
fdMv(int k, float lo) => (k == 0 ? "hold " : k < 0 ? "cut " : "hike ") + fdRng(lo, k)
fillT(string t, string v) =>
    string out = t
    array<string> p = str.split(v, "|")
    for i = 0 to p.size() - 1
        out := str.replace_all(out, "{" + str.tostring(i) + "}", p.get(i))
    out
ctxOf(State hmS, Feed hmF, float c, float h, float l, float dx) =>
    float a  = hmF.ADRtd * hmS.s1.tdO
    float mh = math.max(nz(hmF.mtH, h), h)
    float ml = math.min(nz(hmF.mtL, l), l)
    float p  = mh > ml ? (c - ml) / (mh - ml) : na
    float m  = a > 0 ? (c - hmF.mtO) / a : na
    float d  = na(hmS.s1.ptdH) or not (a > 0) ? na : c > hmS.s1.ptdH ? (c - hmS.s1.ptdH) / a : c < hmS.s1.ptdL ? (c - hmS.s1.ptdL) / a : 0.0
    float s  = a > 0 ? (c - hmS.s1.tdO) / a : na
    float x  = hmF.dxA > 0 ? (dx - hmF.dx20) / hmF.dxA : na
    [p, m, d, s, a, x]
cnAt(State hmS, int sr, int k) => hmS.s2.CN.get(sr * 27 + k)
coneBand(State hmS, int dk, float o, float a, int su, int sd, int kEnd, color fc, color lc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(keyAt(dk, 840), o))
    for k = 0 to kEnd
        pts.push(chart.point.from_time(keyAt(dk, 845 + 5 * k), o + cnAt(hmS, su, k) * a))
    for k = kEnd to 0
        pts.push(chart.point.from_time(keyAt(dk, 845 + 5 * k), o - cnAt(hmS, sd, k) * a))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = lc, fill_color = fc, force_overlay = true)
vzSg(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), format.mintick)
vzAr(float v) => na(v) or v == 0 ? "·" : v > 0 ? "▲" : "▼"
trimL(State hmS, line l, int e) =>
    if e > time
        l.set_x2(time)
        hmS.s2.GL.push(l)
        hmS.s2.GLE.push(e)
    l
trimT(State hmS, label t, int e) =>
    if e > time
        t.set_x(time)
        hmS.s2.GT.push(t)
        hmS.s2.GTE.push(e)
    t
kPath(State hmS, int i, int m, int k, int t0, float sc, color lc, int lw, string ls) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, k, j) * sc))
    polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = lc, line_width = lw, line_style = ls)
kBand(State hmS, int i, int m, int kUp, int kDn, int t0, float sc, color fc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kUp, j) * sc))
    for j = 45 to 0
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kDn, j) * sc))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = #00000000, fill_color = fc)
drawCore1(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on)
        for p in hmS.s2.KP
            p.delete()
        for l in hmS.s2.KL
            l.delete()
        for t in hmS.s2.KT
            t.delete()
        hmS.s2.KP.clear()
        hmS.s2.KL.clear()
        hmS.s2.KT.clear()
        if hmS.s2.clkGo and hmS.s2.scP > 0
            int   t0  = keyAt(addDays(hmS.s1.tdK, -1), 1080)
            int   tE  = t0 + 46 * 1800000
            color ce  = hmS.s2.ckEv ? hmC.cGh : hmS.s1.cSub
            int   iR  = hmS.s2.ckEv ? NCK - 1 : hmS.s2.ckEvI
            color cR  = hmS.s2.ckEv ? hmS.s1.cMu : color.new(hmC.cGh, 25)
            if hmC.kBands
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 0, t0, hmS.s2.scP, color.new(ce, 90)))
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, 1, t0, hmS.s2.scP, color.new(ce, 80)))
            hmS.s2.KP.push(kPath(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, t0, hmS.s2.scP, ce, 2, line.style_solid))
            hmS.s2.KT.push(label.new(tE, ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(hmS.s2.ckI) + " median " + pf(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = ce, style = label.style_label_left, size = size.tiny))
            if hmC.kRef
                hmS.s2.KP.push(kPath(hmS, iR, hmS.s2.mSel, 2, t0, hmS.s2.scP, cR, 1, line.style_dashed))
                hmS.s2.KT.push(label.new(tE, ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(iR) + (hmS.s2.ckEv ? "" : " (next)") + " " + pf(ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = cR, style = label.style_label_left, size = size.tiny))
            for s in str.split(REL, ",")
                float rm = str.tonumber(s)
                if not na(rm)
                    int tr = keyAt(hmS.s1.tdK, int(rm))
                    hmS.s2.KL.push(line.new(tr, 0.0, tr, hmS.s2.scP, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cGh, hmS.s2.ckEv ? 30 : 70), style = line.style_dotted))
    true
clearRight(State hmS) =>
    for b in hmS.s2.RB
        b.delete()
    for l in hmS.s2.RL
        l.delete()
    for t in hmS.s2.RT
        t.delete()
    hmS.s2.RB.clear()
    hmS.s2.RL.clear()
    hmS.s2.RT.clear()
gapOf(string on, string p) => p == "Top left" or p == "Top center" or (p == "Top right" and on == "Indicator pane")
tc(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    t.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = hmS.s1.crdSz, text_halign = ha, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
stripe(table t, int r, color col) =>
    t.cell(0, r, "", bgcolor = col, width = 0.25)
cardHead(State hmS, table t, int r, color col, string title, string tip, string pill, color pfg, color pbg) =>
    hmS.s2.CQ.push(CRow.new(t, 1, r, 0, col, title, "", "", pill, tip, false, pfg, pbg))
cardSub(State hmS, table t, int r, color col, string txt, string a1, string a2) =>
    hmS.s2.CQ.push(CRow.new(t, 2, r, 0, col, "", txt, a1, a2))
cardRow(State hmS, table t, int r, color col, string key, bool held, string lab, string v, string b, string tip, color vfg = na, color bfg = na) =>
    hmS.s2.CQ.push(CRow.new(t, 0, r, 0, col, key, lab, v, b, tip, held, vfg, bfg))
cardWide(State hmS, table t, int r, color col, string key, string txt, string tip, color fg) =>
    hmS.s2.CQ.push(CRow.new(t, 3, r, 0, col, key, txt, "", "", tip, false, fg))
tcQ(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    hmS.s2.CQ.push(CRow.new(t, 4, r, c, na, s, "", "", "", tip, b, fg, bg, ha))
stripeQ(State hmS, table t, int r, color col) =>
    hmS.s2.CQ.push(CRow.new(t, 5, r, 0, col))
gauge(float frac) =>
    string out = "░░░░░░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 10))
        out := str.repeat("█", k) + str.repeat("░", 10 - k)
    out
gauge5(float frac) =>
    string out = "░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 5))
        out := str.repeat("█", k) + str.repeat("░", 5 - k)
    out
meter(float p) =>
    string out = "──────────"
    if not na(p)
        int k = int(math.round(math.max(0.0, math.min(100.0, p)) / 10.0))
        out := str.repeat("─", k) + "●" + str.repeat("─", 10 - k)
    out
octBar(int o) =>
    string out = ""
    for i = 1 to 8
        out += i == o ? "█" : "░"
    out
octOf(float px, float h, float l) => na(h) or na(l) or h <= l ? na : math.min(8, int(math.floor((px - l) / (h - l) * 8)) + 1)
zoneOf(State hmS, float h, float l) =>
    int    o  = octOf(close, h, l)
    string z  = na(o) ? "—" : o >= 7 ? "PREM" : o <= 2 ? "DISC" : "EQ"
    color  zb = na(o) ? hmS.s2.cBody : o >= 7 ? hmS.s2.cPrem : o <= 2 ? hmS.s2.cDisc : hmS.s2.cNeu
    color  zf = na(o) or (o > 2 and o < 7) ? hmS.s1.cTx : #ffffff
    [o, z, zb, zf]
zoneTip(int o, float h, float l, string what) =>
    "This " + what + "'s range so far " + pf(l) + " – " + pf(h) + ": price is " + (na(o) ? "—" : p0((close - l) / (h - l))) + " of the way up (octant " + (na(o) ? "—" : str.tostring(o)) + " of 8), " + (na(l) ? "—" : pf(close - l)) + " above the low and " + (na(h) ? "—" : pf(h - close)) + " below the high (right). Top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount. A locator, not a tested signal."
zoneRow(State hmS, table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(hmS, h, l)
    string tip = zoneTip(o, h, l, what)
    stripeQ(hmS, t, r, col)
    tcQ(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
    tcQ(hmS, t, 2, r, octBar(o) + " O" + (na(o) ? "—" : str.tostring(o)), hmS.s1.cTx, hmS.s2.cBody, tip)
    tcQ(hmS, t, 3, r, z, zf, zb, tip, text.align_center, true)
    tcQ(hmS, t, 4, r, na(h) ? "—" : "−" + str.tostring(h - close, "0"), hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
talAcc(array<float> acc, int t_, int r_, float g_, float p_) =>
    acc.set(0, acc.get(0) + 1)
    acc.set(1, acc.get(1) + (t_ > 0 ? 1 : 0))
    acc.set(2, acc.get(2) + (t_ < 0 ? 1 : 0))
    acc.set(3, acc.get(3) + (r_ > 0 ? 1 : 0))
    acc.set(4, acc.get(4) + (r_ < 0 ? 1 : 0))
    if not na(g_)
        acc.set(5, acc.get(5) + 1)
        acc.set(6, acc.get(6) + g_)
        acc.set(7, acc.get(7) + math.abs(g_))
        acc.set(8, acc.get(8) + (na(p_) ? 0.0 : math.abs(p_)))
        acc.set(9, acc.get(9) + (g_ > 0 ? 1 : 0))
drawCore2(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        clearRight(hmS)
        bool   pend = hmS.s1.AN == 2 and hmS.s1.mod < 570                      // RTH not open yet: the model sits on the last price
        int    tKey = pend ? hmS.s1.calK : hmS.s1.dK
        int    today = hmS.s1.calK
        [pk, pNow, pDay] = ownProfile(hmS, tKey, pend ? hmS.s1.dK : hmS.s1.pK, today)
        int    mTy  = ownTy(pk)                                  // this indicator's own event, never another event's
        bool   live = pNow and not pend
        bool   hasD = not pend and not na(hmS.s1.dO)
        float  O    = hasD ? hmS.s1.dO : close
        // ── cards
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        int    dd   = na(pDay) ? na : inDays(pDay, today)
        string ev   = typeShort(mTy)
        [n1t, n1k, n2t, n2k] = ownNext(hmS, today)
        bool   warn = inDays(LAST_DATE, today) < 60
        // tally of the last N event days (both layouts): this chart's own records first, then built-in ones older than those
        array<float> acc = array.new_float(10, 0.0)
        string seq = ""
        int    d0  = na
        if hmC.showEv
            if hmS.s1.LTd.size() > 0
                for i = hmS.s1.LTd.size() - 1 to 0
                    if acc.get(0) < hmC.talN
                        talAcc(acc, hmS.s1.LTt.get(i), hmS.s1.LTr.get(i), hmS.s1.LTg.get(i), hmS.s1.LTp.get(i))
                        seq := (hmS.s1.LTt.get(i) > 0 ? "▲" : hmS.s1.LTt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s1.LTd.get(i)
            int oldest = hmS.s1.LTd.size() > 0 ? hmS.s1.LTd.get(0) : 99999999
            if hmS.s2.TEd.size() > 0
                for i = hmS.s2.TEd.size() - 1 to 0
                    if acc.get(0) < hmC.talN and hmS.s2.TEd.get(i) < oldest
                        talAcc(acc, hmS.s2.TEt.get(i), hmS.s2.TEr.get(i), hmS.s2.TEg.get(i), hmS.s2.TEp.get(i))
                        seq := (hmS.s2.TEt.get(i) > 0 ? "▲" : hmS.s2.TEt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s2.TEd.get(i)
        int    nT   = int(acc.get(0))
        int    uT   = int(acc.get(1))
        int    dT_  = int(acc.get(2))
        int    uR   = int(acc.get(3))
        int    dR_  = int(acc.get(4))
        int    nG   = int(acc.get(5))
        float  gAvg = nG > 0 ? acc.get(6) / nG : na
        float  gAbs = nG > 0 ? acc.get(7) / nG : na
        string since = na(d0) ? "" : " since " + str.format_time(keyTime(d0), "MMM yyyy", TZ)
        string srcT = hmS.s2.TEd.size() > 0 ? " Built-in " + hmS.s1.symR + " records run to " + str.format_time(keyTime(hmS.s1.talEnd), "dd MMM yyyy", TZ) + "; later days, and any this chart loads itself, come from the chart's own bars." : " Records come from this chart's own bars (built-in history covers NQ / MNQ and ES / MES)."
        string tTip = "Trading day (18:00 → 17:00) close vs open on the last " + str.tostring(nT) + " " + TAL_NAME + " days" + since + ", oldest → newest: " + seq + ". RTH (09:30 → 16:14): ▲ " + str.tostring(uR) + " ▼ " + str.tostring(dR_) + ". A tally, not a forecast: across 2018–26 the up-close rate on these days was not different from normal days." + srcT
        string gTip = "RTH gap = 09:30 open − prior trading day's 16:14 close. Average over the last " + str.tostring(nG) + " " + TAL_NAME + " days: " + (na(gAvg) ? "—" : pf(gAvg)) + " pts; average size " + (na(gAbs) ? "—" : pf(gAbs) + " pts (" + str.tostring(acc.get(8) / nG, "0.00") + "%)") + "; gapped up on " + str.tostring(int(acc.get(9))) + " of " + str.tostring(nG) + "."
        string nxT  = na(n2k) ? "beyond loaded dates" : "FOMC " + str.format_time(keyTime(n2k), "dd MMM", TZ) + (n2k == today ? " · today" : " · " + str.tostring(inDays(n2k, today)) + "d") + (warn ? " · UPDATE" : "")
        string nxTip = "Next decision: " + (na(n2k) ? "beyond the loaded dates" : fmtDay(n2k) + " (statement 14:00 ET), the meeting's day 1 " + fmtDay(addDays(n2k, -1))) + ". Release dates are built in up to " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's dates (federalreserve.gov, bls.gov/schedule) to S_FOMC, S_CPI and S_NFP, then raise LAST_DATE."
        string hdT  = pfName(pk) + ". Recomputed on " + hmS.s1.symR + " 1-minute data 2018–26." + (hmS.s1.isNQ or hmS.s1.isES ? "" : " This chart is " + syminfo.root + ": the figures are " + hmS.s1.symR + "'s.")
        string pill_ = pNow ? "TODAY" : na(dd) ? "—" : dd == 1 ? "TMRW" : "IN " + str.tostring(dd) + "D"
        if hmC.showEv and not na(hmS.s2.TS)
            int r0 = hmS.s2.tsO
            cardHead(hmS, hmS.s2.TS, r0, hmC.cGh, dot + " VIZARD · " + ev + " · " + hmS.s1.symTag, hdT + " " + nxTip, hmS.s2.mob and warn ? "UPDATE" : pill_, hmS.s2.mob and warn or not pNow ? #ffffff : hmC.cGh, hmS.s2.mob and warn ? hmS.s1.cWarn : pNow ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.mob
                cardSub(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "last " + str.tostring(nT) + " " + TAL_NAME + " days", "▲", "▼")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, gauge(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na) + " " + (uT + dT_ > 0 ? p0(float(uT) / (uT + dT_)) : "—"), str.tostring(uT), str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "RTH", false, gauge(uR + dR_ > 0 ? float(uR) / (uR + dR_) : na) + " " + (uR + dR_ > 0 ? p0(float(uR) / (uR + dR_)) : "—"), str.tostring(uR), str.tostring(dR_), "RTH 09:30 → 16:14 close vs open on the same days (days without RTH data are left out).", hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 4, hmC.cGh, "GAP", false, "avg gap · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 5 + zi, hmC.cGh, zi == 0 ? "WEEK" : "MONTH", zi == 0 ? hmF.wH : hmS.s1.mHi, zi == 0 ? hmF.wL : hmS.s1.mLo, zi == 0 ? "week" : "month")
                cardWide(hmS, hmS.s2.TS, r0 + hmS.s2.EV_N - 1, hmC.cGh, "NEXT", nxT, nxTip, na(n1k) or warn ? hmS.s1.cWarn : hmS.s1.cTx)
            else
                // mobile: NOW reads the clock in one row, then the tally in short form
                if hmS.s2.clkTF and not na(hmS.s2.vAdr)
                    float  q50m = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                    string nTip = "Today so far (" + (hmS.s2.clkR ? "range" : "net move") + " from the 18:00 open) against " + ckName(hmS.s2.ckI) + " days at this time: median " + pf(q50m * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts at today's ADR20 (" + x2(q50m) + " typical, " + x2(hmS.s2.vAdr) + " today). Above / below = outside that middle half."
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, (hmS.s2.clkR ? "range " : "net ") + (hmS.s2.clkR or hmS.s2.vPts < 0 ? "" : "+") + str.tostring(hmS.s2.vPts, "0"), x2(hmS.s2.vAdr), "", nTip)
                    tcQ(hmS, hmS.s2.TS, 4, r0 + 1, str.upper(hmS.s2.stB), hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff, hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu, nTip, text.align_center, true)
                else
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, not hmS.s2.clkTF ? "clock: ≤ 60 min" : "needs 15+ days", "", "", "")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, "last " + str.tostring(nT) + " " + gauge5(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na), "▲" + str.tostring(uT), "▼" + str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "GAP", false, "avg · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 4 + zi, hmC.cGh, zi == 0 ? "WK" : "MO", zi == 0 ? hmF.wH : hmS.s1.mHi, zi == 0 ? hmF.wL : hmS.s1.mLo, zi == 0 ? "week" : "month")
    true
drawCore2B(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        // ── clock card
        if hmC.showCk and not na(hmS.s2.TK)
            string bN   = ckName(hmS.s2.ckI)
            string eN   = ckName(hmS.s2.ckEvI)
            string nowT = hhmm(int(math.min(1439.0, (hmS.s2.elM + hmS.s1.tfM + 1080) % 1440)))
            int    r0   = hmS.s2.tkO
            cardHead(hmS, hmS.s2.TK, r0, hmC.cGh, dot + " " + str.upper("Vizard") + " · CLOCK · " + nowT + " ET", "Today's running range (or net move) from the 18:00 open against the same time of day on " + bN + " days, 2018–26: paths from " + ckN(hmS.s2.ckI, hmS.s1.isES) + " " + bN + " days" + (hmS.s2.ckI != NCK - 1 ? " and " + ckN(NCK - 1, hmS.s1.isES) + " normal days" : "") + ", half-hour steps, scaled by today's ADR20" + (hmS.s2.scP > 0 ? " (" + pf(hmS.s2.scP) + " pts)." : "."), hmS.s2.ckEv ? eN + " DAY" : "NORMAL", hmS.s2.ckEv ? hmC.cGh : #ffffff, hmS.s2.ckEv ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.clkTF or na(hmS.s2.vAdr)
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "CLOCK", false, not hmS.s2.clkTF ? "needs an intraday chart ≤ 60 min" : "needs 15+ days of history", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "", false, "", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "", false, "", "", "", "")
            else
                float q10 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 0, hmS.s2.jB, hmS.s2.fB)
                float q50 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                float q90 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, hmS.s2.jB, hmS.s2.fB)
                float pc  = pctQ(hmS.s2.vAdr, q10, hmS.s2.q25B, q50, hmS.s2.q75B, q90)
                string mW = hmS.s2.clkR ? "range" : "net"
                color sBg = hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu
                color sFg = hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "NOW", false, mW + " " + (hmS.s2.clkR ? "" : hmS.s2.vPts >= 0 ? "+" : "") + pf(hmS.s2.vPts) + " pts", x2(hmS.s2.vAdr), "", "Today so far, in ADR20 of the trading day.")
                tcQ(hmS, hmS.s2.TK, 4, r0 + 1, pill(hmS.s2.stB), sFg, sBg, "Above / below = outside the middle half (25–75%) of " + bN + " days at this time.", text.align_center, true)
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "vs " + bN, false, meter(pc) + " " + pTxt(pc), "typ " + x2(q50), "", bN + " days by " + nowT + ": median " + pf(q50 * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts (" + mW + ", at today's ADR20).", hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx)
                float sh = ckShAt(hmS, hmS.s2.ckI, hmS.s2.jB, hmS.s2.fB)
                float rgT = hmS.s1.tdH - hmS.s1.tdL
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "DONE", false, gauge(sh) + " " + p0(sh), sh >= 0.25 ? "→ " + pf(rgT / sh) : "—", "pts", "Median share of the final day range already made by this time on " + bN + " days; right: today's range so far ÷ that share, a rough full-day figure (shown from 25% on).")
            float bestD = -1.0
            int   bestJ = 0
            for j = 0 to 45
                float dj = ck(hmS, hmS.s2.ckEvI, 0, 2, j) - (j > 0 ? ck(hmS, hmS.s2.ckEvI, 0, 2, j - 1) : 0.0)
                if dj > bestD
                    bestD := dj
                    bestJ := j
            float nD = ck(hmS, NCK - 1, 0, 2, bestJ) - (bestJ > 0 ? ck(hmS, NCK - 1, 0, 2, bestJ - 1) : 0.0)
            cardRow(hmS, hmS.s2.TK, r0 + 4, hmC.cGh, "BUSIEST", false, hhmm(stepEnd(bestJ - 1)) + "–" + hhmm(stepEnd(bestJ)), "+" + x2(bestD), "norm +" + x2(nD), "The half hour in which the median running range of " + eN + " days grows most, against normal days in the same half hour.", hmS.s2.ckEv ? hmC.cGh : hmS.s1.cTx)
    true
drawLast1(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        int xd = bar_index + offI
        if hmC.showStr and hmS.s1.FO.includes(addDays(hmS.s1.tdK, 1)) and not na(hmS.s1.tdX)
            hmS.s2.RL.push(line.new(hmS.s1.tdX, hmS.s1.tdH, xd, hmS.s1.tdH, color = hmC.cLvl, style = line.style_dashed, force_overlay = true))
            hmS.s2.RL.push(line.new(hmS.s1.tdX, hmS.s1.tdL, xd, hmS.s1.tdL, color = hmC.cLvl, style = line.style_dashed, force_overlay = true))
            hmS.s2.RT.push(label.new(hmS.s1.tdX, hmS.s1.tdH, "D1 high (live)", color = #00000000, textcolor = hmC.cLvl, style = label.style_label_lower_left, size = size.tiny, tooltip = "Today is FOMC day 1: its high and low carry into the decision day.", force_overlay = true))
            hmS.s2.RT.push(label.new(hmS.s1.tdX, hmS.s1.tdL, "D1 low (live)", color = #00000000, textcolor = hmC.cLvl, style = label.style_label_upper_left, size = size.tiny, force_overlay = true))
        // the shock cone, live on the FOMC day: from 14:00 it runs a few minutes ahead of price; before 14:00 a faint preview
        for p in hmS.s2.VPC
            p.delete()
        hmS.s2.VPC.clear()
        if hmC.showCone and hmS.s1.vzF and not na(hmF.ADRtd)
            if hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s14O) and hmS.s1.mod < 975
                int kE = math.min(26, int((hmS.s1.mod - 840) / 5) + 2)
                for cb = 0 to 1
                    hmS.s2.VPC.push(coneBand(hmS, hmS.s1.calK, hmS.s1.s14O, hmF.ADRtd * hmS.s1.s14O, 1 - cb, 3 - cb, kE, color.new(hmC.cGh, cb == 0 ? 91 : 85), cb == 0 ? color.new(hmC.cGh, 72) : #00000000))
                hmS.s2.RT.push(label.new(keyAt(hmS.s1.calK, 845 + 5 * kE), hmS.s1.s14O + cnAt(hmS, 1, kE) * hmF.ADRtd * hmS.s1.s14O, "80% of FOMC days", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(hmC.cGh, 20), style = label.style_label_lower_left, size = size.tiny, tooltip = "By " + hhmm(845 + 5 * kE) + " ET, 80% of FOMC days (2018–26) had gone no further than this above the 14:00 open, and the inner band held half of them. Scaled by today's ADR20.", force_overlay = true))
            else if hmS.s1.mod >= 570 and hmS.s1.mod < 840
                hmS.s2.VPC.push(coneBand(hmS, hmS.s1.calK, close, hmF.ADRtd * close, 1, 3, 26, color.new(hmC.cGh, 95), color.new(hmC.cGh, 82)))
        // week open, and the FOMC day's 14:00 and 14:30 opens, extended to the right of price
        if hmC.showWO and not na(hmS.s1.wkX) and not na(hmS.s1.wkOp)
            hmS.s2.RL.push(line.new(math.max(hmS.s1.wkX, bar_index - 4900), hmS.s1.wkOp, xd, hmS.s1.wkOp, color = color.new(hmC.cLvl, 15), style = line.style_dashed, force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.wkOp, "week open " + pf(hmS.s1.wkOp), color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, force_overlay = true))
        if hmC.showWO and hmS.s1.vzF and hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s14X) and bar_index - hmS.s1.s14X < 4900
            hmS.s2.RL.push(line.new(hmS.s1.s14X, hmS.s1.s14O, xd, hmS.s1.s14O, color = color.new(hmC.cGh, 15), force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.s14O, "14:00 open " + pf(hmS.s1.s14O), color = #00000000, textcolor = hmC.cGh, style = label.style_label_left, size = size.tiny, force_overlay = true))
            if not na(hmS.s1.s30X)
                hmS.s2.RL.push(line.new(hmS.s1.s30X, hmS.s1.s30O, xd, hmS.s1.s30O, color = color.new(hmC.cGh, 35), style = line.style_dashed, force_overlay = true))
                hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.s30O, "14:30 open " + pf(hmS.s1.s30O), color = #00000000, textcolor = color.new(hmC.cGh, 25), style = label.style_label_left, size = size.tiny, force_overlay = true))
    true
drawLast2(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        int    today = hmS.s1.calK
        string dot   = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        // ── Fed card (CME FedWatch steps on CBOT ZQ): shared values for both layouts
        bool fdEv  = hmS.s1.FO.includes(today)
        bool fdAft = fdEv and hmS.s1.mod >= 840
        [fK, fE, fMK, fMP, fk1, fk2, fw1, fw2, fLo, fBase] = fdCalc(hmS, hmS.s1.fdZ, today, fdAft)
        int  fdHn = hmS.s1.fdH.size()
        array<float> fdZ1 = fdHn >= FDN ? hmS.s1.fdH.slice(fdHn - FDN, fdHn) : array.new<float>()
        array<float> fdZ5 = fdHn >= 5 * FDN ? hmS.s1.fdH.slice(fdHn - 5 * FDN, fdHn - 4 * FDN) : array.new<float>()
        array<float> yE = array.new<float>()
        array<float> wE = array.new<float>()
        int   yk1 = na
        int   yk2 = na
        float yw1 = na
        float yw2 = na
        for pv = 0 to 1
            [hK, hE, hMK, hMP, hk1, hk2, hw1, hw2, hLo, hBase] = fdCalc(hmS, pv == 0 ? fdZ1 : fdZ5, today, fdAft)
            if pv == 0
                yE  := hE
                yk1 := hk1
                yk2 := hk2
                yw1 := hw1
                yw2 := hw2
            else
                wE  := hE
        bool  fOk  = fK.size() > 0
        int   kA   = na(fw1) ? na : fw1 >= fw2 ? fk1 : fk2
        int   kB   = na(fw1) ? na : fw1 >= fw2 ? fk2 : fk1
        float pA   = na(fw1) ? na : math.max(fw1, fw2)
        float pB   = na(fw1) ? na : math.min(fw1, fw2)
        float dA   = 100 * (pA - fdOdd(kA, yk1, yk2, yw1, yw2))
        float dB   = 100 * (pB - fdOdd(kB, yk1, yk2, yw1, yw2))
        float mv5  = fOk and wE.size() > 0 ? 100 * (fE.get(0) - wE.get(0)) : na
        // decision day after 14:00: what was decided, the surprise against 13:59 pricing and how the next meeting repriced
        bool  fDone = fdAft and hmS.s1.fd14K == today
        int   fDec  = na
        float fSur  = na
        float fPx   = na
        float fPr   = na
        int   fNx   = na
        if fDone
            [S1, E1, KY1] = fdRates(hmS, hmS.s1.fd14)
            [S2, E2, KY2] = fdRates(hmS, hmS.s1.fdZ)
            int iT = KY1.indexof(today)
            if iT >= 0
                if not na(E2.get(iT)) and not na(S2.get(iT))
                    fDec := int(math.round((E2.get(iT) - S2.get(iT)) / 0.25))
                if not na(E1.get(iT)) and not na(S1.get(iT))
                    [c1, c2, q1, q2] = fdNode(E1.get(iT) - S1.get(iT))
                    fPr := fdOdd(fDec, c1, c2, q1, q2)
                fSur := 100 * (E2.get(iT) - E1.get(iT))
                if iT < FDN - 1
                    for i = iT + 1 to FDN - 1
                        if KY2.get(i) % 100 > 0 and na(fNx)
                            fNx := KY2.get(i)
                            fPx := 100 * (E2.get(i) - E1.get(i))
        string fPill = fDone ? "DECIDED" : not fOk ? "NO DATA" : str.upper(fdWord(kA)) + " " + p0(pA)
        color  fPbg  = fDone or not fOk or kA == 0 ? hmS.s2.cNeu : kA < 0 ? hmS.s1.cCold : hmS.s1.cHot
        color  fPfg  = fDone or not fOk or kA == 0 ? hmS.s1.cTx : #ffffff
        string fTip  = "Odds for the next FOMC meetings from CBOT 30-day fed funds futures, with the same steps as CME FedWatch: each contract settles to 100 − the month's average effective fed funds rate; the month after a meeting (or before it) anchors the rate after (or before) the decision, which takes effect the next day; the change ÷ 25bp gives the odds of the two nearest moves, combined across meetings as a probability tree. Checked against CME's own FedWatch page for 12 Oct 2026: all eight meetings within 0.06 percentage points. A live readout, not yet a tested signal: rows that held on NQ / ES come once the ZQ history is tested. TradingView delays CBOT data without a subscription."
        string pTip  = "Expected rate after this meeting against the rate now (bp), the most likely target range by then and its odds (probability tree over the meetings in between). Right: change since yesterday's close, bp."

        if hmC.showFd and not na(hmS.s2.TF) and not hmS.s2.mob
            int r0 = hmS.s2.tfO
            cardHead(hmS, hmS.s2.TF, r0, hmS.s1.cFd, dot + " FED · " + (fOk ? fdDate(fK.get(0)) : "NO ZQ DATA"), fTip, fPill, fPfg, fPbg)
            cardSub(hmS, hmS.s2.TF, r0 + 1, hmS.s1.cFd, "now " + (fOk ? fdRng(fLo, 0) : "—"), "odds", "1d")
            string oTip = "The next meeting's two outcomes: the expected change ÷ 25bp sits between two move sizes, and its distance to each is the odds. Right: change since yesterday's close, in percentage points."
            cardRow(hmS, hmS.s2.TF, r0 + 2, hmS.s1.cFd, "NEXT", false, fOk ? fdMv(kA, fLo) : "—", fOk ? p0(pA) : "—", na(dA) ? "—" : fdSg(dA, "0"), oTip)
            cardRow(hmS, hmS.s2.TF, r0 + 3, hmS.s1.cFd, "", false, fOk ? fdMv(kB, fLo) : "", fOk ? p0(pB) : "", na(dB) ? "" : fdSg(dB, "0"), oTip, hmS.s1.cMu)
            for j = 1 to 3
                if j < fK.size()
                    float cb = 100 * (fE.get(j) - fBase)
                    float d1 = j < yE.size() ? 100 * (fE.get(j) - yE.get(j)) : na
                    cardRow(hmS, hmS.s2.TF, r0 + 3 + j, hmS.s1.cFd, fdDate(fK.get(j)), false, fdRng(fLo, fMK.get(j)) + " " + p0(fMP.get(j)), fdSg(cb, "0") + "bp", fdSg(d1, "0.0"), pTip)
            if fDone
                cardRow(hmS, hmS.s2.TF, r0 + 7, hmS.s1.cFd, "14:00", false, fdWord(fDec) + " · priced " + (na(fPr) ? "—" : p0(fPr)), fdSg(fSur, "0.0") + "bp", na(fNx) ? "" : str.upper(str.format_time(keyTime(fNx), "MMM", TZ)) + " " + fdSg(fPx, "0"), "Decision day. Surprise = change in the expected rate after today's meeting from 13:59 to now (the classic fed funds futures surprise), with the odds the decision had at 13:59. Right: how the next meeting's expected rate moved since 13:59, bp.", math.abs(nz(fSur)) >= 5 ? hmS.s1.cHot : hmS.s1.cTx)
            else if fdEv
                cardRow(hmS, hmS.s2.TF, r0 + 7, hmS.s1.cFd, "TODAY", false, "14:00 · priced " + (na(pA) ? "—" : p0(pA)), "", "", "Decision day: the statement lands at 14:00 ET, the press conference at 14:30. After 14:00 this row shows the surprise against the 13:59 pricing.")
            else
                cardRow(hmS, hmS.s2.TF, r0 + 7, hmS.s1.cFd, "5D", false, "next mtg, 5 days", fdSg(mv5, "0.0") + "bp", "", "Change in the expected rate after the next meeting over the last five trading days (bp). Up = cuts priced out or hikes priced in.")
        if hmC.showFd and not na(hmS.s2.TF) and hmS.s2.mob
            string mTx = fDone ? "surprise " + fdSg(fSur, "0.0") + "bp" : not fOk ? "no ZQ data" : str.format_time(keyTime(fK.get(0)), "d MMM", TZ) + " " + fdWord(kA)
            string mVl = fDone ? (na(fNx) ? "—" : str.format_time(keyTime(fNx), "MMM", TZ) + " " + fdSg(fPx, "0")) : fOk ? p0(pA) : "—"
            string mTip = fTip + (fOk ? " Now " + fdRng(fLo, 0) + "; next meeting " + fdDate(fK.get(0)) + ": " + fdWord(kA) + " " + p0(pA) + ", " + fdWord(kB) + " " + p0(pB) + (fK.size() > 1 ? "; by " + fdDate(fK.get(fK.size() - 1)) + " " + fdSg(100 * (fE.get(fE.size() - 1) - fBase), "0") + "bp, most likely " + fdRng(fLo, fMK.get(fMK.size() - 1)) + " (" + p0(fMP.get(fMP.size() - 1)) + ")" : "") + "." : "")
            cardRow(hmS, hmS.s2.TF, hmS.s2.tfO, hmS.s1.cFd, "FED", false, mTx, mVl, "", mTip, fDone and math.abs(nz(fSur)) >= 5 ? hmS.s1.cHot : hmS.s1.cTx)
            tcQ(hmS, hmS.s2.TF, 4, hmS.s2.tfO, fDone ? "DONE" : str.upper(fdWord(kA)), fPfg, fPbg, mTip, text.align_center, true)
    true
mapCell(State hmS, int c, int r, string s, color fg, color bg, string tip = "", bool b = false) =>
    hmS.s2.TFM.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = hmS.s1.crdSz, text_halign = text.align_center, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
drawMap(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and not na(hmS.s2.TFM)
        hmS.s2.TFM.clear(0, 0, 10, 16 + hmS.s2.tmO)
        if hmS.s2.tmO == 1
            hmS.s2.TFM.cell(0, 0, "", height = 7.0, bgcolor = #00000000)
        int  today = hmS.s1.calK
        bool aft   = hmS.s1.FO.includes(today) and hmS.s1.mod >= 840
        bool d14   = aft and hmS.s1.fd14K == today
        int  hn    = hmS.s1.fdH.size()
        [S, E, KY]   = fdRates(hmS, hmS.s1.fdZ)
        [S1, E1, K1] = fdRates(hmS, d14 ? hmS.s1.fd14 : hn >= FDN ? hmS.s1.fdH.slice(hn - FDN, hn) : array.new<float>())
        [S5, E5, K5] = fdRates(hmS, hn >= 5 * FDN ? hmS.s1.fdH.slice(hn - 5 * FDN, hn - 4 * FDN) : array.new<float>())
        array<int> up = array.new<int>()
        for i = 0 to FDN - 1
            int ky = KY.get(i)
            if ky % 100 > 0 and (ky > today or (ky == today and not aft)) and not na(S.get(i)) and not na(E.get(i)) and up.size() < hmC.mapN
                up.push(i)
        int r0 = hmS.s2.tmO
        int nc = up.size()
        if nc == 0
            mapCell(hmS, 0, r0, "FED MAP · no CBOT ZQ data", #ffffff, hmC.cMapH)
        else
            float base = S.get(up.get(0))
            float lo0  = math.floor((base + 0.0001) / 0.25) * 0.25
            matrix<float> PM = matrix.new<float>(41, nc, 0.0)
            array<float>  P  = array.new<float>(41, 0.0)
            P.set(20, 1.0)
            int xHi = 20
            int xLo = 20
            for j = 0 to nc - 1
                P := fdStep(P, E.get(up.get(j)) - S.get(up.get(j)))
                for x = 0 to 40
                    PM.set(x, j, P.get(x))
                    if P.get(x) * 100 >= hmC.mapMin
                        xHi := math.max(xHi, x)
                        xLo := math.min(xLo, x)
            xLo := math.max(xLo, xHi - 9)
            [k1, k2, w1, w2] = fdNode(E.get(up.get(0)) - S.get(up.get(0)))
            int    kA  = w1 >= w2 ? k1 : k2
            string tip = "From CBOT 30-day fed funds futures with CME FedWatch's steps (checked on CME's own page for 12 Oct 2026: within 0.06 pp). Cells: the odds (%) of each target range after each meeting, bold = most likely. Below: the expected change from today's rate (bp), its move since " + (d14 ? "13:59" : "yesterday's close") + " and over 5 days (bp; up = cuts priced out), and the market against the Fed's dot-plot median (SEP " + hmC.sepAs + ") at each year's last meeting. TradingView delays CBOT data without a subscription."
            mapCell(hmS, 0, r0, "FED MAP · " + fdDate(KY.get(up.get(0))) + " " + str.upper(fdWord(kA)) + " " + p0(math.max(w1, w2)) + " · now " + fdRng(lo0, 0), #ffffff, hmC.cMapH, tip, true)
            hmS.s2.TFM.merge_cells(0, r0, nc, r0)
            int rB = r0 + 3 + xHi - xLo                                 // first row under the ranges
            for j = 0 to nc - 1
                int   i   = up.get(j)
                int   yr  = int(KY.get(i) / 10000)
                bool  eoy = j < nc - 1 ? int(KY.get(up.get(j + 1)) / 10000) != yr : int(KY.get(i) / 100) % 100 == 12
                float sep = yr == hmC.sepY ? hmC.sep1 : yr == hmC.sepY + 1 ? hmC.sep2 : yr == hmC.sepY + 2 ? hmC.sep3 : na
                bool  dt  = eoy and not na(sep)
                float bx  = 0.0
                for x = xLo to xHi
                    bx := math.max(bx, PM.get(x, j))
                mapCell(hmS, j + 1, r0 + 1, fdDate(KY.get(i)), hmS.s1.cTx, hmS.s2.cBody2, tip, true)
                for x = xHi to xLo
                    float p = PM.get(x, j)
                    bool  v = p >= 0.005
                    mapCell(hmS, j + 1, r0 + 2 + xHi - x, v ? str.tostring(100 * p, "0") : "·", p >= 0.45 ? #ffffff : v ? hmS.s1.cTx : hmS.s1.cMu, v ? color.from_gradient(p, 0.0, 0.7, hmC.cHtLo, hmC.cHtHi) : hmS.s2.cBody, fdDate(KY.get(i)) + " · " + fdRng(lo0, x - 20) + ": " + str.tostring(100 * p, "0.0") + "%", v and p == bx)
                float c1 = 100 * (E.get(i) - E1.get(i))
                float c5 = 100 * (E.get(i) - E5.get(i))
                mapCell(hmS, j + 1, rB, fdSg(100 * (E.get(i) - base), "0"), hmS.s1.cTx, hmS.s2.cBody2, tip, true)
                mapCell(hmS, j + 1, rB + 1, fdSg(c1, "0.0"), na(c1) or math.abs(c1) < 0.5 ? hmS.s1.cMu : c1 > 0 ? hmS.s1.cHot : hmS.s1.cCold, hmS.s2.cBody, tip)
                mapCell(hmS, j + 1, rB + 2, fdSg(c5, "0.0"), na(c5) or math.abs(c5) < 0.5 ? hmS.s1.cMu : c5 > 0 ? hmS.s1.cHot : hmS.s1.cCold, hmS.s2.cBody, tip)
                mapCell(hmS, j + 1, rB + 3, dt ? fdSg(100 * (E.get(i) - sep), "0") : "", hmS.s1.cTx, hmS.s2.cBody, dt ? "Fed dot plot (SEP " + hmC.sepAs + "): median end-" + str.tostring(yr) + " rate " + str.tostring(sep, "0.000") + "%. The market prices " + str.tostring(E.get(i), "0.000") + "% after " + fdDate(KY.get(i)) + ": " + fdSg(100 * (E.get(i) - sep), "0") + "bp against the Fed's own median." : tip)
            for x = xHi to xLo
                bool cur = x == 20
                mapCell(hmS, 0, r0 + 2 + xHi - x, fdRng(lo0, x - 20) + (cur ? " ◀" : "  "), cur ? hmC.cMapC : hmS.s1.cTx, hmS.s2.cBody2, tip, cur)
            mapCell(hmS, 0, r0 + 1, "RANGE", hmS.s1.cMu, hmS.s2.cBody2, tip)
            mapCell(hmS, 0, rB, "EXP bp", hmS.s1.cMu, hmS.s2.cBody2, tip)
            mapCell(hmS, 0, rB + 1, d14 ? "Δ 13:59" : "Δ 1D", hmS.s1.cMu, hmS.s2.cBody2, tip)
            mapCell(hmS, 0, rB + 2, "Δ 5D", hmS.s1.cMu, hmS.s2.cBody2, tip)
            mapCell(hmS, 0, rB + 3, "vs DOTS", hmS.s1.cMu, hmS.s2.cBody2, tip)
    true
zIdx(float p) => na(p) ? 1 : p >= 0.75 ? 2 : p <= 0.25 ? 0 : 1
zWd(int z) => z == 2 ? "PREM" : z == 0 ? "DISC" : "MID"
sgP(float v) => na(v) ? "—" : str.tostring(v, "0")
sgS(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), "0")
hl(State hmS, int i) => "H" + str.tostring(hmS.s1.VS.get(i), "0") + " L" + str.tostring(hmS.s1.VS.get(i + 1), "0")
liveTx(float sv, float dv) => na(sv) ? "—" : sgS(sv) + " · DXY " + (na(dv) ? "—" : vzAr(dv) + str.tostring(math.abs(dv), "0.00"))
dxPill(State hmS, float dv, float sv, float thr) =>
    bool ok  = not (na(dv) or na(sv) or dv == 0 or sv == 0)
    bool big = ok and math.abs(dv) >= thr
    bool oth = ok and math.sign(dv) != math.sign(sv)
    [not ok ? "—" : (oth ? "⇄" : "⇉") + (big ? " BIG" : ""), big ? #ffffff : hmS.s1.cTx, not ok ? hmS.s2.cBody : big ? (oth ? hmS.s1.cOk : hmS.s1.cWarn) : hmS.s2.cNeu]
drawSg(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV)
        int    today = hmS.s1.calK
        string dot   = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        bool   fz    = not na(hmS.s1.k59) and hmS.s1.k59 == hmS.s1.calK
        [lp, lm, ld, ls, la, lx] = ctxOf(hmS, hmF, close, hmS.s1.tdH, hmS.s1.tdL, hmF.dxL)
        float  p   = fz ? hmS.s1.cxP : lp
        float  m   = fz ? hmS.s1.cxM : lm
        float  d   = fz ? hmS.s1.cxD : ld
        float  s   = fz ? hmS.s1.cxS : ls
        float  a   = fz ? hmS.s1.cxA : la
        float  x   = fz ? hmS.s1.cxX : lx
        int    z   = zIdx(p)
        int    oc  = na(p) ? na : math.min(8, int(math.floor(p * 8)) + 1)
        int    mo3 = na(m) ? 1 : m > 1 ? 0 : m < -1 ? 2 : 1                   // over · near · under the month's open
        int    pg  = na(d) ? 1 : d > 0 ? 0 : d < 0 ? 2 : 1                    // above PDH · inside · below PDL
        int    sg  = na(s) ? 1 : s > 0.4 ? 0 : s < -0.4 ? 2 : 1               // strong up · within · strong down
        int    nxF = nextOf(hmS.s1.FO, today)
        int    ddF = na(nxF) ? na : inDays(nxF, today)
        int    mk  = hmS.s1.vzF ? today : nxF
        bool   sep = not na(mk) and (int(mk / 100) % 100) % 3 == 0
        float  e1  = hmS.s1.VS.get(sep ? 0 : 2) * a
        float  e2  = hmS.s1.VS.get(4 + 2 * z) * a
        bool   st  = hmS.s1.vzK == hmS.s1.calK
        bool   in2 = st and not na(hmS.s1.s30O)
        float  sv1 = st and not na(hmS.s1.s14O) ? (na(hmS.s1.s1C) ? close : hmS.s1.s1C) - hmS.s1.s14O : na
        float  sv2 = in2 ? (na(hmS.s1.s2C) ? close : hmS.s1.s2C) - hmS.s1.s30O : na
        float  dv1 = st and not na(hmS.s1.x14) and hmF.dxA > 0 ? ((na(hmS.s1.x1C) ? hmF.dxL : hmS.s1.x1C) - hmS.s1.x14) / hmF.dxA : na
        float  dv2 = in2 and not na(hmS.s1.x30) and hmF.dxA > 0 ? ((na(hmS.s1.x2C) ? hmF.dxL : hmS.s1.x2C) - hmS.s1.x30) / hmF.dxA : na
        float  r1  = na(sv1) or not (e1 > 0) ? na : math.abs(sv1) / e1
        float  r2  = na(sv2) or not (e2 > 0) ? na : math.abs(sv2) / e2
        [t1, f1, b1] = dxPill(hmS, dv1, sv1, 0.25)
        [t2, f2, b2] = dxPill(hmS, dv2, sv2, 0.5)
        color  pfg = hmS.s1.vzF ? hmC.cGh : #ffffff
        color  pbg = hmS.s1.vzF ? #ffffff : color.new(#000000, 55)
        string mTp = "Price at " + (na(p) ? "—" : p0(p)) + " of the month's range so far (" + (fz ? "13:59" : "live") + "). " + hmS.s1.VZT_MON
        string oTp = "Month's open " + pf(hmF.mtO) + ": " + fdSg(m, "0.0") + " ADR (" + sgS(m * a) + " pts). " + hmS.s1.VZT_MO
        string pdT = na(d) ? "prior day —" : d > 0 ? "above PDH " + sgS(d * a) : d < 0 ? "below PDL " + sgS(d * a) : "inside prior day"
        string gNw = not na(hmS.s2.gfT) ? "filled " + str.format_time(hmS.s2.gfT, "HH:mm", TZ) : hmS.s1.tgKey == hmS.s1.calK and not na(hmS.s1.gapPC) ? "open · " + str.tostring(math.abs(close - hmS.s1.gapPC), "0") + " to go" : "from 09:30"
        string d4  = na(x) ? "" : "S2▲" + (x > 0 ? "27%" : hmS.s1.isES ? "61%" : "65%")
        int    r   = hmS.s2.tvO
        if not hmS.s2.mob
            cardHead(hmS, hmS.s2.TV, r, hmC.cGh, dot + " FOMC STAGES · " + hmS.s1.symTag, hmS.s1.VZT_HD, hmS.s1.vzF ? "TODAY" : na(ddF) ? "—" : "IN " + str.tostring(ddF) + "D", pfg, pbg)
            cardSub(hmS, hmS.s2.TV, r + 1, hmC.cGh, fz ? "SETUP AT 13:59" : "SETUP · LIVE", "ADR", "")
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "MONTH", false, octBar(oc) + " " + (na(p) ? "—" : p0(p)), "", "", mTp)
            tcQ(hmS, hmS.s2.TV, 4, r + 2, zWd(z), z == 1 ? hmS.s1.cTx : #ffffff, z == 2 ? hmS.s2.cPrem : z == 0 ? hmS.s2.cDisc : hmS.s2.cNeu, mTp, text.align_center, true)
            cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "MO", false, "vs month open " + sgS(m * a), fdSg(m, "0.0"), "", oTp)
            tcQ(hmS, hmS.s2.TV, 4, r + 3, mo3 == 0 ? "OVER" : mo3 == 2 ? "UNDER" : "NEAR", mo3 == 1 ? hmS.s1.cTx : #ffffff, mo3 == 0 ? hmS.s1.cHot : mo3 == 2 ? hmS.s1.cCold : hmS.s2.cNeu, oTp, text.align_center, true)
            cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, "PD", false, pdT, pg == 1 ? "" : fdSg(d, "0.0"), hl(hmS, 16 + 2 * pg), "Against the prior trading day's high (PDH) and low (PDL). " + hmS.s1.VZT_PD, na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 5, hmC.cGh, "18:00", false, "since 18:00 " + sgS(s * a), fdSg(s, "0.0"), hl(hmS, 22 + 2 * sg), hmS.s1.VZT_18, sg == 0 ? hmS.s2.cDisc : sg == 2 ? hmS.s2.cPrem : na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 6, hmS.s2.cDxc, "DXY 4W", false, "DXY 4 weeks " + vzAr(x), fdSg(x, "0.0"), d4, hmS.s1.VZT_D4, na, hmS.s1.cSub)
            cardSub(hmS, hmS.s2.TV, r + 7, hmC.cGh, "EXPECT · ADR " + sgP(a), "med", "80%")
            cardRow(hmS, hmS.s2.TV, r + 8, hmC.cGh, "S1", hmS.s1.isES and sep, "14:00–14:30" + (sep ? " · SEP" : ""), "±" + sgP(e1), "±" + sgP(hmS.s1.VS.get(sep ? 1 : 3) * a), hmS.s1.VZT_E1)
            cardRow(hmS, hmS.s2.TV, r + 9, hmC.cGh, "S2", false, "14:30–16:14 · " + zWd(z), "±" + sgP(e2), "±" + sgP(hmS.s1.VS.get(5 + 2 * z) * a), VZT_E2)
            cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "RANGE", false, "after 14:00 · " + zWd(z), sgP(hmS.s1.VS.get(10 + 2 * z) * a), sgP(hmS.s1.VS.get(11 + 2 * z) * a), VZT_E2)
            if not hmS.s1.isES
                cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "EDGE", false, "none held on NQ", "", "", "No 13:59 setup held on NQ in both 2018–24 and 2025–26. Closest: premium, range after 14:00 0.74 vs 0.99 ADR (p 0.08); above PDH, new low after 14:00 28% vs 59% (p 0.02, flipped in 2025–26); strong up since 18:00, new low 22% vs 61% (p 0.005, flipped). NQ's tested information is in the sizes above and the DXY rows.")
            else if z == 2
                cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "EDGE", true, "up 14:00 → 16:14", "65%", "36%", "ES, held: in the month's premium at 13:59 (n 34) the 16:14 close finished above the 14:00 price on 65% of FOMC days vs 36% of the others (2018–24 69% vs 36%; 2025–26 40% vs 38%, barely; p 0.02). The only direction result that held, and only on ES.")
            else if z == 0
                cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "EDGE", true, "new low after 14:00", "100%", "58%", "ES, held: in the month's discount at 13:59 every FOMC day (7 of 7, 2 in 2025–26) made a new day low after 14:00 vs 58% of the others (p 0.03). Small sample.")
            if hmS.s1.isES and mo3 == 0
                cardRow(hmS, hmS.s2.TV, r + 12, hmC.cGh, "EDGE", true, "range after 14:00", sgP(0.67 * a), sgP(1.12 * a), "ES, held: more than 1 ADR over the month's open at 13:59 (n 33) the range after 14:00 ran 0.67 vs 1.12 ADR (2018–24 0.69 vs 1.18, 2025–26 0.63 vs 0.74; p 0.001) and |stage 2| 0.25 vs 0.53 (p 0.004). Value: this setup at today's ADR20; right: the others.")
            else if hmS.s1.isES and mo3 == 2
                cardRow(hmS, hmS.s2.TV, r + 12, hmC.cGh, "EDGE", true, "next NY AM up", "88%", "43%", "ES, held: more than 1 ADR under the month's open at 13:59 (n 8) the next day's NY AM (09:30 → 11:00) closed up 88% vs 43% (2018–24 80%, 2025–26 3 of 3; p 0.02). Small sample.")
            else if hmS.s1.isES and z == 1
                cardRow(hmS, hmS.s2.TV, r + 12, hmC.cGh, "EDGE", false, "none held here", "", "", "ES results that held need a month premium or discount, or price more than 1 ADR from the month's open, at 13:59. Today's setup is in the middle on both.")
            if hmS.s1.vzF
                cardSub(hmS, hmS.s2.TV, r + 13, hmS.s2.cDxc, "LIVE · vs DXY", "×typ", "DXY")
                cardRow(hmS, hmS.s2.TV, r + 14, hmC.cGh, "S1", false, st ? liveTx(sv1, dv1) : "from 14:00", na(r1) ? "" : x2(r1), "", VZT_LV, nz(r1) >= 1 ? hmS.s1.cHot : na)
                tcQ(hmS, hmS.s2.TV, 4, r + 14, t1, f1, b1, VZT_LV, text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 15, hmC.cGh, "S2", false, in2 ? liveTx(sv2, dv2) : "from 14:30", na(r2) ? "" : x2(r2), "", VZT_LV, nz(r2) >= 1 ? hmS.s1.cHot : na)
                tcQ(hmS, hmS.s2.TV, 4, r + 15, t2, f2, b2, VZT_LV, text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 16, hmS.s2.cDxc, "DXY ⇄", true, "big DXY → other way", in2 ? hmS.s1.VZV_D2 : hmS.s1.VZV_D1, in2 ? "73%" : hmS.s1.VZB_D1, hmS.s1.VZT_DR)
                cardRow(hmS, hmS.s2.TV, r + 17, hmC.cGh, "GAP", true, "gap " + gNw, hmS.s1.VZV_GF, hmS.s1.VZB_GF, hmS.s1.VZT_GF)
        else
            cardHead(hmS, hmS.s2.TV, r, hmC.cGh, dot + " STAGES · " + hmS.s1.symTag, hmS.s1.VZT_HD, hmS.s1.vzF ? "TODAY" : na(ddF) ? "—" : str.tostring(ddF) + "D", pfg, pbg)
            cardRow(hmS, hmS.s2.TV, r + 1, hmC.cGh, "MO", false, octBar(oc) + " " + zWd(z), fdSg(m, "0.0"), na(p) ? "—" : p0(p), mTp + " " + oTp, mo3 == 0 ? hmS.s1.cHot : mo3 == 2 ? hmS.s1.cCold : na)
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "EXP", hmS.s1.isES and sep, "S1 ±" + sgP(e1) + " S2 ±" + sgP(e2), sgP(hmS.s1.VS.get(10 + 2 * z) * a), "rng", hmS.s1.VZT_E1 + " " + VZT_E2)
            cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "PD", false, (pg == 0 ? "> PDH " : pg == 2 ? "< PDL " : "in PD ") + hl(hmS, 16 + 2 * pg), pg == 1 ? "" : fdSg(d, "0.0"), "", hmS.s1.VZT_PD)
            if hmS.s1.vzF
                cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, in2 ? "S2" : "S1", false, in2 ? liveTx(sv2, dv2) : st ? liveTx(sv1, dv1) : "from 14:00", na(in2 ? r2 : r1) ? "" : x2(in2 ? r2 : r1), "", VZT_LV)
                tcQ(hmS, hmS.s2.TV, 4, r + 4, in2 ? t2 : t1, in2 ? f2 : f1, in2 ? b2 : b1, VZT_LV, text.align_center, true)
                cardRow(hmS, hmS.s2.TV, r + 5, hmS.s2.cDxc, "DXY", true, "big → other way", in2 ? hmS.s1.VZV_D2 : hmS.s1.VZV_D1, "", hmS.s1.VZT_DR)
                cardRow(hmS, hmS.s2.TV, r + 6, hmC.cGh, "GAP", true, gNw, hmS.s1.VZV_GF, hmS.s1.VZB_GF, hmS.s1.VZT_GF)
            else
                cardRow(hmS, hmS.s2.TV, r + 4, hmS.s2.cDxc, "DXY 4W", false, "DXY 4w " + vzAr(x) + " " + d4, fdSg(x, "0.0"), "", hmS.s1.VZT_D4)
    true
cardFlush(State hmS) =>
    if hmS.s2.CQ.size() > 0
        for q in hmS.s2.CQ
            table t = q.t
            int   r = q.r
            switch q.k
                0 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, q.b ? #ffffff : hmS.s1.cMu, q.b ? hmS.s1.cOk : hmS.s2.cBody, q.tip, text.align_center, q.b)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cTx, hmS.s2.cBody, q.tip)
                    tc(hmS, t, 3, r, q.s3, na(q.f1) ? hmS.s1.cTx : q.f1, hmS.s2.cBody, q.tip, text.align_center, true)
                    tc(hmS, t, 4, r, q.s4, na(q.f2) ? hmS.s1.cMu : q.f2, hmS.s2.cBody, q.tip, text.align_center)
                1 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, #ffffff, q.col, q.tip, text.align_left, true)
                    tc(hmS, t, 4, r, q.s4, q.f1, q.f2, "", text.align_center, true)
                2 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, "", hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 3, r, q.s3, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                    tc(hmS, t, 4, r, q.s4, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                3 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, hmS.s1.cMu, hmS.s2.cBody, "", text.align_center)
                    tc(hmS, t, 2, r, q.s2, q.f1, hmS.s2.cBody, q.tip)
                4 =>
                    tc(hmS, t, q.c, r, q.s1, q.f1, q.f2, q.tip, q.ha, q.b)
                =>
                    stripe(t, r, q.col)
        hmS.s2.CQ.clear()
    true

// ═══════════════════════════════════════════════════════════════ Steps (Hueco Mundo calls them in order on every bar)
// @function Step 1: Today, live
export step1(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s2.calK_1 := hmS.s1.calK
    hmS.s2.iwin_1 := hmS.s1.iwin
    hmS.s2.key_1 := hmS.s1.key
    hmS.s2.mod_1 := hmS.s1.mod
    hmS.s2.tdH_1 := hmS.s1.tdH
    hmS.s2.tdK_1 := hmS.s1.tdK
    hmS.s2.tdL_1 := hmS.s1.tdL
    hmS.s1.clkOn := hmC.paneI == "Clock + Fed map" or hmC.paneI == "Event clock"
    hmS.s1.showMap := hmC.paneI == "Clock + Fed map" or hmC.paneI == "Fed map"
    hmS.s1.AN := hmC.anchorI == "Trading day (18:00)" ? 0 : hmC.anchorI == "NY midnight" ? 1 : 2
    hmS.s1.isES := syminfo.root == "ES" or syminfo.root == "MES"
    hmS.s1.isNQ := syminfo.root == "NQ" or syminfo.root == "MNQ"
    hmS.s1.symR := hmS.s1.isES ? "ES" : "NQ"                           // whose statistics the cards show
    hmS.s1.symTag := hmS.s1.isNQ or hmS.s1.isES ? syminfo.root : syminfo.root + " (" + hmS.s1.symR + " DATA)"
    if barstate.isfirst
        hmS.s1.FO := parseDates(S_FOMC)
    if barstate.isfirst
        hmS.s1.CP := parseDates(S_CPI)
    if barstate.isfirst
        hmS.s1.NP := parseDates(S_NFP)
    if barstate.isfirst
        hmS.s1.CK := unpackMilli(hmS.s1.isES ? CK_ES : CK_NQ)
    hmS.s1.bgLum := 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
    hmS.s1.dark := hmC.themeI == "Dark" or (hmC.themeI == "Auto" and hmS.s1.bgLum < 128)
    hmS.s1.cBg := hmS.s1.dark ? #0e1117 : #ffffff
    hmS.s1.cTx := hmS.s1.dark ? #e6e9ef : #131722
    hmS.s1.cSub := hmS.s1.dark ? #9aa3b5 : #4a5163
    hmS.s1.cMu := hmS.s1.dark ? #5d6476 : #9aa1b2
    hmS.s1.cWarn := #ff5252
    hmS.s1.cHot := hmS.s1.dark ? #ff8a65 : #d84315
    hmS.s1.cCold := hmS.s1.dark ? #64b5f6 : #1565c0
    hmS.s1.cOk := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s1.crdSz := hmC.crdSzI == "Tiny" ? size.tiny : hmC.crdSzI == "Small" ? size.small : size.normal
    hmS.s1.tfM := math.max(1, int(timeframe.in_seconds() / 60))
    hmS.s1.mod := hour(time, TZ) * 60 + minute(time, TZ)
    hmS.s1.calK := dateKey(time)
    hmS.s1.key := anchorKey(hmS.s1.AN, time)
    hmS.s1.iwin := inWin(hmS.s1.AN, hmS.s1.mod)
    hmS.s1.dSt := hmS.s1.iwin and (not hmS.s2.iwin_1 or hmS.s1.key != hmS.s2.key_1)
    if hmS.s1.dSt
        hmS.s1.pK := hmS.s1.dK
        hmS.s1.dK := hmS.s1.key
        hmS.s1.dO := open
        hmS.s1.dH := high
        hmS.s1.dL := low
        hmS.s1.dX := bar_index
        hmS.s1.dT := dayType(hmS, hmS.s1.key, hmS.s1.pK)
    else if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dH := math.max(hmS.s1.dH, high)
        hmS.s1.dL := math.min(hmS.s1.dL, low)
    if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dC := close
    hmS.s1.tdK := anchorKey(0, time)
    hmS.s1.tdSt := hmS.s1.tdK != hmS.s2.tdK_1
    if hmS.s1.tdSt
        hmS.s1.tdPK := hmS.s2.tdK_1
        hmS.s1.ptdH := hmS.s1.tdH
        hmS.s1.ptdL := hmS.s1.tdL
        hmS.s1.tdO  := open
        hmS.s1.tdH  := high
        hmS.s1.tdL  := low
        hmS.s1.tdX  := bar_index
    else
        hmS.s1.tdH := math.max(nz(hmS.s1.tdH, high), high)
        hmS.s1.tdL := math.min(nz(hmS.s1.tdL, low), low)
    hmS.s1.rthSt := hmS.s1.mod >= 570 and hmS.s1.mod < 975 and (hmS.s2.mod_1 < 570 or hmS.s2.mod_1 >= 975 or hmS.s1.calK != hmS.s2.calK_1)
    if hmS.s1.rthSt
        hmS.s1.rthO  := open
        hmS.s1.tgKey := hmS.s1.calK
        hmS.s1.tgGap := na(hmS.s1.rthC) ? na : open - hmS.s1.rthC
        hmS.s1.tgPct := na(hmS.s1.rthC) or hmS.s1.rthC == 0 ? na : (open / hmS.s1.rthC - 1) * 100
        hmS.s1.gapPC := hmS.s1.rthC
        hmS.s1.gapCE := na(hmS.s1.rthC) ? na : (hmS.s1.rthC + open) / 2
        hmS.s1.rH    := high
        hmS.s1.rL    := low
    else if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rH := math.max(hmS.s1.rH, high)
        hmS.s1.rL := math.min(hmS.s1.rL, low)
    if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rthC := close
    hmS.s1.mHi := math.max(nz(hmF.mtH, hmS.s1.tdH), hmS.s1.tdH)
    hmS.s1.mLo := math.min(nz(hmF.mtL, hmS.s1.tdL), hmS.s1.tdL)
    hmS.s1.recent := time > timenow - hmC.markD * 86400000
    if barstate.isfirst
        hmS.s1.LTd := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTt := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTr := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTg := array.new<float>()
    if barstate.isfirst
        hmS.s1.LTp := array.new<float>()
    hmS.s1.talEnd := hmS.s1.isES ? TAL_END_ES : hmS.s1.isNQ ? TAL_END_NQ : 0
    hmS
// @function Step 2: Fed odds (CBOT 30-day fed funds futures)
export step2(State hmS, Cfg hmC, Feed hmF) =>
    if hmS.s1.tdSt and not na(hmS.s1.prvTdO) and hmS.s1.prvTdO_k == hmS.s2.tdK_1 and talIs(hmS, hmS.s2.tdK_1, hmS.s1.prvTdPK)
        bool rOk = hmS.s1.tgKey == hmS.s2.tdK_1 and not na(hmS.s1.rthO)
        hmS.s1.LTd.push(hmS.s2.tdK_1)
        hmS.s1.LTt.push(int(math.sign(close[1] - hmS.s1.prvTdO)))
        hmS.s1.LTr.push(rOk ? int(math.sign(hmS.s1.rthC - hmS.s1.rthO)) : 0)
        hmS.s1.LTg.push(rOk ? hmS.s1.tgGap : na)
        hmS.s1.LTp.push(rOk ? hmS.s1.tgPct : na)
    if hmS.s1.tdSt
        hmS.s1.prvTdO   := open
        hmS.s1.prvTdO_k := hmS.s1.tdK
        hmS.s1.prvTdPK  := hmS.s1.tdPK
    if hmS.s1.tdSt
        hmS.s1.dxTdO := hmF.dxL_1
    if barstate.isfirst
        hmS.s1.fdY := year(last_bar_time, TZ)
    if barstate.isfirst
        hmS.s1.fdM := month(last_bar_time, TZ)
    hmS.s1.fdTf := timeframe.isintraday ? timeframe.period : "D"
    if barstate.isfirst
        hmS.s1.fdZp := array.new<float>(FDN, na)
    hmS.s1.fdZ := array.new<float>(FDN, na)
    for i = 0 to FDN - 1
        hmS.s1.fdZ.set(i, hmF.ZQF.get(i))
    if barstate.isfirst
        hmS.s1.fdH := array.new<float>()
    if barstate.isfirst
        hmS.s1.fd14 := array.new<float>(FDN, na)
    if hmS.s1.tdSt and not na(hmS.s1.fdZp.get(2))
        for v in hmS.s1.fdZp
            hmS.s1.fdH.push(v)
        while hmS.s1.fdH.size() > 6 * FDN
            hmS.s1.fdH.shift()
    if hmS.s1.FO.includes(hmS.s1.calK) and hmS.s1.mod >= 840 and (hmS.s2.mod_1 < 840 or hmS.s2.calK_1 != hmS.s1.calK)
        hmS.s1.fd14  := hmS.s1.fdZp.copy()
        hmS.s1.fd14K := hmS.s1.calK
    hmS.s1.fdZp := hmS.s1.fdZ.copy()
    if barstate.isfirst
        hmS.s1.FMD := array.new<int>()
    if barstate.isfirst
        hmS.s1.FND := array.new<int>()
    if barstate.isfirst
        hmS.s1.FKY := array.new<int>()
    if barstate.isfirst
        for i = 0 to FDN - 1
            [y, m] = fdYM(hmS, i)
            int d = fdDay(hmS, y, m)
            hmS.s1.FMD.push(d)
            hmS.s1.FND.push(fdDim(y, m))
            hmS.s1.FKY.push(y * 10000 + m * 100 + d)
    hmS.s1.cFd := hmC.cAcF
    hmS
// @function Step 3: FOMC stages (Vizard)
export step3(State hmS, Cfg hmC, Feed hmF) =>
    if barstate.isfirst
        hmS.s1.VZT_GF := fillT("FOMC morning RTH gap (prior 16:14 close → 09:30 open) traded back through the prior close by 16:14 on {0}% of {1} FOMC days vs {2}% on ordinary days (2018–24 {3}% vs {4}%, 2025–26 {5}% vs {6}%; held). Before 14:00 only {7}% vs {8}%: the extra fills come after the statement. Don't expect the morning gap to stay open.", hmS.s1.isES ? "76|67|60|76|60|77|62|52|56" : "74|68|61|69|62|92|57|56|58")
    if barstate.isfirst
        hmS.s1.VS := parseStats(hmS.s1.isES ? "0.29,0.46,0.10,0.26,0.52,1.08,0.51,0.95,0.29,0.66,1.48,1.76,0.95,1.43,0.77,1.30,93,29,60,74,50,50,83,25,65,69,33,83" : "0.29,0.46,0.08,0.20,0.48,0.90,0.47,0.91,0.29,0.50,1.38,1.46,0.90,1.35,0.74,1.02,83,28,56,61,75,50,78,22,63,63,33,33")
    if barstate.isfirst
        hmS.s1.VZT_HD := "The FOMC decision day in three parts. SETUP: where price stands against the month's range, the month's open, the prior day and the 18:00 open, and DXY's last 4 weeks (live, then fixed at 13:59). EXPECT: how far FOMC days with that setup moved, 2018–26 (67 meetings, " + hmS.s1.symR + " 1-minute data), at today's ADR20. LIVE: today's stages against DXY. Green key = held in 2018–24 and again in 2025–26 (p < 0.05); every other figure describes, it does not signal. No 13:59 feature called the direction after 14:00 (HYDRA: none survived the locked 2025–26 test)."
    if barstate.isfirst
        hmS.s1.VZT_MON := fillT("FOMC days 2018–26 by the month's position at 13:59 (discount = bottom quarter · middle · premium = top quarter; n {0}): |stage 2| median {1} · {2} · {3} ADR, range after 14:00 {4} · {5} · {6} ADR, new day low after 14:00 {7} · {8} · {9}. A stretched month into the statement (discount) came with the biggest reactions, a premium with the smallest. The EXPECT rows use this group.", hmS.s1.isES ? "7 · 26 · 34|0.52|0.51|0.29|1.48|0.95|0.77|100%|62%|56%" : "7 · 29 · 31|0.48|0.47|0.29|1.38|0.90|0.74|71%|52%|45%")
    if barstate.isfirst
        hmS.s1.VZT_MO := hmS.s1.isES ? "Over / under = more than 1 ADR from the month's open at 13:59. ES, held: over it (n 33) |stage 2| ran 0.25 vs 0.53 ADR and the range after 14:00 0.67 vs 1.12; under it (n 8) the next NY AM (09:30–11:00) closed up 88% vs 43%." : "Over / under = more than 1 ADR from the month's open at 13:59. NQ: over it (n 31) |stage 2| ran 0.27 vs 0.47 ADR (p 0.08, not held); under it (n 9) no lean."
    if barstate.isfirst
        hmS.s1.VZT_PD := fillT("Right: how often the day made a new high (H) and a new low (L) after 14:00, FOMC days 2018–26 with price at 13:59 above PDH (n {0}) H {1}% L {2}% · inside the prior day (n {3}) H {4}% L {5}% · below PDL (n {6}) H {7}% L {8}%. Above PDH the day's low usually held (p {9}); too few 2025–26 cases to count as held.", hmS.s1.isES ? "14|93|29|47|60|74|6|50|50|0.003" : "18|83|28|41|56|61|8|75|50|0.02")
    if barstate.isfirst
        hmS.s1.VZT_18 := fillT("Move since the 18:00 open at 13:59, in ADR; strong = beyond ±0.4. Right: new day high (H) and low (L) after 14:00. Strong up (n {0}) H {1}% L {2}% · within (n {3}) H {4}% L {5}% · strong down (n {6}) H {7}% L {8}%. After a strong run into 14:00 the low rarely broke (p {9}); too few 2025–26 cases to count as held.", hmS.s1.isES ? "12|83|25|49|65|69|6|33|83|0.003" : "18|78|22|46|63|63|3|33|33|0.005")
    if barstate.isfirst
        hmS.s1.VZT_D4 := fillT("DXY's change over the last 20 trading days at 13:59, in DXY's ADR20. FOMC days Feb 2023 – Jul 2026 with DXY up over 4 weeks (n 11): stage 2 closed up 27% vs {0}% otherwise (2023–24 29%, 2025–26 25%; p {1}). Consistent, not significant: no ✓. Right: the stage-2 up rate on today's side.", hmS.s1.isES ? "61|0.08" : "65|0.05")
    if barstate.isfirst
        hmS.s1.VZT_E1 := fillT("|Stage 1| (14:00 open → 14:29 close): median and 80th percentile of FOMC days 2018–26 at today's ADR20. SEP meetings (March, June, September, December: new dots and projections) moved {0} vs {1} ADR at the median{2}", hmS.s1.isES ? "0.29|0.10|; held (2018–24 0.33 vs 0.09, 2025–26 0.14 vs 0.11)." : "0.29|0.08| (p < 0.001, but 2025–26 only 0.06: not held).")
    if barstate.isfirst
        hmS.s1.VZT_DR := fillT("{0} against DXY futures in the same window, FOMC days Feb 2023 – Jul 2026. Stage 1 with DXY ≥ 0.25 ADR20: other way {1}% (n {2}; 2023–24 {3}%, 2025–26 {4}%; held) vs {5}% when smaller, and {0}'s |stage 1| ran {6} ADR vs 0.06. Stage 2 with DXY ≥ 0.5 ADR20: {7}% (n {8}; {9}% · {10}%; held) vs 73%. It confirms the move, it does not call it: DXY's first 10 minutes did not lead the rest of the stage, and stage 1 did not predict stage 2.", hmS.s1.isES ? "ES|100|15|100|100|64|0.26|93|14|100|86" : "NQ|86|14|90|75|57|0.25|85|13|100|67")
    hmS.s1.VZV_GF := hmS.s1.isES ? "76%" : "74%"
    hmS.s1.VZB_GF := hmS.s1.isES ? "60%" : "61%"
    hmS.s1.VZV_D1 := hmS.s1.isES ? "100%" : "86%"
    hmS.s1.VZB_D1 := hmS.s1.isES ? "64%" : "57%"
    hmS.s1.VZV_D2 := hmS.s1.isES ? "93%" : "85%"
    hmS.s1.vzF := hmS.s1.FO.includes(hmS.s1.calK)
    if ta.change(time("W")) != 0
        hmS.s1.wkX  := bar_index
        hmS.s1.wkOp := open
    hmS.s1.at14 := hmS.s1.vzF and hmS.s1.mod >= 840 and hmS.s1.mod < 870 and (hmS.s2.mod_1 < 840 or hmS.s2.calK_1 != hmS.s1.calK) and nz(hmS.s1.vzK) != hmS.s1.calK
    if hmS.s1.at14
        hmS.s1.vzK  := hmS.s1.calK
        hmS.s1.s14O := open
        hmS.s1.s14X := bar_index
        hmS.s1.x14  := hmF.dxL_1
        hmS.s1.s30O := na
        hmS.s1.s30X := na
        hmS.s1.s1C  := na
        hmS.s1.s2C  := na
        hmS.s1.x30  := na
        hmS.s1.x1C  := na
        hmS.s1.x2C  := na
        [p_, m_, d_, q_, a_, z_] = ctxOf(hmS, hmF, close[1], hmS.s2.tdH_1, hmS.s2.tdL_1, hmF.dxL_1)
        hmS.s1.k59 := hmS.s1.calK
        hmS.s1.cxP := p_
        hmS.s1.cxM := m_
        hmS.s1.cxD := d_
        hmS.s1.cxS := q_
        hmS.s1.cxA := a_
        hmS.s1.cxX := z_
    hmS.s2.at30 := hmS.s1.vzK == hmS.s1.calK and na(hmS.s1.s30O) and hmS.s1.mod >= 870 and hmS.s1.mod < 975
    if hmS.s2.at30
        hmS.s1.s30O := open
        hmS.s1.s30X := bar_index
        hmS.s1.s1C  := close[1]
        hmS.s1.x30  := hmF.dxL_1
        hmS.s1.x1C  := hmF.dxL_1
    if hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s30O) and na(hmS.s1.s2C) and hmS.s1.mod >= 975
        hmS.s1.s2C := close[1]
        hmS.s1.x2C := hmF.dxL_1
    if hmS.s1.rthSt
        hmS.s2.gfT := na
    if hmS.s1.vzF and hmS.s1.tgKey == hmS.s1.calK and hmS.s1.mod >= 570 and hmS.s1.mod < 975 and na(hmS.s2.gfT) and not na(hmS.s1.gapPC) and hmS.s1.rthO != hmS.s1.gapPC
        if (hmS.s1.rthO > hmS.s1.gapPC and low <= hmS.s1.gapPC) or (hmS.s1.rthO < hmS.s1.gapPC and high >= hmS.s1.gapPC)
            hmS.s2.gfT := time
    hmS.s2.SGR := hmC.layI == "Mobile" ? 7 : 18
    if (barstate.islast and hmC.on) and na(hmS.s2.TV) and hmC.showSg
        hmS.s2.tvO := hmC.sgPos == "Top left" or hmC.sgPos == "Top center" or (hmC.sgPos == "Top right" and hmC.sgOn == "Indicator pane") ? 1 : 0
        if hmC.sgOn == "Price chart"
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
        else
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0)
        if hmS.s2.tvO == 1
            hmS.s2.TV.cell(0, 0, "", height = hmC.sgOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
            hmS.s2.TV.merge_cells(0, 0, 4, 0)
        hmS.s2.TV.merge_cells(1, hmS.s2.tvO, 3, hmS.s2.tvO)
    if barstate.isfirst
        hmS.s2.CN := unpackMilli(hmS.s1.isES ? CONE_ES : CONE_NQ)
    if barstate.isfirst
        hmS.s2.VPC := array.new<polyline>()
    if barstate.isfirst
        hmS.s2.GL := array.new<line>()
    if barstate.isfirst
        hmS.s2.GLE := array.new<int>()
    if barstate.isfirst
        hmS.s2.GT := array.new<label>()
    if barstate.isfirst
        hmS.s2.GTE := array.new<int>()
    hmS
// @function Step 4: Model structure on the price chart
export step4(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s2.vF := hmS.s1.FO.includes(hmS.s1.calK)
    hmS.s2.vOn := hmC.showStr and hmS.s1.recent
    if hmS.s2.vOn and hmS.s1.tdSt and hmS.s1.FO.includes(hmS.s1.tdK) and not na(hmS.s1.ptdH)
        trimL(hmS, line.new(time, hmS.s1.ptdH, keyAt(hmS.s1.tdK, 1019), hmS.s1.ptdH, xloc = xloc.bar_time, color = hmC.cLvl, width = 1, style = line.style_dashed, force_overlay = true), keyAt(hmS.s1.tdK, 1019))
        trimL(hmS, line.new(time, hmS.s1.ptdL, keyAt(hmS.s1.tdK, 1019), hmS.s1.ptdL, xloc = xloc.bar_time, color = hmC.cLvl, width = 1, style = line.style_dashed, force_overlay = true), keyAt(hmS.s1.tdK, 1019))
        trimT(hmS, label.new(keyAt(hmS.s1.tdK, 1019), hmS.s1.ptdH, "D1 high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, tooltip = "FOMC day 1 high (trading day). The decision day took it 67% of the time vs 56% for any next day.", force_overlay = true), keyAt(hmS.s1.tdK, 1019))
        trimT(hmS, label.new(keyAt(hmS.s1.tdK, 1019), hmS.s1.ptdL, "D1 low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, tooltip = "FOMC day 1 low (trading day). The decision day took it 52% of the time vs 44% for any next day.", force_overlay = true), keyAt(hmS.s1.tdK, 1019))
    if hmS.s2.vOn and hmS.s2.vF and hmS.s1.mod <= 840 and hmS.s1.mod + hmS.s1.tfM > 840
        line.new(keyAt(hmS.s1.calK, 840), close, keyAt(hmS.s1.calK, 840), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cLvl, 50), style = line.style_dotted, force_overlay = true)
        trimT(hmS, label.new(keyAt(hmS.s1.calK, 840), high, "statement", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cGh, style = label.style_label_down, size = size.tiny, force_overlay = true), keyAt(hmS.s1.calK, 840))
    if hmS.s2.vOn and hmS.s2.vF and hmS.s1.mod <= 870 and hmS.s1.mod + hmS.s1.tfM > 870
        line.new(keyAt(hmS.s1.calK, 870), close, keyAt(hmS.s1.calK, 870), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cLvl, 50), style = line.style_dotted, force_overlay = true)
        trimT(hmS, label.new(keyAt(hmS.s1.calK, 870), high, "press conf.", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cGh, style = label.style_label_down, size = size.tiny, force_overlay = true), keyAt(hmS.s1.calK, 870))
    if hmS.s2.vOn and hmS.s2.vF and hmS.s1.rthSt and not na(hmS.s1.gapPC)
        trimL(hmS, line.new(time, hmS.s1.gapPC, keyAt(hmS.s1.calK, 974), hmS.s1.gapPC, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 40), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
        trimL(hmS, line.new(time, hmS.s1.gapCE, keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 20), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
        trimT(hmS, label.new(keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, tooltip = "RTH gap 50% = (prior 16:14 close + 09:30 open) ÷ 2. FOMC days filled the full gap 74% of the time vs 63%.", force_overlay = true), keyAt(hmS.s1.calK, 974))
    hmS.s2.bg0 := hmS.s2.vOn and hmS.s2.vF and hmS.s1.mod >= 840 and hmS.s1.mod < 870 ? hmC.cWin : hmS.s2.vOn and hmS.s2.vF and hmS.s1.mod >= 870 and hmS.s1.mod < 975 ? color.new(hmC.cWin, math.min(100, color.t(hmC.cWin) + 4)) : na
    if hmS.s2.vOn and hmC.showWO and hmS.s1.at14
        trimL(hmS, line.new(time, open, keyAt(hmS.s1.calK, 974), open, xloc = xloc.bar_time, color = color.new(hmC.cGh, 15), width = 1, force_overlay = true), keyAt(hmS.s1.calK, 974))
    if hmS.s2.vOn and hmC.showWO and hmS.s2.at30
        trimL(hmS, line.new(time, open, keyAt(hmS.s1.calK, 974), open, xloc = xloc.bar_time, color = color.new(hmC.cGh, 35), width = 1, style = line.style_dashed, force_overlay = true), keyAt(hmS.s1.calK, 974))
    if hmS.s2.vOn and hmC.showSnp and hmS.s1.at14 and hmS.s1.tgKey == hmS.s1.calK and not na(hmS.s1.rthO)
        label.new(bar_index - 1, open, "14:00\n" + vzSg(open - hmS.s1.rthO) + " vs 09:30\n" + vzSg(open - hmS.s1.wkOp) + " vs week open", color = color.new(hmC.cGh, 25), textcolor = #ffffff, style = label.style_label_right, size = size.tiny, tooltip = "Snapshot at the statement (14:00 open), fixed: distance from today's 09:30 open and from the week's open (Sunday 18:00).", force_overlay = true)
    if hmS.s2.vOn and hmC.showSnp and hmS.s2.at30 and hmS.s1.tgKey == hmS.s1.calK and not na(hmS.s1.rthO) and not na(hmS.s1.s14O)
        label.new(bar_index, low, "14:30 · S1 " + vzSg(close[1] - hmS.s1.s14O) + "\n" + vzSg(open - hmS.s1.rthO) + " vs 09:30\n" + vzSg(open - hmS.s1.wkOp) + " vs week open", color = color.new(hmC.cGh, 45), textcolor = #ffffff, style = label.style_label_up, size = size.tiny, tooltip = "Snapshot at the press conference (14:30 open), fixed: stage 1's move (14:00 → 14:29 close), and the distance from today's 09:30 open and from the week's open.", force_overlay = true)
    if hmS.s2.vOn and hmC.showCone and hmS.s1.vzK == hmS.s1.calK and not na(hmS.s1.s14O) and not na(hmF.ADRtd) and hmS.s1.mod >= 975 and hmS.s2.mod_1 < 975
        for cb = 0 to 1
            coneBand(hmS, hmS.s1.calK, hmS.s1.s14O, hmF.ADRtd * hmS.s1.s14O, 1 - cb, 3 - cb, 26, color.new(hmC.cGh, cb == 0 ? 91 : 85), cb == 0 ? color.new(hmC.cGh, 72) : #00000000)
    if hmS.s2.vOn and hmC.showOct and hmS.s1.rthSt and hmS.s2.vF and not na(hmS.s1.gapPC) and hmS.s1.rthO != hmS.s1.gapPC
        float gp = hmS.s1.rthO - hmS.s1.gapPC
        int   te = keyAt(hmS.s1.calK, 660)
        line  l6 = na
        line  l8 = na
        for k = 0 to 8
            line l = trimL(hmS, line.new(time, hmS.s1.gapPC + gp * k / 8, te, hmS.s1.gapPC + gp * k / 8, xloc = xloc.bar_time, color = k == 4 ? hmC.cLvl : k >= 6 ? color.new(hmC.cOq, 10) : color.new(hmC.cLvl, k == 0 ? 30 : 65), style = k == 4 ? line.style_dashed : line.style_dotted, width = k == 4 ? 2 : 1, force_overlay = true), te)
            if k == 6
                l6 := l
            if k == 8
                l8 := l
        linefill.new(l6, l8, hmC.cOq)
        trimT(hmS, label.new(te, hmS.s1.gapPC + gp * 0.875, "open-side ¼", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(hmC.cOq, 0), style = label.style_label_left, size = size.tiny, tooltip = "The quarter of this morning's RTH gap next to the 09:30 open. " + hmS.s1.VZT_GF, force_overlay = true), te)
        trimT(hmS, label.new(te, hmS.s1.gapPC + gp * 0.5, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, tooltip = hmS.s1.VZT_GF, force_overlay = true), te)
    hmS.s2.bg1 := hmS.s2.vOn and hmC.showOct and hmS.s2.vF and hmS.s1.mod >= 570 and hmS.s1.mod < 660 ? color.new(hmC.cOq, math.min(100, color.t(hmC.cOq) + 14)) : na
    if hmS.s2.GL.size() > 0
        for i = hmS.s2.GL.size() - 1 to 0
            int e = hmS.s2.GLE.get(i)
            hmS.s2.GL.get(i).set_x2(math.min(e, time))
            if time >= e
                hmS.s2.GL.remove(i)
                hmS.s2.GLE.remove(i)
    if hmS.s2.GT.size() > 0
        for i = hmS.s2.GT.size() - 1 to 0
            int e = hmS.s2.GTE.get(i)
            hmS.s2.GT.get(i).set_x(math.min(e, time))
            if time >= e
                hmS.s2.GT.remove(i)
                hmS.s2.GTE.remove(i)
    hmS
// @function Step 5: Drawings right of price (rebuilt on the last bar)
export step5(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s2.clkTF := timeframe.isintraday and timeframe.in_seconds() <= 3600
    hmS.s2.clkGo := hmS.s1.clkOn and hmS.s2.clkTF
    hmS.s2.clkR := hmC.clkMet == "Range"
    hmS.s2.mSel := hmS.s2.clkR ? 0 : 1
    if barstate.isfirst
        hmS.s2.ckI := NCK - 1                                     // today's baseline: this event if today is one, else normal
    if hmS.s1.tdSt or barstate.isfirst
        [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
        hmS.s2.ckEv  := now_
        hmS.s2.ckEvI := ownCk(k_)
        hmS.s2.ckI   := now_ ? ownCk(k_) : NCK - 1
    hmS.s2.elM := (hmS.s1.mod - 1080 + 1440) % 1440
    hmS.s2.eEnd := math.min(1380.0, hmS.s2.elM + hmS.s1.tfM)
    hmS.s2.jB := math.min(45, math.max(0, int(math.ceil(hmS.s2.eEnd / 30.0)) - 1))
    hmS.s2.fB := math.max(0.0, math.min(1.0, (hmS.s2.eEnd - 30.0 * hmS.s2.jB) / 30.0))
    hmS.s2.scP := hmS.s1.tdO * hmF.ADRtd
    hmS.s2.vPts := hmS.s2.clkR ? hmS.s1.tdH - hmS.s1.tdL : close - hmS.s1.tdO
    hmS.s2.vAdr := hmS.s2.scP > 0 ? hmS.s2.vPts / hmS.s2.scP : na
    hmS.s2.q25B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 1, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.q75B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.stB := na(hmS.s2.vAdr) ? "" : hmS.s2.vAdr > hmS.s2.q75B ? "Above" : hmS.s2.vAdr < hmS.s2.q25B ? "Below" : "Inside"
    hmS.s2.isTd := anchorKey(0, last_bar_time) == hmS.s1.tdK
    hmS.s2.liveC := hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx
    hmS.s2.p2 := hmS.s2.clkGo and hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s2.pc2 := hmS.s2.liveC
    hmS.s2.p3 := hmS.s2.clkGo and hmC.kPast and not hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s2.pc3 := color.new(hmS.s1.cSub, 75)
    hmS.s2.ckTop := (hmC.showCk and hmC.ckOn == "Indicator pane" and str.startswith(hmC.ckPos, "Top")) or (hmS.s1.showMap and str.startswith(hmC.mapPos, "Top"))
    hmS.s2.hdrm := hmS.s2.clkGo and hmS.s2.scP > 0 ? math.max(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 45), ck(hmS, NCK - 1, hmS.s2.mSel, 4, 45)) * hmS.s2.scP * (hmS.s2.ckTop ? 1.75 : 1.1) : na
    hmS.s2.p4 := hmS.s2.hdrm
    if barstate.isfirst
        hmS.s2.KP := array.new<polyline>()
    if barstate.isfirst
        hmS.s2.KL := array.new<line>()
    if barstate.isfirst
        hmS.s2.KT := array.new<label>()
    drawCore1(hmS, hmC)
    if barstate.isfirst
        hmS.s2.RB := array.new<box>()
    if barstate.isfirst
        hmS.s2.RL := array.new<line>()
    if barstate.isfirst
        hmS.s2.RT := array.new<label>()
    hmS
// @function Step 6: Cards
export step6(State hmS, Cfg hmC) =>
    hmS.s2.cBody := hmS.s1.dark ? #161a23 : #f4f6f9
    hmS.s2.cBody2 := hmS.s1.dark ? #1c2130 : #e9edf3
    hmS.s2.cNeu := hmS.s1.dark ? #3a3f4b : #d1d4dc
    hmS.s2.cDxc := hmC.cAcD
    hmS.s2.cPrem := hmS.s1.dark ? #ef5350 : #d32f2f
    hmS.s2.cDisc := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s2.mob := hmC.layI == "Mobile"
    hmS.s2.EV_N := hmS.s2.mob ? 6 : 8                    // Full: header · sub · DAY · RTH · GAP · WEEK · MONTH · NEXT; Mobile: header · NOW · DAY · GAP · WK · MO
    hmS.s2.FD_N := hmS.s2.mob ? 1 : 8                    // Fed card: header · sub · 2 odds · 3 path · today / 5D; Mobile: one row
    if (barstate.islast and hmC.on)
        if hmC.showEv and na(hmS.s2.TS)
            hmS.s2.tsO := gapOf("Price chart", hmC.crdPos) ? 1 : 0
            hmS.s2.TS  := table.new(posOf(hmC.crdPos), SC, hmS.s2.EV_N + hmS.s2.tsO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if hmS.s2.tsO == 1
                hmS.s2.TS.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                hmS.s2.TS.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TS.merge_cells(1, hmS.s2.tsO, 3, hmS.s2.tsO)
            if not hmS.s2.mob
                hmS.s2.TS.merge_cells(2, hmS.s2.tsO + hmS.s2.EV_N - 1, SC - 1, hmS.s2.tsO + hmS.s2.EV_N - 1)
        if hmC.showFd and na(hmS.s2.TF)
            hmS.s2.tfO := gapOf("Price chart", hmC.fdPos) ? 1 : 0
            hmS.s2.TF  := table.new(posOf(hmC.fdPos), SC, hmS.s2.FD_N + hmS.s2.tfO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if hmS.s2.tfO == 1
                hmS.s2.TF.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                hmS.s2.TF.merge_cells(0, 0, SC - 1, 0)
            if not hmS.s2.mob
                hmS.s2.TF.merge_cells(1, hmS.s2.tfO, 3, hmS.s2.tfO)
        if hmC.showCk and na(hmS.s2.TK)
            hmS.s2.tkO := gapOf(hmC.ckOn, hmC.ckPos) ? 1 : 0
            if hmC.ckOn == "Price chart"
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            else
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0)
            if hmS.s2.tkO == 1
                hmS.s2.TK.cell(0, 0, "", height = hmC.ckOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
                hmS.s2.TK.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TK.merge_cells(1, hmS.s2.tkO, 3, hmS.s2.tkO)
    if barstate.isfirst
        hmS.s2.CQ := array.new<CRow>()
    if barstate.isfirst
        hmS.s2.TEd := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEt := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEr := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEg := array.new<float>()
    if barstate.isfirst
        hmS.s2.TEp := array.new<float>()
    if barstate.isfirst
        string src = hmS.s1.isES ? TAL_ES : hmS.s1.isNQ ? TAL_NQ : ""
        if src != ""
            for rec in str.split(src, ";")
                array<string> f = str.split(rec, ",")
                if f.size() >= 3
                    hmS.s2.TEd.push(int(str.tonumber(f.get(0))))
                    hmS.s2.TEt.push(int(str.tonumber(f.get(1))))
                    hmS.s2.TEr.push(int(str.tonumber(f.get(2))))
                    hmS.s2.TEg.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
                    hmS.s2.TEp.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)
    hmS
// @function Step 7: Write the queued card cells, in the order they were queued
export step7(State hmS, Cfg hmC, Feed hmF) =>
    drawCore2(hmS, hmC, hmF)
    drawCore2B(hmS, hmC, hmF)
    drawLast1(hmS, hmC, hmF)
    drawLast2(hmS, hmC, hmF)
    if (barstate.islast and hmC.on) and na(hmS.s2.TFM) and hmS.s1.showMap
        hmS.s2.tmO := gapOf("Indicator pane", hmC.mapPos) ? 1 : 0
        hmS.s2.TFM := table.new(posOf(hmC.mapPos), 11, 17 + hmS.s2.tmO, bgcolor = #00000000, frame_width = 0, border_color = chart.bg_color, border_width = 1)
    drawMap(hmS, hmC)
    drawSg(hmS, hmC, hmF)
    cardFlush(hmS)
    hmS
// @function The day this module's cards read (yyyymmdd): today's trading day when it is one of its days, else the next.
export nextDay(State hmS) =>
    [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
    d_

// @function A new, empty State with all its parts. Hold it with var.
export newState() =>
    State.new(StatePart1.new(), StatePart2.new())

plot(na, "Hueco Mundo module", display = display.none)
