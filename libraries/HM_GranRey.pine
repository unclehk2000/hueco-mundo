// @type Everything the module keeps from bar to bar, in parts. Make one with newState().
export type State
    StatePart1 s1
    StatePart2 s2
    StatePart3 s3

// ═══════════════════════════════════════════════════════════════ Functions
parseDates(string s) =>
    array<int> out = array.new<int>()
    for p in str.split(s, ",")
        out.push(int(str.tonumber(p)))
    out
parseStats(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p))
    out
parseMilli(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p) / 1000.0)
    out
_ld_ST(State hmS) => parseStats(hmS.s1.isES ? (hmS.s1.AN == 0 ? ES_TD : hmS.s1.AN == 1 ? ES_MID : ES_RTH) : (hmS.s1.AN == 0 ? NQ_TD : hmS.s1.AN == 1 ? NQ_MID : NQ_RTH))
_ld_CK(State hmS) => parseMilli(hmS.s1.isES ? CK_ES : CK_NQ)
sv(State hmS, int ty, int f) => hmS.s1.ST.get(ty * NF + f)
ck(State hmS, int i, int m, int k, int j) => hmS.s1.CK.get(i * CKB + m * 230 + k * 46 + j)
ckSh(State hmS, int i, int j) => hmS.s1.CK.get(i * CKB + 460 + j)
ckAt(State hmS, int i, int m, int k, int j, float f) =>
    float b  = ck(hmS, i, m, k, j)
    float a0 = j > 0 ? ck(hmS, i, m, k, j - 1) : 0.0
    a0 + (b - a0) * f
ckShAt(State hmS, int i, int j, float f) =>
    float b  = ckSh(hmS, i, j)
    float a0 = j > 0 ? ckSh(hmS, i, j - 1) : 0.0
    a0 + (b - a0) * f
lsOf(string s) => s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed
posOf(string s) =>
    switch s
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
keyTime(int k) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, 12, 0)
keyAt(int k, int m) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, int(m / 60), m % 60)
addDays(int k, int n) => dateKey(keyTime(k) + n * 86400000)
anchorKey(int an, int t) => an == 0 ? dateKey(t + 6 * 3600000) : dateKey(t)
inWin(int an, int m) => an == 0 ? true : an == 1 ? m < 1020 : m >= 570 and m < 975
winBars(int an) => an == 0 ? 92 : an == 1 ? 68 : 27
pf(float v) => str.tostring(v, format.mintick)
x2(float v) => str.tostring(v, "0.00") + "×"
p0(float v) => str.tostring(v * 100, "0") + "%"
fmtDay(int k) => str.format_time(keyTime(k), "EEE dd MMM", TZ)
dowOf(int k) => dayofweek(keyTime(k), TZ)
hhmm(int m) => (m / 60 < 10 ? "0" : "") + str.tostring(int(m / 60)) + ":" + (m % 60 < 10 ? "0" : "") + str.tostring(m % 60)
stepEnd(int j) => (1080 + 30 * (j + 1)) % 1440
dayType(State hmS, int k, int pk) =>
    int  dw  = dowOf(k)
    bool hol = false
    if dw >= 2 and dw <= 5
        for j = 1 to 6 - dw
            if hmS.s1.NP.includes(addDays(k, j))
                hol := true
    hmS.s1.FO.includes(k) ? 0 : hmS.s1.NP.includes(k) ? 1 : hmS.s1.CP.includes(k) ? 2 : hmS.s1.FO.includes(pk) ? 3 : hmS.s1.FO.includes(addDays(k, 1)) ? 4 : hol ? 5 : 6
typeShort(int ty) =>
    switch ty
        0 => "FOMC"
        1 => "NFP"
        2 => "CPI"
        3 => "FOMC +1"
        4 => "FOMC D1"
        5 => "NFP week"
        => "Normal"
nextOf(array<int> a, int k) =>
    int r = na
    for d in a
        if d >= k
            r := d
            break
    r
inDays(int k, int today) => int(math.round((keyTime(k) - keyTime(today)) / 86400000.0))
whenTxt(int k, int today) =>
    int dd = inDays(k, today)
    fmtDay(k) + (dd == 0 ? " · today" : dd == 1 ? " · tomorrow" : " · in " + str.tostring(dd) + "d")
pctQ(float x, float q10, float q25, float q50, float q75, float q90) =>
    float p = na
    if not na(x) and not na(q10) and not na(q90)
        if x < q10
            p := 5.0
        else if x <= q25
            p := 10.0 + 15.0 * (x - q10) / math.max(q25 - q10, 1e-9)
        else if x <= q50
            p := 25.0 + 25.0 * (x - q25) / math.max(q50 - q25, 1e-9)
        else if x <= q75
            p := 50.0 + 25.0 * (x - q50) / math.max(q75 - q50, 1e-9)
        else if x <= q90
            p := 75.0 + 15.0 * (x - q75) / math.max(q90 - q75, 1e-9)
        else
            p := 95.0
    p
pTxt(float p) => na(p) ? "—" : p <= 5.0 ? "<P10" : p >= 95.0 ? ">P90" : "≈P" + str.tostring(p, "0")
pill(string s) => s == "Above" ? "▲ ABOVE" : s == "Below" ? "▼ BELOW" : s == "Inside" ? "● INSIDE" : "—"
pfName(int k) =>
    switch k
        0 => "M7–8 GRAN REY CERO · CPI 08:30"
        => ""
ownTy(int k) =>
    switch k
        0 => 2
        => 6
chkRows(int k, bool es) =>
    switch k
        0 => es ? "08:30 candle (× ADR)~0.25×~0.03×~Median 08:30 one-minute candle ÷ ADR20: 0.25× on CPI days vs 0.03× on normal days, about 9× (2018–24 7.7×, 2025–26 12.8×).|08:30–09:00 adds (× ADR)~+0.19×~+0.03×~How much the median day range grows in the 08:30–09:00 half hour: +0.19× ADR on CPI days (2018–24 +0.19×, 2025–26 +0.28×) vs +0.03× on normal days.|VIX fell on the day~68%~55%~VIX closed below its prior close on 67 of 98 CPI days (2018–24 67%, 2025–26 74%) vs 55% of normal days, p 0.010. (The 1st-sweep row held on NQ but faded on ES in 2025–26, so it is not shown here.)" : "08:30 candle (× ADR)~0.27×~0.03×~Median 08:30 one-minute candle ÷ ADR20: 0.27× on CPI days vs 0.03× on normal days, about 9× (2018–24 8.4×, 2025–26 10.9×).|08:30–09:00 adds (× ADR)~+0.19×~+0.02×~How much the median day range grows in the 08:30–09:00 half hour: +0.19× ADR on CPI days (2018–24 +0.17×, 2025–26 +0.31×) vs +0.02× on normal days.|1st sweep side won~70%~56%~The first side of the 07:30–08:30 range taken after 08:30; the bigger of the moves from 08:30 went that way on 70% of CPI days vs 56% of normal days (2018–24 70% n79, 2025–26 71% n17, p 0.008).|VIX fell on the day~69%~55%~VIX closed below its prior close on 66 of 96 CPI days (2018–24 67%, 2025–26 76%) vs 55% of normal days, p 0.008: implied volatility tends to come out after the release."
        => ""
chkMax(bool es) => es ? 3 : 4
talIs(State hmS, int k, int pk) => hmS.s1.CP.includes(k)
ownCk(int k) =>
    switch k
        0 => 0
        => 0
ckName(int k) =>
    switch k
        0 => "CPI"
        1 => "Normal"
        => ""
ckN(int k, bool es) =>
    switch k
        0 => es ? "98" : "96"
        1 => es ? "1416" : "1342"
        => ""
ownProfile(State hmS, int tk, int pk, int today) =>
    bool now = hmS.s1.CP.includes(tk)
    int  rf  = na(tk) ? today : math.max(tk, today)
    [0, now, now ? tk : nextOf(hmS.s1.CP, rf)]
ownNext(State hmS, int today) =>
    int n1 = nextOf(hmS.s1.CP, today)
    ["CPI 08:30", n1, "then", na(n1) ? na : nextOf(hmS.s1.CP, addDays(n1, 1))]
done(float v0, float v1, int tc) => not na(tc) and tc <= time ? v0 : v1
idxNm(State hmS, int i) => hmS.s1.famMc ? (i == 0 ? "MNQ" : i == 1 ? "MES" : "M2K") : (i == 0 ? "NQ" : i == 1 ? "ES" : "RTY")
trimL(State hmS, line l, int e) =>
    if e > time
        l.set_x2(time)
        hmS.s1.GL.push(l)
        hmS.s1.GLE.push(e)
    l
trimT(State hmS, label t, int e) =>
    if e > time
        t.set_x(time)
        hmS.s1.GT.push(t)
        hmS.s1.GTE.push(e)
    t
wkPct(float px, float wo) => na(px) or na(wo) or wo == 0 ? na : (px / wo - 1) * 100
wkCell(float p) => na(p) ? "   —    " : (p >= 0 ? "▲" : "▼") + str.tostring(math.abs(p), "0.00") + "%"
padR(string s, int n) => s + str.repeat(" ", math.max(0, n - str.length(s)))
gjRow(State hmS, Feed hmF, string tm) =>
    float a = wkPct(hmF.nqO, hmF.nqW)
    float b = wkPct(hmF.esO, hmF.esW)
    float c = wkPct(hmF.ryO, hmF.ryW)
    bool  ok = not (na(a) or na(b) or na(c))
    int   up = (nz(a) > 0 ? 1 : 0) + (nz(b) > 0 ? 1 : 0) + (nz(c) > 0 ? 1 : 0)
    float lo = math.min(nz(a, 1e9), nz(b, 1e9), nz(c, 1e9))
    string wk = not ok ? "" : lo == a ? idxNm(hmS, 0) : lo == b ? idxNm(hmS, 1) : idxNm(hmS, 2)
    string tg = not ok ? "" : up == 3 ? "all ▲" : up == 0 ? "all ▼" : "SPLIT"
    padR(tm, 7) + padR(wkCell(a), 8) + " " + padR(wkCell(b), 8) + " " + padR(wkCell(c), 8) + " " + padR(tg, 5) + (wk == "" ? "" : " weak " + wk)
gjHead(State hmS) => "vs week open\n" + padR("", 7) + padR(idxNm(hmS, 0), 8) + " " + padR(idxNm(hmS, 1), 8) + " " + padR(idxNm(hmS, 2), 8)
kPath(State hmS, int i, int m, int k, int t0, float sc, color lc, int lw, string ls) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, k, j) * sc))
    polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = lc, line_width = lw, line_style = ls)
kBand(State hmS, int i, int m, int kUp, int kDn, int t0, float sc, color fc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kUp, j) * sc))
    for j = 45 to 0
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kDn, j) * sc))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = #00000000, fill_color = fc)
clearRight(State hmS) =>
    for b in hmS.s2.RB
        b.delete()
    for l in hmS.s2.RL
        l.delete()
    for t in hmS.s2.RT
        t.delete()
    hmS.s2.RB.clear()
    hmS.s2.RL.clear()
    hmS.s2.RT.clear()
pxR(State hmS, int x, float y, string tx, color c) =>
    hmS.s2.RT.push(label.new(x, y, tx, color = #00000000, textcolor = c, style = label.style_label_left, size = hmS.s1.pxSz, force_overlay = true))
pxL(State hmS, int x, float y, string tx, color c) =>
    hmS.s2.RT.push(label.new(x, y, tx, color = #00000000, textcolor = c, style = label.style_label_right, size = hmS.s1.pxSz, force_overlay = true))
drawCandle(State hmS, Cfg hmC, int x, int w, float o, float h, float l, float c) =>
    if not na(o) and not na(h) and not na(l) and not na(c)
        int xm = x + int(w / 2)
        hmS.s2.RL.push(line.new(xm, h, xm, l, color = hmC.cWk, width = 1, force_overlay = true))
        hmS.s2.RB.push(box.new(x, math.max(o, c), x + w, math.min(o, c), border_color = hmC.cWk, border_width = 1, bgcolor = c >= o ? hmC.cUp : hmC.cDn, force_overlay = true))
chip(State hmS, int x, float y, string tx, string tip, bool above) =>
    hmS.s2.RT.push(label.new(x, y, tx, color = hmS.s1.cBg, textcolor = hmS.s1.cTx, style = above ? label.style_label_down : label.style_label_up, size = hmS.s1.chSz, tooltip = tip, text_font_family = font.family_monospace, textalign = text.align_left, force_overlay = true))
gapOf(string on, string p) => p == "Top left" or p == "Top center" or (p == "Top right" and on == "Indicator pane")
tc(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    t.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = hmS.s1.crdSz, text_halign = ha, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
stripe(table t, int r, color col) =>
    t.cell(0, r, "", bgcolor = col, width = 0.25)
cardHead(State hmS, table t, int r, color col, string title, string tip, string pill, color pfg, color pbg) =>
    stripe(t, r, col)
    tc(hmS, t, 1, r, title, #ffffff, col, tip, text.align_left, true)
    tc(hmS, t, 4, r, pill, pfg, pbg, "", text.align_center, true)
cardSub(State hmS, table t, int r, color col, string txt, string a1, string a2) =>
    stripe(t, r, col)
    tc(hmS, t, 1, r, "", hmS.s1.cMu, hmS.s2.cBody2)
    tc(hmS, t, 2, r, txt, hmS.s1.cMu, hmS.s2.cBody2)
    tc(hmS, t, 3, r, a1, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
    tc(hmS, t, 4, r, a2, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
cardRow(State hmS, table t, int r, color col, string key, bool held, string lab, string v, string b, string tip, color vfg = na, color bfg = na) =>
    stripe(t, r, col)
    tc(hmS, t, 1, r, key, held ? #ffffff : hmS.s1.cMu, held ? hmS.s1.cOk : hmS.s2.cBody, tip, text.align_center, held)
    tc(hmS, t, 2, r, lab, hmS.s1.cTx, hmS.s2.cBody, tip)
    tc(hmS, t, 3, r, v, na(vfg) ? hmS.s1.cTx : vfg, hmS.s2.cBody, tip, text.align_center, true)
    tc(hmS, t, 4, r, b, na(bfg) ? hmS.s1.cMu : bfg, hmS.s2.cBody, tip, text.align_center)
cardWide(State hmS, table t, int r, color col, string key, string txt, string tip, color fg) =>
    stripe(t, r, col)
    tc(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, "", text.align_center)
    tc(hmS, t, 2, r, txt, fg, hmS.s2.cBody, tip)
gauge(float frac) =>
    string out = "░░░░░░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 10))
        out := str.repeat("█", k) + str.repeat("░", 10 - k)
    out
gauge5(float frac) =>
    string out = "░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 5))
        out := str.repeat("█", k) + str.repeat("░", 5 - k)
    out
meter(float p) =>
    string out = "──────────"
    if not na(p)
        int k = int(math.round(math.max(0.0, math.min(100.0, p)) / 10.0))
        out := str.repeat("─", k) + "●" + str.repeat("─", 10 - k)
    out
octBar(int o) =>
    string out = ""
    for i = 1 to 8
        out += i == o ? "█" : "░"
    out
octOf(float px, float h, float l) => na(h) or na(l) or h <= l ? na : math.min(8, int(math.floor((px - l) / (h - l) * 8)) + 1)
zoneOf(State hmS, float h, float l) =>
    int    o  = octOf(close, h, l)
    string z  = na(o) ? "—" : o >= 7 ? "PREMIUM" : o <= 2 ? "DISCOUNT" : "EQUILIB."
    color  zb = na(o) ? hmS.s2.cBody : o >= 7 ? hmS.s2.cPrem : o <= 2 ? hmS.s2.cDisc : hmS.s2.cNeu
    color  zf = na(o) or (o > 2 and o < 7) ? hmS.s1.cTx : #ffffff
    [o, z, zb, zf]
zoneTip(int o, float h, float l, string what) =>
    "This " + what + "'s range so far " + pf(l) + " – " + pf(h) + ": price is " + (na(o) ? "—" : p0((close - l) / (h - l))) + " of the way up (octant " + (na(o) ? "—" : str.tostring(o)) + " of 8), " + (na(l) ? "—" : pf(close - l)) + " above the low and " + (na(h) ? "—" : pf(h - close)) + " below the high. Top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount. A locator, not a tested signal."
zoneRow(State hmS, table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(hmS, h, l)
    string tip = zoneTip(o, h, l, what)
    stripe(t, r, col)
    tc(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
    tc(hmS, t, 2, r, octBar(o) + "  O" + (na(o) ? "—" : str.tostring(o)) + " · +" + (na(l) ? "—" : pf(close - l)) + " from low", hmS.s1.cTx, hmS.s2.cBody, tip)
    tc(hmS, t, 3, r, z, zf, zb, tip, text.align_center, true)
    tc(hmS, t, 4, r, na(h) ? "—" : "−" + pf(h - close), hmS.s1.cMu, hmS.s2.cBody, tip + " Right: distance to the " + what + "'s high.", text.align_center)
zoneRowM(State hmS, table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(hmS, h, l)
    string tip = zoneTip(o, h, l, what)
    stripe(t, r, col)
    tc(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
    tc(hmS, t, 2, r, octBar(o) + " O" + (na(o) ? "—" : str.tostring(o)), hmS.s1.cTx, hmS.s2.cBody, tip)
    tc(hmS, t, 3, r, na(o) ? "—" : o >= 7 ? "PREM" : o <= 2 ? "DISC" : "EQ", zf, zb, tip, text.align_center, true)
    tc(hmS, t, 4, r, na(h) ? "—" : "−" + pf(h - close), hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
talAcc(array<float> acc, int t_, int r_, float g_, float p_) =>
    acc.set(0, acc.get(0) + 1)
    acc.set(1, acc.get(1) + (t_ > 0 ? 1 : 0))
    acc.set(2, acc.get(2) + (t_ < 0 ? 1 : 0))
    acc.set(3, acc.get(3) + (r_ > 0 ? 1 : 0))
    acc.set(4, acc.get(4) + (r_ < 0 ? 1 : 0))
    if not na(g_)
        acc.set(5, acc.get(5) + 1)
        acc.set(6, acc.get(6) + g_)
        acc.set(7, acc.get(7) + math.abs(g_))
        acc.set(8, acc.get(8) + (na(p_) ? 0.0 : math.abs(p_)))
        acc.set(9, acc.get(9) + (g_ > 0 ? 1 : 0))
_isfirst_1(State hmS) =>
    string src = hmS.s1.isES ? TAL_ES : hmS.s1.isNQ ? TAL_NQ : ""
    if src != ""
        for rec in str.split(src, ";")
            array<string> f = str.split(rec, ",")
            if f.size() >= 3
                hmS.s2.TEd.push(int(str.tonumber(f.get(0))))
                hmS.s2.TEt.push(int(str.tonumber(f.get(1))))
                hmS.s2.TEr.push(int(str.tonumber(f.get(2))))
                hmS.s2.TEg.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
                hmS.s2.TEp.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)

// ═══════════════════════════════════════════════════════════════ Steps (Hueco Mundo calls them in order on every bar)
// @function Step 1: Today, live
export step1(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s3.calK_1 := hmS.s1.calK
    hmS.s3.inRC_1 := hmS.s2.inRC
    hmS.s3.iwin_1 := hmS.s1.iwin
    hmS.s3.key_1 := hmS.s1.key
    hmS.s3.mod_1 := hmS.s1.mod
    hmS.s3.tdK_1 := hmS.s1.tdK
    hmS.s1.clkOn := hmC.paneI == "Event clock"
    hmS.s1.showFd := false
    hmS.s1.AN := hmC.anchorI == "Trading day (18:00)" ? 0 : hmC.anchorI == "NY midnight" ? 1 : 2
    hmS.s1.isES := syminfo.root == "ES" or syminfo.root == "MES"
    hmS.s1.isNQ := syminfo.root == "NQ" or syminfo.root == "MNQ"
    hmS.s1.symR := hmS.s1.isES ? "ES" : "NQ"                           // whose statistics the cards show
    hmS.s1.symTag := hmS.s1.isNQ or hmS.s1.isES ? syminfo.root : syminfo.root + " (" + hmS.s1.symR + " DATA)"
    if barstate.isfirst
        hmS.s1.FO := parseDates(S_FOMC)
    if barstate.isfirst
        hmS.s1.CP := parseDates(S_CPI)
    if barstate.isfirst
        hmS.s1.NP := parseDates(S_NFP)
    if barstate.isfirst
        hmS.s1.ST := _ld_ST(hmS)
    if barstate.isfirst
        hmS.s1.CK := _ld_CK(hmS)
    hmS.s1.bgLum := 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
    hmS.s1.dark := hmC.themeI == "Dark" or (hmC.themeI == "Auto" and hmS.s1.bgLum < 128)
    hmS.s1.cBg := hmS.s1.dark ? #0e1117 : #ffffff
    hmS.s1.cTx := hmS.s1.dark ? #e6e9ef : #131722
    hmS.s1.cSub := hmS.s1.dark ? #9aa3b5 : #4a5163
    hmS.s1.cMu := hmS.s1.dark ? #5d6476 : #9aa1b2
    hmS.s1.cWarn := #ff5252
    hmS.s1.cHot := hmS.s1.dark ? #ff8a65 : #d84315
    hmS.s1.cCold := hmS.s1.dark ? #64b5f6 : #1565c0
    hmS.s1.cOk := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s1.pxSz := hmC.pxSzI == "Tiny" ? size.tiny : hmC.pxSzI == "Small" ? size.small : size.normal
    hmS.s1.crdSz := hmC.crdSzI == "Tiny" ? size.tiny : hmC.crdSzI == "Small" ? size.small : size.normal
    hmS.s1.chSz := hmC.chSzI == "Tiny" ? size.tiny : hmC.chSzI == "Small" ? size.small : size.normal
    hmS.s1.lbSz := hmC.lblI == "Small" ? size.small : hmC.lblI == "Normal" ? size.normal : size.tiny
    hmS.s1.famOk := syminfo.root == "NQ" or syminfo.root == "ES" or syminfo.root == "RTY" or syminfo.root == "MNQ" or syminfo.root == "MES" or syminfo.root == "M2K"
    hmS.s1.famMc := syminfo.root == "MNQ" or syminfo.root == "MES" or syminfo.root == "M2K"
    hmS.s1.famSx := hmS.s1.famOk ? str.replace(syminfo.ticker, syminfo.root, "") : "1!"
    hmS.s1.famPx := hmS.s1.famOk ? syminfo.prefix : "CME_MINI"
    hmS.s1.vPrev := done(hmF.vC0, hmF.vC1, hmF.vTC)                             // VIX prior close
    hmS.s1.vAvg := done(hmF.vS0, hmF.vS1, hmF.vTC)                             // its 20-day average
    hmS.s1.dxAtr := done(hmF.dA0, hmF.dA1, hmF.dTC)                             // DXY ATR20 of completed days
    hmS.s1.ylPrev := done(hmF.yC0, hmF.yC1, hmF.yTC)
    hmS.s1.tfM := math.max(1, int(timeframe.in_seconds() / 60))
    hmS.s1.mod := hour(time, TZ) * 60 + minute(time, TZ)
    hmS.s1.calK := dateKey(time)
    hmS.s1.key := anchorKey(hmS.s1.AN, time)
    hmS.s1.iwin := inWin(hmS.s1.AN, hmS.s1.mod)
    hmS.s1.dSt := hmS.s1.iwin and (not hmS.s3.iwin_1 or hmS.s1.key != hmS.s3.key_1)
    if hmS.s1.dSt
        hmS.s1.pK := hmS.s1.dK
        hmS.s1.dK := hmS.s1.key
        hmS.s1.dO := open
        hmS.s1.dH := high
        hmS.s1.dL := low
        hmS.s1.dX := bar_index
        hmS.s1.dT := dayType(hmS, hmS.s1.key, hmS.s1.pK)
    else if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dH := math.max(hmS.s1.dH, high)
        hmS.s1.dL := math.min(hmS.s1.dL, low)
    if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dC := close
    hmS.s1.tdK := anchorKey(0, time)
    hmS.s1.tdSt := hmS.s1.tdK != hmS.s3.tdK_1
    if hmS.s1.tdSt
        hmS.s1.tdPK := hmS.s3.tdK_1
        hmS.s1.ptdH := hmS.s1.tdH
        hmS.s1.ptdL := hmS.s1.tdL
        hmS.s1.tdO  := open
        hmS.s1.tdH  := high
        hmS.s1.tdL  := low
        hmS.s1.tdX  := bar_index
    else
        hmS.s1.tdH := math.max(nz(hmS.s1.tdH, high), high)
        hmS.s1.tdL := math.min(nz(hmS.s1.tdL, low), low)
    hmS.s1.rthSt := hmS.s1.mod >= 570 and hmS.s1.mod < 975 and (hmS.s3.mod_1 < 570 or hmS.s3.mod_1 >= 975 or hmS.s1.calK != hmS.s3.calK_1)
    if hmS.s1.rthSt
        hmS.s1.rthO  := open
        hmS.s1.tgKey := hmS.s1.calK
        hmS.s1.tgGap := na(hmS.s1.rthC) ? na : open - hmS.s1.rthC
        hmS.s1.tgPct := na(hmS.s1.rthC) or hmS.s1.rthC == 0 ? na : (open / hmS.s1.rthC - 1) * 100
        hmS.s1.gapPC := hmS.s1.rthC
        hmS.s1.gapCE := na(hmS.s1.rthC) ? na : (hmS.s1.rthC + open) / 2
        hmS.s1.rH    := high
        hmS.s1.rL    := low
    else if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rH := math.max(hmS.s1.rH, high)
        hmS.s1.rL := math.min(hmS.s1.rL, low)
    if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rthC := close
    hmS.s1.recent := time > timenow - hmC.markD * 86400000
    if barstate.isfirst
        hmS.s1.LTd := array.new<int>()
    hmS
// @function Step 2: Model structure on the price chart
export step2(State hmS, Cfg hmC, Feed hmF) =>
    if barstate.isfirst
        hmS.s1.LTt := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTr := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTg := array.new<float>()
    if barstate.isfirst
        hmS.s1.LTp := array.new<float>()
    hmS.s1.talEnd := hmS.s1.isES ? TAL_END_ES : hmS.s1.isNQ ? TAL_END_NQ : 0
    if hmS.s1.tdSt and not na(hmS.s1.prvTdO) and hmS.s1.prvTdO_k == hmS.s3.tdK_1 and talIs(hmS, hmS.s3.tdK_1, hmS.s1.prvTdPK)
        bool rOk = hmS.s1.tgKey == hmS.s3.tdK_1 and not na(hmS.s1.rthO)
        hmS.s1.LTd.push(hmS.s3.tdK_1)
        hmS.s1.LTt.push(int(math.sign(close[1] - hmS.s1.prvTdO)))
        hmS.s1.LTr.push(rOk ? int(math.sign(hmS.s1.rthC - hmS.s1.rthO)) : 0)
        hmS.s1.LTg.push(rOk ? hmS.s1.tgGap : na)
        hmS.s1.LTp.push(rOk ? hmS.s1.tgPct : na)
    if hmS.s1.tdSt
        hmS.s1.prvTdO   := open
        hmS.s1.prvTdO_k := hmS.s1.tdK
        hmS.s1.prvTdPK  := hmS.s1.tdPK
    if hmS.s1.tdSt
        hmS.s1.dxTdO := hmF.dxL_1
    hmS.s1.dxDay := na(hmS.s1.dxTdO) or hmS.s1.dxTdO == 0 ? na : hmF.dxL / hmS.s1.dxTdO - 1
    if hmS.s1.tdSt or na(hmS.s1.dxHi)
        hmS.s1.dxHi := hmF.dxL
        hmS.s1.dxLo := hmF.dxL
    else if not na(hmF.dxL)
        hmS.s1.dxHi := math.max(hmS.s1.dxHi, hmF.dxL)
        hmS.s1.dxLo := math.min(hmS.s1.dxLo, hmF.dxL)
    if barstate.isfirst
        hmS.s1.GL := array.new<line>()
    if barstate.isfirst
        hmS.s1.GLE := array.new<int>()
    if barstate.isfirst
        hmS.s1.GT := array.new<label>()
    if barstate.isfirst
        hmS.s1.GTE := array.new<int>()
    hmS.s1.gCPI := hmS.s1.CP.includes(hmS.s1.calK)
    hmS.s1.gAft := hmS.s1.CP.includes(hmS.s1.tdPK) and not hmS.s1.gCPI                   // the trading day after a CPI day
    hmS.s1.gOn := hmC.showStr and hmS.s1.recent
    hmS.s1.wkd := dayofweek(time, TZ) >= 2 and dayofweek(time, TZ) <= 6
    hmS.s1.drEndM := hmC.drEnd == "11:00" ? 660 : hmC.drEnd == "16:14" ? 974 : 1020
    hmS.s1.swTip := "First side of the pre-CPI range (07:30–08:29) taken after the release. The day's bigger move (from 08:30) went the same way " + (hmS.s1.isES ? "67% of the time vs 56% on normal days, but only 53% in 2025–26 (71% in 2018–24)." : "70% of the time vs 56% on normal days, and 71% in 2025–26.")
    if hmS.s1.gOn and hmS.s1.gCPI
        if hmS.s1.mod >= 450 and hmS.s1.mod < 510
            if nz(hmS.s1.drK) != hmS.s1.calK
                hmS.s1.drK := hmS.s1.calK
                hmS.s1.drH := high
                hmS.s1.drL := low
                hmS.s1.swp := 0
                if hmC.showDR0
                    hmS.s1.p0H  := line.new(time, high, time, high, xloc = xloc.bar_time, color = hmC.cDR0, style = lsOf(hmC.stDR0), force_overlay = true)
                    hmS.s1.p0L  := line.new(time, low, time, low, xloc = xloc.bar_time, color = hmC.cDR0, style = lsOf(hmC.stDR0), force_overlay = true)
                    hmS.s1.p0Ht := label.new(time, high, "pre-CPI high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR0, style = label.style_label_lower_left, size = hmS.s1.lbSz, tooltip = hmS.s1.swTip, force_overlay = true)
                    hmS.s1.p0Lt := label.new(time, low, "pre-CPI low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR0, style = label.style_label_upper_left, size = hmS.s1.lbSz, tooltip = hmS.s1.swTip, force_overlay = true)
                if hmC.showYC and not na(hmS.s1.rthC)
                    trimL(hmS, line.new(keyAt(hmS.s1.calK, 450), hmS.s1.rthC, keyAt(hmS.s1.calK, 974), hmS.s1.rthC, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 25), style = line.style_dotted, width = 1, force_overlay = true), keyAt(hmS.s1.calK, 974))
                    trimT(hmS, label.new(keyAt(hmS.s1.calK, 974), hmS.s1.rthC, "yday RTH close", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(hmC.cLvl, 15), style = label.style_label_left, size = hmS.s1.lbSz, tooltip = "Yesterday's RTH close (16:14 bar): the gap the release opens is measured from here.", force_overlay = true), keyAt(hmS.s1.calK, 974))
            else
                hmS.s1.drH := math.max(hmS.s1.drH, high)
                hmS.s1.drL := math.min(hmS.s1.drL, low)
                if hmC.showDR0 and not na(hmS.s1.p0H)
                    hmS.s1.p0H.set_y1(hmS.s1.drH)
                    hmS.s1.p0H.set_y2(hmS.s1.drH)
                    hmS.s1.p0L.set_y1(hmS.s1.drL)
                    hmS.s1.p0L.set_y2(hmS.s1.drL)
                    hmS.s1.p0Ht.set_y(hmS.s1.drH)
                    hmS.s1.p0Lt.set_y(hmS.s1.drL)
        // the range runs right until the release first takes one of its sides
        if hmC.showDR0 and hmS.s1.drK == hmS.s1.calK and not na(hmS.s1.p0H) and hmS.s1.swp == 0 and hmS.s1.mod >= 450 and hmS.s1.mod < hmS.s1.drEndM
            hmS.s1.p0H.set_x2(time)
            hmS.s1.p0L.set_x2(time)
        if hmS.s1.drK == hmS.s1.calK and hmS.s1.mod >= 510 and hmS.s1.mod < 975 and hmS.s1.swp == 0 and not na(hmS.s1.drH)
            if low < hmS.s1.drL
                hmS.s1.swp := -1
                label.new(bar_index, hmS.s1.drL, "1st sweep ▼", color = #00000000, textcolor = hmC.cDR0, style = label.style_label_upper_right, size = hmS.s1.lbSz, tooltip = hmS.s1.swTip, force_overlay = true)
            else if high > hmS.s1.drH
                hmS.s1.swp := 1
                label.new(bar_index, hmS.s1.drH, "1st sweep ▲", color = #00000000, textcolor = hmC.cDR0, style = label.style_label_lower_right, size = hmS.s1.lbSz, tooltip = hmS.s1.swTip, force_overlay = true)
        if hmS.s1.mod <= 530 and hmS.s1.mod + hmS.s1.tfM > 530
            line.new(keyAt(hmS.s1.calK, 530), close, keyAt(hmS.s1.calK, 530), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cLvl, 60), style = line.style_dotted, force_overlay = true)
        if hmS.s1.rthSt and not na(hmS.s1.gapCE)
            trimL(hmS, line.new(time, hmS.s1.gapCE, keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 20), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
            trimT(hmS, label.new(keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = size.tiny, tooltip = "RTH gap 50% = (yesterday's RTH close + 09:30 open) ÷ 2", force_overlay = true), keyAt(hmS.s1.calK, 974))
    hmS.s1.inW := hmS.s1.mod < 540 and hmS.s1.mod + hmS.s1.tfM > 510
    hmS.s1.winShow := hmS.s1.gOn and hmS.s1.wkd and timeframe.isintraday and (hmC.winDays == "Every weekday" or hmS.s1.gCPI or (hmS.s1.gAft and hmC.winDays == "CPI days and the day after"))
    hmS.s1.winC := hmS.s1.gCPI ? hmC.cWinL : hmS.s1.gAft ? color.new(hmC.cWinL, 45) : color.new(hmC.cWinL, 70)
    if hmS.s1.winShow and hmC.winLn
        for m in array.from(510, 540)
            if hmS.s1.mod <= m and hmS.s1.mod + hmS.s1.tfM > m
                line.new(keyAt(hmS.s1.calK, m), close, keyAt(hmS.s1.calK, m), close + syminfo.mintick, xloc = xloc.bar_time, extend = extend.both, color = hmS.s1.winC, width = hmC.winLW, force_overlay = true)
    hmS
// @function Step 3: Model structure on the price chart
export step3(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s3.bg0 := hmS.s1.winShow and hmC.winBg and hmS.s1.inW ? color.new(hmC.cWinL, hmS.s1.gCPI ? 82 : hmS.s1.gAft ? 90 : 95) : na
    if hmS.s1.gOn and hmS.s1.gCPI and hmC.showDR and hmS.s1.tfM <= 30 and hmS.s1.mod >= 510 and hmS.s1.mod < 540
        float ce_ = na
        if nz(hmS.s1.c3K) != hmS.s1.calK
            hmS.s1.c3K  := hmS.s1.calK
            hmS.s1.c3H  := high
            hmS.s1.c3L  := low
            ce_  := (hmS.s1.c3H + hmS.s1.c3L) / 2
            hmS.s1.c3Hl := line.new(time, hmS.s1.c3H, time, hmS.s1.c3H, xloc = xloc.bar_time, color = hmC.cDR, style = lsOf(hmC.stDR), width = hmC.wDR, force_overlay = true)
            hmS.s1.c3Ll := line.new(time, hmS.s1.c3L, time, hmS.s1.c3L, xloc = xloc.bar_time, color = hmC.cDR, style = lsOf(hmC.stDR), width = hmC.wDR, force_overlay = true)
            hmS.s1.c3Cl := hmC.drEq ? line.new(time, ce_, time, ce_, xloc = xloc.bar_time, color = color.new(hmC.cDR, 25), style = line.style_dotted, force_overlay = true) : na
            hmS.s1.c3Fl := hmC.drFill ? linefill.new(hmS.s1.c3Hl, hmS.s1.c3Ll, color.new(hmC.cDR, 92)) : na
            hmS.s1.c3Ht := label.new(time, hmS.s1.c3H, "CPI DR high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR, style = label.style_label_lower_left, size = hmS.s1.lbSz, tooltip = c3Tip, force_overlay = true)
            hmS.s1.c3Lt := label.new(time, hmS.s1.c3L, "CPI DR low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR, style = label.style_label_upper_left, size = hmS.s1.lbSz, tooltip = c3Tip, force_overlay = true)
        else
            hmS.s1.c3H := math.max(hmS.s1.c3H, high)
            hmS.s1.c3L := math.min(hmS.s1.c3L, low)
            ce_ := (hmS.s1.c3H + hmS.s1.c3L) / 2
            hmS.s1.c3Hl.set_y1(hmS.s1.c3H)
            hmS.s1.c3Hl.set_y2(hmS.s1.c3H)
            hmS.s1.c3Ll.set_y1(hmS.s1.c3L)
            hmS.s1.c3Ll.set_y2(hmS.s1.c3L)
            hmS.s1.c3Ht.set_y(hmS.s1.c3H)
            hmS.s1.c3Lt.set_y(hmS.s1.c3L)
            if not na(hmS.s1.c3Cl)
                hmS.s1.c3Cl.set_y1(ce_)
                hmS.s1.c3Cl.set_y2(ce_)
        hmS.s1.c3Hl.set_x2(time)
        hmS.s1.c3Ll.set_x2(time)
        if not na(hmS.s1.c3Cl)
            hmS.s1.c3Cl.set_x2(time)
    if hmS.s1.c3K == hmS.s1.calK and hmS.s1.mod >= 540 and (hmS.s3.mod_1 < 540 or hmS.s1.calK != hmS.s3.calK_1) and not na(hmS.s1.c3Hl)
        int   te  = keyAt(hmS.s1.calK, hmS.s1.drEndM)
        float ce_ = (hmS.s1.c3H + hmS.s1.c3L) / 2
        float cd  = hmS.s1.tdO * hmF.ADRtd > 0 ? math.abs(close[1] - ce_) / (hmS.s1.tdO * hmF.ADRtd) : na
        string od = na(cd) ? "" : cd <= 0.1 ? " · 94%" : cd <= 0.2 ? " · 85%" : cd <= 0.4 ? " · 71%" : " · 39%"
        trimL(hmS, hmS.s1.c3Hl, te)
        trimL(hmS, hmS.s1.c3Ll, te)
        if not na(hmS.s1.c3Cl)
            trimL(hmS, hmS.s1.c3Cl, te)
            trimT(hmS, label.new(te, ce_, "CPI CE" + od, xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cDR, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = "CE = the 08:30–09:00 range's 50%. How often RTH traded back to it after 09:00 (by 16:14) on CPI days, by its distance from the 08:59 close: within 0.1 ADR20 94% · 0.1–0.2 85% · 0.2–0.4 71% · beyond 0.4 39% (2018–24 / 2025–26: 94 / 95 · 87 / 70 · 74 / 56). Normal days within 0.2 ADR: 94% · 85%. Read it as distance: a near CE gets traded, a far one less often. Today: " + (na(cd) ? "—" : str.tostring(cd, "0.00") + " ADR20") + ".", force_overlay = true), te)
    if hmS.s1.gOn and hmC.showWin and (hmS.s1.gCPI or hmS.s1.gAft) and hmS.s1.inW and hmS.s1.wkd
        if nz(hmS.s1.wK) != hmS.s1.calK
            hmS.s1.wK  := hmS.s1.calK
            hmS.s1.wBx := box.new(keyAt(hmS.s1.calK, 510), high, keyAt(hmS.s1.calK, 540), low, xloc = xloc.bar_time, border_color = color.new(hmC.cGh, hmS.s1.gCPI ? 35 : 70), border_width = 1, bgcolor = color.new(hmC.cGh, hmS.s1.gCPI ? 78 : 92), force_overlay = true)
        else
            hmS.s1.wBx.set_top(math.max(hmS.s1.wBx.get_top(), high))
            hmS.s1.wBx.set_bottom(math.min(hmS.s1.wBx.get_bottom(), low))
    hmS.s1.cPilM := hmS.s1.dark ? #2a2e39 : #e3e6ec
    hmS.s1.noteTx := hmS.s1.gCPI ? hmC.txCPI : hmS.s1.gAft ? hmC.txAft : hmC.txOth
    hmS.s2.noteOf := (hmS.s1.tdO * hmF.ADRtd > 0 ? hmS.s1.tdO * hmF.ADRtd : hmS.s1.tdH - hmS.s1.tdL) * hmC.noteUp / 100.0
    hmS.s2.noteSz := hmC.noteSzI == "Tiny" ? size.tiny : hmC.noteSzI == "Small" ? size.small : hmC.noteSzI == "Normal" ? size.normal : hmC.noteSzI == "Large" ? size.large : size.huge
    if hmS.s1.gOn and hmC.showNot and hmS.s1.wkd and (hmS.s1.gCPI or hmS.s1.noteTx != "") and hmS.s1.mod <= 510 and hmS.s1.mod + hmS.s1.tfM > 510
        int    nx   = nextOf(hmS.s1.CP, addDays(hmS.s1.calK, 1))
        string nTip = hmS.s1.gCPI ? "CPI day: the release is at 08:30 ET. The 08:30–09:00 half hour adds a median " + (hmS.s1.isES ? "+0.19× ADR20 to the day range vs +0.03×" : "+0.19× ADR20 to the day range vs +0.02×") + " on normal days." : hmS.s1.gAft ? "The trading day after a CPI day. Tested 2018–26: it went the same way as the CPI day " + (hmS.s1.isES ? "46% ±10 of the time (any day → next day 49%)" : "44% ±10 of the time (any day → next day 48%)") + ", so no continuation edge showed up." : "Not a CPI day: a normal day's 08:30 one-minute candle is about 1/9 the size of a CPI one (medians)." + (na(nx) ? "" : " Next CPI: " + fmtDay(nx) + ".")
        float  yT   = high + hmS.s2.noteOf
        hmS.s1.wTxK := hmS.s1.calK
        hmS.s1.wTs  := hmS.s1.gCPI ? line.new(time, open, time, yT, xloc = xloc.bar_time, color = color.new(hmC.cNote, 25), style = line.style_dotted, force_overlay = true) : na
        hmS.s1.wTx  := label.new(time, yT, hmS.s1.gCPI ? "CPI 08:30 · " + pf(open) + (hmS.s1.noteTx == "" ? "" : "\n" + hmS.s1.noteTx) : (hmS.s1.gAft ? "CPI +1 · " : "") + hmS.s1.noteTx, xloc = xloc.bar_time, color = hmS.s1.gCPI ? hmC.cNote : hmS.s1.cPilM, textcolor = hmS.s1.gCPI ? #ffffff : hmS.s1.cSub, style = label.style_label_down, size = hmS.s1.gCPI ? hmS.s2.noteSz : size.tiny, tooltip = nTip, force_overlay = true)
    else if hmS.s1.wTxK == hmS.s1.calK and hmS.s1.mod < 540 and not na(hmS.s1.wTx) and high + hmS.s2.noteOf > hmS.s1.wTx.get_y()
        hmS.s1.wTx.set_y(high + hmS.s2.noteOf)
        if not na(hmS.s1.wTs)
            hmS.s1.wTs.set_y2(high + hmS.s2.noteOf)
    hmS.s2.gjOff := (hmS.s1.tdO * hmF.ADRtd > 0 ? hmS.s1.tdO * hmF.ADRtd : hmS.s1.tdH - hmS.s1.tdL) * 0.12
    if hmS.s1.gOn and hmS.s1.gCPI and hmC.showWkO and hmS.s1.mod <= 510 and hmS.s1.mod + hmS.s1.tfM > 510
        hmS.s2.gjK := hmS.s1.calK
        hmS.s2.gj8 := gjRow(hmS, hmF, "08:30")
        hmS.s2.gjY := low - hmS.s2.gjOff
        hmS.s2.gjL := label.new(time, hmS.s2.gjY, gjHead(hmS) + "\n" + hmS.s2.gj8, xloc = xloc.bar_time, color = color.new(hmS.s1.dark ? #161a23 : #f4f6f9, 0), textcolor = hmS.s1.cTx, style = label.style_label_up, size = hmS.s1.lbSz == size.tiny ? size.small : hmS.s1.lbSz, text_font_family = font.family_monospace, textalign = text.align_left, tooltip = gjTip, force_overlay = true)
    else if hmS.s2.gjK == hmS.s1.calK and not na(hmS.s2.gjL) and hmS.s1.mod < 600
        if hmS.s1.mod <= 570 and hmS.s1.mod + hmS.s1.tfM > 570
            hmS.s2.gjL.set_text(gjHead(hmS) + "\n" + hmS.s2.gj8 + "\n" + gjRow(hmS, hmF, "09:30"))
        if low - hmS.s2.gjOff < hmS.s2.gjY
            hmS.s2.gjY := low - hmS.s2.gjOff
            hmS.s2.gjL.set_y(hmS.s2.gjY)
    if barstate.isfirst
        hmS.s2.RCB := array.new<box>()
    if barstate.isfirst
        hmS.s2.RCT := array.new<label>()
    hmS.s2.rcLen := hmC.relLenI == "1 min" ? 1 : hmC.relLenI == "5 min" ? 5 : 15
    hmS.s2.inRC := hmS.s1.tfM <= hmS.s2.rcLen ? (hmS.s1.mod >= 510 and hmS.s1.mod < 510 + hmS.s2.rcLen) : (hmS.s1.mod <= 510 and hmS.s1.mod + hmS.s1.tfM > 510)
    if hmS.s1.gCPI and hmS.s2.inRC
        if nz(hmS.s2.rcK) != hmS.s1.calK
            hmS.s2.rcK := hmS.s1.calK
            hmS.s2.rcH := high
            hmS.s2.rcL := low
        else
            hmS.s2.rcH := math.max(hmS.s2.rcH, high)
            hmS.s2.rcL := math.min(hmS.s2.rcL, low)
    hmS
// @function Step 4: Event clock (indicator pane)
export step4(State hmS, Cfg hmC, Feed hmF) =>
    if hmC.markEv and hmS.s1.gCPI and hmS.s2.rcK == hmS.s1.calK and not hmS.s2.inRC and hmS.s3.inRC_1
        int   eff = math.max(hmS.s2.rcLen, hmS.s1.tfM)
        float q1  = eff <= 1 ? (hmS.s1.isES ? 0.161 : 0.146) : eff <= 5 ? (hmS.s1.isES ? 0.209 : 0.202) : (hmS.s1.isES ? 0.234 : 0.235)
        float q2  = eff <= 1 ? (hmS.s1.isES ? 0.400 : 0.369) : eff <= 5 ? (hmS.s1.isES ? 0.470 : 0.432) : (hmS.s1.isES ? 0.504 : 0.464)
        float xr  = hmS.s1.tdO * hmF.ADRtd > 0 ? (hmS.s2.rcH - hmS.s2.rcL) / (hmS.s1.tdO * hmF.ADRtd) : na
        string cat = na(xr) ? "" : xr >= q2 ? " · wild" : xr < q1 ? " · quiet" : " · average"
        for b in hmS.s2.RCB                                              // older CPI candles fade back, the latest stays strong
            b.set_bgcolor(color.new(hmC.cGh, 93))
            b.set_border_color(color.new(hmC.cGh, 55))
        for t in hmS.s2.RCT
            t.set_textcolor(color.new(hmC.cGh, 35))
        hmS.s2.RCB.push(box.new(keyAt(hmS.s1.calK, 510), hmS.s2.rcH, time, hmS.s2.rcL, xloc = xloc.bar_time, border_color = color.new(hmC.cGh, 15), border_width = 1, bgcolor = color.new(hmC.cGh, 86), force_overlay = true))
        hmS.s2.RCT.push(label.new(time, hmS.s2.rcH, "CPI " + str.format_time(keyTime(hmS.s1.calK), "dd/MM", TZ) + cat, xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cGh, style = label.style_label_lower_left, size = size.small, tooltip = "CPI 08:30 candle (" + str.tostring(eff) + " min): " + pf(hmS.s2.rcH - hmS.s2.rcL) + " pts = " + (na(xr) ? "—" : str.tostring(xr, "0.00") + "× ADR20") + ". CPI release candles of this length since 2018: bottom third under " + str.tostring(q1, "0.00") + "× (quiet), top third over " + str.tostring(q2, "0.00") + "× (wild). A normal day's 08:30 candle of the same length is about " + (eff <= 1 ? "1/9" : eff <= 5 ? "1/5" : "1/4") + " the size of a CPI one (medians).", force_overlay = true))
        if hmS.s2.RCB.size() > hmC.relKeep
            hmS.s2.RCB.shift().delete()
            hmS.s2.RCT.shift().delete()
    if hmS.s2.RCB.size() > 0
        for b in hmS.s2.RCB
            b.set_right(time)
        for t in hmS.s2.RCT
            t.set_x(time)
    if hmS.s1.GL.size() > 0
        for i = hmS.s1.GL.size() - 1 to 0
            int e = hmS.s1.GLE.get(i)
            hmS.s1.GL.get(i).set_x2(math.min(e, time))
            if time >= e
                hmS.s1.GL.remove(i)
                hmS.s1.GLE.remove(i)
    if hmS.s1.GT.size() > 0
        for i = hmS.s1.GT.size() - 1 to 0
            int e = hmS.s1.GTE.get(i)
            hmS.s1.GT.get(i).set_x(math.min(e, time))
            if time >= e
                hmS.s1.GT.remove(i)
                hmS.s1.GTE.remove(i)
    hmS.s2.clkTF := timeframe.isintraday and timeframe.in_seconds() <= 3600
    hmS.s2.clkGo := hmS.s1.clkOn and hmS.s2.clkTF and paneV == "Event clock"
    hmS.s2.clkR := hmC.clkMet == "Range"
    hmS.s2.mSel := hmS.s2.clkR ? 0 : 1
    if barstate.isfirst
        hmS.s2.ckI := NCK - 1                                     // today's baseline: this event if today is one, else normal
    if hmS.s1.tdSt or barstate.isfirst
        [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
        hmS.s2.ckEv  := now_
        hmS.s2.ckEvI := ownCk(k_)
        hmS.s2.ckI   := now_ ? ownCk(k_) : NCK - 1
    hmS.s2.elM := (hmS.s1.mod - 1080 + 1440) % 1440
    hmS.s2.eEnd := math.min(1380.0, hmS.s2.elM + hmS.s1.tfM)
    hmS.s2.jB := math.min(45, math.max(0, int(math.ceil(hmS.s2.eEnd / 30.0)) - 1))
    hmS.s2.fB := math.max(0.0, math.min(1.0, (hmS.s2.eEnd - 30.0 * hmS.s2.jB) / 30.0))
    hmS.s2.scP := hmS.s1.tdO * hmF.ADRtd
    hmS.s2.vPts := hmS.s2.clkR ? hmS.s1.tdH - hmS.s1.tdL : close - hmS.s1.tdO
    hmS.s2.vAdr := hmS.s2.scP > 0 ? hmS.s2.vPts / hmS.s2.scP : na
    hmS.s2.q25B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 1, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.q75B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.stB := na(hmS.s2.vAdr) ? "" : hmS.s2.vAdr > hmS.s2.q75B ? "Above" : hmS.s2.vAdr < hmS.s2.q25B ? "Below" : "Inside"
    hmS.s2.isTd := anchorKey(0, last_bar_time) == hmS.s1.tdK
    hmS.s2.liveC := hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx
    hmS.s3.p1 := hmS.s2.clkGo and hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc1 := hmS.s2.liveC
    hmS.s3.p2 := hmS.s2.clkGo and hmC.kPast and not hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc2 := color.new(hmS.s1.cSub, 75)
    hmS.s2.ckTop := hmC.showCk and hmC.ckOn == "Indicator pane" and str.startswith(hmC.ckPos, "Top")
    hmS.s2.hdrm := hmS.s2.clkGo and hmS.s2.scP > 0 ? math.max(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 45), ck(hmS, NCK - 1, hmS.s2.mSel, 4, 45)) * hmS.s2.scP * (hmS.s2.ckTop ? 1.75 : 1.1) : na
    hmS.s3.p3 := hmS.s2.hdrm
    if barstate.isfirst
        hmS.s2.KP := array.new<polyline>()
    if barstate.isfirst
        hmS.s2.KL := array.new<line>()
    if barstate.isfirst
        hmS.s2.KT := array.new<label>()
    hmS
// @function Step 5: Cards
export step5(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on)
        for p in hmS.s2.KP
            p.delete()
        for l in hmS.s2.KL
            l.delete()
        for t in hmS.s2.KT
            t.delete()
        hmS.s2.KP.clear()
        hmS.s2.KL.clear()
        hmS.s2.KT.clear()
        if hmS.s2.clkGo and hmS.s2.scP > 0
            int   t0  = keyAt(addDays(hmS.s1.tdK, -1), 1080)
            int   tE  = t0 + 46 * 1800000
            color ce  = hmS.s2.ckEv ? hmC.cGh : hmS.s1.cSub
            int   iR  = hmS.s2.ckEv ? NCK - 1 : hmS.s2.ckEvI
            color cR  = hmS.s2.ckEv ? hmS.s1.cMu : color.new(hmC.cGh, 25)
            if hmC.kBands
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 0, t0, hmS.s2.scP, color.new(ce, 90)))
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, 1, t0, hmS.s2.scP, color.new(ce, 80)))
            hmS.s2.KP.push(kPath(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, t0, hmS.s2.scP, ce, 2, line.style_solid))
            hmS.s2.KT.push(label.new(tE, ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(hmS.s2.ckI) + " median " + pf(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = ce, style = label.style_label_left, size = size.tiny))
            if hmC.kRef
                hmS.s2.KP.push(kPath(hmS, iR, hmS.s2.mSel, 2, t0, hmS.s2.scP, cR, 1, line.style_dashed))
                hmS.s2.KT.push(label.new(tE, ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(iR) + (hmS.s2.ckEv ? "" : " (next)") + " " + pf(ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = cR, style = label.style_label_left, size = size.tiny))
            for s in str.split(REL, ",")
                float rm = str.tonumber(s)
                if not na(rm)
                    int tr = keyAt(hmS.s1.tdK, int(rm))
                    hmS.s2.KL.push(line.new(tr, 0.0, tr, hmS.s2.scP, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cGh, hmS.s2.ckEv ? 30 : 70), style = line.style_dotted))
    if barstate.isfirst
        hmS.s2.RB := array.new<box>()
    if barstate.isfirst
        hmS.s2.RL := array.new<line>()
    if barstate.isfirst
        hmS.s2.RT := array.new<label>()
    hmS.s2.cBody := hmS.s1.dark ? #161a23 : #f4f6f9
    hmS.s2.cBody2 := hmS.s1.dark ? #1c2130 : #e9edf3
    hmS.s2.cNeu := hmS.s1.dark ? #3a3f4b : #d1d4dc
    hmS.s2.cVx := #7e57c2
    hmS.s2.cDxc := #00897b
    hmS.s2.cPrem := hmS.s1.dark ? #ef5350 : #d32f2f
    hmS.s2.cDisc := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s2.EV_N := 2 + (hmC.evMode == "Checklist" ? chkMax(hmS.s1.isES) : 5) + 1        // header · sub-header · rows · NEXT
    hmS.s2.mob := hmC.layI == "Mobile"
    hmS.s2.MB_N := 2 + (hmC.evMode == "Checklist" ? chkMax(hmS.s1.isES) : 4)              // header · NOW · rows
    hmS
// @function Step 6: Cards
export step6(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and na(hmS.s2.TS) and na(hmS.s2.TM) and na(hmS.s2.TK)
        int o = gapOf("Price chart", hmC.crdPos) ? 1 : 0
        int r = o
        if hmS.s2.mob
            if hmC.showEv
                hmS.s2.mEv := r
                r += hmS.s2.MB_N
            int g = r
            if (hmC.showVx or hmC.showDx or hmS.s1.showFd) and r > o
                r += 1
            if hmC.showVx
                hmS.s2.mVx := r
                r += 1
            if hmC.showDx
                hmS.s2.mDx := r
                r += 1
            if hmS.s1.showFd
                hmS.s2.mFd := r
                r += 1
            if r > o
                hmS.s2.TM := table.new(posOf(hmC.crdPos), SC, r, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
                if o == 1
                    hmS.s2.TM.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                    hmS.s2.TM.merge_cells(0, 0, SC - 1, 0)
                if hmS.s2.mEv >= 0
                    hmS.s2.TM.merge_cells(1, hmS.s2.mEv, 3, hmS.s2.mEv)
                if g < r and g > o and (hmS.s2.mVx > g or hmS.s2.mDx > g or hmS.s2.mFd > g)
                    hmS.s2.TM.cell(0, g, "", height = 0.6, bgcolor = #00000000)
                    hmS.s2.TM.merge_cells(0, g, SC - 1, g)
        else
            if hmC.showEv
                hmS.s2.rEv := r
                r += hmS.s2.EV_N
            if hmC.showVx
                r += r > o ? 1 : 0
                hmS.s2.rVx := r
                r += VX_N
            if hmC.showDx
                r += r > o ? 1 : 0
                hmS.s2.rDx := r
                r += DX_N
            if hmS.s1.showFd
                r += r > o ? 1 : 0
                hmS.s2.rFd := r
                r += FD_N
            if r > o
                hmS.s2.TS := table.new(posOf(hmC.crdPos), SC, r, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
                if o == 1
                    hmS.s2.TS.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                    hmS.s2.TS.merge_cells(0, 0, SC - 1, 0)
                for st in array.from(hmS.s2.rEv, hmS.s2.rVx, hmS.s2.rDx, hmS.s2.rFd)
                    if st >= 0
                        hmS.s2.TS.merge_cells(1, st, 3, st)
                        if st > o
                            hmS.s2.TS.cell(0, st - 1, "", height = 0.6, bgcolor = #00000000)
                            hmS.s2.TS.merge_cells(0, st - 1, SC - 1, st - 1)
                if hmS.s2.rEv >= 0
                    hmS.s2.TS.merge_cells(2, hmS.s2.rEv + hmS.s2.EV_N - 1, SC - 1, hmS.s2.rEv + hmS.s2.EV_N - 1)
            if hmC.showCk and paneV == "Event clock"
                hmS.s2.tkO := gapOf(hmC.ckOn, hmC.ckPos) ? 1 : 0
                if hmC.ckOn == "Price chart"
                    hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
                else
                    hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0)
                if hmS.s2.tkO == 1
                    hmS.s2.TK.cell(0, 0, "", height = hmC.ckOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
                    hmS.s2.TK.merge_cells(0, 0, SC - 1, 0)
                hmS.s2.TK.merge_cells(1, hmS.s2.tkO, 3, hmS.s2.tkO)
    if barstate.isfirst
        hmS.s2.TEd := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEt := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEr := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEg := array.new<float>()
    if barstate.isfirst
        hmS.s2.TEp := array.new<float>()
    if barstate.isfirst
        _isfirst_1(hmS)
    hmS
// @function Step 7: Draw (last bar)
export step7(State hmS, Cfg hmC) =>
    hmS.s2.pend := false
    hmS.s2.tKey := na
    hmS.s2.today := na
    hmS.s2.pk := na
    hmS.s2.pNow := false
    hmS.s2.pDay := na
    hmS.s2.mTy := na
    hmS.s2.live := false
    hmS.s2.hasD := false
    hmS.s2.O := na
    hmS.s2.gc := na
    hmS.s2.a := na
    hmS.s2.gw := na
    hmS.s2.xd := na
    hmS.s2.x0 := na
    hmS.s2.xc := na
    hmS.s2.xw := na
    hmS.s2.hasS := false
    hmS.s2.shM := false
    hmS.s2.vFac := na
    hmS.s2.mR := na
    hmS.s2.uS := na
    hmS.s2.mH := na
    hmS.s2.mL := na
    hmS.s2.mC := na
    hmS.s2.dot := ""
    hmS.s2.dd := na
    hmS.s2.ev := ""
    hmS.s2.n1t := ""
    hmS.s2.n1k := na
    hmS.s2.n2t := ""
    hmS.s2.n2k := na
    hmS.s2.warn := false
    hmS.s2.acc := na
    hmS.s2.seq := ""
    hmS.s2.d0 := na
    hmS.s2.nT := na
    hmS.s2.uT := na
    hmS.s2.dT_ := na
    hmS.s2.uR := na
    hmS.s2.dR_ := na
    hmS.s2.nG := na
    hmS.s2.gAvg := na
    hmS.s2.gAbs := na
    hmS.s2.since := ""
    hmS.s2.srcT := ""
    hmS.s3.tTip := ""
    hmS.s3.gTip := ""
    hmS.s3.vOk := false
    hmS.s3.vsp := na
    hmS.s3.vch := na
    hmS.s3.st := ""
    hmS.s3.bR := ""
    hmS.s3.bA := ""
    hmS.s3.vDn := false
    hmS.s3.dOk := false
    hmS.s3.net := na
    hmS.s3.rg := na
    hmS.s3.bigL := na
    hmS.s3.big := false
    if (barstate.islast and hmC.on)
        clearRight(hmS)
    hmS
// @function Step 8: Draw (last bar)
export step8(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        hmS.s2.pend := hmS.s1.AN == 2 and hmS.s1.mod < 570                      // RTH not open yet: the model sits on the last price
        hmS.s2.tKey := hmS.s2.pend ? hmS.s1.calK : hmS.s1.dK
        hmS.s2.today := hmS.s1.calK
        [pk_, pNow_, pDay_] = ownProfile(hmS, hmS.s2.tKey, hmS.s2.pend ? hmS.s1.dK : hmS.s1.pK, hmS.s2.today)
        hmS.s2.pk := pk_
        hmS.s2.pNow := pNow_
        hmS.s2.pDay := pDay_
        hmS.s2.mTy := ownTy(hmS.s2.pk)                                  // this indicator's own event, never another event's
        hmS.s2.live := hmS.s2.pNow and not hmS.s2.pend
        hmS.s2.hasD := not hmS.s2.pend and not na(hmS.s1.dO)
        hmS.s2.O := hmS.s2.hasD ? hmS.s1.dO : close
        hmS.s2.gc := hmS.s2.pNow ? hmC.cGh : color.new(hmC.cGh, 55)
        hmS.s2.a := hmF.ADR
        hmS.s2.gw := hmC.widI + 6
        hmS.s2.xd := bar_index + hmC.offI
        hmS.s2.x0 := na(hmS.s1.dX) ? na : math.max(hmS.s1.dX, bar_index - 4900)   // day start, capped inside the 5000-bar buffer
        hmS.s2.xc := hmS.s2.xd + int(hmS.s2.gw / 2)
        hmS.s2.xw := hmS.s2.xd + hmS.s2.gw + hmC.gapI
        hmS.s2.hasS := hmS.s1.ST.size() == 7 * NF and not na(hmS.s2.a) and not na(hmS.s2.O)
        hmS.s2.shM := hmC.showGh and hmS.s2.hasS and (hmS.s2.pNow or hmC.offDayI == "Next event's model")
        // model candle: typical range of this event (median), split above / below the open in the ratio of the median
        // reaches, and the median close
        // optional VIX sizing: the event's median range scaled by today's VIX against its 20-day average and against ADR20
        hmS.s2.vFac := 1.0
        if hmC.vixSize and not na(hmS.s1.vPrev) and not na(hmS.s1.vAvg) and hmS.s1.vAvg > 0 and not na(hmF.ADRtd) and hmF.ADRtd > 0
            float iv = math.log(hmS.s1.vPrev / math.sqrt(252.0)) - math.log(hmF.ADRtd * 100)
            float vs = math.log(hmS.s1.vPrev / hmS.s1.vAvg)
            hmS.s2.vFac := math.exp((hmS.s1.isES ? 0.308 : 0.261) * (iv - (hmS.s1.isES ? IVRV_ES : IVRV_NQ)) + (hmS.s1.isES ? 1.472 : 1.178) * vs)
        hmS.s2.mR := hmS.s2.hasS ? sv(hmS, hmS.s2.mTy, 10) * hmS.s2.a * hmS.s2.O * hmS.s2.vFac : na
        hmS.s2.uS := hmS.s2.hasS ? sv(hmS, hmS.s2.mTy, 3) / math.max(sv(hmS, hmS.s2.mTy, 3) + sv(hmS, hmS.s2.mTy, 6), 1e-9) : na
        hmS.s2.mH := hmS.s2.O + hmS.s2.mR * hmS.s2.uS
        hmS.s2.mL := hmS.s2.O - hmS.s2.mR * (1 - hmS.s2.uS)
        hmS.s2.mC := hmS.s2.hasS ? hmS.s2.O * (1 + sv(hmS, hmS.s2.mTy, 8) * hmS.s2.a * hmS.s2.vFac) : na
    if (barstate.islast and hmC.on)
        if hmS.s2.shM
            hmS.s2.RB.push(box.new(hmS.s2.xd + 2, hmS.s2.mH, hmS.s2.xd + hmS.s2.gw - 2, hmS.s2.mL, border_color = color.new(hmS.s2.gc, 40), border_style = line.style_dotted, bgcolor = color.new(hmS.s2.gc, 90), force_overlay = true))
            hmS.s2.RB.push(box.new(hmS.s2.xd, math.max(hmS.s2.O, hmS.s2.mC), hmS.s2.xd + hmS.s2.gw, math.min(hmS.s2.O, hmS.s2.mC), border_color = hmS.s2.gc, border_width = 1, bgcolor = color.new(hmS.s2.gc, 70), force_overlay = true))
            hmS.s2.RL.push(line.new(hmS.s2.xd, hmS.s2.mH, hmS.s2.xd + hmS.s2.gw, hmS.s2.mH, color = hmS.s2.gc, width = 2, force_overlay = true))
            hmS.s2.RL.push(line.new(hmS.s2.xd, hmS.s2.mL, hmS.s2.xd + hmS.s2.gw, hmS.s2.mL, color = hmS.s2.gc, width = 2, force_overlay = true))
            if hmC.showPx
                pxL(hmS, hmS.s2.xd, hmS.s2.mH, pf(hmS.s2.mH), hmS.s2.gc)
                pxL(hmS, hmS.s2.xd, hmS.s2.mL, pf(hmS.s2.mL), hmS.s2.gc)
            if hmC.showPL and hmS.s2.live and not na(hmS.s2.x0)
                hmS.s2.RL.push(line.new(hmS.s2.x0, hmS.s2.mH, hmS.s2.xd, hmS.s2.mH, color = color.new(hmS.s2.gc, 45), style = line.style_dotted, force_overlay = true))
                hmS.s2.RL.push(line.new(hmS.s2.x0, hmS.s2.mL, hmS.s2.xd, hmS.s2.mL, color = color.new(hmS.s2.gc, 45), style = line.style_dotted, force_overlay = true))
    if (barstate.islast and hmC.on)
        if hmS.s2.hasD
            drawCandle(hmS, hmC, hmS.s2.xd + 3, hmC.widI, hmS.s1.dO, hmS.s1.dH, hmS.s1.dL, hmS.s1.dC)
            if hmC.showPx
                pxR(hmS, hmS.s2.xd + hmS.s2.gw, hmS.s1.dH, pf(hmS.s1.dH), hmS.s1.cSub)
                pxR(hmS, hmS.s2.xd + hmS.s2.gw, hmS.s1.dL, pf(hmS.s1.dL), hmS.s1.cSub)
            if hmC.showLv and not na(hmS.s2.x0)
                hmS.s2.RL.push(line.new(hmS.s2.x0, hmS.s1.dO, hmS.s2.xd, hmS.s1.dO, color = color.new(hmC.cWk, 30), style = line.style_dotted, force_overlay = true))
                hmS.s2.RL.push(line.new(hmS.s2.x0, hmS.s1.dH, hmS.s2.xd, hmS.s1.dH, color = color.new(hmC.cWk, 50), style = line.style_dotted, force_overlay = true))
                hmS.s2.RL.push(line.new(hmS.s2.x0, hmS.s1.dL, hmS.s2.xd, hmS.s1.dL, color = color.new(hmC.cWk, 50), style = line.style_dotted, force_overlay = true))
    if (barstate.islast and hmC.on)
        if hmC.showWk and not na(hmF.wO)
            drawCandle(hmS, hmC, hmS.s2.xw, hmC.widI, hmF.wO, hmF.wH, hmF.wL, hmF.wC)
            if hmC.showPx
                pxR(hmS, hmS.s2.xw + hmC.widI, hmF.wH, pf(hmF.wH), hmS.s1.cSub)
                pxR(hmS, hmS.s2.xw + hmC.widI, hmF.wL, pf(hmF.wL), hmS.s1.cSub)
        // chips
    if (barstate.islast and hmC.on)
        if hmC.showCh
            string dHd = (hmS.s1.AN == 0 ? "1D" : hmS.s1.AN == 1 ? "1D 00:00" : "1D RTH") + " · " + (hmS.s2.pNow ? typeShort(hmS.s2.mTy) + " DAY" : "next " + typeShort(hmS.s2.mTy) + (na(hmS.s2.pDay) ? "" : " " + fmtDay(hmS.s2.pDay)))
            string dR  = hmS.s2.hasD ? "range " + pf(hmS.s1.dH - hmS.s1.dL) : "range —"
            string dM  = hmS.s2.hasS ? "model " + pf(hmS.s2.mR) + (hmS.s2.vFac != 1.0 ? " (VIX ×" + str.tostring(hmS.s2.vFac, "0.00") + ")" : "") + (hmS.s2.live and hmS.s2.hasD and hmS.s2.mR > 0 ? " · " + p0((hmS.s1.dH - hmS.s1.dL) / hmS.s2.mR) + " filled" : "") : ""
            string dTip = hmS.s2.hasS ? typeShort(hmS.s2.mTy) + " days (" + str.tostring(sv(hmS, hmS.s2.mTy, 0), "0") + " since 2018): median range " + x2(sv(hmS, hmS.s2.mTy, 10)) + " ADR20 (middle half " + x2(sv(hmS, hmS.s2.mTy, 9)) + "–" + x2(sv(hmS, hmS.s2.mTy, 11)) + "), normal days " + x2(sv(hmS, 6, 10)) + ". Split above / below the open in the ratio of the median reaches (" + x2(sv(hmS, hmS.s2.mTy, 3)) + " up, " + x2(sv(hmS, hmS.s2.mTy, 6)) + " down); the body runs to the median close (" + (sv(hmS, hmS.s2.mTy, 8) >= 0 ? "+" : "") + x2(sv(hmS, hmS.s2.mTy, 8)) + "), and " + p0(sv(hmS, hmS.s2.mTy, 1)) + " of these days closed up. ADR20 = " + pf(hmS.s2.a * hmS.s2.O) + " pts." + (hmS.s2.pNow ? "" : "\nNo " + typeShort(hmS.s2.mTy) + " today: this is the next one's model at today's ADR, around today's candle. A size reference, not a forecast.") : "Needs 15+ days of history for ADR20."
            float yD   = math.max(nz(hmS.s1.dH, hmS.s2.O), hmS.s2.shM ? hmS.s2.mH : nz(hmS.s1.dH, hmS.s2.O))
            chip(hmS, hmS.s2.xc, yD, dHd + "\n" + dR + (dM == "" ? "" : "\n" + dM), dTip, true)
            if hmC.showWk and not na(hmF.wO)
                chip(hmS, hmS.s2.xw + int(hmC.widI / 2), hmF.wL, "1W\nrange " + pf(hmF.wH - hmF.wL), "This week so far (CME week, Sunday 18:00 open), in points.", false)

        // ── cards
    hmS
// @function Step 9: Draw (last bar)
export step9(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        hmS.s2.dot := barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        hmS.s2.dd := na(hmS.s2.pDay) ? na : inDays(hmS.s2.pDay, hmS.s2.today)
        hmS.s2.ev := typeShort(hmS.s2.mTy)
        [n1t_, n1k_, n2t_, n2k_] = ownNext(hmS, hmS.s2.today)
        hmS.s2.n1t := n1t_
        hmS.s2.n1k := n1k_
        hmS.s2.n2t := n2t_
        hmS.s2.n2k := n2k_
        hmS.s2.warn := inDays(LAST_DATE, hmS.s2.today) < 60
        // tally of the last N event days (both layouts): this chart's own records first, then built-in ones older than those
        hmS.s2.acc := array.new_float(10, 0.0)
        hmS.s2.seq := ""
        hmS.s2.d0 := na
        if hmC.showEv and hmC.evMode == "Tally"
            if hmS.s1.LTd.size() > 0
                for i = hmS.s1.LTd.size() - 1 to 0
                    if hmS.s2.acc.get(0) < hmC.talN
                        talAcc(hmS.s2.acc, hmS.s1.LTt.get(i), hmS.s1.LTr.get(i), hmS.s1.LTg.get(i), hmS.s1.LTp.get(i))
                        hmS.s2.seq := (hmS.s1.LTt.get(i) > 0 ? "▲" : hmS.s1.LTt.get(i) < 0 ? "▼" : "·") + hmS.s2.seq
                        hmS.s2.d0 := hmS.s1.LTd.get(i)
            int oldest = hmS.s1.LTd.size() > 0 ? hmS.s1.LTd.get(0) : 99999999
            if hmS.s2.TEd.size() > 0
                for i = hmS.s2.TEd.size() - 1 to 0
                    if hmS.s2.acc.get(0) < hmC.talN and hmS.s2.TEd.get(i) < oldest
                        talAcc(hmS.s2.acc, hmS.s2.TEt.get(i), hmS.s2.TEr.get(i), hmS.s2.TEg.get(i), hmS.s2.TEp.get(i))
                        hmS.s2.seq := (hmS.s2.TEt.get(i) > 0 ? "▲" : hmS.s2.TEt.get(i) < 0 ? "▼" : "·") + hmS.s2.seq
                        hmS.s2.d0 := hmS.s2.TEd.get(i)
        hmS.s2.nT := int(hmS.s2.acc.get(0))
        hmS.s2.uT := int(hmS.s2.acc.get(1))
        hmS.s2.dT_ := int(hmS.s2.acc.get(2))
        hmS.s2.uR := int(hmS.s2.acc.get(3))
        hmS.s2.dR_ := int(hmS.s2.acc.get(4))
        hmS.s2.nG := int(hmS.s2.acc.get(5))
        hmS.s2.gAvg := hmS.s2.nG > 0 ? hmS.s2.acc.get(6) / hmS.s2.nG : na
        hmS.s2.gAbs := hmS.s2.nG > 0 ? hmS.s2.acc.get(7) / hmS.s2.nG : na
        hmS.s2.since := na(hmS.s2.d0) ? "" : " since " + str.format_time(keyTime(hmS.s2.d0), "MMM yyyy", TZ)
        hmS.s2.srcT := hmS.s2.TEd.size() > 0 ? " Built-in " + hmS.s1.symR + " records run to " + str.format_time(keyTime(hmS.s1.talEnd), "dd MMM yyyy", TZ) + "; later days, and any this chart loads itself, come from the chart's own bars." : " Records come from this chart's own bars (built-in history covers NQ / MNQ and ES / MES)."
        hmS.s3.tTip := "Trading day (18:00 → 17:00) close vs open on the last " + str.tostring(hmS.s2.nT) + " " + TAL_NAME + " days, oldest → newest: " + hmS.s2.seq + ". RTH (09:30 → 16:14): ▲ " + str.tostring(hmS.s2.uR) + " ▼ " + str.tostring(hmS.s2.dR_) + ". A tally, not a forecast: across 2018–26 the up-close rate on these days was not different from normal days." + hmS.s2.srcT
        hmS.s3.gTip := "RTH gap = 09:30 open − prior trading day's 16:14 close. Average over the last " + str.tostring(hmS.s2.nG) + " " + TAL_NAME + " days: " + (na(hmS.s2.gAvg) ? "—" : pf(hmS.s2.gAvg)) + " pts; average size " + (na(hmS.s2.gAbs) ? "—" : pf(hmS.s2.gAbs) + " pts (" + str.tostring(hmS.s2.acc.get(8) / hmS.s2.nG, "0.00") + "%)") + "; gapped up on " + str.tostring(int(hmS.s2.acc.get(9))) + " of " + str.tostring(hmS.s2.nG) + "."
        // VIX and DXY readings (both layouts)
        hmS.s3.vOk := not na(hmF.vixL) and not na(hmS.s1.vPrev) and not na(hmS.s1.vAvg) and hmS.s1.vAvg > 0 and hmS.s1.vPrev > 0
        hmS.s3.vsp := hmS.s3.vOk ? hmS.s1.vPrev / hmS.s1.vAvg - 1 : na
        hmS.s3.vch := hmS.s3.vOk ? hmF.vixL / hmS.s1.vPrev - 1 : na
        hmS.s3.st := na(hmS.s3.vsp) ? "—" : hmS.s3.vsp >= 0.10 ? "HOT" : hmS.s3.vsp <= -0.10 ? "CALM" : "NORMAL"
        hmS.s3.bR := hmS.s3.st == "HOT" ? (hmS.s1.isES ? "1.37×" : "1.27×") : hmS.s3.st == "CALM" ? (hmS.s1.isES ? "0.64×" : "0.70×") : hmS.s3.st == "NORMAL" ? (hmS.s1.isES ? "0.90×" : "0.91×") : "—"
        hmS.s3.bA := hmS.s3.st == "HOT" ? (hmS.s1.isES ? "76%" : "73%") : hmS.s3.st == "CALM" ? (hmS.s1.isES ? "10%" : "16%") : hmS.s3.st == "NORMAL" ? (hmS.s1.isES ? "39%" : "40%") : "—"
        hmS.s3.vDn := hmS.s3.vOk and hmS.s3.vch < 0
        hmS.s3.dOk := not na(hmF.dxL) and not na(hmS.s1.dxTdO) and not na(hmS.s1.dxAtr) and hmS.s1.dxAtr > 0
        hmS.s3.net := hmS.s3.dOk ? hmF.dxL - hmS.s1.dxTdO : na
        hmS.s3.rg := hmS.s3.dOk ? hmS.s1.dxHi - hmS.s1.dxLo : na
        hmS.s3.bigL := hmS.s3.dOk ? 0.5 * hmS.s1.dxAtr : na
        hmS.s3.big := hmS.s3.dOk and math.abs(hmS.s3.net) >= hmS.s3.bigL
    if (barstate.islast and hmC.on)
        if hmC.showEv and not na(hmS.s2.TS) and hmS.s2.rEv >= 0
            int    r0 = hmS.s2.rEv
            cardHead(hmS, hmS.s2.TS, r0, hmC.cGh, hmS.s2.dot + " " + str.upper("Gran Rey Cero") + " · " + hmS.s2.ev + " · " + hmS.s1.symTag, pfName(hmS.s2.pk) + ". Recomputed on " + hmS.s1.symR + " 1-minute data 2018–26." + (hmS.s1.isNQ or hmS.s1.isES ? "" : " This chart is " + syminfo.root + ": the figures are " + hmS.s1.symR + "'s."), hmS.s2.pNow ? "TODAY" : na(hmS.s2.dd) ? "—" : hmS.s2.dd == 1 ? "TOMORROW" : "IN " + str.tostring(hmS.s2.dd) + "D", hmS.s2.pNow ? hmC.cGh : #ffffff, hmS.s2.pNow ? #ffffff : color.new(#000000, 55))
            if hmC.evMode == "Checklist"
                cardSub(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "held 2018–24 and 2025–26", hmS.s2.ev, "normal")
                array<string> rows = str.split(chkRows(hmS.s2.pk, hmS.s1.isES), "|")
                for i = 0 to chkMax(hmS.s1.isES) - 1
                    if i < rows.size() and rows.get(i) != ""
                        array<string> f = str.split(rows.get(i), "~")
                        cardRow(hmS, hmS.s2.TS, r0 + 2 + i, hmC.cGh, "✓", true, f.get(0), f.size() > 1 ? f.get(1) : "", f.size() > 2 ? f.get(2) : "", f.size() > 3 ? f.get(3) : "")
                    else
                        cardRow(hmS, hmS.s2.TS, r0 + 2 + i, hmC.cGh, "", false, i == 0 ? "nothing held on " + hmS.s1.symR : "", "", "", "Every candidate row either failed p < 0.05 over 2018–26 or flipped in 2025–26 on this symbol.")
            else
                cardSub(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "last " + str.tostring(hmS.s2.nT) + " " + TAL_NAME + " days" + hmS.s2.since, "▲ up", "▼ down")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, gauge(hmS.s2.uT + hmS.s2.dT_ > 0 ? float(hmS.s2.uT) / (hmS.s2.uT + hmS.s2.dT_) : na) + " " + (hmS.s2.uT + hmS.s2.dT_ > 0 ? p0(float(hmS.s2.uT) / (hmS.s2.uT + hmS.s2.dT_)) : "—"), "▲ " + str.tostring(hmS.s2.uT), "▼ " + str.tostring(hmS.s2.dT_), hmS.s3.tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "RTH", false, gauge(hmS.s2.uR + hmS.s2.dR_ > 0 ? float(hmS.s2.uR) / (hmS.s2.uR + hmS.s2.dR_) : na) + " " + (hmS.s2.uR + hmS.s2.dR_ > 0 ? p0(float(hmS.s2.uR) / (hmS.s2.uR + hmS.s2.dR_)) : "—"), "▲ " + str.tostring(hmS.s2.uR), "▼ " + str.tostring(hmS.s2.dR_), "RTH 09:30 → 16:14 close vs open on the same days (days without RTH data are left out).", hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 4, hmC.cGh, "GAP", false, "avg RTH gap · up " + str.tostring(int(hmS.s2.acc.get(9))) + "/" + str.tostring(hmS.s2.nG), na(hmS.s2.gAvg) ? "—" : (hmS.s2.gAvg >= 0 ? "+" : "") + pf(hmS.s2.gAvg), na(hmS.s2.gAbs) ? "—" : "±" + pf(hmS.s2.gAbs), hmS.s3.gTip)
                zoneRow(hmS, hmS.s2.TS, r0 + 5, hmC.cGh, "WEEK", hmF.wH, hmF.wL, "week")
                zoneRow(hmS, hmS.s2.TS, r0 + 6, hmC.cGh, "MONTH", hmF.moH, hmF.moL, "month")
            cardWide(hmS, hmS.s2.TS, r0 + hmS.s2.EV_N - 1, hmC.cGh, "NEXT", (na(hmS.s2.n1k) ? "beyond loaded dates" : whenTxt(hmS.s2.n1k, hmS.s2.today)) + (na(hmS.s2.n2k) ? "" : "  →  " + fmtDay(hmS.s2.n2k)) + (hmS.s2.warn ? " · UPDATE DATES" : ""), hmS.s2.n1t + ". Release dates are built in up to " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's dates (federalreserve.gov, bls.gov/schedule) to S_FOMC, S_CPI and S_NFP, then raise LAST_DATE.", na(hmS.s2.n1k) or hmS.s2.warn ? hmS.s1.cWarn : hmS.s1.cTx)

        // ── VIX card: only what held (VIX against its own 20-day average → day range; same-day VIX direction)
    if (barstate.islast and hmC.on)
        if hmC.showVx and not na(hmS.s2.TS) and hmS.s2.rVx >= 0
            int    r0  = hmS.s2.rVx
            cardHead(hmS, hmS.s2.TS, r0, hmS.s2.cVx, hmS.s2.dot + " VIX " + (hmS.s3.vOk ? str.tostring(hmF.vixL, "0.00") + "  " + (hmS.s3.vch >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(hmS.s3.vch) * 100, "0.0") + "%" : "— (no data)"), "CBOE VIX, live against its prior close.", hmS.s3.st, hmS.s3.st == "HOT" or hmS.s3.st == "CALM" ? #ffffff : hmS.s1.cTx, hmS.s3.st == "HOT" ? hmS.s1.cHot : hmS.s3.st == "CALM" ? hmS.s1.cCold : hmS.s2.cNeu)
            cardSub(hmS, hmS.s2.TS, r0 + 1, hmS.s2.cVx, "held 2018–24 and 2025–26", "days ran", "> ADR")
            cardRow(hmS, hmS.s2.TS, r0 + 2, hmS.s2.cVx, "VIX", false, "vs its 20-day avg " + (na(hmS.s3.vsp) ? "—" : (hmS.s3.vsp >= 0 ? "+" : "−") + str.tostring(math.abs(hmS.s3.vsp) * 100, "0") + "%"), hmS.s3.bR, hmS.s3.bA, "VIX prior close against its 20-day average. Days with VIX ≥ 10% above it ran a median " + (hmS.s1.isES ? "1.37× ADR20 (above ADR on 76% of days)" : "1.27× ADR20 (above ADR on 73% of days)") + "; within ±10% " + (hmS.s1.isES ? "0.90× (39%)" : "0.91× (40%)") + "; ≥ 10% below " + (hmS.s1.isES ? "0.64× (10%)" : "0.70× (16%)") + ". 2018–24 and 2025–26 alike. Added to a range forecast it lifted the 2025–26 R² from " + (hmS.s1.isES ? "0.25 to 0.39" : "0.24 to 0.33") + " (" + hmS.s1.symR + "). Range only, no direction.", hmS.s3.st == "HOT" ? hmS.s1.cHot : hmS.s3.st == "CALM" ? hmS.s1.cCold : hmS.s1.cTx)
            cardRow(hmS, hmS.s2.TS, r0 + 3, hmS.s2.cVx, "DAY", false, "VIX " + (hmS.s3.vDn ? "▼" : "▲") + " today → " + hmS.s1.symR + " closed up", hmS.s3.vOk ? (hmS.s3.vDn ? (hmS.s1.isES ? "80%" : "78%") : (hmS.s1.isES ? "23%" : "25%")) : "—", "of days", "Same day, 2018–26: " + hmS.s1.symR + " closed up (trading day) on " + (hmS.s1.isES ? "80%" : "78%") + " of days VIX fell and " + (hmS.s1.isES ? "23%" : "25%") + " of days it rose. It describes the day, it does not forecast it.")

        // ── DXY card (last three years: Oct 2023 → Aug 2026, first two years then the last one)
    hmS
// @function Step 10: Draw (last bar)
export step10(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        if hmC.showDx and not na(hmS.s2.TS) and hmS.s2.rDx >= 0
            int    r0  = hmS.s2.rDx
            cardHead(hmS, hmS.s2.TS, r0, hmS.s2.cDxc, hmS.s2.dot + " DXY " + (hmS.s3.dOk ? str.tostring(hmF.dxL, "0.00") + "  " + (hmS.s3.net >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(nz(hmS.s1.dxDay)) * 100, "0.00") + "%" : "— (no data)"), "DXY since the 18:00 open.", hmS.s3.big ? "BIG DAY" : "USUAL DAY", hmS.s3.big ? #ffffff : hmS.s1.cTx, hmS.s3.big ? hmS.s1.cHot : hmS.s2.cNeu)
            cardSub(hmS, hmS.s2.TS, r0 + 1, hmS.s2.cDxc, "last 3 years · held in both halves", "this", "other")
            cardRow(hmS, hmS.s2.TS, r0 + 2, hmS.s2.cDxc, "RANGE", false, gauge(hmS.s3.dOk ? hmS.s3.rg / hmS.s1.dxAtr : na) + " " + (hmS.s3.dOk ? p0(hmS.s3.rg / hmS.s1.dxAtr) : "—") + " of ATR", hmS.s3.dOk ? str.tostring(hmS.s3.rg, "0.00") : "—", hmS.s3.dOk ? "ATR " + str.tostring(hmS.s1.dxAtr, "0.00") : "—", "DXY's range since the 18:00 open against its 20-day ATR (completed days): how much of a usual day it has used.")
            cardRow(hmS, hmS.s2.TS, r0 + 3, hmS.s2.cDxc, "MOVE", false, gauge(hmS.s3.dOk ? math.abs(hmS.s3.net) / hmS.s3.bigL : na) + " " + (hmS.s3.dOk ? p0(math.min(1.0, math.abs(hmS.s3.net) / hmS.s3.bigL)) : "—") + " to big", hmS.s3.dOk ? (hmS.s3.net >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(hmS.s3.net), "0.00") : "—", hmS.s3.dOk ? "big " + str.tostring(hmS.s3.bigL, "0.00") : "—", "DXY's net move since the 18:00 open against half its ATR20. A big DXY day = a net move of at least ½ ATR.", hmS.s3.big ? hmS.s1.cHot : hmS.s1.cTx)
            cardRow(hmS, hmS.s2.TS, r0 + 4, hmS.s2.cDxc, "✓", true, "big DXY day → " + hmS.s1.symR + " closed other way", hmS.s1.isES ? "65%" : "60%", hmS.s1.isES ? "53%" : "50%", "On big DXY days (net move ≥ ½ ATR20) " + hmS.s1.symR + " closed the trading day the other way to DXY on " + (hmS.s1.isES ? "65% (Oct 2023 – Sep 2025 63%, Oct 2025 – Aug 2026 70%)" : "60% (Oct 2023 – Sep 2025 58%, Oct 2025 – Aug 2026 67%)") + " vs " + (hmS.s1.isES ? "53%" : "50%") + " on other days, n ≈ 270. Same day: it describes how the day finishes; from 10:00, 12:00 or 14:00 on, the rest of the day was a coin flip.")
            cardRow(hmS, hmS.s2.TS, r0 + 5, hmS.s2.cDxc, "✓", true, "DXY 4wk " + (na(hmF.dx4) ? "—" : (hmF.dx4 >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(hmF.dx4) * 100, "0.0") + "%") + " → day range", na(hmF.dx4) ? "—" : hmF.dx4 >= 0 ? (hmS.s1.isES ? "0.96×" : "0.99×") : (hmS.s1.isES ? "0.86×" : "0.88×"), na(hmF.dx4) ? "—" : hmF.dx4 >= 0 ? (hmS.s1.isES ? "0.86×" : "0.88×") : (hmS.s1.isES ? "0.96×" : "0.99×"), "Last completed week's 4-week DXY change. After a 4-week rise " + hmS.s1.symR + " days ran a median " + (hmS.s1.isES ? "0.96× ADR20 vs 0.86×" : "0.99× ADR20 vs 0.88×") + " after a fall (Oct 2023 – Sep 2025 and Oct 2025 – Aug 2026 alike; weekly test p 0.001). Over 2018–24 it did not show, and once VIX is known it adds little.")
            float ybp = na(hmF.ylL) or na(hmS.s1.ylPrev) ? na : (hmF.ylL - hmS.s1.ylPrev) * 100
            cardRow(hmS, hmS.s2.TS, r0 + 6, hmS.s2.cDxc, "10Y", false, na(hmF.ylL) ? "— (no data)" : str.tostring(hmF.ylL, "0.000") + "%  " + (na(ybp) ? "" : (ybp >= 0 ? "▲ " : "▼ ") + str.tostring(math.abs(ybp), "0.0") + "bp today"), "", "live", "US 10-year yield, live. Nothing about it held as a range or direction signal here (monthly data only), so it is a readout.")

        // ── mobile card: one narrow table. Header (event · when), NOW (the clock in one row), the held rows in short form or
        // the tally, then VIX and DXY in one row each. Every row keeps its full explanation in the tooltip.
    if (barstate.islast and hmC.on)
        if hmS.s2.mob and not na(hmS.s2.TM)
            if hmC.showEv and hmS.s2.mEv >= 0
                int    r0  = hmS.s2.mEv
                string bdg = hmS.s2.pNow ? "TODAY" : na(hmS.s2.dd) ? "—" : hmS.s2.dd == 1 ? "TMRW" : str.upper(str.format_time(keyTime(hmS.s2.pDay), "EEE d", TZ))
                string hTip = pfName(hmS.s2.pk) + ". Recomputed on " + hmS.s1.symR + " 1-minute data 2018–26." + (hmS.s1.isNQ or hmS.s1.isES ? "" : " This chart is " + syminfo.root + ": the figures are " + hmS.s1.symR + "'s.") + " Next: " + (na(hmS.s2.n1k) ? "beyond the loaded dates" : whenTxt(hmS.s2.n1k, hmS.s2.today)) + (na(hmS.s2.n2k) ? "" : ", then " + fmtDay(hmS.s2.n2k)) + "." + (hmS.s2.warn ? " Release dates run out on " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's to S_FOMC, S_CPI and S_NFP." : "")
                cardHead(hmS, hmS.s2.TM, r0, hmC.cGh, hmS.s2.dot + " " + str.upper("Gran Rey") + " · " + hmS.s2.ev + " · " + hmS.s1.symTag, hTip, hmS.s2.warn ? "UPDATE" : bdg, hmS.s2.warn or not hmS.s2.pNow ? #ffffff : hmC.cGh, hmS.s2.warn ? hmS.s1.cWarn : hmS.s2.pNow ? #ffffff : color.new(#000000, 55))
                if hmS.s2.clkTF and not na(hmS.s2.vAdr)
                    float  q50m = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                    string nTip = "Today so far (" + (hmS.s2.clkR ? "range" : "net move") + " from the 18:00 open) against " + ckName(hmS.s2.ckI) + " days at this time: median " + pf(q50m * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts at today's ADR20 (" + x2(q50m) + " typical, " + x2(hmS.s2.vAdr) + " today). Above / below = outside that middle half."
                    cardRow(hmS, hmS.s2.TM, r0 + 1, hmC.cGh, "NOW", false, (hmS.s2.clkR ? "range " : "net ") + (hmS.s2.clkR or hmS.s2.vPts < 0 ? "" : "+") + pf(hmS.s2.vPts), x2(hmS.s2.vAdr), "", nTip)
                    tc(hmS, hmS.s2.TM, 4, r0 + 1, str.upper(hmS.s2.stB), hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff, hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu, nTip, text.align_center, true)
                else
                    cardRow(hmS, hmS.s2.TM, r0 + 1, hmC.cGh, "NOW", false, not hmS.s2.clkTF ? "clock: chart ≤ 60 min" : "needs 15+ days", "", "", "")
                if hmC.evMode == "Checklist"
                    array<string> rows = str.split(chkRows(hmS.s2.pk, hmS.s1.isES), "|")
                    for i = 0 to chkMax(hmS.s1.isES) - 1
                        if i < rows.size() and rows.get(i) != ""
                            array<string> f = str.split(rows.get(i), "~")
                            string lab = str.replace_all(str.replace_all(str.replace_all(f.get(0), " (× ADR)", ""), " on the day", ""), " side", "")
                            cardRow(hmS, hmS.s2.TM, r0 + 2 + i, hmC.cGh, "✓", true, lab, f.size() > 1 ? f.get(1) : "", f.size() > 2 ? f.get(2) : "", (f.size() > 3 ? f.get(3) : "") + " Held 2018–24 and 2025–26; grey = normal days.")
                        else
                            cardRow(hmS, hmS.s2.TM, r0 + 2 + i, hmC.cGh, "", false, i == 0 ? "nothing held on " + hmS.s1.symR : "", "", "", "")
                else
                    cardRow(hmS, hmS.s2.TM, r0 + 2, hmC.cGh, "DAY", false, "last " + str.tostring(hmS.s2.nT) + " " + gauge5(hmS.s2.uT + hmS.s2.dT_ > 0 ? float(hmS.s2.uT) / (hmS.s2.uT + hmS.s2.dT_) : na), "▲ " + str.tostring(hmS.s2.uT), "▼ " + str.tostring(hmS.s2.dT_), hmS.s3.tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                    cardRow(hmS, hmS.s2.TM, r0 + 3, hmC.cGh, "GAP", false, "avg gap · up " + str.tostring(int(hmS.s2.acc.get(9))) + "/" + str.tostring(hmS.s2.nG), na(hmS.s2.gAvg) ? "—" : (hmS.s2.gAvg >= 0 ? "+" : "") + pf(hmS.s2.gAvg), na(hmS.s2.gAbs) ? "—" : "±" + pf(hmS.s2.gAbs), hmS.s3.gTip)
                    zoneRowM(hmS, hmS.s2.TM, r0 + 4, hmC.cGh, "WK", hmF.wH, hmF.wL, "week")
                    zoneRowM(hmS, hmS.s2.TM, r0 + 5, hmC.cGh, "MO", hmF.moH, hmF.moL, "month")
            if hmC.showVx and hmS.s2.mVx >= 0
                string vTip = "VIX " + (hmS.s3.vOk ? str.tostring(hmF.vixL, "0.00") : "—") + ", prior close " + (na(hmS.s1.vPrev) ? "—" : str.tostring(hmS.s1.vPrev, "0.00")) + " against its 20-day average " + (na(hmS.s1.vAvg) ? "—" : str.tostring(hmS.s1.vAvg, "0.00")) + " (" + (na(hmS.s3.vsp) ? "—" : (hmS.s3.vsp >= 0 ? "+" : "−") + str.tostring(math.abs(hmS.s3.vsp) * 100, "0") + "%") + "). Days with VIX ≥ 10% above its average ran a median " + (hmS.s1.isES ? "1.37×" : "1.27×") + " ADR20, within ±10% " + (hmS.s1.isES ? "0.90×" : "0.91×") + ", ≥ 10% below " + (hmS.s1.isES ? "0.64×" : "0.70×") + " (" + hmS.s1.symR + ", 2018–24 and 2025–26 alike): today's bucket is " + hmS.s3.bR + ", above ADR on " + hmS.s3.bA + " of such days. Same day: " + hmS.s1.symR + " closed up on " + (hmS.s1.isES ? "80%" : "78%") + " of days VIX fell and " + (hmS.s1.isES ? "23%" : "25%") + " of days it rose (it describes the day, it does not forecast it)."
                cardRow(hmS, hmS.s2.TM, hmS.s2.mVx, hmS.s2.cVx, "VIX", false, hmS.s3.vOk ? str.tostring(hmF.vixL, "0.00") + " " + (hmS.s3.vch >= 0 ? "▲" : "▼") + str.tostring(math.abs(hmS.s3.vch) * 100, "0.0") + "%" : "no data", hmS.s3.bR, "", vTip, hmS.s3.st == "HOT" ? hmS.s1.cHot : hmS.s3.st == "CALM" ? hmS.s1.cCold : hmS.s1.cTx)
                tc(hmS, hmS.s2.TM, 4, hmS.s2.mVx, hmS.s3.st == "NORMAL" ? "NORM" : hmS.s3.st, hmS.s3.st == "HOT" or hmS.s3.st == "CALM" ? #ffffff : hmS.s1.cTx, hmS.s3.st == "HOT" ? hmS.s1.cHot : hmS.s3.st == "CALM" ? hmS.s1.cCold : hmS.s2.cNeu, vTip, text.align_center, true)
            if hmC.showDx and hmS.s2.mDx >= 0
                float  fr   = hmS.s3.dOk ? math.min(1.0, math.abs(hmS.s3.net) / hmS.s3.bigL) : na
                string xTip = "DXY " + (hmS.s3.dOk ? str.tostring(hmF.dxL, "0.00") + ", " + (hmS.s3.net >= 0 ? "+" : "−") + str.tostring(math.abs(hmS.s3.net), "0.00") + " since the 18:00 open; its range so far is " + p0(hmS.s3.rg / hmS.s1.dxAtr) + " of its 20-day ATR (" + str.tostring(hmS.s1.dxAtr, "0.00") + ")" : "—") + ". The battery is the net move against ½ ATR (" + (hmS.s3.dOk ? str.tostring(hmS.s3.bigL, "0.00") : "—") + "), the line for a big DXY day. On big days " + hmS.s1.symR + " closed the trading day the other way to DXY on " + (hmS.s1.isES ? "65%" : "60%") + " vs " + (hmS.s1.isES ? "53%" : "50%") + " of other days (Oct 2023 – Aug 2026, held in both halves). Same day: it describes how the day finishes."
                cardRow(hmS, hmS.s2.TM, hmS.s2.mDx, hmS.s2.cDxc, "DXY", false, not hmS.s3.dOk ? "no data" : hmS.s3.big ? hmS.s1.symR + " other way " + (hmS.s1.isES ? "65%" : "60%") : gauge5(fr) + " " + p0(fr), hmS.s3.dOk ? (hmS.s3.net >= 0 ? "▲" : "▼") + str.tostring(math.abs(nz(hmS.s1.dxDay)) * 100, "0.00") + "%" : "—", "", xTip, hmS.s3.big ? hmS.s1.cHot : hmS.s1.cTx)
                tc(hmS, hmS.s2.TM, 4, hmS.s2.mDx, hmS.s3.big ? "BIG" : "USUAL", hmS.s3.big ? #ffffff : hmS.s1.cTx, hmS.s3.big ? hmS.s1.cHot : hmS.s2.cNeu, xTip, text.align_center, true)

        // ── clock card
    if (barstate.islast and hmC.on)
        if hmC.showCk and not na(hmS.s2.TK)
            string bN   = ckName(hmS.s2.ckI)
            string eN   = ckName(hmS.s2.ckEvI)
            string nowT = hhmm(int(math.min(1439.0, (hmS.s2.elM + hmS.s1.tfM + 1080) % 1440)))
            int    r0   = hmS.s2.tkO
            cardHead(hmS, hmS.s2.TK, r0, hmC.cGh, hmS.s2.dot + " " + str.upper("Gran Rey Cero") + " · CLOCK · " + nowT + " ET", "Today's running range (or net move) from the 18:00 open against the same time of day on " + bN + " days, 2018–26: paths from " + ckN(hmS.s2.ckI, hmS.s1.isES) + " " + bN + " days" + (hmS.s2.ckI != NCK - 1 ? " and " + ckN(NCK - 1, hmS.s1.isES) + " normal days" : "") + ", half-hour steps, scaled by today's ADR20" + (hmS.s2.scP > 0 ? " (" + pf(hmS.s2.scP) + " pts)." : "."), hmS.s2.ckEv ? eN + " DAY" : "NORMAL", hmS.s2.ckEv ? hmC.cGh : #ffffff, hmS.s2.ckEv ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.clkTF or na(hmS.s2.vAdr)
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "CLOCK", false, not hmS.s2.clkTF ? "needs an intraday chart ≤ 60 min" : "needs 15+ days of history", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "", false, "", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "", false, "", "", "", "")
            else
                float q10 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 0, hmS.s2.jB, hmS.s2.fB)
                float q50 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                float q90 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, hmS.s2.jB, hmS.s2.fB)
                float pc  = pctQ(hmS.s2.vAdr, q10, hmS.s2.q25B, q50, hmS.s2.q75B, q90)
                string mW = hmS.s2.clkR ? "range" : "net"
                color sBg = hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu
                color sFg = hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "NOW", false, mW + " " + (hmS.s2.clkR ? "" : hmS.s2.vPts >= 0 ? "+" : "") + pf(hmS.s2.vPts) + " pts", x2(hmS.s2.vAdr), "", "Today so far, in ADR20 of the trading day.")
                tc(hmS, hmS.s2.TK, 4, r0 + 1, pill(hmS.s2.stB), sFg, sBg, "Above / below = outside the middle half (25–75%) of " + bN + " days at this time.", text.align_center, true)
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "vs " + bN, false, meter(pc) + " " + pTxt(pc), "typ " + x2(q50), "", bN + " days by " + nowT + ": median " + pf(q50 * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts (" + mW + ", at today's ADR20).", hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx)
                float sh = ckShAt(hmS, hmS.s2.ckI, hmS.s2.jB, hmS.s2.fB)
                float rgT = hmS.s1.tdH - hmS.s1.tdL
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "DONE", false, gauge(sh) + " " + p0(sh), sh >= 0.25 ? "→ " + pf(rgT / sh) : "—", "pts", "Median share of the final day range already made by this time on " + bN + " days; right: today's range so far ÷ that share, a rough full-day figure (shown from 25% on).")
            float bestD = -1.0
            int   bestJ = 0
            for j = 0 to 45
                float dj = ck(hmS, hmS.s2.ckEvI, 0, 2, j) - (j > 0 ? ck(hmS, hmS.s2.ckEvI, 0, 2, j - 1) : 0.0)
                if dj > bestD
                    bestD := dj
                    bestJ := j
            float nD = ck(hmS, NCK - 1, 0, 2, bestJ) - (bestJ > 0 ? ck(hmS, NCK - 1, 0, 2, bestJ - 1) : 0.0)
            cardRow(hmS, hmS.s2.TK, r0 + 4, hmC.cGh, "BUSIEST", false, hhmm(stepEnd(bestJ - 1)) + "–" + hhmm(stepEnd(bestJ)), "+" + x2(bestD), "norm +" + x2(nD), "The half hour in which the median running range of " + eN + " days grows most, against normal days in the same half hour.", hmS.s2.ckEv ? hmC.cGh : hmS.s1.cTx)
    hmS
// @function The day this module's cards read (yyyymmdd): today's trading day when it is one of its days, else the next.
export nextDay(State hmS) =>
    [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
    d_

// @function A new, empty State with all its parts. Hold it with var.
export newState() =>
    State.new(StatePart1.new(), StatePart2.new(), StatePart3.new())

plot(na, "Hueco Mundo module", display = display.none)
