// @type Everything the module keeps from bar to bar, in parts. Make one with newState().
export type State
    StatePart1 s1
    StatePart2 s2
    StatePart3 s3

// ═══════════════════════════════════════════════════════════════ Functions
parseDates(string s) =>
    array<int> out = array.new<int>()
    for p in str.split(s, ",")
        out.push(int(str.tonumber(p)))
    out
parseStats(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p))
    out
unpackMilli(string s) =>
    array<float> out = array.new<float>()
    for i = 0 to int(str.length(s) / 2) - 1
        out.push((str.pos(P92, str.substring(s, 2 * i, 2 * i + 1)) * 92 + str.pos(P92, str.substring(s, 2 * i + 1, 2 * i + 2)) - 2000) / 1000.0)
    out
parseMilli(string s) =>
    array<float> out = array.new<float>()
    for r in str.split(s, ";")
        for p in str.split(r, ",")
            out.push(str.tonumber(p) / 1000.0)
    out
ck(State hmS, int i, int m, int k, int j) => hmS.s1.CK.get(i * CKB + m * 230 + k * 46 + j)
ckSh(State hmS, int i, int j) => hmS.s1.CK.get(i * CKB + 460 + j)
ckAt(State hmS, int i, int m, int k, int j, float f) =>
    float b  = ck(hmS, i, m, k, j)
    float a0 = j > 0 ? ck(hmS, i, m, k, j - 1) : 0.0
    a0 + (b - a0) * f
ckShAt(State hmS, int i, int j, float f) =>
    float b  = ckSh(hmS, i, j)
    float a0 = j > 0 ? ckSh(hmS, i, j - 1) : 0.0
    a0 + (b - a0) * f
lsOf(string s) => s == "Solid" ? line.style_solid : s == "Dotted" ? line.style_dotted : line.style_dashed
posOf(string s) =>
    switch s
        "Top left"      => position.top_left
        "Top center"    => position.top_center
        "Top right"     => position.top_right
        "Middle left"   => position.middle_left
        "Middle right"  => position.middle_right
        "Bottom left"   => position.bottom_left
        "Bottom center" => position.bottom_center
        => position.bottom_right
dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
keyTime(int k) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, 12, 0)
keyAt(int k, int m) => timestamp(TZ, int(k / 10000), int(k / 100) % 100, k % 100, int(m / 60), m % 60)
addDays(int k, int n) => dateKey(keyTime(k) + n * 86400000)
anchorKey(int an, int t) => an == 0 ? dateKey(t + 6 * 3600000) : dateKey(t)
inWin(int an, int m) => an == 0 ? true : an == 1 ? m < 1020 : m >= 570 and m < 975
winBars(int an) => an == 0 ? 92 : an == 1 ? 68 : 27
pf(float v) => str.tostring(v, format.mintick)
x2(float v) => str.tostring(v, "0.00") + "×"
p0(float v) => str.tostring(v * 100, "0") + "%"
fmtDay(int k) => str.format_time(keyTime(k), "EEE dd MMM", TZ)
dowOf(int k) => dayofweek(keyTime(k), TZ)
hhmm(int m) => (m / 60 < 10 ? "0" : "") + str.tostring(int(m / 60)) + ":" + (m % 60 < 10 ? "0" : "") + str.tostring(m % 60)
stepEnd(int j) => (1080 + 30 * (j + 1)) % 1440
dayType(State hmS, int k, int pk) =>
    int  dw  = dowOf(k)
    bool hol = false
    if dw >= 2 and dw <= 5
        for j = 1 to 6 - dw
            if hmS.s1.NP.includes(addDays(k, j))
                hol := true
    hmS.s1.FO.includes(k) ? 0 : hmS.s1.NP.includes(k) ? 1 : hmS.s1.CP.includes(k) ? 2 : hmS.s1.FO.includes(pk) ? 3 : hmS.s1.FO.includes(addDays(k, 1)) ? 4 : hol ? 5 : 6
typeShort(int ty) =>
    switch ty
        0 => "FOMC"
        1 => "NFP"
        2 => "CPI"
        3 => "FOMC +1"
        4 => "FOMC D1"
        5 => "NFP week"
        => "Normal"
nextOf(array<int> a, int k) =>
    int r = na
    for d in a
        if d >= k
            r := d
            break
    r
inDays(int k, int today) => int(math.round((keyTime(k) - keyTime(today)) / 86400000.0))
whenTxt(int k, int today) =>
    int dd = inDays(k, today)
    fmtDay(k) + (dd == 0 ? " · today" : dd == 1 ? " · tomorrow" : " · in " + str.tostring(dd) + "d")
pctQ(float x, float q10, float q25, float q50, float q75, float q90) =>
    float p = na
    if not na(x) and not na(q10) and not na(q90)
        if x < q10
            p := 5.0
        else if x <= q25
            p := 10.0 + 15.0 * (x - q10) / math.max(q25 - q10, 1e-9)
        else if x <= q50
            p := 25.0 + 25.0 * (x - q25) / math.max(q50 - q25, 1e-9)
        else if x <= q75
            p := 50.0 + 25.0 * (x - q50) / math.max(q75 - q50, 1e-9)
        else if x <= q90
            p := 75.0 + 15.0 * (x - q75) / math.max(q90 - q75, 1e-9)
        else
            p := 95.0
    p
pTxt(float p) => na(p) ? "—" : p <= 5.0 ? "<P10" : p >= 95.0 ? ">P90" : "≈P" + str.tostring(p, "0")
pill(string s) => s == "Above" ? "▲ ABOVE" : s == "Below" ? "▼ BELOW" : s == "Inside" ? "● INSIDE" : "—"
pfName(int k) =>
    switch k
        0 => "M11 HOLLOW · NFP week Monday"
        1 => "M11 HOLLOW · NFP week Tuesday"
        2 => "M11 HOLLOW · NFP week Wednesday"
        3 => "M11 HOLLOW · NFP week Thursday"
        4 => "M12 FULL BRINGER · day after FOMC"
        => ""
ownTy(int k) =>
    switch k
        0 => 5
        1 => 5
        2 => 5
        3 => 5
        4 => 3
        => 6
talIs(State hmS, int k, int pk) => hmS.s1.FO.includes(pk)
ownCk(int k) =>
    switch k
        0 => 0
        1 => 0
        2 => 0
        3 => 0
        4 => 1
        => 0
ckName(int k) =>
    switch k
        0 => "NFP week"
        1 => "FOMC +1"
        2 => "Normal"
        => ""
ckN(State hmS, int k) =>
    switch k
        0 => hmS.s1.isES ? "324" : hmS.s1.isRTY ? "333" : "323"
        1 => hmS.s1.isRTY ? "68" : "67"
        2 => hmS.s1.isES ? "1416" : hmS.s1.isRTY ? "1441" : "1342"
        => ""
hollowDay(State hmS, int k) =>
    int  dw = dowOf(k)
    bool h  = false
    if dw >= 2 and dw <= 5
        for j = 1 to 6 - dw
            if hmS.s1.NP.includes(addDays(k, j))
                h := true
    h
hollowNext(State hmS, int today) =>
    int n = nextOf(hmS.s1.NP, addDays(today, 1))
    int m = na(n) ? na : math.max(addDays(n, 2 - dowOf(n)), today)
    int f = nextOf(hmS.s1.FO, today)
    int p = na(f) ? na : addDays(f, dowOf(f) == 6 ? 3 : 1)
    [m, p]
ownProfile(State hmS, int tk, int pk, int today) =>
    int  k   = 0
    bool now = false
    int  d   = na
    if hmS.s1.FO.includes(pk)
        k := 4
        now := true
        d := tk
    else if hollowDay(hmS, tk)
        k := dowOf(tk) - 2
        now := true
        d := tk
    else
        [m, p] = hollowNext(hmS, na(tk) ? today : math.max(tk, today))
        k := nz(m, 99999999) <= nz(p, 99999999) ? 0 : 4
        d := k == 0 ? m : p
    [k, now, d]
ownNext(State hmS, int today) =>
    [m, p] = hollowNext(hmS, today)
    ["NFP week", m, "day after FOMC", p]
fdSg(float v, string f) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), f)
vzSg(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), format.mintick)
vzAr(float v) => na(v) or v == 0 ? "·" : v > 0 ? "▲" : "▼"
txAdd(State hmS, string s) =>
    hmS.s1.TXA.push(s)
    hmS.s1.TXA.size() - 1
vh(int i) => str.substring(VH, i, i + 1) == "1"
ctxOf(State hmS, Feed hmF, float c, float h, float l) =>
    float a  = hmF.ADRtd * hmS.s1.tdO
    float mh = math.max(nz(hmF.mtH, h), h)
    float ml = math.min(nz(hmF.mtL, l), l)
    float p  = mh > ml ? (c - ml) / (mh - ml) : na
    float m  = a > 0 ? (c - hmF.mtO) / a : na
    float d  = na(hmS.s1.ptdH) or not (a > 0) ? na : c > hmS.s1.ptdH ? (c - hmS.s1.ptdH) / a : c < hmS.s1.ptdL ? (c - hmS.s1.ptdL) / a : 0.0
    float s  = a > 0 ? (c - hmS.s1.tdO) / a : na
    [p, m, d, s, a]
trimL(State hmS, line l, int e) =>
    if e > time
        l.set_x2(time)
        hmS.s2.GL.push(l)
        hmS.s2.GLE.push(e)
    l
trimT(State hmS, label t, int e) =>
    if e > time
        t.set_x(time)
        hmS.s2.GT.push(t)
        hmS.s2.GTE.push(e)
    t
kPath(State hmS, int i, int m, int k, int t0, float sc, color lc, int lw, string ls) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, k, j) * sc))
    polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = lc, line_width = lw, line_style = ls)
kBand(State hmS, int i, int m, int kUp, int kDn, int t0, float sc, color fc) =>
    array<chart.point> pts = array.new<chart.point>()
    pts.push(chart.point.from_time(t0, 0.0))
    for j = 0 to 45
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kUp, j) * sc))
    for j = 45 to 0
        pts.push(chart.point.from_time(t0 + (j + 1) * 1800000, ck(hmS, i, m, kDn, j) * sc))
    polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = #00000000, fill_color = fc)
drawCore1(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on)
        for p in hmS.s2.KP
            p.delete()
        for l in hmS.s2.KL
            l.delete()
        for t in hmS.s2.KT
            t.delete()
        hmS.s2.KP.clear()
        hmS.s2.KL.clear()
        hmS.s2.KT.clear()
        if hmS.s2.clkGo and hmS.s2.scP > 0
            int   t0  = keyAt(addDays(hmS.s1.tdK, -1), 1080)
            int   tE  = t0 + 46 * 1800000
            color ce  = hmS.s2.ckEv ? hmC.cGh : hmS.s1.cSub
            int   iR  = hmS.s2.ckEv ? NCK - 1 : hmS.s2.ckEvI
            color cR  = hmS.s2.ckEv ? hmS.s1.cMu : color.new(hmC.cGh, 25)
            if hmC.kBands
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 0, t0, hmS.s2.scP, color.new(ce, 90)))
                hmS.s2.KP.push(kBand(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, 1, t0, hmS.s2.scP, color.new(ce, 80)))
            hmS.s2.KP.push(kPath(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, t0, hmS.s2.scP, ce, 2, line.style_solid))
            hmS.s2.KT.push(label.new(tE, ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(hmS.s2.ckI) + " median " + pf(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = ce, style = label.style_label_left, size = size.tiny))
            if hmC.kRef
                hmS.s2.KP.push(kPath(hmS, iR, hmS.s2.mSel, 2, t0, hmS.s2.scP, cR, 1, line.style_dashed))
                hmS.s2.KT.push(label.new(tE, ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP, ckName(iR) + (hmS.s2.ckEv ? "" : " (next)") + " " + pf(ck(hmS, iR, hmS.s2.mSel, 2, 45) * hmS.s2.scP), xloc = xloc.bar_time, color = #00000000, textcolor = cR, style = label.style_label_left, size = size.tiny))
            for s in str.split(REL, ",")
                float rm = str.tonumber(s)
                if not na(rm)
                    int tr = keyAt(hmS.s1.tdK, int(rm))
                    hmS.s2.KL.push(line.new(tr, 0.0, tr, hmS.s2.scP, xloc = xloc.bar_time, extend = extend.both, color = color.new(hmC.cGh, hmS.s2.ckEv ? 30 : 70), style = line.style_dotted))
    true
clearRight(State hmS) =>
    for b in hmS.s2.RB
        b.delete()
    for l in hmS.s2.RL
        l.delete()
    for t in hmS.s2.RT
        t.delete()
    hmS.s2.RB.clear()
    hmS.s2.RL.clear()
    hmS.s2.RT.clear()
gapOf(string on, string p) => p == "Top left" or p == "Top center" or (p == "Top right" and on == "Indicator pane")
tc(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    t.cell(c, r, s, text_color = fg, bgcolor = bg, text_size = hmS.s1.crdSz, text_halign = ha, tooltip = tip, text_font_family = font.family_monospace, text_formatting = b ? text.format_bold : text.format_none)
stripe(table t, int r, color col) =>
    t.cell(0, r, "", bgcolor = col, width = 0.25)
cardHead(State hmS, table t, int r, color col, string title, string tip, string pill, color pfg, color pbg) =>
    hmS.s2.CQ.push(CRow.new(t, 1, r, 0, col, title, "", "", pill, tip, false, pfg, pbg))
cardSub(State hmS, table t, int r, color col, string txt, string a1, string a2) =>
    hmS.s2.CQ.push(CRow.new(t, 2, r, 0, col, "", txt, a1, a2))
cardRow(State hmS, table t, int r, color col, string key, bool held, string lab, string v, string b, string tip, color vfg = na, color bfg = na) =>
    hmS.s2.CQ.push(CRow.new(t, 0, r, 0, col, key, lab, v, b, tip, held, vfg, bfg))
cardWide(State hmS, table t, int r, color col, string key, string txt, string tip, color fg) =>
    hmS.s2.CQ.push(CRow.new(t, 3, r, 0, col, key, txt, "", "", tip, false, fg))
tcQ(State hmS, table t, int c, int r, string s, color fg, color bg, string tip = "", string ha = text.align_left, bool b = false) =>
    hmS.s2.CQ.push(CRow.new(t, 4, r, c, na, s, "", "", "", tip, b, fg, bg, ha))
stripeQ(State hmS, table t, int r, color col) =>
    hmS.s2.CQ.push(CRow.new(t, 5, r, 0, col))
gauge(float frac) =>
    string out = "░░░░░░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 10))
        out := str.repeat("█", k) + str.repeat("░", 10 - k)
    out
gauge5(float frac) =>
    string out = "░░░░░"
    if not na(frac)
        int k = int(math.round(math.max(0.0, math.min(1.0, frac)) * 5))
        out := str.repeat("█", k) + str.repeat("░", 5 - k)
    out
meter(float p) =>
    string out = "──────────"
    if not na(p)
        int k = int(math.round(math.max(0.0, math.min(100.0, p)) / 10.0))
        out := str.repeat("─", k) + "●" + str.repeat("─", 10 - k)
    out
octBar(int o) =>
    string out = ""
    for i = 1 to 8
        out += i == o ? "█" : "░"
    out
octOf(float px, float h, float l) => na(h) or na(l) or h <= l ? na : math.min(8, int(math.floor((px - l) / (h - l) * 8)) + 1)
zoneOf(State hmS, float h, float l) =>
    int    o  = octOf(close, h, l)
    string z  = na(o) ? "—" : o >= 7 ? "PREM" : o <= 2 ? "DISC" : "EQ"
    color  zb = na(o) ? hmS.s2.cBody : o >= 7 ? hmS.s2.cPrem : o <= 2 ? hmS.s2.cDisc : hmS.s2.cNeu
    color  zf = na(o) or (o > 2 and o < 7) ? hmS.s1.cTx : #ffffff
    [o, z, zb, zf]
zoneTip(int o, float h, float l, string what) =>
    "This " + what + "'s range so far " + pf(l) + " – " + pf(h) + ": price is " + (na(o) ? "—" : p0((close - l) / (h - l))) + " of the way up (octant " + (na(o) ? "—" : str.tostring(o)) + " of 8), " + (na(l) ? "—" : pf(close - l)) + " above the low and " + (na(h) ? "—" : pf(h - close)) + " below the high (right). Top quarter (octants 7–8) = premium, bottom quarter (1–2) = discount. A locator, not a tested signal."
zoneRow(State hmS, table t, int r, color col, string key, float h, float l, string what) =>
    [o, z, zb, zf] = zoneOf(hmS, h, l)
    string tip = zoneTip(o, h, l, what)
    stripeQ(hmS, t, r, col)
    tcQ(hmS, t, 1, r, key, hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
    tcQ(hmS, t, 2, r, octBar(o) + " O" + (na(o) ? "—" : str.tostring(o)), hmS.s1.cTx, hmS.s2.cBody, tip)
    tcQ(hmS, t, 3, r, z, zf, zb, tip, text.align_center, true)
    tcQ(hmS, t, 4, r, na(h) ? "—" : "−" + str.tostring(h - close, "0"), hmS.s1.cMu, hmS.s2.cBody, tip, text.align_center)
talAcc(array<float> acc, int t_, int r_, float g_, float p_) =>
    acc.set(0, acc.get(0) + 1)
    acc.set(1, acc.get(1) + (t_ > 0 ? 1 : 0))
    acc.set(2, acc.get(2) + (t_ < 0 ? 1 : 0))
    acc.set(3, acc.get(3) + (r_ > 0 ? 1 : 0))
    acc.set(4, acc.get(4) + (r_ < 0 ? 1 : 0))
    if not na(g_)
        acc.set(5, acc.get(5) + 1)
        acc.set(6, acc.get(6) + g_)
        acc.set(7, acc.get(7) + math.abs(g_))
        acc.set(8, acc.get(8) + (na(p_) ? 0.0 : math.abs(p_)))
        acc.set(9, acc.get(9) + (g_ > 0 ? 1 : 0))
drawCore2(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        clearRight(hmS)
        bool   pend = hmS.s1.AN == 2 and hmS.s1.mod < 570                      // RTH not open yet: the model sits on the last price
        int    tKey = pend ? hmS.s1.calK : hmS.s1.dK
        int    today = hmS.s1.calK
        [pk, pNow, pDay] = ownProfile(hmS, tKey, pend ? hmS.s1.dK : hmS.s1.pK, today)
        int    mTy  = ownTy(pk)                                  // this indicator's own event, never another event's
        bool   live = pNow and not pend
        bool   hasD = not pend and not na(hmS.s1.dO)
        float  O    = hasD ? hmS.s1.dO : close
        // ── cards
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        int    dd   = na(pDay) ? na : inDays(pDay, today)
        string ev   = typeShort(mTy)
        [n1t, n1k, n2t, n2k] = ownNext(hmS, today)
        bool   warn = inDays(LAST_DATE, today) < 60
        // tally of the last N event days (both layouts): this chart's own records first, then built-in ones older than those
        array<float> acc = array.new_float(10, 0.0)
        string seq = ""
        int    d0  = na
        if hmC.showEv
            if hmS.s1.LTd.size() > 0
                for i = hmS.s1.LTd.size() - 1 to 0
                    if acc.get(0) < hmC.talN
                        talAcc(acc, hmS.s1.LTt.get(i), hmS.s1.LTr.get(i), hmS.s1.LTg.get(i), hmS.s1.LTp.get(i))
                        seq := (hmS.s1.LTt.get(i) > 0 ? "▲" : hmS.s1.LTt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s1.LTd.get(i)
            int oldest = hmS.s1.LTd.size() > 0 ? hmS.s1.LTd.get(0) : 99999999
            if hmS.s2.TEd.size() > 0
                for i = hmS.s2.TEd.size() - 1 to 0
                    if acc.get(0) < hmC.talN and hmS.s2.TEd.get(i) < oldest
                        talAcc(acc, hmS.s2.TEt.get(i), hmS.s2.TEr.get(i), hmS.s2.TEg.get(i), hmS.s2.TEp.get(i))
                        seq := (hmS.s2.TEt.get(i) > 0 ? "▲" : hmS.s2.TEt.get(i) < 0 ? "▼" : "·") + seq
                        d0 := hmS.s2.TEd.get(i)
        int    nT   = int(acc.get(0))
        int    uT   = int(acc.get(1))
        int    dT_  = int(acc.get(2))
        int    uR   = int(acc.get(3))
        int    dR_  = int(acc.get(4))
        int    nG   = int(acc.get(5))
        float  gAvg = nG > 0 ? acc.get(6) / nG : na
        float  gAbs = nG > 0 ? acc.get(7) / nG : na
        string since = na(d0) ? "" : " since " + str.format_time(keyTime(d0), "MMM yyyy", TZ)
        string srcT = hmS.s2.TEd.size() > 0 ? " Built-in " + hmS.s1.symR + " records run to " + str.format_time(keyTime(hmS.s1.talEnd), "dd MMM yyyy", TZ) + "; later days, and any this chart loads itself, come from the chart's own bars." : " Records come from this chart's own bars (built-in history covers NQ / MNQ, ES / MES and RTY / M2K)."
        string tTip = "Trading day (18:00 → 17:00) close vs open on the last " + str.tostring(nT) + " " + TAL_NAME + " days" + since + ", oldest → newest: " + seq + ". RTH (09:30 → 16:14): ▲ " + str.tostring(uR) + " ▼ " + str.tostring(dR_) + ". A tally, not a forecast: across 2018–26 the up-close rate on these days was not different from normal days." + srcT
        string gTip = "RTH gap = 09:30 open − prior trading day's 16:14 close. Average over the last " + str.tostring(nG) + " " + TAL_NAME + " days: " + (na(gAvg) ? "—" : pf(gAvg)) + " pts; average size " + (na(gAbs) ? "—" : pf(gAbs) + " pts (" + str.tostring(acc.get(8) / nG, "0.00") + "%)") + "; gapped up on " + str.tostring(int(acc.get(9))) + " of " + str.tostring(nG) + "."
        bool   nxW  = not na(n1k) and (na(n2k) or n1k <= n2k)
        int    nxK  = nxW ? n1k : n2k
        string nxT  = na(nxK) ? "beyond loaded dates" : (nxW ? "NFP week " : "FOMC +1 ") + str.format_time(keyTime(nxK), "dd MMM", TZ) + (nxK == today ? " · today" : " · " + str.tostring(inDays(nxK, today)) + "d") + (warn ? " · UPDATE" : "")
        string nxTip = "Next NFP week (Mon–Thu): " + (na(n1k) ? "beyond the loaded dates" : fmtDay(n1k)) + " · next day after FOMC: " + (na(n2k) ? "beyond the loaded dates" : fmtDay(n2k)) + ". Release dates are built in up to " + str.format_time(keyTime(LAST_DATE), "dd MMM yyyy", TZ) + ": add next year's dates (bls.gov/schedule, federalreserve.gov) to S_FOMC, S_CPI and S_NFP, then raise LAST_DATE."
        string hdT  = pfName(pk) + ". Clock and tally: " + hmS.s1.symR + " 1-minute data 2018–26; stages card and Shirosaki: NQ + ES + RTY pooled." + (hmS.s1.isNQ or hmS.s1.isES or hmS.s1.isRTY ? "" : " This chart is " + syminfo.root + ": the clock and tally are " + hmS.s1.symR + "'s.")
        string pill_ = pNow ? "TODAY" : na(dd) ? "—" : dd == 1 ? "TMRW" : "IN " + str.tostring(dd) + "D"
        if hmC.showEv and not na(hmS.s2.TS)
            int r0 = hmS.s2.tsO
            cardHead(hmS, hmS.s2.TS, r0, hmC.cGh, dot + " HOLLOW · " + ev + " · " + hmS.s1.symTag, hdT + " " + nxTip, hmS.s2.mob and warn ? "UPDATE" : pill_, hmS.s2.mob and warn or not pNow ? #ffffff : hmC.cGh, hmS.s2.mob and warn ? hmS.s1.cWarn : pNow ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.mob
                cardSub(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "last " + str.tostring(nT) + " " + TAL_NAME + " days", "▲", "▼")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, gauge(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na) + " " + (uT + dT_ > 0 ? p0(float(uT) / (uT + dT_)) : "—"), str.tostring(uT), str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "RTH", false, gauge(uR + dR_ > 0 ? float(uR) / (uR + dR_) : na) + " " + (uR + dR_ > 0 ? p0(float(uR) / (uR + dR_)) : "—"), str.tostring(uR), str.tostring(dR_), "RTH 09:30 → 16:14 close vs open on the same days (days without RTH data are left out).", hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 4, hmC.cGh, "GAP", false, "avg gap · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 5 + zi, hmC.cGh, zi == 0 ? "WEEK" : "MONTH", zi == 0 ? hmF.wH : hmS.s1.mHi, zi == 0 ? hmF.wL : hmS.s1.mLo, zi == 0 ? "week" : "month")
                cardWide(hmS, hmS.s2.TS, r0 + hmS.s2.EV_N - 1, hmC.cGh, "NEXT", nxT, nxTip, na(n1k) or warn ? hmS.s1.cWarn : hmS.s1.cTx)
            else
                // mobile: NOW reads the clock in one row, then the tally in short form
                if hmS.s2.clkTF and not na(hmS.s2.vAdr)
                    float  q50m = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                    string nTip = "Today so far (" + (hmS.s2.clkR ? "range" : "net move") + " from the 18:00 open) against " + ckName(hmS.s2.ckI) + " days at this time: median " + pf(q50m * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts at today's ADR20 (" + x2(q50m) + " typical, " + x2(hmS.s2.vAdr) + " today). Above / below = outside that middle half."
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, (hmS.s2.clkR ? "range " : "net ") + (hmS.s2.clkR or hmS.s2.vPts < 0 ? "" : "+") + str.tostring(hmS.s2.vPts, "0"), x2(hmS.s2.vAdr), "", nTip)
                    tcQ(hmS, hmS.s2.TS, 4, r0 + 1, str.upper(hmS.s2.stB), hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff, hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu, nTip, text.align_center, true)
                else
                    cardRow(hmS, hmS.s2.TS, r0 + 1, hmC.cGh, "NOW", false, not hmS.s2.clkTF ? "clock: ≤ 60 min" : "needs 15+ days", "", "", "")
                cardRow(hmS, hmS.s2.TS, r0 + 2, hmC.cGh, "DAY", false, "last " + str.tostring(nT) + " " + gauge5(uT + dT_ > 0 ? float(uT) / (uT + dT_) : na), "▲" + str.tostring(uT), "▼" + str.tostring(dT_), tTip, hmS.s2.cDisc, hmS.s2.cPrem)
                cardRow(hmS, hmS.s2.TS, r0 + 3, hmC.cGh, "GAP", false, "avg · ▲" + str.tostring(int(acc.get(9))) + "/" + str.tostring(nG), na(gAvg) ? "—" : (gAvg >= 0 ? "+" : "") + str.tostring(gAvg, "0.0"), na(gAbs) ? "—" : "±" + str.tostring(gAbs, "0.0"), gTip)
                for zi = 0 to 1
                    zoneRow(hmS, hmS.s2.TS, r0 + 4 + zi, hmC.cGh, zi == 0 ? "WK" : "MO", zi == 0 ? hmF.wH : hmS.s1.mHi, zi == 0 ? hmF.wL : hmS.s1.mLo, zi == 0 ? "week" : "month")
    true
drawCore2B(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on)
        string dot = barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
        // ── clock card
        if hmC.showCk and not na(hmS.s2.TK)
            string bN   = ckName(hmS.s2.ckI)
            string eN   = ckName(hmS.s2.ckEvI)
            string nowT = hhmm(int(math.min(1439.0, (hmS.s2.elM + hmS.s1.tfM + 1080) % 1440)))
            int    r0   = hmS.s2.tkO
            cardHead(hmS, hmS.s2.TK, r0, hmC.cGh, dot + " " + "HOLLOW · CLOCK · " + nowT + " ET", "Today's running range (or net move) from the 18:00 open against the same time of day on " + bN + " days, 2018–26: paths from " + ckN(hmS, hmS.s2.ckI) + " " + bN + " days" + (hmS.s2.ckI != NCK - 1 ? " and " + ckN(hmS, NCK - 1) + " normal days" : "") + ", half-hour steps, scaled by today's ADR20" + (hmS.s2.scP > 0 ? " (" + pf(hmS.s2.scP) + " pts)." : "."), hmS.s2.ckEv ? eN + " DAY" : "NORMAL", hmS.s2.ckEv ? hmC.cGh : #ffffff, hmS.s2.ckEv ? #ffffff : color.new(#000000, 55))
            if not hmS.s2.clkTF or na(hmS.s2.vAdr)
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "CLOCK", false, not hmS.s2.clkTF ? "needs an intraday chart ≤ 60 min" : "needs 15+ days of history", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "", false, "", "", "", "")
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "", false, "", "", "", "")
            else
                float q10 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 0, hmS.s2.jB, hmS.s2.fB)
                float q50 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 2, hmS.s2.jB, hmS.s2.fB)
                float q90 = ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, hmS.s2.jB, hmS.s2.fB)
                float pc  = pctQ(hmS.s2.vAdr, q10, hmS.s2.q25B, q50, hmS.s2.q75B, q90)
                string mW = hmS.s2.clkR ? "range" : "net"
                color sBg = hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s2.cNeu
                color sFg = hmS.s2.stB == "Inside" ? hmS.s1.cTx : #ffffff
                cardRow(hmS, hmS.s2.TK, r0 + 1, hmC.cGh, "NOW", false, mW + " " + (hmS.s2.clkR ? "" : hmS.s2.vPts >= 0 ? "+" : "") + pf(hmS.s2.vPts) + " pts", x2(hmS.s2.vAdr), "", "Today so far, in ADR20 of the trading day.")
                tcQ(hmS, hmS.s2.TK, 4, r0 + 1, pill(hmS.s2.stB), sFg, sBg, "Above / below = outside the middle half (25–75%) of " + bN + " days at this time.", text.align_center, true)
                cardRow(hmS, hmS.s2.TK, r0 + 2, hmC.cGh, "vs " + bN, false, meter(pc) + " " + pTxt(pc), "typ " + x2(q50), "", bN + " days by " + nowT + ": median " + pf(q50 * hmS.s2.scP) + ", middle half " + pf(hmS.s2.q25B * hmS.s2.scP) + "–" + pf(hmS.s2.q75B * hmS.s2.scP) + " pts (" + mW + ", at today's ADR20).", hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx)
                float sh = ckShAt(hmS, hmS.s2.ckI, hmS.s2.jB, hmS.s2.fB)
                float rgT = hmS.s1.tdH - hmS.s1.tdL
                cardRow(hmS, hmS.s2.TK, r0 + 3, hmC.cGh, "DONE", false, gauge(sh) + " " + p0(sh), sh >= 0.25 ? "→ " + pf(rgT / sh) : "—", "pts", "Median share of the final day range already made by this time on " + bN + " days; right: today's range so far ÷ that share, a rough full-day figure (shown from 25% on).")
            float bestD = -1.0
            int   bestJ = 1
            for j = 1 to 45
                float dj = ck(hmS, hmS.s2.ckEvI, 0, 2, j) - (j > 0 ? ck(hmS, hmS.s2.ckEvI, 0, 2, j - 1) : 0.0)
                if dj > bestD
                    bestD := dj
                    bestJ := j
            float nD = ck(hmS, NCK - 1, 0, 2, bestJ) - (bestJ > 0 ? ck(hmS, NCK - 1, 0, 2, bestJ - 1) : 0.0)
            cardRow(hmS, hmS.s2.TK, r0 + 4, hmC.cGh, "BUSIEST", false, hhmm(stepEnd(bestJ - 1)) + "–" + hhmm(stepEnd(bestJ)), "+" + x2(bestD), "norm +" + x2(nD), "The half hour in which the median running range of " + eN + " days grows most, against normal days in the same half hour.", hmS.s2.ckEv ? hmC.cGh : hmS.s1.cTx)
    true
drawLast1(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on)
        int xd = bar_index + offI
        // the week's open, extended to the right of price
        if hmC.showWO and not na(hmS.s1.wkX) and not na(hmS.s1.wkOp)
            hmS.s2.RL.push(line.new(math.max(hmS.s1.wkX, bar_index - 4900), hmS.s1.wkOp, xd, hmS.s1.wkOp, color = color.new(hmC.cLvl, 15), style = line.style_dashed, force_overlay = true))
            hmS.s2.RT.push(label.new(bar_index + 2, hmS.s1.wkOp, "week open " + pf(hmS.s1.wkOp), color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = hmS.s1.lbSz, force_overlay = true))
    true
zIdx(float p) => na(p) ? 1 : p >= 0.75 ? 2 : p <= 0.25 ? 0 : 1
zWd(int z) => z == 2 ? "PREM" : z == 0 ? "DISC" : "MID"
sgP(float v) => na(v) ? "—" : str.tostring(v, "0")
sgS(float v) => na(v) ? "—" : (v >= 0 ? "+" : "−") + str.tostring(math.abs(v), "0")
pcV(State hmS, int i) => hmS.s1.VS.get(i) < 0 ? "—" : str.tostring(hmS.s1.VS.get(i), "0")
hl(State hmS, int i) => "H" + pcV(hmS, i) + " L" + pcV(hmS, i + 1)
fl(State hmS, int i) => "FH" + pcV(hmS, i) + " FL" + pcV(hmS, i + 1)
hlH(int i) => vh(i) or vh(i + 1)
rg(State hmS, int i) => "R" + str.tostring(hmS.s1.VS.get(i), "0.00")
hhT(int t) => str.format_time(t, "HH:mm", TZ)
mOf(int t) => hour(t, TZ) * 60 + minute(t, TZ)
liveTx(float sv, float dv) => na(sv) ? "—" : sgS(sv) + " · DXY " + (na(dv) ? "—" : vzAr(dv) + str.tostring(math.abs(dv), "0.00"))
dxPill(State hmS, float dv, float sv, float thr) =>
    bool ok  = not (na(dv) or na(sv) or dv == 0 or sv == 0)
    bool big = ok and math.abs(dv) >= thr
    bool oth = ok and math.sign(dv) != math.sign(sv)
    [not ok ? "—" : (oth ? "⇄" : "⇉") + (big ? " BIG" : ""), big ? #ffffff : hmS.s1.cTx, not ok ? hmS.s2.cBody : big ? (oth ? hmS.s1.cOk : hmS.s1.cWarn) : hmS.s2.cNeu]
szT(State hmS, int i, string lab, float b) =>
    bool h = vh(i)
    [h ? lab + (hmS.s1.VS.get(i) > b ? "↑ " : "↓ ") : "", h ? lab + " " + str.tostring(hmS.s1.VS.get(i), "0.00") + " · " : "", h and hmS.s1.VS.get(i) > b ? 1 : 0, h and hmS.s1.VS.get(i) < b ? 1 : 0]
gpB(State hmS, int i, string s) => hmS.s2.gpOn ? s : "all " + pcV(hmS, i) + "%"
sgDot(Feed hmF) => barstate.isrealtime ? (hmF.beat % 2 == 0 ? "●" : "○") : "◆"
sgVals(State hmS) =>
    int    z   = hmS.s2.uZ
    float  a   = hmS.s2.uA
    int    o   = hmS.s2.isF ? 58 : 0
    float  eA  = hmS.s1.VS.get(o + 2 * z) * a
    float  eR  = hmS.s1.VS.get(o + 6 + 2 * z) * a
    float  rQ  = hmS.s2.stS and hmS.s1.tgKey == hmS.s1.calK and not na(hmS.s1.rH) ? hmS.s1.rH - hmS.s1.rL : na
    string zW  = z == 2 ? "PREMIUM" : z == 0 ? "DISCOUNT" : "MIDDLE"
    string mTp = "Price at " + (na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP)) + " of the month's range so far (" + (hmS.s2.fzS ? "09:29" : "live") + "): " + zW + ". " + (hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FMON) : VZT_WMON)
    string gpR = hmS.s2.isF ? "F" + pcV(hmS, 97 + hmS.s2.uGg) + " ½" + pcV(hmS, 100 + hmS.s2.uGg) : "½" + pcV(hmS, 48 + hmS.s2.uGg) + " F" + pcV(hmS, 51 + hmS.s2.uGg)
    bool   gpH = hmS.s2.isF ? vh(97 + hmS.s2.uGg) or vh(100 + hmS.s2.uGg) : vh(48 + hmS.s2.uGg) or vh(51 + hmS.s2.uGg)
    [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH]
drawSgA(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV) and not hmS.s2.mob
        [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH] = sgVals(hmS)
        string dayT = hmS.s2.evD ? "TODAY" : na(hmS.s2.uDd) ? "—" : "IN " + str.tostring(hmS.s2.uDd) + "D"
        string ttl  = hmS.s2.isF ? "FULL BRINGER · FOMC +1" : "HOLLOW · NFP WEEK"
        string oc   = octBar(hmS.s2.uOc) + " O" + (na(hmS.s2.uOc) ? "—" : str.tostring(hmS.s2.uOc))
        int    r    = hmS.s2.tvO
        cardHead(hmS, hmS.s2.TV, r, hmC.cGh, sgDot(hmF) + " " + ttl + " · " + hmS.s1.symTag + " · " + dayT + (hmS.s2.fzS ? " · 09:29" : ""), hmS.s1.TXA.get(hmS.s1.VZT_HD), zW, hmS.s3.zFg, hmS.s3.zBg)
        if hmS.s2.isF
            cardRow(hmS, hmS.s2.TV, r + 1, hmC.cGh, "FOMC", hlH(hmS.s2.fpI), "14:00→16:14 " + sgS(hmS.s2.fPo * hmS.s1.fA) + " · R" + (na(hmS.s2.fRg) ? "—" : str.tostring(hmS.s2.fRg, "0.0")), fdSg(hmS.s2.fPo, "0.0"), fl(hmS, hmS.s2.fpI), hmS.s1.TXA.get(hmS.s1.VZT_FP), na, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "MONTH", hlH(88 + 2 * z), oc, na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP), fl(hmS, 88 + 2 * z), mTp, z == 1 ? na : hmS.s3.zBg, hmS.s1.cSub)
        else
            cardRow(hmS, hmS.s2.TV, r + 1, hmC.cGh, "MONTH", hlH(36 + 2 * z) or vh(6 + 2 * z), oc, na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP), hl(hmS, 36 + 2 * z), mTp, z == 1 ? na : hmS.s3.zBg, hmS.s1.cSub)
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "MO", vh(42 + hmS.s2.uMo), "vs month open " + sgS(hmS.s2.uM * a), fdSg(hmS.s2.uM, "0.0"), rg(hmS, 42 + hmS.s2.uMo), "Month's open " + pf(hmF.mtO) + ": " + fdSg(hmS.s2.uM, "0.0") + " ADR (" + sgS(hmS.s2.uM * a) + " pts). " + hmS.s1.TXA.get(hmS.s1.VZT_WMO), hmS.s2.uMo == 0 ? hmS.s1.cHot : hmS.s2.uMo == 2 ? hmS.s1.cCold : na, hmS.s1.cSub)
    true
drawSgB(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV) and not hmS.s2.mob
        [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH] = sgVals(hmS)
        string lvH = hmS.s2.isF and hmS.s1.faF ? "FOMC high" : "PDH"
        string lvL = hmS.s2.isF and hmS.s1.faF ? "FOMC low" : "PDL"
        string pdT = na(hmS.s2.uD) ? "prior day —" : hmS.s2.uD > 0 ? "above " + lvH + " " + sgS(hmS.s2.uD * a) : hmS.s2.uD < 0 ? "below " + lvL + " " + sgS(hmS.s2.uD * a) : hmS.s2.isF and hmS.s1.faF ? "inside FOMC day" : "inside prior day"
        string gpT = na(hmS.s2.uG) ? "gap at 09:30" : (hmS.s2.gOpn ? "" : "now ") + (hmS.s2.uG >= 0 ? "gap up " : "gap down ") + sgP(math.abs(hmS.s2.uG) * a)
        string vxT = na(hmS.s2.uV) ? "VIX —" : "VIX " + str.tostring(hmF.vxC, "0.0") + " · " + fdSg(100 * hmS.s2.uV, "0") + "% vs 20d"
        int    r   = hmS.s2.tvO
        cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "PD", hlH((hmS.s2.isF ? 76 : 24) + 2 * hmS.s2.uPg), pdT, hmS.s2.uPg == 1 ? "" : fdSg(hmS.s2.uD, "0.0"), hl(hmS, (hmS.s2.isF ? 76 : 24) + 2 * hmS.s2.uPg), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FPD) : hmS.s1.TXA.get(hmS.s1.VZT_WPD), na, hmS.s1.cSub)
        cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, "O/N", hlH((hmS.s2.isF ? 82 : 30) + 2 * hmS.s2.uSg), "since 18:00 " + sgS(hmS.s2.uS * a), fdSg(hmS.s2.uS, "0.0"), hl(hmS, (hmS.s2.isF ? 82 : 30) + 2 * hmS.s2.uSg), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_F18) : hmS.s1.TXA.get(hmS.s1.VZT_W18), hmS.s2.uSg == 0 ? hmS.s2.cDisc : hmS.s2.uSg == 2 ? hmS.s2.cPrem : na, hmS.s1.cSub)
        cardRow(hmS, hmS.s2.TV, r + 5, hmC.cGh, "GAP", gpH, gpT, fdSg(hmS.s2.uG, "0.00"), gpR, hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP), na, hmS.s1.cSub)
        cardRow(hmS, hmS.s2.TV, r + 6, hmC.cGh, "VIX", vh((hmS.s2.isF ? 94 : 45) + hmS.s2.uVg), vxT, "", rg(hmS, (hmS.s2.isF ? 94 : 45) + hmS.s2.uVg), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FVX) : hmS.s1.TXA.get(hmS.s1.VZT_WVX), na, hmS.s1.cSub)
    true
drawSgC(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV) and not hmS.s2.mob and hmS.s2.stS
        [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH] = sgVals(hmS)
        float rA = na(hmS.s2.svA) or not (eA > 0) ? na : math.abs(hmS.s2.svA) / eA
        float rR = na(rQ) or not (eR > 0) ? na : rQ / eR
        [tA, fA_, bA] = dxPill(hmS, hmS.s2.dvA, hmS.s2.svA, hmS.s2.isF ? 99.0 : 0.19)
        [tR, fR, bR] = dxPill(hmS, hmS.s2.dvR, hmS.s2.svR, hmS.s2.isF ? 0.52 : 0.26)
        int r = hmS.s2.tvO
        cardSub(hmS, hmS.s2.TV, r + 7, hmS.s2.cDxc, "LIVE · vs DXY", "×typ", "DXY")
        cardRow(hmS, hmS.s2.TV, r + 8, hmC.cGh, "NY AM", false, liveTx(hmS.s2.svA, hmS.s2.dvA), na(rA) ? "" : x2(rA), "", hmS.s1.TXA.get(hmS.s1.VZT_LV), nz(rA) >= 1 ? hmS.s1.cHot : na)
        tcQ(hmS, hmS.s2.TV, 4, r + 8, tA, fA_, bA, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
        cardRow(hmS, hmS.s2.TV, r + 9, hmC.cGh, "RTH", false, liveTx(hmS.s2.svR, hmS.s2.dvR), "", "", hmS.s1.TXA.get(hmS.s1.VZT_LV) + " " + (hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FDR) : hmS.s1.TXA.get(hmS.s1.VZT_WDR)))
        tcQ(hmS, hmS.s2.TV, 4, r + 9, tR, fR, bR, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
        cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "RANGE", false, "since 09:30 " + sgP(rQ) + " pts", na(rR) ? "" : x2(rR), "med " + sgP(eR), "The RTH range so far against the EXPECT median for today's month position. " + (hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FE) : hmS.s1.TXA.get(hmS.s1.VZT_WE)), nz(rR) >= 1 ? hmS.s1.cHot : na)
        cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "GAP", gpH, "½ " + hmS.s2.sHalf + " · F " + hmS.s3.sFill, hmS.s2.isF ? pcV(hmS, 100 + hmS.s2.uGg) + "%" : pcV(hmS, 48 + hmS.s2.uGg) + "%", "F" + pcV(hmS, (hmS.s2.isF ? 97 : 51) + hmS.s2.uGg), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP))
    true
drawSgD(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV) and not hmS.s2.mob and not hmS.s2.stS
        [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH] = sgVals(hmS)
        int r = hmS.s2.tvO
        cardSub(hmS, hmS.s2.TV, r + 7, hmC.cGh, "EXPECT · " + zWd(z) + " · ADR " + sgP(a), "med", "80%")
        cardRow(hmS, hmS.s2.TV, r + 8, hmC.cGh, "NY AM", vh(o + 2 * z), "09:30–11:00", "±" + sgP(eA), "±" + sgP(hmS.s1.VS.get(o + 1 + 2 * z) * a), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FE) : hmS.s1.TXA.get(hmS.s1.VZT_WE))
        cardRow(hmS, hmS.s2.TV, r + 9, hmC.cGh, "RTH", vh(o + 6 + 2 * z), "RTH range", sgP(eR), sgP(hmS.s1.VS.get(o + 7 + 2 * z) * a), hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FE) : hmS.s1.TXA.get(hmS.s1.VZT_WE))
        if hmS.s2.isF
            cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "NEXT", vh(70 + 2 * z), "next day's range", sgP(hmS.s1.VS.get(70 + 2 * z) * a), sgP(hmS.s1.VS.get(71 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_FE))
            cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "¼", vh(152 + hmS.s2.uGg), "open-side ¼ held NY AM", pcV(hmS, 152 + hmS.s2.uGg) + "%", "all " + pcV(hmS, 168) + "%", hmS.s1.TXA.get(hmS.s1.VZT_Q))
        else
            cardRow(hmS, hmS.s2.TV, r + 10, hmC.cGh, "SETTLE", vh(12 + 2 * z), "16:15–17:00 range", sgP(hmS.s1.VS.get(12 + 2 * z) * a), sgP(hmS.s1.VS.get(13 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_WE))
            cardRow(hmS, hmS.s2.TV, r + 11, hmC.cGh, "NEXT", vh(18 + 2 * z), "next day's range", sgP(hmS.s1.VS.get(18 + 2 * z) * a), sgP(hmS.s1.VS.get(19 + 2 * z) * a), hmS.s1.TXA.get(hmS.s1.VZT_WE))
    true
drawSgM(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmC.showSg and not na(hmS.s2.TV) and hmS.s2.mob
        [z, a, o, eA, eR, rQ, zW, mTp, gpR, gpH] = sgVals(hmS)
        [tR, fR, bR] = dxPill(hmS, hmS.s2.dvR, hmS.s2.svR, hmS.s2.isF ? 0.52 : 0.26)
        int r = hmS.s2.tvO
        cardHead(hmS, hmS.s2.TV, r, hmC.cGh, sgDot(hmF) + " " + (hmS.s2.isF ? "FOMC +1" : "NFP WEEK") + " · " + hmS.s1.symTag + (hmS.s2.evD or na(hmS.s2.uDd) ? "" : " · " + str.tostring(hmS.s2.uDd) + "D"), hmS.s1.TXA.get(hmS.s1.VZT_HD), zWd(z), hmS.s3.zFg, hmS.s3.zBg)
        cardRow(hmS, hmS.s2.TV, r + 1, hmC.cGh, "MONTH", hmS.s2.isF ? hlH(88 + 2 * z) : hlH(36 + 2 * z), octBar(hmS.s2.uOc), na(hmS.s2.uP) ? "—" : p0(hmS.s2.uP), hmS.s2.isF ? fl(hmS, 88 + 2 * z) : hl(hmS, 36 + 2 * z), mTp, z == 1 ? na : hmS.s3.zBg)
        if hmS.s2.stS
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "RTH", false, liveTx(hmS.s2.svR, hmS.s2.dvR), "", "", hmS.s1.TXA.get(hmS.s1.VZT_LV))
            tcQ(hmS, hmS.s2.TV, 4, r + 2, tR, fR, bR, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
            cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "GAP", gpH, "½ " + hmS.s2.sHalf + " · F " + hmS.s3.sFill, "", "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP))
        else
            cardRow(hmS, hmS.s2.TV, r + 2, hmC.cGh, "EXP", vh(o + 6 + 2 * z), "RTH " + sgP(eR) + " · AM ±" + sgP(eA), sgP(hmS.s1.VS.get(o + 7 + 2 * z) * a), "80%", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FE) : hmS.s1.TXA.get(hmS.s1.VZT_WE))
            cardRow(hmS, hmS.s2.TV, r + 3, hmC.cGh, "GAP", gpH, (na(hmS.s2.uG) ? "gap —" : "gap " + fdSg(hmS.s2.uG, "0.00")) + " " + gpR, "", "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP))
        cardRow(hmS, hmS.s2.TV, r + 4, hmC.cGh, "PD", hlH((hmS.s2.isF ? 76 : 24) + 2 * hmS.s2.uPg), (hmS.s2.uPg == 0 ? "> " : hmS.s2.uPg == 2 ? "< " : "in ") + (hmS.s2.isF ? "FOMC " : "PD ") + hl(hmS, (hmS.s2.isF ? 76 : 24) + 2 * hmS.s2.uPg), hmS.s2.uPg == 1 ? "" : fdSg(hmS.s2.uD, "0.0"), "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FPD) : hmS.s1.TXA.get(hmS.s1.VZT_WPD))
    true
shSize(State hmS) =>
    float  base = hmS.s1.VS.get(hmS.s2.isF ? 165 : 155)
    int    zi   = (hmS.s2.isF ? 64 : 6) + 2 * hmS.s2.uZ
    string tg   = ""
    string tgN  = ""
    int    bg_  = vh(zi) and hmS.s1.VS.get(zi) > base ? 1 : 0
    int    sm_  = vh(zi) and hmS.s1.VS.get(zi) < base ? 1 : 0
    for g = 0 to 4
        int lv = g == 0 ? hmS.s2.uVg : g == 1 ? hmS.s2.uMo : g == 2 ? hmS.s2.uPg : g == 3 ? hmS.s2.uSg : hmS.s2.uGg
        if lv != 1 and (g == 0 or not hmS.s2.isF)
            int    ix = g == 0 ? (hmS.s2.isF ? 94 : 45) + hmS.s2.uVg : g == 1 ? 42 + hmS.s2.uMo : g == 2 ? 115 + hmS.s2.uPg : g == 3 ? 118 + hmS.s2.uSg : 121 + hmS.s2.uGg
            string lb = g == 0 ? "VIX" : g == 1 ? "MO" : g == 2 ? "PD" : g == 3 ? "O/N" : "GAP"
            [t1, n1, b1, s1] = szT(hmS, ix, lb, base)
            tg  += t1
            tgN += n1
            bg_ += b1
            sm_ += s1
    string agr = bg_ > 0 and sm_ == 0 ? "BIGGER" : sm_ > 0 and bg_ == 0 ? "SMALLER" : bg_ > 0 ? "MIXED" : "TYPICAL"
    string agT = "RTH range in ADR for each held size group active today (all such days " + str.tostring(base, "0.00") + "): " + (tgN == "" ? "none" : tgN) + " BIGGER / SMALLER = every held group, the month's position included, points the same way; MIXED = they disagree. " + (hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FVX) : hmS.s1.TXA.get(hmS.s1.VZT_WVX) + " " + hmS.s1.TXA.get(hmS.s1.VZT_WMO))
    [base, zi, tg, agr, agT]
shHL(State hmS) =>
    int    z  = hmS.s2.uZ
    int    xi = hmS.s2.isF ? (hmS.s2.uSg != 1 ? 82 + 2 * hmS.s2.uSg : hmS.s2.uPg != 1 ? 76 + 2 * hmS.s2.uPg : hmS.s2.uGg != 1 ? 140 + 2 * hmS.s2.uGg : 146 + 2 * z) : (hmS.s2.uSg != 1 ? 30 + 2 * hmS.s2.uSg : hmS.s2.uPg != 1 ? 24 + 2 * hmS.s2.uPg : hmS.s2.uGg != 1 ? 109 + 2 * hmS.s2.uGg : 36 + 2 * z)
    string xn = hmS.s2.uSg == 0 ? "O/N↑" : hmS.s2.uSg == 2 ? "O/N↓" : hmS.s2.uPg == 0 ? (hmS.s2.isF ? ">FOMC H" : ">PDH") : hmS.s2.uPg == 2 ? (hmS.s2.isF ? "<FOMC L" : "<PDL") : hmS.s2.uGg != 1 ? hmS.s3.gLab : zWd(z)
    [xi, xn, "H" + pcV(hmS, hmS.s2.isF ? 163 : 156) + " L" + pcV(hmS, hmS.s2.isF ? 164 : 157)]
agFg(State hmS, string s) => s == "BIGGER" or s == "SMALLER" ? #ffffff : hmS.s1.cTx
agBg(State hmS, string s) => s == "BIGGER" ? hmS.s1.cHot : s == "SMALLER" ? hmS.s1.cCold : hmS.s2.cNeu
shGi(State hmS) => hmS.s2.uGg != 1 ? 128 + 2 * hmS.s2.uGg : hmS.s2.fpI
shGn(State hmS) => hmS.s2.uGg == 0 ? "gap up" : hmS.s2.uGg == 2 ? "gap down" : na(hmS.s2.fPo) ? "14:00→16:14" : hmS.s2.fPo >= 0 ? "14:00→16:14 ▲" : "14:00→16:14 ▼"
shRi(State hmS) => hmS.s2.uVg != 1 ? 94 + hmS.s2.uVg : (64 + 2 * hmS.s2.uZ)
shN(State hmS) =>
    [base, zi, tg, agr, agT] = shSize(hmS)
    [xi, xn, xB] = shHL(hmS)
    int z = hmS.s2.uZ
    hmS.s2.isF ? (hlH(88 + 2 * z) ? 1 : 0) + (hlH(shGi(hmS)) ? 1 : 0) + (vh(shRi(hmS)) ? 1 : 0) + (hlH(xi) ? 1 : 0) + (vh(97 + hmS.s2.uGg) ? 1 : 0) + (vh(100 + hmS.s2.uGg) ? 1 : 0) + (vh(152 + hmS.s2.uGg) ? 1 : 0) + 1 + (hmS.s2.uVg == 1 ? 1 : 0) : (vh(zi) ? 1 : 0) + (tg != "" ? 1 : 0) + (hlH(xi) ? 1 : 0) + (vh(48 + hmS.s2.uGg) ? 1 : 0) + (vh(51 + hmS.s2.uGg) ? 1 : 0) + (vh(103 + hmS.s2.uGg) ? 1 : 0) + 2 + (hmS.s2.uSg == 0 ? 1 : 0)
drawShW1(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and not hmS.s2.isF and not hmS.s2.mob
        [base, zi, tg, agr, agT] = shSize(hmS)
        int   r = hmS.s2.thO
        float a = hmS.s2.uA
        cardHead(hmS, hmS.s2.TH, r, hmC.cSh, sgDot(hmF) + " SHIROSAKI · NFP WEEK", hmS.s1.TXA.get(hmS.s1.VZT_SHW), str.tostring(shN(hmS)) + " ✓", hmC.cSh, #ffffff)
        cardSub(hmS, hmS.s2.TH, r + 1, hmC.cSh, "NQ+ES+RTY · ADR " + sgP(a), "today", hmS.s2.stS ? "base · live" : "base")
        cardWide(hmS, hmS.s2.TH, r + 2, hmC.cSh, "SIDE", hmS.s2.uSg == 0 ? "O/N up: RTH up 69% vs 54% ✓" : "none held: size the day", hmS.s1.TXA.get(hmS.s1.VZT_SHW), hmS.s2.uSg == 0 ? hmS.s1.cOk : hmS.s1.cSub)
        cardRow(hmS, hmS.s2.TH, r + 3, hmC.cSh, "RANGE", vh(zi), "RTH range · " + zWd(hmS.s2.uZ), sgP(hmS.s1.VS.get(zi) * a), "all " + sgP(base * a), "RTH range for today's month position (" + zWd(hmS.s2.uZ) + "): median " + sgP(hmS.s1.VS.get(zi) * a) + ", 80% " + sgP(hmS.s1.VS.get(zi + 1) * a) + " pts. " + hmS.s1.TXA.get(hmS.s1.VZT_WE))
        cardRow(hmS, hmS.s2.TH, r + 4, hmC.cSh, "SIZE+", tg != "", tg == "" ? "none active" : tg, "", "", agT)
        tcQ(hmS, hmS.s2.TH, 3, r + 4, agr, agFg(hmS, agr), agBg(hmS, agr), agT, text.align_center, true)
    true
drawShW2(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and not hmS.s2.isF and not hmS.s2.mob
        [xi, xn, xB] = shHL(hmS)
        int r = hmS.s2.thO
        cardRow(hmS, hmS.s2.TH, r + 5, hmC.cSh, "H/L", hlH(xi), "after 09:30 · " + xn, hl(hmS, xi), xB, "New day high (H) / low (L) after 09:30 for today's most specific group (" + xn + "). " + hmS.s1.TXA.get(hmS.s1.VZT_W18) + " " + hmS.s1.TXA.get(hmS.s1.VZT_WPD))
        cardRow(hmS, hmS.s2.TH, r + 6, hmC.cSh, "½ 10:00", vh(48 + hmS.s2.uGg), hmS.s3.gLab + " · 50% by 10:00", pcV(hmS, 48 + hmS.s2.uGg) + "%", gpB(hmS, 158, hmS.s2.sHalf), "The gap's 50% traded by 10:00. " + hmS.s1.TXA.get(hmS.s1.VZT_WGP), na, hmS.s3.cH)
        cardRow(hmS, hmS.s2.TH, r + 7, hmC.cSh, "FILL", vh(51 + hmS.s2.uGg), hmS.s3.gLab + " · filled by 16:14", pcV(hmS, 51 + hmS.s2.uGg) + "%", gpB(hmS, 159, hmS.s3.sFill), "The whole gap filled by 16:14. " + hmS.s1.TXA.get(hmS.s1.VZT_WGP), na, hmS.s3.cF)
        cardRow(hmS, hmS.s2.TH, r + 8, hmC.cSh, "¼ OPEN", vh(103 + hmS.s2.uGg), hmS.s3.gLab + " · held NY AM", pcV(hmS, 103 + hmS.s2.uGg) + "%", gpB(hmS, 160, hmS.s3.sQ), "The open-side quarter: the quarter of the RTH gap next to the 09:30 open. " + PW + "NY AM never traded back past it on gap up " + pcV(hmS, 103) + "% · smaller gap " + pcV(hmS, 104) + "% · gap down " + pcV(hmS, 105) + "% of days (" + pcV(hmS, 160) + "% overall); each held. A minority outcome: most days retrace past it.", na, hmS.s3.cQ)
    true
drawShW3(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and not hmS.s2.isF and not hmS.s2.mob
        int r = hmS.s2.thO
        cardRow(hmS, hmS.s2.TH, r + 9, hmC.cSh, "DXY RTH", true, "BIG ≥ 0.26 → other way", "70%", "vs 42%", hmS.s1.TXA.get(hmS.s1.VZT_WDR))
        cardRow(hmS, hmS.s2.TH, r + 10, hmC.cSh, "DXY AM", true, "BIG ≥ 0.19 → other way", "60%", "vs 54%", hmS.s1.TXA.get(hmS.s1.VZT_WDR))
        if hmS.s2.stS
            [tR, fR, bR] = dxPill(hmS, hmS.s2.dvR, hmS.s2.svR, 0.26)
            [tA, fA_, bA] = dxPill(hmS, hmS.s2.dvA, hmS.s2.svA, 0.19)
            tcQ(hmS, hmS.s2.TH, 4, r + 9, tR, fR, bR, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
            tcQ(hmS, hmS.s2.TH, 4, r + 10, tA, fA_, bA, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
    true
drawShF1(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and hmS.s2.isF and not hmS.s2.mob
        int   r = hmS.s2.thO
        float a = hmS.s2.uA
        int   z = hmS.s2.uZ
        cardHead(hmS, hmS.s2.TH, r, hmC.cSh, sgDot(hmF) + " SHIROSAKI · FOMC +1", hmS.s1.TXA.get(hmS.s1.VZT_SHF), str.tostring(shN(hmS)) + " ✓", hmC.cSh, #ffffff)
        cardSub(hmS, hmS.s2.TH, r + 1, hmC.cSh, "NQ+ES+RTY · ADR " + sgP(a), "today", hmS.s2.stS ? "base · live" : "base")
        cardWide(hmS, hmS.s2.TH, r + 2, hmC.cSh, "SIDE", hmS.s2.uVg == 1 ? "VIX near avg: NY AM down 64% vs 42% ✓" : "none held: size the day", hmS.s1.TXA.get(hmS.s1.VZT_SHF), hmS.s2.uVg == 1 ? hmS.s1.cOk : hmS.s1.cSub)
        cardRow(hmS, hmS.s2.TH, r + 3, hmC.cSh, "FH/FL", hlH(88 + 2 * z), "RTH takes · " + zWd(z), fl(hmS, 88 + 2 * z), "FH" + pcV(hmS, 161) + " FL" + pcV(hmS, 162), hmS.s1.TXA.get(hmS.s1.VZT_FMON))
        cardRow(hmS, hmS.s2.TH, r + 4, hmC.cSh, "FH/FL", hlH(shGi(hmS)), "RTH takes · " + shGn(hmS), fl(hmS, shGi(hmS)), "", hmS.s2.uGg != 1 ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) + " " + hmS.s1.TXA.get(hmS.s1.VZT_FP) : hmS.s1.TXA.get(hmS.s1.VZT_FP))
        cardRow(hmS, hmS.s2.TH, r + 5, hmC.cSh, "RANGE", vh(shRi(hmS)), "RTH range · " + (hmS.s2.uVg == 0 ? "VIX high" : hmS.s2.uVg == 2 ? "VIX low" : zWd(z)), sgP(hmS.s1.VS.get(shRi(hmS)) * a), "all " + sgP(hmS.s1.VS.get(165) * a), hmS.s1.TXA.get(hmS.s1.VZT_FVX) + " " + hmS.s1.TXA.get(hmS.s1.VZT_FE))
    true
drawShF2(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and hmS.s2.isF and not hmS.s2.mob
        [xi, xn, xB] = shHL(hmS)
        int r = hmS.s2.thO
        cardRow(hmS, hmS.s2.TH, r + 6, hmC.cSh, "H/L", hlH(xi), "after 09:30 · " + xn, hl(hmS, xi), xB, "New day high (H) / low (L) after 09:30 for today's most specific group (" + xn + "). " + hmS.s1.TXA.get(hmS.s1.VZT_F18) + " " + hmS.s1.TXA.get(hmS.s1.VZT_FPD))
        cardRow(hmS, hmS.s2.TH, r + 7, hmC.cSh, "FILL", vh(97 + hmS.s2.uGg), hmS.s3.gLab + " · filled by 16:14", pcV(hmS, 97 + hmS.s2.uGg) + "%", gpB(hmS, 166, hmS.s3.sFill), "The whole gap filled by 16:14. " + hmS.s1.TXA.get(hmS.s1.VZT_FGP), na, hmS.s3.cF)
        cardRow(hmS, hmS.s2.TH, r + 8, hmC.cSh, "½ NY AM", vh(100 + hmS.s2.uGg), hmS.s3.gLab + " · 50% by 11:00", pcV(hmS, 100 + hmS.s2.uGg) + "%", gpB(hmS, 167, hmS.s2.sHalf), "The gap's 50% traded in NY AM. " + hmS.s1.TXA.get(hmS.s1.VZT_FGP), na, hmS.s3.cH)
        cardRow(hmS, hmS.s2.TH, r + 9, hmC.cSh, "¼ OPEN", vh(152 + hmS.s2.uGg), hmS.s3.gLab + " · held NY AM", pcV(hmS, 152 + hmS.s2.uGg) + "%", gpB(hmS, 168, hmS.s3.sQ), hmS.s1.TXA.get(hmS.s1.VZT_Q), na, hmS.s3.cQ)
        cardRow(hmS, hmS.s2.TH, r + 10, hmC.cSh, "DXY RTH", true, "BIG ≥ 0.52 → other way", "81%", "vs 41%", hmS.s1.TXA.get(hmS.s1.VZT_FDR))
        if hmS.s2.stS
            [tR, fR, bR] = dxPill(hmS, hmS.s2.dvR, hmS.s2.svR, 0.52)
            tcQ(hmS, hmS.s2.TH, 4, r + 10, tR, fR, bR, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
    true
drawShM1(State hmS, Cfg hmC, Feed hmF) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and hmS.s2.mob
        [base, zi, tg, agr, agT] = shSize(hmS)
        [xi, xn, xB] = shHL(hmS)
        int   r = hmS.s2.thO
        float a = hmS.s2.uA
        cardHead(hmS, hmS.s2.TH, r, hmC.cSh, sgDot(hmF) + " SHIROSAKI", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_SHF) : hmS.s1.TXA.get(hmS.s1.VZT_SHW), str.tostring(shN(hmS)) + " ✓", hmC.cSh, #ffffff)
        if hmS.s2.isF
            cardRow(hmS, hmS.s2.TH, r + 1, hmC.cSh, "FH/FL", hlH(shGi(hmS)) or hlH(88 + 2 * hmS.s2.uZ), shGn(hmS), fl(hmS, shGi(hmS)), "", hmS.s1.TXA.get(hmS.s1.VZT_FP))
        else
            cardRow(hmS, hmS.s2.TH, r + 1, hmC.cSh, "RANGE", vh(zi), zWd(hmS.s2.uZ) + " " + sgP(hmS.s1.VS.get(zi) * a) + " pts", "", "", hmS.s1.TXA.get(hmS.s1.VZT_WE))
            tcQ(hmS, hmS.s2.TH, 3, r + 1, agr, agFg(hmS, agr), agBg(hmS, agr), agT, text.align_center, true)
        cardRow(hmS, hmS.s2.TH, r + 2, hmC.cSh, "H/L", hlH(xi), "after 09:30 · " + xn, hl(hmS, xi), "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_F18) : hmS.s1.TXA.get(hmS.s1.VZT_W18))
    true
drawShM2(State hmS, Cfg hmC) =>
    if (barstate.islast and hmC.on) and hmS.s1.showSh and not na(hmS.s2.TH) and hmS.s2.mob
        int r  = hmS.s2.thO
        int iH = hmS.s2.isF ? 100 + hmS.s2.uGg : 48 + hmS.s2.uGg
        int iF = hmS.s2.isF ? 97 + hmS.s2.uGg : 51 + hmS.s2.uGg
        cardRow(hmS, hmS.s2.TH, r + 3, hmC.cSh, "½", vh(iH), hmS.s3.gLab + (hmS.s2.isF ? " · by 11:00" : " · by 10:00"), pcV(hmS, iH) + "%", hmS.s2.gpOn ? hmS.s2.sHalf : "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP), na, hmS.s3.cH)
        cardRow(hmS, hmS.s2.TH, r + 4, hmC.cSh, "FILL", vh(iF), hmS.s3.gLab + " · by 16:14", pcV(hmS, iF) + "%", hmS.s2.gpOn ? hmS.s3.sFill : "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP), na, hmS.s3.cF)
        cardRow(hmS, hmS.s2.TH, r + 5, hmC.cSh, "DXY", true, "RTH BIG → other", hmS.s2.isF ? "81%" : "70%", "", hmS.s2.isF ? hmS.s1.TXA.get(hmS.s1.VZT_FDR) : hmS.s1.TXA.get(hmS.s1.VZT_WDR))
        if hmS.s2.stS
            [tR, fR, bR] = dxPill(hmS, hmS.s2.dvR, hmS.s2.svR, hmS.s2.isF ? 0.52 : 0.26)
            tcQ(hmS, hmS.s2.TH, 4, r + 5, tR, fR, bR, hmS.s1.TXA.get(hmS.s1.VZT_LV), text.align_center, true)
    true
cardFlush(State hmS) =>
    if hmS.s2.CQ.size() > 0
        for q in hmS.s2.CQ
            table t = q.t
            int   r = q.r
            switch q.k
                0 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, q.b ? #ffffff : hmS.s1.cMu, q.b ? hmS.s1.cOk : hmS.s2.cBody, q.tip, text.align_center, q.b)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cTx, hmS.s2.cBody, q.tip)
                    tc(hmS, t, 3, r, q.s3, na(q.f1) ? hmS.s1.cTx : q.f1, hmS.s2.cBody, q.tip, text.align_center, true)
                    tc(hmS, t, 4, r, q.s4, na(q.f2) ? hmS.s1.cMu : q.f2, hmS.s2.cBody, q.tip, text.align_center)
                1 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, #ffffff, q.col, q.tip, text.align_left, true)
                    tc(hmS, t, 4, r, q.s4, q.f1, q.f2, "", text.align_center, true)
                2 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, "", hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 2, r, q.s2, hmS.s1.cMu, hmS.s2.cBody2)
                    tc(hmS, t, 3, r, q.s3, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                    tc(hmS, t, 4, r, q.s4, hmS.s1.cMu, hmS.s2.cBody2, "", text.align_center)
                3 =>
                    stripe(t, r, q.col)
                    tc(hmS, t, 1, r, q.s1, hmS.s1.cMu, hmS.s2.cBody, "", text.align_center)
                    tc(hmS, t, 2, r, q.s2, q.f1, hmS.s2.cBody, q.tip)
                4 =>
                    tc(hmS, t, q.c, r, q.s1, q.f1, q.f2, q.tip, q.ha, q.b)
                =>
                    stripe(t, r, q.col)
        hmS.s2.CQ.clear()
    true

// ═══════════════════════════════════════════════════════════════ Steps (Hueco Mundo calls them in order on every bar)
// @function Step 1: Today, live
export step1(State hmS, Cfg hmC, Feed hmF) =>
    hmS.s3.calK_1 := hmS.s1.calK
    hmS.s3.iwin_1 := hmS.s1.iwin
    hmS.s3.key_1 := hmS.s1.key
    hmS.s3.mod_1 := hmS.s1.mod
    hmS.s3.tdH_1 := hmS.s1.tdH
    hmS.s3.tdK_1 := hmS.s1.tdK
    hmS.s3.tdL_1 := hmS.s1.tdL
    hmS.s1.clkOn := hmC.paneI == "Clock + Shirosaki" or hmC.paneI == "Event clock"
    hmS.s1.showSh := hmC.paneI == "Clock + Shirosaki" or hmC.paneI == "Shirosaki"
    hmS.s1.AN := hmC.anchorI == "Trading day (18:00)" ? 0 : hmC.anchorI == "NY midnight" ? 1 : 2
    hmS.s1.isES := syminfo.root == "ES" or syminfo.root == "MES"
    hmS.s1.isNQ := syminfo.root == "NQ" or syminfo.root == "MNQ"
    hmS.s1.isRTY := syminfo.root == "RTY" or syminfo.root == "M2K"
    hmS.s1.symR := hmS.s1.isES ? "ES" : hmS.s1.isRTY ? "RTY" : "NQ"           // whose clock and tally the chart shows
    hmS.s1.symTag := hmS.s1.isNQ or hmS.s1.isES or hmS.s1.isRTY ? syminfo.root : syminfo.root + " (" + hmS.s1.symR + " DATA)"
    if barstate.isfirst
        hmS.s1.FO := parseDates(S_FOMC)
    if barstate.isfirst
        hmS.s1.CP := parseDates(S_CPI)
    if barstate.isfirst
        hmS.s1.NP := parseDates(S_NFP)
    if barstate.isfirst
        hmS.s1.CK := unpackMilli(hmS.s1.isES ? CK_ES : hmS.s1.isRTY ? CK_RTY : CK_NQ)
    hmS.s1.bgLum := 0.299 * color.r(chart.bg_color) + 0.587 * color.g(chart.bg_color) + 0.114 * color.b(chart.bg_color)
    hmS.s1.dark := hmC.themeI == "Dark" or (hmC.themeI == "Auto" and hmS.s1.bgLum < 128)
    hmS.s1.cBg := hmS.s1.dark ? #0e1117 : #ffffff
    hmS.s1.cTx := hmS.s1.dark ? #e6e9ef : #131722
    hmS.s1.cSub := hmS.s1.dark ? #9aa3b5 : #4a5163
    hmS.s1.cMu := hmS.s1.dark ? #5d6476 : #9aa1b2
    hmS.s1.cWarn := #ff5252
    hmS.s1.cHot := hmS.s1.dark ? #ff8a65 : #d84315
    hmS.s1.cCold := hmS.s1.dark ? #64b5f6 : #1565c0
    hmS.s1.cOk := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s1.crdSz := hmC.crdSzI == "Tiny" ? size.tiny : hmC.crdSzI == "Small" ? size.small : size.normal
    hmS.s1.lbSz := hmC.lblI == "Small" ? size.small : hmC.lblI == "Normal" ? size.normal : size.tiny
    hmS.s1.tfM := math.max(1, int(timeframe.in_seconds() / 60))
    hmS.s1.mod := hour(time, TZ) * 60 + minute(time, TZ)
    hmS.s1.calK := dateKey(time)
    hmS.s1.key := anchorKey(hmS.s1.AN, time)
    hmS.s1.iwin := inWin(hmS.s1.AN, hmS.s1.mod)
    hmS.s1.dSt := hmS.s1.iwin and (not hmS.s3.iwin_1 or hmS.s1.key != hmS.s3.key_1)
    if hmS.s1.dSt
        hmS.s1.pK := hmS.s1.dK
        hmS.s1.dK := hmS.s1.key
        hmS.s1.dO := open
        hmS.s1.dH := high
        hmS.s1.dL := low
        hmS.s1.dX := bar_index
        hmS.s1.dT := dayType(hmS, hmS.s1.key, hmS.s1.pK)
    else if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dH := math.max(hmS.s1.dH, high)
        hmS.s1.dL := math.min(hmS.s1.dL, low)
    if hmS.s1.iwin and not na(hmS.s1.dO)
        hmS.s1.dC := close
    hmS.s1.tdK := anchorKey(0, time)
    hmS.s1.tdSt := hmS.s1.tdK != hmS.s3.tdK_1
    if hmS.s1.tdSt
        hmS.s1.tdPK := hmS.s3.tdK_1
        hmS.s1.ptdH := hmS.s1.tdH
        hmS.s1.ptdL := hmS.s1.tdL
        hmS.s1.tdO  := open
        hmS.s1.tdH  := high
        hmS.s1.tdL  := low
        hmS.s1.tdX  := bar_index
    else
        hmS.s1.tdH := math.max(nz(hmS.s1.tdH, high), high)
        hmS.s1.tdL := math.min(nz(hmS.s1.tdL, low), low)
    hmS.s1.rthSt := hmS.s1.mod >= 570 and hmS.s1.mod < 975 and (hmS.s3.mod_1 < 570 or hmS.s3.mod_1 >= 975 or hmS.s1.calK != hmS.s3.calK_1)
    if hmS.s1.rthSt
        hmS.s1.rthO  := open
        hmS.s1.tgKey := hmS.s1.calK
        hmS.s1.tgGap := na(hmS.s1.rthC) ? na : open - hmS.s1.rthC
        hmS.s1.tgPct := na(hmS.s1.rthC) or hmS.s1.rthC == 0 ? na : (open / hmS.s1.rthC - 1) * 100
        hmS.s1.gapPC := hmS.s1.rthC
        hmS.s1.gapCE := na(hmS.s1.rthC) ? na : (hmS.s1.rthC + open) / 2
        hmS.s1.rH    := high
        hmS.s1.rL    := low
    else if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rH := math.max(hmS.s1.rH, high)
        hmS.s1.rL := math.min(hmS.s1.rL, low)
    if hmS.s1.mod >= 570 and hmS.s1.mod < 975
        hmS.s1.rthC := close
    hmS.s1.mHi := math.max(nz(hmF.mtH, hmS.s1.tdH), hmS.s1.tdH)
    hmS.s1.mLo := math.min(nz(hmF.mtL, hmS.s1.tdL), hmS.s1.tdL)
    hmS.s1.recent := time > timenow - hmC.markD * 86400000
    if barstate.isfirst
        hmS.s1.LTd := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTt := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTr := array.new<int>()
    if barstate.isfirst
        hmS.s1.LTg := array.new<float>()
    if barstate.isfirst
        hmS.s1.LTp := array.new<float>()
    hmS.s1.talEnd := hmS.s1.isES ? TAL_END_ES : hmS.s1.isRTY ? TAL_END_RTY : hmS.s1.isNQ ? TAL_END_NQ : 0
    hmS
// @function Step 2: Hollow stages (NFP week · day after FOMC)
export step2(State hmS, Feed hmF) =>
    if hmS.s1.tdSt and not na(hmS.s1.prvTdO) and hmS.s1.prvTdO_k == hmS.s3.tdK_1 and talIs(hmS, hmS.s3.tdK_1, hmS.s1.prvTdPK)
        bool rOk = hmS.s1.tgKey == hmS.s3.tdK_1 and not na(hmS.s1.rthO)
        hmS.s1.LTd.push(hmS.s3.tdK_1)
        hmS.s1.LTt.push(int(math.sign(close[1] - hmS.s1.prvTdO)))
        hmS.s1.LTr.push(rOk ? int(math.sign(hmS.s1.rthC - hmS.s1.rthO)) : 0)
        hmS.s1.LTg.push(rOk ? hmS.s1.tgGap : na)
        hmS.s1.LTp.push(rOk ? hmS.s1.tgPct : na)
    if hmS.s1.tdSt
        hmS.s1.prvTdO   := open
        hmS.s1.prvTdO_k := hmS.s1.tdK
        hmS.s1.prvTdPK  := hmS.s1.tdPK
    if hmS.s1.tdSt
        hmS.s1.dxTdO := hmF.dxL_1
    if barstate.isfirst
        hmS.s1.VS := parseStats("0.30,0.59,0.22,0.42,0.20,0.37,0.94,1.29,0.77,1.10,0.66,0.94,0.08,0.14,0.07,0.11,0.07,0.11,1.07,1.62,0.96,1.46,0.85,1.26,76,43,65,61,40,76,89,23,66,62,27,78,45,76,70,55,69,53,0.67,0.76,0.90,0.97,0.74,0.59,32,82,40,37,83,48,61,67,54,59,0.33,0.48,0.28,0.63,0.29,0.52,0.99,1.23,1.07,1.48,0.80,1.21,1.19,1.54,1.21,1.70,0.86,1.17,64,36,69,54,17,80,81,26,61,60,21,73,9,86,39,47,76,22,1.26,0.97,0.74,40,81,36,51,80,47,32,6,24,46,89,57,81,35,67,64,38,75,0.66,0.76,0.93,0.81,0.73,1.06,0.76,0.71,0.91,73,28,24,61,68,22,57,41,15,78,81,17,48,50,19,64,76,35,68,62,24,71,36,77,69,53,62,44,22,16,42,0.76,64,59,60,64,17,49,44,59,55,0.91,54,60,26,0.95")
    if barstate.isfirst
        hmS.s1.TXA := array.new<string>()
    if barstate.isfirst
        hmS.s1.VZT_WMO := txAdd(hmS, PW + "Over / under = more than 1 ADR from the month's open. Right: R = the RTH range, ADR. over (n 212) 0.67 · within (n 599) 0.76 · under (n 159) 0.90. Held: ✓ over: RTH range 0.67 vs 0.78 (2018–24 0.66 vs 0.76, 2025–26 0.72 vs 0.85; NQ 0.72 · ES 0.61 · RTY 0.72; p 0.008); ✓ under: RTH range 0.90 vs 0.74 (2018–24 0.81 vs 0.73, 2025–26 1.03 vs 0.77; NQ 0.91 · ES 0.90 · RTY 0.88; p 0.005).")
    if barstate.isfirst
        hmS.s1.VZT_WPD := txAdd(hmS, PW + "Against the prior day's high and low. Right: H / L after 09:30. above PDH (n 211) H76% L43% · inside (n 627) H65% L61% · below PDL (n 132) H40% L76%. Held: ✓ above PDH: new day high after 09:30 76% vs 61% (2018–24 76% vs 59%, 2025–26 77% vs 65%; NQ 76% · ES 78% · RTY 75%; p < 0.001); ✓ above PDH: new day low after 09:30 43% vs 64% (2018–24 44% vs 64%, 2025–26 40% vs 62%; NQ 45% · ES 42% · RTY 42%; p < 0.001); ✓ below PDL: new day high after 09:30 40% vs 68% (2018–24 33% vs 68%, 2025–26 60% vs 69%; NQ 46% · ES 34% · RTY 40%; p < 0.001); ✓ below PDL: new day low after 09:30 76% vs 56% (2018–24 79% vs 56%, 2025–26 66% vs 57%; NQ 72% · ES 77% · RTY 79%; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_W18 := txAdd(hmS, PW + "Overnight: the 18:00 open to 09:29, in ADR; strong = beyond ±0.4. Right: H / L after 09:30. up > 0.4 (n 122) H89% L23% · within (n 736) H66% L62% · down > 0.4 (n 112) H27% L78%. Held: ✓ up > 0.4 ADR: new day low after 09:30 23% vs 64% (2018–24 22% vs 65%, 2025–26 29% vs 61%; NQ 24% · ES 20% · RTY 24%; p < 0.001); ✓ within: new day low after 09:30 62% vs 49% (2018–24 63% vs 47%, 2025–26 59% vs 58%; NQ 61% · ES 58% · RTY 67%; p 0.010); ✓ down > 0.4 ADR: new day high after 09:30 27% vs 69% (2018–24 24% vs 68%, 2025–26 36% vs 73%; NQ 36% · ES 18% · RTY 26%; p < 0.001); ✓ down > 0.4 ADR: new day low after 09:30 78% vs 57% (2018–24 79% vs 57%, 2025–26 75% vs 56%; NQ 69% · ES 85% · RTY 79%; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_WGP := txAdd(hmS, PW + "RTH gap = 09:30 open − prior 16:14 close, in ADR. Right: ½ = the gap's 50% traded by 10:00, F = the whole gap filled by 16:14. gap up > 0.25 ADR (n 242) ½32% F37% · smaller (n 517) ½82% F83% · gap down > 0.25 ADR (n 211) ½40% F48%. Held: ✓ gap up: gap 50% by 10:00 32% vs 70% (2018–24 30% vs 70%, 2025–26 40% vs 70%; NQ 38% · ES 22% · RTY 37%; p < 0.001); ✓ gap up: gap filled by 16:14 37% vs 72% (2018–24 36% vs 71%, 2025–26 43% vs 78%; NQ 40% · ES 32% · RTY 38%; p < 0.001); ✓ smaller: gap 50% by 10:00 82% vs 36% (2018–24 81% vs 35%, 2025–26 85% vs 40%; NQ 84% · ES 79% · RTY 83%; p < 0.001); ✓ smaller: gap filled by 16:14 83% vs 42% (2018–24 81% vs 40%, 2025–26 91% vs 49%; NQ 80% · ES 84% · RTY 84%; p < 0.001); ✓ gap down: gap 50% by 10:00 40% vs 66% (2018–24 40% vs 65%, 2025–26 40% vs 72%; NQ 43% · ES 39% · RTY 39%; p < 0.001); ✓ gap down: gap filled by 16:14 48% vs 68% (2018–24 46% vs 66%, 2025–26 54% vs 77%; NQ 49% · ES 49% · RTY 45%; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_WVX := txAdd(hmS, PW + "VIX's prior close against its 20-day average (±10%). Right: R = the RTH range, ADR. over (n 215) 0.97 · near (n 596) 0.74 · under (n 159) 0.59. Held: ✓ VIX over: RTH range 0.97 vs 0.71 (2018–24 0.96 vs 0.68, 2025–26 1.02 vs 0.79; NQ 1.00 · ES 0.96 · RTY 0.93; p < 0.001); ✓ VIX under: RTH range 0.59 vs 0.79 (2018–24 0.59 vs 0.78, 2025–26 0.56 vs 0.85; NQ 0.61 · ES 0.56 · RTY 0.66; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_WE := txAdd(hmS, PW + "Median and 80th percentile by the month's position (discount · middle · premium; n 218 · 395 · 357), at today's ADR20. |NY AM| 09:30–11:00: 0.30 · 0.22 · 0.20 ADR (80%: 0.59 · 0.42 · 0.37) — held for discount, premium; RTH range: 0.94 · 0.77 · 0.66 ADR (80%: 1.29 · 1.10 · 0.94) — held for discount, premium; settlement window 16:15–17:00 range: 0.08 · 0.07 · 0.07 ADR (80%: 0.14 · 0.11 · 0.11) — held for discount, premium; next day's range: 1.07 · 0.96 · 0.85 ADR (80%: 1.62 · 1.46 · 1.26) — held for discount, premium. Sizes for stops and targets: which way it goes did not hold.")
    if barstate.isfirst
        hmS.s1.VZT_WDR := txAdd(hmS, PD + "RTH 09:30–16:14: with DXY ≥ 0.26 of its ADR20 (BIG) the index went the other way 70% (n 188 on 64 days; 2023–24 66%, 2025–26 74%; NQ 65% · ES 69% · RTY 75%; p < 0.001; held) vs 42% when smaller. NY AM: with DXY ≥ 0.19, 60% (2023–24 67%, 2025–26 53%; p 0.047; held, barely) vs 54%. It confirms the move, it does not call it.")
    if barstate.isfirst
        hmS.s1.VZT_FMON := txAdd(hmS, PF + "By the month's position. Right: how often RTH took the FOMC day's high (FH) and low (FL). discount (n 44) FH9% FL86% · middle (n 62) FH39% FL47% · premium (n 90) FH76% FL22%. Held: ✓ discount: took the FOMC high 9% vs 61% (2018–24 8% vs 61%, 2025–26 20% vs 59%; NQ 19% · ES 8% · RTY 0%; p < 0.001); ✓ discount: took the FOMC low 86% vs 32% (2018–24 92% vs 32%, 2025–26 40% vs 34%; NQ 81% · ES 100% · RTY 81%; p < 0.001); ✓ premium: took the FOMC high 76% vs 26% (2018–24 75% vs 25%, 2025–26 78% vs 32%; NQ 87% · ES 71% · RTY 68%; p < 0.001); ✓ premium: took the FOMC low 22% vs 63% (2018–24 21% vs 68%, 2025–26 28% vs 42%; NQ 13% · ES 29% · RTY 25%; p < 0.001). The EXPECT rows use this group.")
    if barstate.isfirst
        hmS.s1.VZT_FPD := txAdd(hmS, PF + "Against the FOMC day's high and low at 09:29. Right: H / L after 09:30. above the FOMC high (n 44) H64% L36% · inside (n 117) H69% L54% · below the FOMC low (n 35) H17% L80%. Held: ✓ above the FOMC high: new day low after 09:30 36% vs 60% (2018–24 39% vs 63%, 2025–26 27% vs 46%; NQ 37% · ES 38% · RTY 33%; p 0.047); ✓ inside: new day high after 09:30 69% vs 43% (2018–24 70% vs 38%, 2025–26 65% vs 64%; NQ 76% · ES 69% · RTY 64%; p 0.007); ✓ below the FOMC low: new day high after 09:30 17% vs 68% (2018–24 16% vs 68%, 2025–26 33% vs 68%; NQ 23% · ES 17% · RTY 10%; p < 0.001); ✓ below the FOMC low: new day low after 09:30 80% vs 49% (2018–24 81% vs 52%, 2025–26 67% vs 38%; NQ 77% · ES 75% · RTY 90%; p 0.004). (Above the FOMC high at 09:29, RTH takes it by construction.)")
    if barstate.isfirst
        hmS.s1.VZT_F18 := txAdd(hmS, PF + "Overnight after the decision: the 18:00 open to 09:29, in ADR. Right: H / L after 09:30. up > 0.4 (n 42) H81% L26% · within (n 121) H61% L60% · down > 0.4 (n 33) H21% L73%. Held: ✓ up > 0.4 ADR: new day high after 09:30 81% vs 53% (2018–24 77% vs 53%, 2025–26 92% vs 52%; NQ 87% · ES 86% · RTY 69%; p 0.006); ✓ up > 0.4 ADR: new day low after 09:30 26% vs 62% (2018–24 33% vs 64%, 2025–26 8% vs 56%; NQ 20% · ES 36% · RTY 23%; p 0.002); ✓ down > 0.4 ADR: new day high after 09:30 21% vs 66% (2018–24 19% vs 66%, 2025–26 50% vs 66%; NQ 30% · ES 20% · RTY 15%; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_FGP := txAdd(hmS, PF + "RTH gap = 09:30 open − FOMC day's 16:14 close, in ADR. Right: F = the whole gap filled by 16:14, ½ = its 50% traded in NY AM. gap up > 0.25 ADR (n 72) F40% ½51% · smaller (n 69) F81% ½80% · gap down > 0.25 ADR (n 55) F36% ½47%. Held: ✓ gap up: gap filled by 16:14 40% vs 61% (2018–24 43% vs 59%, 2025–26 33% vs 75%; NQ 32% · ES 39% · RTY 50%; p 0.040); ✓ smaller: gap filled by 16:14 81% vs 39% (2018–24 81% vs 36%, 2025–26 80% vs 47%; NQ 78% · ES 76% · RTY 88%; p < 0.001); ✓ smaller: gap 50% in NY AM 80% vs 50% (2018–24 78% vs 43%, 2025–26 100% vs 69%; NQ 83% · ES 81% · RTY 76%; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_FVX := txAdd(hmS, PF + "VIX's prior close against its 20-day average. Right: R = the RTH range, ADR. over (n 39) 1.26 · near (n 106) 0.97 · under (n 51) 0.74. Held: ✓ VIX over: RTH range 1.26 vs 0.82 (2018–24 1.32 vs 0.84, 2025–26 0.83 vs 0.79; NQ 1.12 · ES 1.37 · RTY 1.20; p < 0.001); ✓ VIX under: RTH range 0.74 vs 1.06 (2018–24 0.73 vs 1.10, 2025–26 0.74 vs 0.81; NQ 0.61 · ES 0.69 · RTY 0.76; p < 0.001).")
    if barstate.isfirst
        hmS.s1.VZT_FE := txAdd(hmS, PF + "Median and 80th percentile by the month's position (discount · middle · premium; n 44 · 62 · 90), at today's ADR20. |NY AM| 09:30–11:00: 0.33 · 0.28 · 0.29 ADR (80%: 0.48 · 0.63 · 0.52); RTH range: 0.99 · 1.07 · 0.80 ADR (80%: 1.23 · 1.48 · 1.21); next day's range: 1.19 · 1.21 · 0.86 ADR (80%: 1.54 · 1.70 · 1.17) — held for middle, premium. Sizes for stops and targets: which way it goes did not hold.")
    if barstate.isfirst
        hmS.s1.VZT_FDR := txAdd(hmS, PD + "RTH 09:30–16:14: with DXY ≥ 0.52 of its ADR20 (BIG) the index went the other way 81% (n 42 on 14 days; 2023–24 78%, 2025–26 87%; NQ 93% · ES 79% · RTY 71%; p 0.003; held) vs 41% when smaller. NY AM: 63% with a big DXY move (p 0.228; not held). It confirms the move, it does not call it.")
    if barstate.isfirst
        hmS.s1.VZT_FP := txAdd(hmS, PF + "The FOMC day's own afternoon, 14:00 → 16:14. Right: FH / FL = RTH took the FOMC high / low the next day. up (n 98) FH73% FL28% · down (n 98) FH24% FL61%. Held: ✓ afternoon up: took the FOMC high 73% vs 24% (2018–24 75% vs 17%, 2025–26 64% vs 48%; NQ 77% · ES 73% · RTY 70%; p < 0.001); ✓ afternoon up: took the FOMC low 28% vs 61% (2018–24 27% vs 68%, 2025–26 29% vs 39%; NQ 26% · ES 33% · RTY 23%; p < 0.001); ✓ afternoon down: took the FOMC high 24% vs 73% (2018–24 17% vs 75%, 2025–26 48% vs 64%; NQ 40% · ES 19% · RTY 16%; p < 0.001); ✓ afternoon down: took the FOMC low 61% vs 28% (2018–24 68% vs 27%, 2025–26 39% vs 29%; NQ 57% · ES 61% · RTY 65%; p < 0.001). By where the FOMC day closed in its range: top quarter FH81% FL17% · middle FH48% FL50% · bottom quarter FH19% FL64%.")
    if barstate.isfirst
        hmS.s1.VZT_Q := txAdd(hmS, PF + "The open-side quarter: the quarter of the RTH gap next to the 09:30 open (the top quarter of a gap up, the bottom of a gap down). NY AM never traded back past it on gap up 22% · smaller gap 16% · gap down 42% of days (26% overall). Still a minority outcome: most days retrace past it.")
    if barstate.isfirst
        hmS.s1.VZT_HD := txAdd(hmS, "Hollow reads two days at the RTH open (09:29): Monday–Thursday of NFP week (Model 11) and the day after FOMC (Model 12, Full Bringer), led by where price sits in the month's range. SETUP: the month, its open, the prior day (the FOMC day's own range the day after), the overnight, the RTH gap and VIX (live, then fixed at 09:29). EXPECT: how far such days moved, at today's ADR20. LIVE (after 09:30): NY AM and RTH against DXY, the gap and the range since 09:30. Figures pooled from NQ, ES and RTY. Green key = held. No 09:29 feature called the day's direction.")
    if barstate.isfirst
        hmS.s1.VZT_LV := txAdd(hmS, "Today so far (points from the 09:30 open) and DXY's move in the same window, in DXY's ADR20. ×typ = against the EXPECT median. ⇄ = the other way to DXY, ⇉ = the same way. BIG = DXY's move reached the size where the other-way rate applies (NFP week: 0.19 in NY AM, 0.26 over RTH; day after FOMC: 0.52 over RTH).")
    if barstate.isfirst
        hmS.s1.VZT_SHW := txAdd(hmS, "Shirosaki · NFP week. HYDRA on NQ + ES + RTY pooled (773 training rows on 258 days 2018–24, errors clustered by date; 406 heads × 15 targets; 20 shifted-target nulls; locked 2025–26 test (197 rows on 71 days) plus the same sign on each symbol). Direction: NY AM up, RTH up and the settlement window had no more survivors than their nulls (10 / 4 / 0 vs null means 14 / 19 / 4), and the whole net scored AUC 0.52–0.56 on 2025–26. Group tests: 3 of 44 direction tests passed the ✓ rule, about what chance gives with this many tries. SIDE shows the one that leans 60 / 40 or more: after an overnight up more than 0.4 ADR, RTH closed up 69% vs 54% (2018–24 70% vs 52%, 2025–26 65% vs 61%; NQ 73 · ES 66 · RTY 68; p 0.014; n 122 on 60 days). The other two are near a coin flip: NY AM up 56% vs 48% from the month's middle; RTH up 53% vs 64% after a flat overnight. What held: the gap (filled 33 heads, 50% by 10:00 30, in NY AM 30, open-side quarter 29), the RTH range 37, the next day 33, new high 29 and low 31 after 09:30, |NY AM| 12, the settlement range 11.")
    if barstate.isfirst
        hmS.s1.VZT_SHF := txAdd(hmS, "Shirosaki · day after FOMC. HYDRA on NQ + ES + RTY pooled (159 training rows on 53 days 2018–24; 413 heads × 15 targets; locked 2025–26 test on 37 rows / 14 days plus each symbol). Direction: NY AM up had 0 survivors and RTH up 8 against a null maximum of 30; no direction head held in 2025–26. The whole net beat its null on NY AM up (AUC 0.71) and on NY AM going the stage-2 way (0.76), but on 14 days and with no single head behind it: unconfirmed. Group tests: 2 of 46 direction tests passed the ✓ rule, about what chance gives. SIDE shows the one that leans 60 / 40 or more: with VIX within 10% of its 20-day average, NY AM went down 64% vs 42% (2018–24 67% vs 40%, 2025–26 55% vs 53%, barely; NQ 63 · ES 63 · RTY 67; p 0.039; n 106 on 36 days). The other: inside the FOMC day's range at 09:29, NY AM up 54% vs 34%, near a coin flip. What held: RTH taking the FOMC high (31 heads) and low (15), new high after 09:30 (16), the gap fill (9) and its 50% in NY AM (4).")
    hmS.s1.hwF := hollowDay(hmS, hmS.s1.calK) and not hmS.s1.FO.includes(hmS.s1.tdPK)
    hmS.s1.faF := hmS.s1.FO.includes(hmS.s1.tdPK) and hmS.s1.tdK == hmS.s1.calK                      // the day after an FOMC day
    if ta.change(time("W")) != 0
        hmS.s1.wkX  := bar_index
        hmS.s1.wkOp := open
    if hmS.s1.FO.includes(hmS.s1.calK) and hmS.s1.mod >= 840 and (hmS.s3.mod_1 < 840 or hmS.s3.calK_1 != hmS.s1.calK)
        hmS.s1.fc59 := close[1]
        hmS.s1.fA   := hmF.ADRtd * hmS.s1.tdO
        hmS.s1.fK   := hmS.s1.calK
    hmS.s2.at930 := (hmS.s1.hwF or hmS.s1.faF) and hmS.s1.tfM <= 30 and hmS.s1.rthSt and hmS.s1.tgKey == hmS.s1.calK and nz(hmS.s1.hK) != hmS.s1.calK
    if hmS.s2.at930
        hmS.s1.hK   := hmS.s1.calK
        hmS.s1.x0   := hmF.dxL_1
        hmS.s1.amC  := na
        hmS.s1.xA   := na
        hmS.s1.xR   := na
        hmS.s2.ceT  := na
        hmS.s2.gfT  := na
        hmS.s2.qbT  := na
        [p_, m_, d_, q_, a_] = ctxOf(hmS, hmF, close[1], hmS.s3.tdH_1, hmS.s3.tdL_1)
        hmS.s1.k59 := hmS.s1.calK
        hmS.s1.cxP := p_
        hmS.s1.cxM := m_
        hmS.s2.cxD := d_
        hmS.s2.cxS := q_
        hmS.s2.cxA := a_
    if hmS.s1.hK == hmS.s1.calK and na(hmS.s1.amC) and hmS.s1.mod >= 660 and hmS.s1.mod < 975
        hmS.s1.amC := close[1]
        hmS.s1.xA  := hmF.dxL_1
    if hmS.s1.hK == hmS.s1.calK and na(hmS.s1.xR) and hmS.s1.mod >= 975
        hmS.s1.xR := hmF.dxL_1
    hmS
// @function Step 3: Model structure on the price chart
export step3(State hmS, Cfg hmC, Feed hmF) =>
    if hmS.s1.hK == hmS.s1.calK and hmS.s1.mod >= 570 and hmS.s1.mod < 975 and not na(hmS.s1.gapPC) and hmS.s1.rthO != hmS.s1.gapPC
        float g_ = hmS.s1.rthO - hmS.s1.gapPC
        if na(hmS.s2.ceT) and (g_ > 0 ? low <= hmS.s1.gapCE : high >= hmS.s1.gapCE)
            hmS.s2.ceT := time
        if na(hmS.s2.gfT) and (g_ > 0 ? low <= hmS.s1.gapPC : high >= hmS.s1.gapPC)
            hmS.s2.gfT := time
        if na(hmS.s2.qbT) and hmS.s1.mod < 660 and (g_ > 0 ? low <= hmS.s1.gapPC + 0.75 * g_ : high >= hmS.s1.gapPC + 0.75 * g_)
            hmS.s2.qbT := time
    hmS.s2.SGR := hmC.layI == "Mobile" ? 5 : 12
    if (barstate.islast and hmC.on) and na(hmS.s2.TV) and hmC.showSg
        hmS.s2.tvO := hmC.sgPos == "Top left" or hmC.sgPos == "Top center" or (hmC.sgPos == "Top right" and hmC.sgOn == "Indicator pane") ? 1 : 0
        if hmC.sgOn == "Price chart"
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
        else
            hmS.s2.TV := table.new(posOf(hmC.sgPos), 5, hmS.s2.SGR + hmS.s2.tvO, bgcolor = #00000000, frame_width = 0, border_width = 0)
        if hmS.s2.tvO == 1
            hmS.s2.TV.cell(0, 0, "", height = hmC.sgOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
            hmS.s2.TV.merge_cells(0, 0, 4, 0)
        hmS.s2.TV.merge_cells(1, hmS.s2.tvO, 3, hmS.s2.tvO)
    hmS.s2.HYR := hmC.layI == "Mobile" ? 6 : 11
    if (barstate.islast and hmC.on) and na(hmS.s2.TH) and hmS.s1.showSh
        hmS.s2.thO := str.startswith(hmC.shPos, "Top") ? 1 : 0
        hmS.s2.TH  := table.new(posOf(hmC.shPos), 5, hmS.s2.HYR + hmS.s2.thO, bgcolor = #00000000, frame_width = 0, border_width = 0)
        if hmS.s2.thO == 1
            hmS.s2.TH.cell(0, 0, "", height = 7.0, bgcolor = #00000000)
            hmS.s2.TH.merge_cells(0, 0, 4, 0)
        hmS.s2.TH.merge_cells(1, hmS.s2.thO, 3, hmS.s2.thO)
        if hmC.layI != "Mobile"
            hmS.s2.TH.merge_cells(2, hmS.s2.thO + 2, 4, hmS.s2.thO + 2)
    if barstate.isfirst
        hmS.s2.GL := array.new<line>()
    if barstate.isfirst
        hmS.s2.GLE := array.new<int>()
    if barstate.isfirst
        hmS.s2.GT := array.new<label>()
    if barstate.isfirst
        hmS.s2.GTE := array.new<int>()
    hmS.s2.hOn := hmC.showStr and hmS.s1.recent
    if hmS.s1.tdSt
        hmS.s2.tdTy := dayType(hmS, hmS.s1.tdK, hmS.s2.ptdK)
        if na(hmS.s2.ptdK) or dowOf(hmS.s1.tdK) <= dowOf(nz(hmS.s2.ptdK, hmS.s1.tdK))
            hmS.s2.nwC := close[1]
            hmS.s2.nwO := open
            int nfpK = na
            for j = 0 to 4
                if hmS.s1.NP.includes(addDays(hmS.s1.tdK, j)) and na(nfpK)
                    nfpK := addDays(hmS.s1.tdK, j)
            if hmS.s2.hOn and hmC.showNW and not na(nfpK) and not na(hmS.s2.nwC)
                int te = keyAt(nfpK, 510)
                float ce = (hmS.s2.nwC + hmS.s2.nwO) / 2
                trimL(hmS, line.new(time, hmS.s2.nwC, te, hmS.s2.nwC, xloc = xloc.bar_time, color = color.new(hmC.cNW, 40), style = line.style_dotted, force_overlay = true), te)
                trimL(hmS, line.new(time, hmS.s2.nwO, te, hmS.s2.nwO, xloc = xloc.bar_time, color = color.new(hmC.cNW, 40), style = line.style_dotted, force_overlay = true), te)
                trimL(hmS, line.new(time, ce, te, ce, xloc = xloc.bar_time, color = hmC.cNW, style = lsOf(hmC.stNW), force_overlay = true), te)
                trimT(hmS, label.new(te, ce, "NWOG 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cNW, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = VZT_NW, force_overlay = true), te)
        if hmS.s2.hOn and hmC.showFH and hmS.s1.FO.includes(hmS.s2.ptdK) and not na(hmS.s1.ptdH)
            trimL(hmS, line.new(time, hmS.s1.ptdH, keyAt(hmS.s1.tdK, 974), hmS.s1.ptdH, xloc = xloc.bar_time, color = hmC.cFH, style = lsOf(hmC.stFH), force_overlay = true), keyAt(hmS.s1.tdK, 974))
            trimL(hmS, line.new(time, hmS.s1.ptdL, keyAt(hmS.s1.tdK, 974), hmS.s1.ptdL, xloc = xloc.bar_time, color = hmC.cFH, style = lsOf(hmC.stFH), force_overlay = true), keyAt(hmS.s1.tdK, 974))
            trimT(hmS, label.new(keyAt(hmS.s1.tdK, 974), hmS.s1.ptdH, "FOMC high", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cFH, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = VZT_FH, force_overlay = true), keyAt(hmS.s1.tdK, 974))
            trimT(hmS, label.new(keyAt(hmS.s1.tdK, 974), hmS.s1.ptdL, "FOMC low", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cFH, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = VZT_FH, force_overlay = true), keyAt(hmS.s1.tdK, 974))
        hmS.s2.ptdK := hmS.s1.tdK
    if hmS.s2.hOn and hmC.showGap and (hmS.s2.tdTy == 5 or hmS.s2.tdTy == 3) and hmS.s1.rthSt and not na(hmS.s1.gapPC)
        trimL(hmS, line.new(time, hmS.s1.gapPC, keyAt(hmS.s1.calK, 974), hmS.s1.gapPC, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 40), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
        trimL(hmS, line.new(time, hmS.s1.gapCE, keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, xloc = xloc.bar_time, color = color.new(hmC.cLvl, 20), style = line.style_dotted, force_overlay = true), keyAt(hmS.s1.calK, 974))
        trimT(hmS, label.new(keyAt(hmS.s1.calK, 974), hmS.s1.gapCE, "gap 50%", xloc = xloc.bar_time, color = #00000000, textcolor = hmC.cLvl, style = label.style_label_left, size = hmS.s1.lbSz, tooltip = "RTH gap 50% = (prior 16:14 close + 09:30 open) ÷ 2. " + (hmS.s2.tdTy == 3 ? hmS.s1.TXA.get(hmS.s1.VZT_FGP) : hmS.s1.TXA.get(hmS.s1.VZT_WGP)), force_overlay = true), keyAt(hmS.s1.calK, 974))
    hmS.s2.mkN := not hmC.skipNfpMark and hmS.s1.NP.includes(hmS.s1.calK) and hmS.s1.mod <= 510 and hmS.s1.mod + hmS.s1.tfM > 510
    hmS.s2.mkF := hmS.s1.FO.includes(hmS.s1.calK) and hmS.s1.mod <= 840 and hmS.s1.mod + hmS.s1.tfM > 840
    if hmS.s2.hOn and hmC.markEv and (hmS.s2.mkN or hmS.s2.mkF)
        float yT = high + 0.3 * nz(hmF.ADRtd * hmS.s1.tdO, 4 * (high - low))
        hmS.s2.mkK := hmS.s1.calK
        hmS.s2.mkE := hmS.s2.mkN ? 540 : 870
        hmS.s2.mkV := line.new(time, open, time, yT, xloc = xloc.bar_time, color = color.new(hmC.cGh, 25), style = line.style_dotted, force_overlay = true)
        hmS.s2.mkL := label.new(time, yT, (hmS.s2.mkN ? "NFP 08:30 · " : "FOMC 14:00 · ") + pf(open), xloc = xloc.bar_time, color = hmC.cGh, textcolor = #ffffff, style = label.style_label_down, size = hmS.s1.lbSz == size.tiny ? size.small : hmS.s1.lbSz, tooltip = hmS.s2.mkN ? "NFP release, 08:30 ET: the end of the Hollow week. The stem runs to the 08:30 open." : "FOMC statement, 14:00 ET: tomorrow is a Full Bringer day (Model 12). The stem runs to the 14:00 open.", force_overlay = true)
    else if hmS.s2.mkK == hmS.s1.calK and hmS.s1.mod < hmS.s2.mkE and high + 0.3 * nz(hmF.ADRtd * hmS.s1.tdO) > hmS.s2.mkL.get_y()
        hmS.s2.mkL.set_y(high + 0.3 * nz(hmF.ADRtd * hmS.s1.tdO))
        hmS.s2.mkV.set_y2(high + 0.3 * nz(hmF.ADRtd * hmS.s1.tdO))
    hmS.s3.bg0 := hmS.s2.hOn and hmC.showSet and hmS.s2.tdTy == 5 and hmS.s1.mod >= 975 and hmS.s1.mod < 1020 ? hmC.cWin : na
    if hmS.s2.hOn and hmC.showOct and hmS.s1.faF and hmS.s1.rthSt and not na(hmS.s1.gapPC) and hmS.s1.rthO != hmS.s1.gapPC
        float gp = hmS.s1.rthO - hmS.s1.gapPC
        int   te = keyAt(hmS.s1.calK, 660)
        line  l6 = na
        line  l8 = na
        for k = 0 to 8
            line l = trimL(hmS, line.new(time, hmS.s1.gapPC + gp * k / 8, te, hmS.s1.gapPC + gp * k / 8, xloc = xloc.bar_time, color = k == 4 ? hmC.cLvl : k >= 6 ? color.new(hmC.cOq, 10) : color.new(hmC.cLvl, k == 0 ? 30 : 65), style = k == 4 ? line.style_dashed : line.style_dotted, width = k == 4 ? 2 : 1, force_overlay = true), te)
            if k == 6
                l6 := l
            if k == 8
                l8 := l
        linefill.new(l6, l8, hmC.cOq)
        trimT(hmS, label.new(te, hmS.s1.gapPC + gp * 0.875, "open-side ¼", xloc = xloc.bar_time, color = #00000000, textcolor = color.new(hmC.cOq, 0), style = label.style_label_left, size = hmS.s1.lbSz, tooltip = hmS.s1.TXA.get(hmS.s1.VZT_Q), force_overlay = true), te)
    hmS.s3.bg1 := hmS.s2.hOn and hmC.showOct and hmS.s1.faF and hmS.s1.mod >= 570 and hmS.s1.mod < 660 ? color.new(hmC.cOq, math.min(100, color.t(hmC.cOq) + 14)) : na
    hmS
// @function Step 4: Event clock (indicator pane)
export step4(State hmS, Cfg hmC, Feed hmF) =>
    if hmS.s2.GL.size() > 0
        for i = hmS.s2.GL.size() - 1 to 0
            int e = hmS.s2.GLE.get(i)
            hmS.s2.GL.get(i).set_x2(math.min(e, time))
            if time >= e
                hmS.s2.GL.remove(i)
                hmS.s2.GLE.remove(i)
    if hmS.s2.GT.size() > 0
        for i = hmS.s2.GT.size() - 1 to 0
            int e = hmS.s2.GTE.get(i)
            hmS.s2.GT.get(i).set_x(math.min(e, time))
            if time >= e
                hmS.s2.GT.remove(i)
                hmS.s2.GTE.remove(i)
    hmS.s2.clkTF := timeframe.isintraday and timeframe.in_seconds() <= 3600
    hmS.s2.clkGo := hmS.s1.clkOn and hmS.s2.clkTF
    hmS.s2.clkR := hmC.clkMet == "Range"
    hmS.s2.mSel := hmS.s2.clkR ? 0 : 1
    if barstate.isfirst
        hmS.s2.ckI := NCK - 1                                     // today's baseline: this event if today is one, else normal
    if hmS.s1.tdSt or barstate.isfirst
        [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
        hmS.s2.ckEv  := now_
        hmS.s2.ckEvI := ownCk(k_)
        hmS.s2.ckI   := now_ ? ownCk(k_) : NCK - 1
    hmS.s2.elM := (hmS.s1.mod - 1080 + 1440) % 1440
    hmS.s2.eEnd := math.min(1380.0, hmS.s2.elM + hmS.s1.tfM)
    hmS.s2.jB := math.min(45, math.max(0, int(math.ceil(hmS.s2.eEnd / 30.0)) - 1))
    hmS.s2.fB := math.max(0.0, math.min(1.0, (hmS.s2.eEnd - 30.0 * hmS.s2.jB) / 30.0))
    hmS.s2.scP := hmS.s1.tdO * hmF.ADRtd
    hmS.s2.vPts := hmS.s2.clkR ? hmS.s1.tdH - hmS.s1.tdL : close - hmS.s1.tdO
    hmS.s2.vAdr := hmS.s2.scP > 0 ? hmS.s2.vPts / hmS.s2.scP : na
    hmS.s2.q25B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 1, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.q75B := ckAt(hmS, hmS.s2.ckI, hmS.s2.mSel, 3, hmS.s2.jB, hmS.s2.fB)
    hmS.s2.stB := na(hmS.s2.vAdr) ? "" : hmS.s2.vAdr > hmS.s2.q75B ? "Above" : hmS.s2.vAdr < hmS.s2.q25B ? "Below" : "Inside"
    hmS.s2.isTd := anchorKey(0, last_bar_time) == hmS.s1.tdK
    hmS.s2.liveC := hmS.s2.stB == "Above" ? hmS.s1.cHot : hmS.s2.stB == "Below" ? hmS.s1.cCold : hmS.s1.cTx
    hmS.s3.p2 := hmS.s2.clkGo and hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc2 := hmS.s2.liveC
    hmS.s3.p3 := hmS.s2.clkGo and hmC.kPast and not hmS.s2.isTd and not hmS.s1.tdSt ? hmS.s2.vPts : na
    hmS.s3.pc3 := color.new(hmS.s1.cSub, 75)
    hmS.s2.ckTop := (hmC.showCk and hmC.ckOn == "Indicator pane" and str.startswith(hmC.ckPos, "Top")) or (hmS.s1.showSh and str.startswith(hmC.shPos, "Top"))
    hmS.s2.hdrm := hmS.s2.clkGo and hmS.s2.scP > 0 ? math.max(ck(hmS, hmS.s2.ckI, hmS.s2.mSel, 4, 45), ck(hmS, NCK - 1, hmS.s2.mSel, 4, 45)) * hmS.s2.scP * (hmS.s2.ckTop ? 1.75 : 1.1) : na
    hmS.s3.p4 := hmS.s2.hdrm
    if barstate.isfirst
        hmS.s2.KP := array.new<polyline>()
    if barstate.isfirst
        hmS.s2.KL := array.new<line>()
    if barstate.isfirst
        hmS.s2.KT := array.new<label>()
    drawCore1(hmS, hmC)
    hmS
// @function Step 5: Cards
export step5(State hmS, Cfg hmC) =>
    if barstate.isfirst
        hmS.s2.RB := array.new<box>()
    if barstate.isfirst
        hmS.s2.RL := array.new<line>()
    if barstate.isfirst
        hmS.s2.RT := array.new<label>()
    hmS.s2.cBody := hmS.s1.dark ? #161a23 : #f4f6f9
    hmS.s2.cBody2 := hmS.s1.dark ? #1c2130 : #e9edf3
    hmS.s2.cNeu := hmS.s1.dark ? #3a3f4b : #d1d4dc
    hmS.s2.cDxc := hmC.cAcD
    hmS.s2.cPrem := hmS.s1.dark ? #ef5350 : #d32f2f
    hmS.s2.cDisc := hmS.s1.dark ? #66bb6a : #2e7d32
    hmS.s2.mob := hmC.layI == "Mobile"
    hmS.s2.EV_N := hmS.s2.mob ? 6 : 8                    // Full: header · sub · DAY · RTH · GAP · WEEK · MONTH · NEXT; Mobile: header · NOW · DAY · GAP · WK · MO
    if (barstate.islast and hmC.on)
        if hmC.showEv and na(hmS.s2.TS)
            hmS.s2.tsO := gapOf("Price chart", hmC.crdPos) ? 1 : 0
            hmS.s2.TS  := table.new(posOf(hmC.crdPos), SC, hmS.s2.EV_N + hmS.s2.tsO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            if hmS.s2.tsO == 1
                hmS.s2.TS.cell(0, 0, "", height = 3.5, bgcolor = #00000000)
                hmS.s2.TS.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TS.merge_cells(1, hmS.s2.tsO, 3, hmS.s2.tsO)
            if not hmS.s2.mob
                hmS.s2.TS.merge_cells(2, hmS.s2.tsO + hmS.s2.EV_N - 1, SC - 1, hmS.s2.tsO + hmS.s2.EV_N - 1)
        if hmC.showCk and na(hmS.s2.TK)
            hmS.s2.tkO := gapOf(hmC.ckOn, hmC.ckPos) ? 1 : 0
            if hmC.ckOn == "Price chart"
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0, force_overlay = true)
            else
                hmS.s2.TK := table.new(posOf(hmC.ckPos), SC, KR + hmS.s2.tkO, bgcolor = #00000000, frame_width = 0, border_width = 0)
            if hmS.s2.tkO == 1
                hmS.s2.TK.cell(0, 0, "", height = hmC.ckOn == "Price chart" ? 3.5 : 7.0, bgcolor = #00000000)
                hmS.s2.TK.merge_cells(0, 0, SC - 1, 0)
            hmS.s2.TK.merge_cells(1, hmS.s2.tkO, 3, hmS.s2.tkO)
    if barstate.isfirst
        hmS.s2.CQ := array.new<CRow>()
    if barstate.isfirst
        hmS.s2.TEd := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEt := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEr := array.new<int>()
    if barstate.isfirst
        hmS.s2.TEg := array.new<float>()
    if barstate.isfirst
        hmS.s2.TEp := array.new<float>()
    if barstate.isfirst
        string src = hmS.s1.isES ? TAL_ES : hmS.s1.isRTY ? TAL_RTY : hmS.s1.isNQ ? TAL_NQ : ""
        if src != ""
            for rec in str.split(src, ";")
                array<string> f = str.split(rec, ",")
                if f.size() >= 3
                    hmS.s2.TEd.push(int(str.tonumber(f.get(0))))
                    hmS.s2.TEt.push(int(str.tonumber(f.get(1))))
                    hmS.s2.TEr.push(int(str.tonumber(f.get(2))))
                    hmS.s2.TEg.push(f.size() > 3 ? str.tonumber(f.get(3)) : na)
                    hmS.s2.TEp.push(f.size() > 4 ? str.tonumber(f.get(4)) : na)
    hmS
// @function Step 6: Hollow stages card and Shirosaki (last bar)
export step6(State hmS, Cfg hmC, Feed hmF) =>
    drawCore2(hmS, hmC, hmF)
    drawCore2B(hmS, hmC, hmF)
    drawLast1(hmS, hmC)
    if (barstate.islast and hmC.on)
        [k_, n_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.calK)
        hmS.s2.hKd := k_
        hmS.s2.hNw := n_
        hmS.s2.hDy := d_
    hmS.s2.isF := hmS.s2.hKd == 4                                               // the day after FOMC, else NFP week
    hmS.s2.evD := hmS.s2.hNw and (hmS.s2.isF ? hmS.s1.faF : hmS.s1.hwF)
    hmS.s2.fzS := not na(hmS.s1.k59) and hmS.s1.k59 == hmS.s1.calK
    [t_lp_, t_lm_, t_ld_, t_ls_, t_la_] = ctxOf(hmS, hmF, close, hmS.s1.tdH, hmS.s1.tdL)
    hmS.s2.lp_ := t_lp_
    hmS.s2.lm_ := t_lm_
    hmS.s2.ld_ := t_ld_
    hmS.s2.ls_ := t_ls_
    hmS.s2.la_ := t_la_
    hmS.s2.uP := hmS.s2.fzS ? hmS.s1.cxP : hmS.s2.lp_
    hmS.s2.uM := hmS.s2.fzS ? hmS.s1.cxM : hmS.s2.lm_
    hmS.s2.uD := hmS.s2.fzS ? hmS.s2.cxD : hmS.s2.ld_
    hmS.s2.uS := hmS.s2.fzS ? hmS.s2.cxS : hmS.s2.ls_
    hmS.s2.uA := hmS.s2.fzS ? hmS.s2.cxA : hmS.s2.la_
    hmS.s2.gOpn := hmS.s1.tgKey == hmS.s1.calK and not na(hmS.s1.gapPC) and hmS.s1.mod >= 570
    hmS.s2.uG := not (hmS.s2.uA > 0) ? na : hmS.s2.gOpn ? (hmS.s1.rthO - hmS.s1.gapPC) / hmS.s2.uA : not na(hmS.s1.rthC) ? (close - hmS.s1.rthC) / hmS.s2.uA : na      // before 09:30: the gap if it opened now
    hmS.s2.uV := hmF.vxA > 0 ? hmF.vxC / hmF.vxA - 1 : na
    hmS.s2.uZ := zIdx(hmS.s2.uP)
    hmS.s2.uOc := na(hmS.s2.uP) ? na : math.min(8, int(math.floor(hmS.s2.uP * 8)) + 1)
    hmS.s2.uMo := na(hmS.s2.uM) ? 1 : hmS.s2.uM > 1 ? 0 : hmS.s2.uM < -1 ? 2 : 1                  // over · near · under the month's open
    hmS.s2.uPg := na(hmS.s2.uD) ? 1 : hmS.s2.uD > 0 ? 0 : hmS.s2.uD < 0 ? 2 : 1                   // above the prior high · inside · below the prior low
    hmS.s2.uSg := na(hmS.s2.uS) ? 1 : hmS.s2.uS > 0.4 ? 0 : hmS.s2.uS < -0.4 ? 2 : 1               // overnight strong up · within · strong down
    hmS.s2.uGg := na(hmS.s2.uG) ? 1 : hmS.s2.uG > 0.25 ? 0 : hmS.s2.uG < -0.25 ? 2 : 1             // gap up · smaller · gap down
    hmS.s2.uVg := na(hmS.s2.uV) ? 1 : hmS.s2.uV > 0.1 ? 0 : hmS.s2.uV < -0.1 ? 2 : 1               // VIX over · near · under its average
    hmS.s2.uDd := na(hmS.s2.hDy) ? na : inDays(hmS.s2.hDy, hmS.s1.calK)
    hmS.s2.stS := hmS.s1.hK == hmS.s1.calK
    hmS.s2.svA := hmS.s2.stS and not na(hmS.s1.rthO) ? (na(hmS.s1.amC) ? close : hmS.s1.amC) - hmS.s1.rthO : na
    hmS.s2.svR := hmS.s2.stS and not na(hmS.s1.rthO) ? (hmS.s1.mod < 975 ? close : hmS.s1.rthC) - hmS.s1.rthO : na
    hmS.s2.dvA := hmS.s2.stS and not na(hmS.s1.x0) and hmF.dxA > 0 ? ((na(hmS.s1.xA) ? hmF.dxL : hmS.s1.xA) - hmS.s1.x0) / hmF.dxA : na
    hmS.s2.dvR := hmS.s2.stS and not na(hmS.s1.x0) and hmF.dxA > 0 ? ((na(hmS.s1.xR) ? hmF.dxL : hmS.s1.xR) - hmS.s1.x0) / hmF.dxA : na
    hmS.s2.fCl := hmS.s1.tgKey == hmS.s1.calK ? hmS.s1.gapPC : hmS.s1.rthC                            // the FOMC day's 16:14 close
    hmS.s2.fPo := hmS.s2.isF and hmS.s1.fK == hmS.s1.tdPK and not na(hmS.s1.fc59) and hmS.s1.fA > 0 and not na(hmS.s2.fCl) ? (hmS.s2.fCl - hmS.s1.fc59) / hmS.s1.fA : na
    hmS.s2.fpI := nz(hmS.s2.fPo) >= 0 ? 124 : 126
    hmS.s2.fRg := hmS.s2.isF and hmS.s1.faF and hmS.s1.fA > 0 ? (hmS.s1.ptdH - hmS.s1.ptdL) / hmS.s1.fA : na
    hmS.s2.gpOn := hmS.s2.stS and hmS.s2.gOpn and hmS.s1.rthO != hmS.s1.gapPC
    hmS.s2.cDl := hmS.s2.isF ? 660 : 600
    hmS.s2.sHalf := not hmS.s2.stS ? "from 09:30" : not hmS.s2.gpOn ? "no gap" : not na(hmS.s2.ceT) ? (mOf(hmS.s2.ceT) < hmS.s2.cDl ? "hit " : "late ") + hhT(hmS.s2.ceT) : hmS.s1.mod < hmS.s2.cDl ? "open" : "missed"
    hmS.s3.sFill := not hmS.s2.stS ? "from 09:30" : not hmS.s2.gpOn ? "no gap" : not na(hmS.s2.gfT) ? "filled " + hhT(hmS.s2.gfT) : hmS.s1.mod < 975 ? "open" : "missed"
    hmS.s3.sQ := not hmS.s2.stS ? "from 09:30" : not hmS.s2.gpOn ? "no gap" : not na(hmS.s2.qbT) ? "broke " + hhT(hmS.s2.qbT) : hmS.s1.mod < 660 ? "holding" : "held"
    hmS.s3.zBg := hmS.s2.uZ == 2 ? hmS.s2.cPrem : hmS.s2.uZ == 0 ? hmS.s2.cDisc : hmS.s2.cNeu
    hmS.s3.zFg := hmS.s2.uZ == 1 ? hmS.s1.cTx : #ffffff
    hmS.s3.gLab := hmS.s2.uGg == 0 ? "gap up" : hmS.s2.uGg == 2 ? "gap down" : "small gap"
    hmS.s3.cH := not na(hmS.s2.ceT) and mOf(hmS.s2.ceT) < hmS.s2.cDl ? hmS.s1.cOk : hmS.s2.sHalf == "missed" or str.startswith(hmS.s2.sHalf, "late") ? hmS.s1.cWarn : na
    hmS.s3.cF := not na(hmS.s2.gfT) ? hmS.s1.cOk : hmS.s3.sFill == "missed" ? hmS.s1.cWarn : na
    hmS.s3.cQ := not na(hmS.s2.qbT) ? hmS.s1.cWarn : hmS.s3.sQ == "held" ? hmS.s1.cOk : na
    drawSgA(hmS, hmC, hmF)
    drawSgB(hmS, hmC, hmF)
    drawSgC(hmS, hmC)
    drawSgD(hmS, hmC)
    drawSgM(hmS, hmC, hmF)
    drawShW1(hmS, hmC, hmF)
    drawShW2(hmS, hmC)
    drawShW3(hmS, hmC)
    drawShF1(hmS, hmC, hmF)
    drawShF2(hmS, hmC)
    drawShM1(hmS, hmC, hmF)
    drawShM2(hmS, hmC)
    hmS
// @function Step 7: Write the queued card cells, in the order they were queued
export step7(State hmS) =>
    cardFlush(hmS)
    hmS
// @function The day this module's cards read (yyyymmdd): today's trading day when it is one of its days, else the next.
export nextDay(State hmS) =>
    [k_, now_, d_] = ownProfile(hmS, hmS.s1.tdK, hmS.s1.tdPK, hmS.s1.tdK)
    d_

// @function A new, empty State with all its parts. Hold it with var.
export newState() =>
    State.new(StatePart1.new(), StatePart2.new(), StatePart3.new())

plot(na, "Hueco Mundo module", display = display.none)
